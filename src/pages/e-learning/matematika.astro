---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Matematika E-Learning — SAN TUTOR Learning Studio"
	titleEn="Mathematics E-Learning — SAN TUTOR Learning Studio"
	description="Pilih jalur belajar Matematika SAN TUTOR berdasarkan kurikulum Nasional, Cambridge, atau IB."
	descriptionEn="Choose SAN TUTOR Mathematics learning paths based on National, Cambridge, or IB curriculum needs."
	currentPage="math"
>
	<main id="top">
		<section class="math-hero">
			<div class="section-decor" aria-hidden="true">
				<span class="dot-grid dot-grid-hero"></span>
				<span class="blob blob-blue" style="top:-130px; left:-120px; width:340px; height:340px;"></span>
				<span class="blob blob-orange" style="bottom:-130px; right:20%; width:270px; height:270px;"></span>
				<svg class="doodle doodle-star" style="top:18%; left:6%;" width="26" height="26" viewBox="0 0 24 24" fill="var(--orange)"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2Z"/></svg>
			</div>

			<div class="wrap math-hero-inner">
				<div class="math-hero-copy reveal">
					<p class="eyebrow" data-i18n-id="SAN TUTOR Mathematics" data-i18n-en="SAN TUTOR Mathematics">SAN TUTOR Mathematics</p>
					<h1 data-i18n-id="Pilih Jalur Matematika Sesuai Kurikulum Anak" data-i18n-en="Choose the Right Mathematics Path for Your Child’s Curriculum">Pilih Jalur Matematika Sesuai Kurikulum Anak</h1>
					<p class="hero-lede" data-i18n-id="Setiap kurikulum punya cara belajar dan target yang berbeda. Di sini, orang tua dan siswa bisa memilih jalur Matematika yang paling sesuai: Nasional, Cambridge, atau IB." data-i18n-en="Each curriculum has different learning approaches and targets. Here, parents and students can choose the most suitable Mathematics path: National, Cambridge, or IB.">Setiap kurikulum punya cara belajar dan target yang berbeda. Di sini, orang tua dan siswa bisa memilih jalur Matematika yang paling sesuai: Nasional, Cambridge, atau IB.</p>
					<div class="hero-cta">
						<a href="#kurikulum" class="btn btn-primary btn-lg" data-i18n-id="Pilih Kurikulum" data-i18n-en="Choose Curriculum">Pilih Kurikulum</a>
						<a href="/e-learning" class="btn btn-ghost btn-lg" data-i18n-id="Kembali ke E-Learning" data-i18n-en="Back to E-Learning">Kembali ke E-Learning</a>
					</div>
					<dl class="hero-stats math-stats">
						<div><dt>3</dt><dd data-i18n-id="Jalur kurikulum" data-i18n-en="Curriculum paths">Jalur kurikulum</dd></div>
						<div><dt data-i18n-id="Slides" data-i18n-en="Slides">Slides</dt><dd data-i18n-id="Lesson interaktif" data-i18n-en="Interactive lessons">Lesson interaktif</dd></div>
						<div><dt data-i18n-id="Quiz" data-i18n-en="Quiz">Quiz</dt><dd data-i18n-id="Cek pemahaman" data-i18n-en="Understanding check">Cek pemahaman</dd></div>
					</dl>
				</div>

				<div class="math-visual reveal" aria-label="Mathematics learning path preview">
					<div class="math-board">
						<div class="math-board-top"><span></span><span></span><span></span></div>
						<div class="formula-card main-formula">
							<small>Lesson Preview</small>
							<strong>x + 5 = 12</strong>
							<p data-i18n-id="Pahami konsep, lalu latihan bertahap." data-i18n-en="Understand the concept, then practise step by step.">Pahami konsep, lalu latihan bertahap.</p>
						</div>
						<div class="mini-path">
							<span>01 Concept</span>
							<span>02 Example</span>
							<span>03 Practice</span>
							<span>04 Quiz</span>
						</div>
					</div>
					<div class="floating-math-card">
						<strong>72%</strong>
						<span data-i18n-id="Progress latihan" data-i18n-en="Practice progress">Progress latihan</span>
					</div>
				</div>
			</div>
		</section>

		<section class="curriculum-section" id="kurikulum">
			<div class="section-decor" aria-hidden="true">
				<span class="blob blob-sage" style="top:-90px; right:-100px; width:300px; height:300px;"></span>
			</div>
			<div class="wrap">
				<div class="section-head reveal">
					<p class="eyebrow" data-i18n-id="Pilih Kurikulum" data-i18n-en="Choose Curriculum">Pilih Kurikulum</p>
					<h2 data-i18n-id="Masuk ke Jalur Belajar yang Tepat" data-i18n-en="Enter the Right Learning Path">Masuk ke Jalur Belajar yang Tepat</h2>
					<p class="section-lede" data-i18n-id="Mulai dari kurikulum yang anak gunakan di sekolah. Setelah masuk, siswa bisa memilih level, topik, dan lesson slide yang ingin dipelajari." data-i18n-en="Start from the curriculum your child uses at school. After entering, students can choose their level, topic, and lesson slides.">Mulai dari kurikulum yang anak gunakan di sekolah. Setelah masuk, siswa bisa memilih level, topik, dan lesson slide yang ingin dipelajari.</p>
				</div>

				<div class="curriculum-grid">
					<a class="curriculum-card reveal" href="/e-learning/matematika/matematika_nasional">
						<span class="card-badge" data-i18n-id="Kurikulum Nasional" data-i18n-en="National Curriculum">Kurikulum Nasional</span>
						<h3 data-i18n-id="Nasional" data-i18n-en="National">Nasional</h3>
						<p data-i18n-id="Untuk siswa yang mengikuti Kurikulum Nasional atau Kurikulum Merdeka, dengan fokus pada penguatan konsep, latihan sekolah, dan persiapan ujian." data-i18n-en="For students following Indonesia’s National Curriculum or Kurikulum Merdeka, focused on concept mastery, school practice, and exam preparation.">Untuk siswa yang mengikuti Kurikulum Nasional atau Kurikulum Merdeka, dengan fokus pada penguatan konsep, latihan sekolah, dan persiapan ujian.</p>
						<ul>
							<li data-i18n-id="SD, SMP, SMA" data-i18n-en="Primary, Lower Secondary, High School">SD, SMP, SMA</li>
							<li data-i18n-id="Latihan bertahap" data-i18n-en="Step-by-step practice">Latihan bertahap</li>
							<li data-i18n-id="Persiapan ulangan" data-i18n-en="School test preparation">Persiapan ulangan</li>
						</ul>
						<span class="card-link" data-i18n-id="Buka Jalur Nasional →" data-i18n-en="Open National Path →">Buka Jalur Nasional →</span>
					</a>

					<a class="curriculum-card reveal" href="/e-learning/matematika/matematika_cambridge">
						<span class="card-badge blue" data-i18n-id="International Curriculum" data-i18n-en="International Curriculum">International Curriculum</span>
						<h3 data-i18n-id="Cambridge" data-i18n-en="Cambridge">Cambridge</h3>
						<p data-i18n-id="Untuk siswa Cambridge Primary, Lower Secondary, Checkpoint, atau IGCSE foundation yang membutuhkan penjelasan konsep dan latihan dengan gaya soal internasional." data-i18n-en="For Cambridge Primary, Lower Secondary, Checkpoint, or IGCSE foundation students who need concept explanations and international-style practice.">Untuk siswa Cambridge Primary, Lower Secondary, Checkpoint, atau IGCSE foundation yang membutuhkan penjelasan konsep dan latihan dengan gaya soal internasional.</p>
						<ul>
							<li>Cambridge Primary</li>
							<li>Lower Secondary</li>
							<li>Checkpoint / IGCSE Prep</li>
						</ul>
						<span class="card-link" data-i18n-id="Buka Jalur Cambridge →" data-i18n-en="Open Cambridge Path →">Buka Jalur Cambridge →</span>
					</a>

					<a class="curriculum-card reveal" href="/e-learning/matematika/matematika_ib">
						<span class="card-badge sage" data-i18n-id="Concept-Based Learning" data-i18n-en="Concept-Based Learning">Concept-Based Learning</span>
						<h3 data-i18n-id="IB" data-i18n-en="IB">IB</h3>
						<p data-i18n-id="Untuk siswa yang membutuhkan pendekatan Matematika berbasis konsep, inquiry, reasoning, dan aplikasi dalam konteks nyata." data-i18n-en="For students who need a concept-based Mathematics approach with inquiry, reasoning, and real-world application.">Untuk siswa yang membutuhkan pendekatan Matematika berbasis konsep, inquiry, reasoning, dan aplikasi dalam konteks nyata.</p>
						<ul>
							<li data-i18n-id="Conceptual understanding" data-i18n-en="Conceptual understanding">Conceptual understanding</li>
							<li data-i18n-id="Inquiry & reasoning" data-i18n-en="Inquiry & reasoning">Inquiry & reasoning</li>
							<li data-i18n-id="Problem solving" data-i18n-en="Problem solving">Problem solving</li>
						</ul>
						<span class="card-link" data-i18n-id="Buka Jalur IB →" data-i18n-en="Open IB Path →">Buka Jalur IB →</span>
					</a>
				</div>
			</div>
		</section>

		<section class="math-guide-section">
			<div class="wrap guide-inner">
				<div class="guide-copy reveal">
					<p class="eyebrow" data-i18n-id="Cara Memilih" data-i18n-en="How to Choose">Cara Memilih</p>
					<h2 data-i18n-id="Mulai dari Kurikulum Sekolah, Lalu Sesuaikan Target Anak" data-i18n-en="Start from the School Curriculum, Then Adjust to Your Child’s Goal">Mulai dari Kurikulum Sekolah, Lalu Sesuaikan Target Anak</h2>
					<p class="section-lede" data-i18n-id="Kalau anak belajar di sekolah nasional, mulai dari jalur Nasional. Kalau sekolah memakai Cambridge atau IB, gunakan jalur internasional agar bahasa soal, cara berpikir, dan bentuk latihan lebih sesuai." data-i18n-en="If your child studies in a national school, start with the National path. If the school uses Cambridge or IB, use the international path so the question language, thinking style, and practice format fit better.">Kalau anak belajar di sekolah nasional, mulai dari jalur Nasional. Kalau sekolah memakai Cambridge atau IB, gunakan jalur internasional agar bahasa soal, cara berpikir, dan bentuk latihan lebih sesuai.</p>
				</div>
				<div class="guide-list reveal">
					<div><strong>01</strong><span data-i18n-id="Pilih kurikulum" data-i18n-en="Choose curriculum">Pilih kurikulum</span></div>
					<div><strong>02</strong><span data-i18n-id="Pilih jenjang / level" data-i18n-en="Choose level">Pilih jenjang / level</span></div>
					<div><strong>03</strong><span data-i18n-id="Pilih topik" data-i18n-en="Choose topic">Pilih topik</span></div>
					<div><strong>04</strong><span data-i18n-id="Buka slide lesson" data-i18n-en="Open lesson slides">Buka slide lesson</span></div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.math-hero { padding: 64px 0 96px; overflow: hidden; position: relative; }
	.math-hero-inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
	.math-hero-copy h1 { font-size: clamp(2.1rem, 4vw, 3.15rem); line-height: 1.14; letter-spacing: -0.005em; margin-bottom: 20px; }
	.math-stats dt { color: var(--navy); }
	.math-visual { position: relative; min-height: 430px; display: grid; place-items: center; }
	.math-board { width: min(100%, 480px); background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-soft); position: relative; z-index: 1; }
	.math-board::before { content: ""; position: absolute; inset: -24px; border-radius: 42px; background: linear-gradient(135deg, var(--blue-light), var(--orange-light)); z-index: -1; }
	.math-board-top { display: flex; gap: 7px; margin-bottom: 18px; }
	.math-board-top span { width: 10px; height: 10px; border-radius: 50%; background: var(--border); }
	.formula-card { background: var(--cream); border: 1px solid var(--border); border-radius: 24px; padding: 28px; text-align: center; }
	.formula-card small { display: block; font-weight: 800; color: var(--orange); margin-bottom: 12px; }
	.formula-card strong { display: block; font-family: var(--font-display); color: var(--navy); font-size: clamp(2rem, 5vw, 4rem); margin-bottom: 12px; }
	.mini-path { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 14px; }
	.mini-path span { background: var(--white); border: 1px solid var(--border); border-radius: 16px; padding: 12px; font-weight: 800; color: var(--navy); font-size: 0.82rem; }
	.floating-math-card { position: absolute; right: -2px; bottom: 54px; background: var(--navy); color: var(--white); border-radius: 22px; padding: 18px 20px; box-shadow: 0 24px 40px -22px rgba(29, 43, 69, 0.55); }
	.floating-math-card strong { display: block; color: var(--white); font-family: var(--font-display); font-size: 2rem; }
	.floating-math-card span { color: rgba(255,255,255,0.72); font-weight: 700; font-size: 0.82rem; }
	.curriculum-section { padding: 90px 0 100px; background: var(--cream); position: relative; overflow: hidden; }
	.curriculum-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
	.curriculum-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 30px 26px; box-shadow: var(--shadow-soft); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; display: flex; flex-direction: column; min-height: 420px; }
	.curriculum-card:hover { transform: translateY(-6px); border-color: var(--orange); box-shadow: 0 22px 46px -24px rgba(29, 43, 69, 0.4); }
	.card-badge { width: fit-content; background: var(--orange-light); color: var(--orange); border-radius: 999px; padding: 6px 12px; font-size: .78rem; font-weight: 900; margin-bottom: 18px; }
	.card-badge.blue { background: var(--blue-light); color: var(--blue); }
	.card-badge.sage { background: var(--sage-light); color: var(--sage); }
	.curriculum-card h3 { font-size: 1.6rem; margin-bottom: 12px; }
	.curriculum-card p { font-size: .94rem; margin-bottom: 20px; }
	.curriculum-card ul { display: flex; flex-direction: column; gap: 9px; margin-top: auto; margin-bottom: 22px; }
	.curriculum-card li { color: var(--navy); font-weight: 800; font-size: .9rem; display: flex; gap: 8px; }
	.curriculum-card li::before { content: "✓"; color: var(--sage); font-weight: 900; }
	.card-link { color: var(--orange); font-weight: 900; }
	.math-guide-section { padding: 90px 0; background: var(--white); }
	.guide-inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: center; }
	.guide-copy h2 { font-size: clamp(1.7rem, 3vw, 2.35rem); margin-bottom: 14px; }
	.guide-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
	.guide-list div { background: var(--cream); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 22px; }
	.guide-list strong { display: block; font-family: var(--font-display); color: var(--blue); font-size: 1.3rem; margin-bottom: 8px; }
	.guide-list span { color: var(--navy); font-weight: 900; }
	@media (max-width: 980px) { .math-hero-inner, .guide-inner { grid-template-columns: 1fr; } .math-visual { order: -1; max-width: 520px; margin: 0 auto; } .math-hero-copy { text-align: center; } .math-hero-copy .hero-lede { margin-inline: auto; } .math-hero-copy .hero-cta, .math-hero-copy .hero-stats { justify-content: center; } .curriculum-grid { grid-template-columns: 1fr; } }
	@media (max-width: 560px) { .math-hero { padding-top: 42px; } .mini-path, .guide-list { grid-template-columns: 1fr; } .floating-math-card { position: static; margin-top: 16px; width: 100%; text-align: center; } .math-visual { display: block; min-height: auto; } .curriculum-card { min-height: auto; } }
</style>
