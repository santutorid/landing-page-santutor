---
import Layout from '../../../../layouts/Layout.astro';

const pageTitle = 'Cambridge Lower Secondary Mathematics Stage 8 — SAN TUTOR';
const pageDescription = 'Pilih unit dan topic Cambridge Lower Secondary Mathematics Stage 8 berdasarkan Scheme of Work: Number, Algebra, Geometry, Probability, Statistics, dan Transformations.';
const pageTitleEn = 'Cambridge Lower Secondary Mathematics Stage 8 — SAN TUTOR';
const pageDescriptionEn = 'Choose Cambridge Lower Secondary Mathematics Stage 8 units and topics based on the Scheme of Work: Number, Algebra, Geometry, Probability, Statistics, and Transformations.';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<main id="top">
		<section class="stage8-hero">
			<div class="section-decor" aria-hidden="true">
				<span class="dot-grid dot-grid-hero"></span>
				<span class="blob blob-blue" style="top:-120px; left:-140px; width:340px; height:340px;"></span>
				<span class="blob blob-orange" style="bottom:-120px; right:18%; width:260px; height:260px;"></span>
			</div>
			<div class="wrap stage8-hero-inner">
				<div class="stage8-hero-copy reveal">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge" data-i18n-id="← Kembali ke Cambridge Mathematics" data-i18n-en="← Back to Cambridge Mathematics">← Kembali ke Cambridge Mathematics</a>
					<p class="eyebrow">Cambridge Lower Secondary</p>
					<h1 data-i18n-id="Stage 8 Mathematics Lesson Library" data-i18n-en="Stage 8 Mathematics Lesson Library">Stage 8 Mathematics Lesson Library</h1>
					<p class="hero-lede" data-i18n-id="Pilih unit dan topic berdasarkan Scheme of Work Cambridge Lower Secondary Mathematics Stage 8. Halaman ini dibuat sebagai pintu masuk menuju slide lesson interaktif per bab." data-i18n-en="Choose units and topics based on the Cambridge Lower Secondary Mathematics Stage 8 Scheme of Work. This page is designed as the entry point for interactive lesson slides by chapter.">Pilih unit dan topic berdasarkan Scheme of Work Cambridge Lower Secondary Mathematics Stage 8. Halaman ini dibuat sebagai pintu masuk menuju slide lesson interaktif per bab.</p>
					<div class="stage8-stats" aria-label="Stage 8 overview">
						<div><strong>9</strong><span data-i18n-id="Unit" data-i18n-en="Units">Unit</span></div>
						<div><strong>23</strong><span data-i18n-id="Topic" data-i18n-en="Topics">Topic</span></div>
						<div><strong>150</strong><span data-i18n-id="Jam SOW" data-i18n-en="SOW hours">Jam SOW</span></div>
					</div>
				</div>

				<div class="stage8-overview-card reveal">
					<span class="overview-badge" data-i18n-id="Strands" data-i18n-en="Strands">Strands</span>
					<h2 data-i18n-id="Fokus Pembelajaran Stage 8" data-i18n-en="Stage 8 Learning Focus">Fokus Pembelajaran Stage 8</h2>
					<ul>
						<li><span>01</span><strong>Number</strong></li>
						<li><span>02</span><strong>Algebra, Geometry and Measure</strong></li>
						<li><span>03</span><strong>Statistics and Probability</strong></li>
					</ul>
					<p data-i18n-id="Klik topic untuk membuka halaman lesson. Untuk topic yang belum dibuat, link sementara diarahkan ke halaman coming soon agar struktur website tetap aman." data-i18n-en="Click a topic to open its lesson page. Topics that are not ready yet temporarily point to a coming soon page, so the website structure remains safe.">Klik topic untuk membuka halaman lesson. Untuk topic yang belum dibuat, link sementara diarahkan ke halaman coming soon agar struktur website tetap aman.</p>
				</div>
			</div>
		</section>

		<section class="stage8-map-section" id="topics">
			<div class="wrap">
				<div class="section-head reveal">
					<p class="eyebrow" data-i18n-id="Pilih Bab / Chapter" data-i18n-en="Choose a Chapter">Pilih Bab / Chapter</p>
					<h2 data-i18n-id="Unit dan Topic Cambridge Stage 8" data-i18n-en="Cambridge Stage 8 Units and Topics">Unit dan Topic Cambridge Stage 8</h2>
					<p class="section-lede" data-i18n-id="Susunan ini mengikuti long-term plan dalam Cambridge Lower Secondary Mathematics Stage 8 Scheme of Work. Urutan ini bisa dipakai sebagai struktur library slide lesson di website." data-i18n-en="This structure follows the long-term plan in the Cambridge Lower Secondary Mathematics Stage 8 Scheme of Work. It can be used as the lesson slide library structure on the website.">Susunan ini mengikuti long-term plan dalam Cambridge Lower Secondary Mathematics Stage 8 Scheme of Work. Urutan ini bisa dipakai sebagai struktur library slide lesson di website.</p>
				</div>

				<div class="unit-jump reveal" aria-label="Quick unit links">
