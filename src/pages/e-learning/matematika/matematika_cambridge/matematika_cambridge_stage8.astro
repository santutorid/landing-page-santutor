									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-construction-and-midpoints">
									<span class="topic-kicker">Topic 2</span>
									<strong>Construction and midpoints</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
					</div>
				</article>
				<article class="stage8-unit-card reveal" id="unit-8-7">
					<div class="unit-card-top">
						<span class="unit-code">Unit 8.7</span>
