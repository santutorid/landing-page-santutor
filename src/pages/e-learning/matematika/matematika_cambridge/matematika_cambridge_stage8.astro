									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-recording-and-interpreting-data">
									<span class="topic-kicker">Topic 2</span>
									<strong>Recording and interpreting data</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
