					<a href="#unit-8-2">8.2</a>
					<a href="#unit-8-3">8.3</a>
					<a href="#unit-8-4">8.4</a>
					<a href="#unit-8-5">8.5</a>
					<a href="#unit-8-6">8.6</a>
					<a href="#unit-8-7">8.7</a>
					<a href="#unit-8-8">8.8</a>
					<a href="#unit-8-9">8.9</a>
				</div>

				<div class="stage8-unit-grid">
				<article class="stage8-unit-card reveal" id="unit-8-1">
					<div class="unit-card-top">
						<span class="unit-code">Unit 8.1</span>
						<span class="unit-time">13% · 20 hours</span>
					</div>
					<h3 data-i18n-id="Bilangan dan perhitungan" data-i18n-en="Number and calculation">Bilangan dan perhitungan</h3>
					<p data-i18n-id="Nilai tempat, pembulatan, indeks, faktor, kelipatan, serta perhitungan bilangan bulat dan desimal." data-i18n-en="Place value, rounding, indices, factors, multiples, and confident calculation with integers and decimals.">Nilai tempat, pembulatan, indeks, faktor, kelipatan, serta perhitungan bilangan bulat dan desimal.</p>
					<div class="unit-strand">Number</div>
					<div class="topic-list">
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-place-value-and-rounding">
									<span class="topic-kicker">Topic 1</span>
									<strong>Place value and rounding</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-indices-factors-and-multiples">
									<span class="topic-kicker">Topic 2</span>
									<strong>Indices, factors and multiples</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-calculating-with-integers-and-decimals">
									<span class="topic-kicker">Topic 3</span>
									<strong>Calculating with integers and decimals</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
					</div>
				</article>
				<article class="stage8-unit-card reveal" id="unit-8-2">
					<div class="unit-card-top">
						<span class="unit-code">Unit 8.2</span>
						<span class="unit-time">13% · 20 hours</span>
					</div>
					<h3 data-i18n-id="Representasi dan manipulasi aljabar" data-i18n-en="Algebraic representation and manipulation">Representasi dan manipulasi aljabar</h3>
					<p data-i18n-id="Huruf sebagai variabel, ekspresi, formula, urutan operasi, faktorisasi, persamaan, pertidaksamaan, dan interval." data-i18n-en="Letters, expressions, formulae, order of operations, factorising, equations, inequalities and intervals.">Huruf sebagai variabel, ekspresi, formula, urutan operasi, faktorisasi, persamaan, pertidaksamaan, dan interval.</p>
					<div class="unit-strand">Algebra, Geometry and Measure</div>
					<div class="topic-list">
								<a class="topic-card" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-1">
									<span class="topic-kicker">Topic 1</span>
									<strong>Manipulating algebra, expressions and formulae</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-2">
									<span class="topic-kicker">Topic 2</span>
									<strong>Equations and inequalities</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
					</div>
				</article>
				<article class="stage8-unit-card reveal" id="unit-8-3">
					<div class="unit-card-top">
						<span class="unit-code">Unit 8.3</span>
						<span class="unit-time">13% · 20 hours</span>
					</div>
					<h3 data-i18n-id="Bangun 2D dan 3D" data-i18n-en="2D and 3D shape">Bangun 2D dan 3D</h3>
					<p data-i18n-id="Sifat segiempat dan poligon, lingkaran, luas, keliling, keliling lingkaran, luas permukaan, dan volume." data-i18n-en="Properties of quadrilaterals and polygons, circles, area, perimeter, circumference, surface area and volume.">Sifat segiempat dan poligon, lingkaran, luas, keliling, keliling lingkaran, luas permukaan, dan volume.</p>
					<div class="unit-strand">Algebra, Geometry and Measure</div>
					<div class="topic-list">
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-quadrilaterals-and-polygons">
									<span class="topic-kicker">Topic 1</span>
									<strong>Quadrilaterals and polygons</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-area-perimeter-and-circumference">
									<span class="topic-kicker">Topic 2</span>
									<strong>Area, perimeter and circumference</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-3d-shapes-surface-area-and-volume">
									<span class="topic-kicker">Topic 3</span>
									<strong>3D shapes, surface area and volume</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
								</a>
					</div>
				</article>
				<article class="stage8-unit-card reveal" id="unit-8-4">
					<div class="unit-card-top">
						<span class="unit-code">Unit 8.4</span>
						<span class="unit-time">13% · 20 hours</span>
					</div>
					<h3 data-i18n-id="Pecahan, desimal, persentase, rasio, dan proporsi" data-i18n-en="Fractions, decimals, percentages, ratio and proportion">Pecahan, desimal, persentase, rasio, dan proporsi</h3>
					<p data-i18n-id="Membandingkan bilangan, menghitung dengan pecahan, serta menghubungkan perubahan persentase, rasio, dan proporsi dalam konteks." data-i18n-en="Compare numbers, calculate with fractions, and connect percentage change, ratio and proportion in context.">Membandingkan bilangan, menghitung dengan pecahan, serta menghubungkan perubahan persentase, rasio, dan proporsi dalam konteks.</p>
					<div class="unit-strand">Number</div>
					<div class="topic-list">
								<a class="topic-card" href="/e-learning/coming-soon?subject=cambridge-stage-8-comparing-numbers">
									<span class="topic-kicker">Topic 1</span>
									<strong>Comparing numbers</strong>
									<small data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</small>
