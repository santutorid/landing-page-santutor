	<style>
		.stage8-hero { padding: 64px 0 88px; overflow: hidden; position: relative; }
		.stage8-hero-inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 50px; align-items: center; }
		.back-link { display: inline-flex; align-items: center; font-weight: 800; font-size: 0.88rem; color: var(--blue); margin-bottom: 18px; }
		.back-link:hover { color: var(--orange); }
		.stage8-hero-copy h1 { font-size: clamp(2.1rem, 4vw, 3.15rem); line-height: 1.14; margin-bottom: 20px; }
		.stage8-stats { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
		.stage8-stats div { min-width: 124px; background: var(--white); border: 1px solid var(--border); border-radius: 18px; padding: 16px 18px; box-shadow: var(--shadow-soft); }
		.stage8-stats strong { display: block; font-family: var(--font-display); font-size: 1.55rem; color: var(--navy); }
