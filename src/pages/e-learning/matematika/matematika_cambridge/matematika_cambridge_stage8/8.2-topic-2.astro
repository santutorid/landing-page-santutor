---
import Layout from '../../../../../layouts/Layout.astro';

const pageTitle = '8.2 Topic 2: Equations and Inequalities — SAN TUTOR';
const pageDescription = 'Lesson list for Cambridge Lower Secondary Stage 8 Mathematics Unit 8.2 Topic 2: Equations and inequalities.';
const pageTitleEn = '8.2 Topic 2: Equations and Inequalities — SAN TUTOR';
const pageDescriptionEn = 'Lesson library for Cambridge Lower Secondary Stage 8 Mathematics Unit 8.2 Topic 2: equations, inequalities, and intervals.';

const basePath = '/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-2';

const lessons = [
	{
		lessonNo: 'Lesson 1',
		titleId: 'From Words to Equations',
		titleEn: 'From Words to Equations',
		duration: '50 min',
		focusId: 'Membaca situasi sederhana, menentukan unknown, lalu menulis equation yang mewakili cerita.',
		focusEn: 'Read a simple situation, identify the unknown, and write an equation to represent the story.',
		objective: '8Ae.06',
		objectives: ['8Ae.06'],
		flowId: ['Hook: equation as a balance story', 'Identify the unknown', 'Translate words to equation', 'Mini whiteboard check'],
		flowEn: ['Hook: equation as a balance story', 'Identify the unknown', 'Translate words to equation', 'Mini whiteboard check'],
		featuresId: ['Balance puzzle', 'Tap-to-build equation', 'Story card challenge'],
		featuresEn: ['Balance puzzle', 'Tap-to-build equation', 'Story card challenge'],
		accent: '#F2761E',
		href: `${basePath}/8.2-topic2-lesson1`,
		statusId: 'Siap dibuat',
		statusEn: 'Ready to build',
	},
	{
		lessonNo: 'Lesson 2',
		titleId: 'Solving One-Step and Two-Step Equations',
		titleEn: 'Solving One-Step and Two-Step Equations',
		duration: '50 min',
		focusId: 'Menggunakan inverse operations untuk menyelesaikan linear equations secara bertahap.',
		focusEn: 'Use inverse operations to solve linear equations step by step.',
		objective: '8Ae.06',
		objectives: ['8Ae.06'],
		flowId: ['Warm-up: undo the operation', 'Solve one-step equations', 'Solve two-step equations', 'Exit ticket'],
		flowEn: ['Warm-up: undo the operation', 'Solve one-step equations', 'Solve two-step equations', 'Exit ticket'],
		featuresId: ['Equation unlock game', 'Step reveal', 'Error checker'],
		featuresEn: ['Equation unlock game', 'Step reveal', 'Error checker'],
		accent: '#3EB6EA',
		href: `${basePath}/8.2-topic2-lesson2`,
		statusId: 'Siap dibuat',
		statusEn: 'Ready to build',
	},
	{
		lessonNo: 'Lesson 3',
		titleId: 'Unknowns on Both Sides',
		titleEn: 'Unknowns on Both Sides',
		duration: '50 min',
		focusId: 'Menyelesaikan persamaan ketika unknown muncul di kedua sisi, termasuk kasus dengan brackets sederhana.',
		focusEn: 'Solve equations where the unknown appears on both sides, including simple bracket cases.',
		objective: '8Ae.06',
		objectives: ['8Ae.06'],
		flowId: ['Hook: balance scale', 'Move terms carefully', 'Solve and check', 'Board race'],
		flowEn: ['Hook: balance scale', 'Move terms carefully', 'Solve and check', 'Board race'],
		featuresId: ['Balance scale simulator', 'Which side first?', 'Team challenge'],
		featuresEn: ['Balance scale simulator', 'Which side first?', 'Team challenge'],
		accent: '#6E9B7D',
		href: `${basePath}/8.2-topic2-lesson3`,
		statusId: 'Siap dibuat',
		statusEn: 'Ready to build',
	},
	{
		lessonNo: 'Lesson 4',
		titleId: 'Inequalities and Integer Solutions',
		titleEn: 'Inequalities and Integer Solutions',
		duration: '50 min',
		focusId: 'Membaca tanda inequality, menyelesaikan inequality sederhana, dan menentukan solusi integer.',
		focusEn: 'Read inequality signs, solve simple inequalities, and identify integer solutions.',
		objective: '8Ae.07',
		objectives: ['8Ae.07'],
		flowId: ['Hook: more than / less than', 'Solve inequalities', 'Choose integer solutions', 'Quick quiz'],
		flowEn: ['Hook: more than / less than', 'Solve inequalities', 'Choose integer solutions', 'Quick quiz'],
		featuresId: ['Number line tap game', 'Integer solution picker', 'Mistake detective'],
		featuresEn: ['Number line tap game', 'Integer solution picker', 'Mistake detective'],
		accent: '#F2761E',
		href: `${basePath}/8.2-topic2-lesson4`,
		statusId: 'Siap dibuat',
		statusEn: 'Ready to build',
	},
	{
		lessonNo: 'Lesson 5',
		titleId: 'Open and Closed Intervals',
		titleEn: 'Open and Closed Intervals',
		duration: '50 min',
		focusId: 'Memahami interval terbuka dan tertutup, lalu merepresentasikannya pada number line.',
		focusEn: 'Understand open and closed intervals and represent them on a number line.',
		objective: '8Ae.07',
		objectives: ['8Ae.07'],
		flowId: ['Concept: open vs closed endpoints', 'Interval notation on a number line', 'Sort the interval', 'Exit ticket'],
		flowEn: ['Concept: open vs closed endpoints', 'Interval notation on a number line', 'Sort the interval', 'Exit ticket'],
		featuresId: ['Open/closed dot simulator', 'Interval sorting game', 'Number line challenge'],
		featuresEn: ['Open/closed dot simulator', 'Interval sorting game', 'Number line challenge'],
		accent: '#3EB6EA',
		href: `${basePath}/8.2-topic2-lesson5`,
		statusId: 'Siap dibuat',
		statusEn: 'Ready to build',
	},
];

const objectives = [
	{
		code: '8Ae.06',
		textId: 'Represent situations in words or as equations, move between the representations, and solve linear equations with integer or fractional coefficients, including unknowns on either or both sides.',
		textEn: 'Represent situations in words or as equations, move between the representations, and solve linear equations with integer or fractional coefficients, including unknowns on either or both sides.',
	},
	{
		code: '8Ae.07',
		textId: 'Understand that letters can represent open and closed intervals.',
		textEn: 'Understand that letters can represent open and closed intervals.',
	},
];

const keySkills = [
	{ label: 'equations', textId: 'Membuat dan menyelesaikan equations', textEn: 'Form and solve equations' },
	{ label: 'unknowns', textId: 'Menyelesaikan unknown di satu atau dua sisi', textEn: 'Solve unknowns on one or both sides' },
	{ label: 'inequalities', textId: 'Membaca dan menyelesaikan inequalities', textEn: 'Read and solve inequalities' },
	{ label: 'intervals', textId: 'Memahami open dan closed intervals', textEn: 'Understand open and closed intervals' },
];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<main id="top">
		<section class="topic2-hero">
			<div class="section-decor" aria-hidden="true">
				<span class="dot-grid dot-grid-hero"></span>
				<span class="blob blob-blue" style="top:-110px; left:-150px; width:320px; height:320px;"></span>
				<span class="blob blob-orange" style="bottom:-120px; right:10%; width:270px; height:270px;"></span>
			</div>

			<div class="wrap topic2-hero-inner">
				<div class="topic2-hero-copy reveal">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8" data-i18n-id="← Kembali ke Stage 8" data-i18n-en="← Back to Stage 8">← Kembali ke Stage 8</a>
					<p class="eyebrow">Cambridge Stage 8 · Unit 8.2 · Topic 2</p>
					<h1 data-i18n-id="Equations and Inequalities" data-i18n-en="Equations and Inequalities">Equations and Inequalities</h1>
					<p class="hero-lede" data-i18n-id="Halaman ini adalah lesson library untuk Topic 2. Fokusnya adalah membangun pemahaman equation sebagai balance, menyelesaikan unknown, lalu masuk ke inequalities dan intervals." data-i18n-en="This page is the lesson library for Topic 2. The focus is to build the idea of equations as balance, solve unknowns, then move into inequalities and intervals.">Halaman ini adalah lesson library untuk Topic 2. Fokusnya adalah membangun pemahaman equation sebagai balance, menyelesaikan unknown, lalu masuk ke inequalities dan intervals.</p>

					<div class="topic-meta-grid" aria-label="Topic overview">
						<div>
							<strong>{lessons.length}</strong>
							<span data-i18n-id="Lesson" data-i18n-en="Lessons">Lesson</span>
						</div>
						<div>
							<strong>50</strong>
							<span data-i18n-id="Menit / lesson" data-i18n-en="Minutes / lesson">Menit / lesson</span>
						</div>
						<div>
							<strong>8Ae.06–07</strong>
							<span data-i18n-id="Learning objectives" data-i18n-en="Learning objectives">Learning objectives</span>
						</div>
					</div>
				</div>

				<aside class="topic-focus-card reveal" aria-label="Topic focus">
					<span class="focus-badge" data-i18n-id="Fokus Topic" data-i18n-en="Topic Focus">Fokus Topic</span>
					<h2 data-i18n-id="Dari equation ke solution set" data-i18n-en="From equations to solution sets">Dari equation ke solution set</h2>
					<p data-i18n-id="Topic ini sebaiknya tidak langsung lompat ke aturan pindah ruas. Mulai dari balance, lalu inverse operations, kemudian unknowns on both sides, inequalities, dan interval representation." data-i18n-en="This topic should not jump straight into moving terms. Start from balance, then inverse operations, unknowns on both sides, inequalities, and interval representation.">Topic ini sebaiknya tidak langsung lompat ke aturan pindah ruas. Mulai dari balance, lalu inverse operations, kemudian unknowns on both sides, inequalities, dan interval representation.</p>
					<div class="focus-mini-board">
						<span class="math-line">2x + 5 = 17</span>
						<span class="arrow">↓</span>
						<span class="math-line">x = 6</span>
					</div>
				</aside>
			</div>
		</section>

		<section class="skill-strip-section">
			<div class="wrap skill-strip">
				{keySkills.map((skill) => (
					<div class="skill-pill reveal">
						<strong>{skill.label}</strong>
						<span data-i18n-id={skill.textId} data-i18n-en={skill.textEn}>{skill.textId}</span>
					</div>
				))}
			</div>
		</section>

		<section class="lesson-list-section" id="lessons">
			<div class="wrap">
				<div class="section-head reveal">
					<p class="eyebrow" data-i18n-id="Lesson Sequence" data-i18n-en="Lesson Sequence">Lesson Sequence</p>
					<h2 data-i18n-id="5 Lesson untuk 8.2 Topic 2" data-i18n-en="5 Lessons for 8.2 Topic 2">5 Lesson untuk 8.2 Topic 2</h2>
					<p class="section-lede" data-i18n-id="Urutan lesson dibuat supaya siswa memahami equation sebagai hubungan yang seimbang sebelum mempelajari inequalities dan intervals." data-i18n-en="The lesson sequence is designed so students understand equations as balanced relationships before learning inequalities and intervals.">Urutan lesson dibuat supaya siswa memahami equation sebagai hubungan yang seimbang sebelum mempelajari inequalities dan intervals.</p>
				</div>

				<div class="lesson-grid">
					{lessons.map((lesson) => (
						<article class="lesson-card reveal" style={`--accent:${lesson.accent};`}>
							<div class="lesson-card-top">
								<span class="lesson-number">{lesson.lessonNo}</span>
								<span class="lesson-duration">{lesson.duration}</span>
							</div>

							<div class="lesson-status-row">
								{lesson.objectives.map((objective) => <span class="objective-chip">{objective}</span>)}
								<span class="status-chip" data-i18n-id={lesson.statusId} data-i18n-en={lesson.statusEn}>{lesson.statusId}</span>
							</div>

							<h3 data-i18n-id={lesson.titleId} data-i18n-en={lesson.titleEn}>{lesson.titleId}</h3>
							<p data-i18n-id={lesson.focusId} data-i18n-en={lesson.focusEn}>{lesson.focusId}</p>

							<div class="lesson-flow">
								<span class="flow-title" data-i18n-id="Alur 50 menit" data-i18n-en="50-minute flow">Alur 50 menit</span>
								<ol>
									{lesson.flowId.map((step, index) => (
										<li data-i18n-id={step} data-i18n-en={lesson.flowEn[index]}>{step}</li>
									))}
								</ol>
							</div>

							<div class="feature-list">
								<span class="flow-title" data-i18n-id="Ide interaktif" data-i18n-en="Interactive ideas">Ide interaktif</span>
								<div>
									{lesson.featuresId.map((feature, index) => (
										<span data-i18n-id={feature} data-i18n-en={lesson.featuresEn[index]}>{feature}</span>
									))}
								</div>
							</div>

							<a class="lesson-button" href={lesson.href} data-i18n-id="Buka lesson" data-i18n-en="Open lesson">Buka lesson</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="objective-section" id="objectives">
			<div class="section-decor" aria-hidden="true">
				<span class="blob blob-sage" style="top:-90px; right:-100px; width:300px; height:300px;"></span>
			</div>
			<div class="wrap objective-inner">
				<div class="objective-copy reveal">
					<p class="eyebrow" data-i18n-id="Coverage" data-i18n-en="Coverage">Coverage</p>
					<h2 data-i18n-id="Learning objectives yang dicakup" data-i18n-en="Learning objectives covered">Learning objectives yang dicakup</h2>
					<p class="section-lede" data-i18n-id="Topic 2 melanjutkan Topic 1. Setelah siswa bisa memanipulasi expressions dan formulae, mereka belajar membuat equation, menyelesaikannya, lalu membaca solution set pada inequalities dan intervals." data-i18n-en="Topic 2 continues from Topic 1. After students can manipulate expressions and formulae, they learn to form equations, solve them, and read solution sets in inequalities and intervals.">Topic 2 melanjutkan Topic 1. Setelah siswa bisa memanipulasi expressions dan formulae, mereka belajar membuat equation, menyelesaikannya, lalu membaca solution set pada inequalities dan intervals.</p>
				</div>

				<div class="objective-list reveal">
					{objectives.map((objective) => (
						<div class="objective-item">
							<span>{objective.code}</span>
							<p data-i18n-id={objective.textId} data-i18n-en={objective.textEn}>{objective.textId}</p>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>

	<style>
		.topic2-hero {
			padding: 64px 0 84px;
			position: relative;
			overflow: hidden;
			background: var(--white, #fffaf4);
		}

		.topic2-hero-inner {
			display: grid;
			grid-template-columns: 1.05fr 0.95fr;
			gap: 48px;
			align-items: center;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			font-weight: 800;
			font-size: 0.9rem;
			color: var(--orange, #f2761e);
			margin-bottom: 20px;
			text-decoration: none;
		}

		.back-link:hover { color: var(--navy, #23304d); }

		.eyebrow {
			margin: 0 0 10px;
			font-size: 0.78rem;
			font-weight: 900;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--orange, #f2761e);
		}

		.topic2-hero-copy h1 {
			font-size: clamp(2.15rem, 4.8vw, 4.6rem);
			line-height: 0.98;
			letter-spacing: -0.04em;
			margin: 0 0 18px;
			color: var(--navy, #23304d);
		}

		.hero-lede,
		.section-lede {
			font-size: 1.08rem;
			line-height: 1.7;
			color: var(--muted, #5a677d);
			max-width: 760px;
		}

		.topic-meta-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 14px;
			margin-top: 30px;
		}

		.topic-meta-grid div,
		.topic-focus-card,
		.skill-pill,
		.lesson-card,
		.objective-item {
			background: rgba(255, 255, 255, 0.92);
			border: 1px solid rgba(35, 48, 77, 0.12);
			box-shadow: 0 20px 60px rgba(30, 41, 59, 0.08);
		}

		.topic-meta-grid div {
			padding: 18px;
			border-radius: 22px;
			display: grid;
			gap: 6px;
		}

		.topic-meta-grid strong {
			font-size: 1.65rem;
			color: var(--navy, #23304d);
		}

		.topic-meta-grid span {
			font-weight: 800;
			color: var(--muted, #5a677d);
		}

		.topic-focus-card {
			border-radius: 34px;
			padding: clamp(26px, 4vw, 44px);
			position: relative;
			overflow: hidden;
		}

		.topic-focus-card::before {
			content: '';
			position: absolute;
			inset: 0 0 auto 0;
			height: 8px;
			background: linear-gradient(90deg, var(--orange, #f2761e), var(--sky, #3eb6ea));
		}

		.focus-badge,
		.objective-chip,
		.status-chip,
		.lesson-number,
		.lesson-duration {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border-radius: 999px;
			font-weight: 900;
		}

		.focus-badge {
			padding: 9px 14px;
			background: #fff3e9;
			color: var(--orange, #f2761e);
			margin-bottom: 16px;
		}

		.topic-focus-card h2 {
			margin: 0 0 12px;
			font-size: clamp(1.6rem, 3vw, 2.4rem);
			line-height: 1.08;
			color: var(--navy, #23304d);
		}

		.topic-focus-card p {
			margin: 0;
			line-height: 1.65;
			color: var(--muted, #5a677d);
		}

		.focus-mini-board {
			margin-top: 22px;
			border-radius: 26px;
			padding: 22px;
			background: linear-gradient(145deg, #23304d, #35507d);
			color: #fff;
			display: grid;
			place-items: center;
			gap: 8px;
		}

		.math-line {
			font-family: Georgia, 'Times New Roman', serif;
			font-size: clamp(1.8rem, 4vw, 3rem);
			font-style: italic;
			color: #fff;
		}

		.arrow {
			font-size: 1.8rem;
			color: #f3bc34;
		}

		.skill-strip-section {
			padding: 28px 0;
			background: #f6fafd;
		}

		.skill-strip {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 16px;
		}

		.skill-pill {
			border-radius: 24px;
			padding: 18px;
			display: grid;
			gap: 6px;
		}

		.skill-pill strong {
			color: var(--orange, #f2761e);
			font-size: 0.84rem;
			letter-spacing: 0.09em;
			text-transform: uppercase;
		}

		.skill-pill span {
			color: var(--navy, #23304d);
			font-weight: 850;
			line-height: 1.35;
		}

		.lesson-list-section {
			padding: 52px 0 64px;
			background: #fffaf4;
		}

		.section-head {
			max-width: 820px;
			margin-bottom: 22px;
		}

		.section-head h2,
		.objective-copy h2 {
			margin: 0 0 12px;
			font-size: clamp(1.8rem, 3.6vw, 3rem);
			line-height: 1.08;
			color: var(--navy, #23304d);
		}

		.lesson-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 16px;
		}

		.lesson-card {
			position: relative;
			display: grid;
			gap: 12px;
			padding: 18px;
			border-radius: 24px;
			overflow: hidden;
		}

		.lesson-card::before {
			content: '';
			position: absolute;
			inset: 0 0 auto 0;
			height: 5px;
			background: var(--accent, #f2761e);
		}

		.lesson-card-top,
		.lesson-status-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
			flex-wrap: wrap;
		}

		.lesson-number {
			padding: 7px 12px;
			background: var(--accent, #f2761e);
			color: #fff;
			font-size: 0.88rem;
		}

		.lesson-duration,
		.status-chip {
			padding: 7px 11px;
			background: #f3fbff;
			color: var(--navy, #23304d);
			font-size: 0.84rem;
		}

		.objective-chip {
			padding: 6px 10px;
			background: #23304d;
			color: #fff;
			font-size: 0.76rem;
		}

		.status-chip {
			font-size: 0.78rem;
			background: #fff3e9;
			color: #b45112;
		}

		.lesson-card h3 {
			margin: 0;
			font-size: clamp(1.18rem, 1.75vw, 1.55rem);
			line-height: 1.14;
			color: var(--navy, #23304d);
		}

		.lesson-card > p {
			margin: 0;
			color: var(--muted, #5a677d);
			font-size: 0.93rem;
			line-height: 1.45;
		}

		.lesson-flow,
		.feature-list {
			background: #f7fafc;
			border: 1px solid rgba(35, 48, 77, 0.08);
			border-radius: 18px;
			padding: 12px;
		}

		.flow-title {
			display: block;
			margin-bottom: 7px;
			font-size: 0.68rem;
			font-weight: 950;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--orange, #f2761e);
		}

		.lesson-flow ol {
			margin: 0;
			padding-left: 18px;
			color: var(--navy, #23304d);
			font-weight: 760;
			font-size: 0.91rem;
			line-height: 1.36;
		}

		.feature-list div {
			display: flex;
			gap: 6px;
			flex-wrap: wrap;
		}

		.feature-list div span {
			display: inline-flex;
			align-items: center;
			border-radius: 999px;
			padding: 6px 9px;
			background: #ffffff;
			border: 1px solid rgba(35, 48, 77, 0.1);
			font-size: 0.82rem;
			font-weight: 850;
			color: #40506a;
		}

		.lesson-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 42px;
			border-radius: 999px;
			background: var(--navy, #23304d);
			color: #fff;
			font-weight: 900;
			text-decoration: none;
			transition: transform 0.18s ease, background 0.18s ease;
		}

		.lesson-button:hover {
			transform: translateY(-2px);
			background: var(--accent, #f2761e);
		}

		.objective-section {
