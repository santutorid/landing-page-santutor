	.lesson-5-page.ifp-fullscreen .option-row .game-option,
	.ifp-fullscreen.lesson-5-page .option-row .game-option {
		grid-template-columns: 54px minmax(0, 1fr) !important;
		min-height: 56px !important;
		border-radius: 15px !important;
		box-shadow: 0 6px 14px rgba(35, 48, 77, 0.08) !important;
	}
	.lesson-5-page.ifp-fullscreen .option-row .game-option .option-badge,
	.ifp-fullscreen.lesson-5-page .option-row .game-option .option-badge {
		min-width: 54px !important;
		font-size: 0.92rem !important;
	}
	.lesson-5-page.ifp-fullscreen .option-row .game-option .option-text,
	.ifp-fullscreen.lesson-5-page .option-row .game-option .option-text {
		min-height: 56px !important;
		padding: 10px 12px !important;
		font-size: clamp(0.92rem, 1.05vw, 1.02rem) !important;
	}
	.lesson-5-page .board-card-tag {
		border-radius: 999px !important;
		width: auto !important;
		min-height: 34px !important;
		padding: 0 14px !important;
	}
</style>

<script is:inline type="text/javascript">
	// @ts-nocheck
	(function () {
		const root = document.querySelector('[data-lesson-root]');
		if (!root || root.dataset.initialized === 'true') return;
		root.dataset.initialized = 'true';

		const slides = Array.from(root.querySelectorAll('[data-slide]'));
		const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
		const progressLabel = root.querySelector('[data-progress-label]');
		const progressBar = root.querySelector('[data-progress-bar]');
		const nextButton = root.querySelector('[data-next-slide]');
		const prevButton = root.querySelector('[data-prev-slide]');
		const resetSlideButton = root.querySelector('[data-reset-slide]');
		const modeToggle = root.querySelector('[data-mode-toggle]');
		const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
		const fullscreenTarget = document.querySelector('.lesson-page.ifp-fullscreen') || root;
		const totalScoreButton = root.querySelector('[data-total-score]');
		const teacherNotes = root.querySelector('[data-teacher-notes]');
		const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
		const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
		const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');

		const notes = [
			'Keep this slide as a clean overview. Ask students to name one phrase that can become algebra.',
			'Slow down here. Students must separate expression, formula, and subject before changing the subject.',
			'Ask students to underline keywords and decide the order of operations before choosing.',
			'Focus on the fixed amount and repeated amount. This prevents students from swapping coefficients.',
			'Use substitution to show why formulae are useful before rearranging them.',
			'Teach rearranging as undoing operations in reverse order. Keep brackets visible.',
			'Pause before each reveal. Ask: what operation is trapping the target letter?',
			'Let students explain the mistake verbally first, then tap an option.',
			'Use this as pair work. Award one point for answer and one point for reasoning.',
			'Collect quick notebook answers before revealing the sample answers.'
		];

		let currentSlide = 0;
		let totalScore = 0;

		const renderMath = (scope = root) => {
			const targetScope = scope || root;
			const mathNodes = targetScope.matches?.('[data-tex]')
				? [targetScope]
				: Array.from(targetScope.querySelectorAll?.('[data-tex]') || []);
			mathNodes.forEach((node) => {
				const tex = node.getAttribute('data-tex') || '';
				if (tex) node.textContent = '$' + tex + '$';
			});
			if (window.MathJax && window.MathJax.typesetPromise) {
				window.MathJax.typesetClear?.([targetScope]);
				window.MathJax.typesetPromise([targetScope]).catch(() => {});
			}
		};

		const setMath = (element, tex) => {
			if (!element) return;
			element.setAttribute('data-tex', tex);
			element.textContent = '$' + tex + '$';
			renderMath(element);
		};

		const updateTotalScore = (points) => {
			totalScore += points;
			if (totalScoreButton) totalScoreButton.textContent = 'Score ' + totalScore;
		};

		const updateSlide = (index) => {
			currentSlide = Math.max(0, Math.min(index, slides.length - 1));
			slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === currentSlide));
			dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === currentSlide));
			if (progressLabel) progressLabel.textContent = 'Slide ' + (currentSlide + 1) + ' of ' + slides.length;
			if (progressBar) progressBar.style.width = ((currentSlide + 1) / slides.length * 100) + '%';
			if (prevButton) prevButton.disabled = currentSlide === 0;
			if (nextButton) nextButton.textContent = currentSlide === slides.length - 1 ? 'Finish' : 'Next';
			if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || '';
			renderMath(slides[currentSlide]);
		};

		dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
		nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
		prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));
		resetSlideButton?.addEventListener('click', () => updateSlide(currentSlide));

		modeToggle?.addEventListener('click', () => {
			const isSelfStudy = root.classList.toggle('is-self-study');
			modeToggle.setAttribute('aria-pressed', String(isSelfStudy));
			modeToggle.textContent = isSelfStudy ? 'Self-Study Mode' : 'Teach Mode';
		});

		const getFullscreenElement = () => document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement;
		const updateFullscreenButton = () => {
			if (!fullscreenButton) return;
			const isFullscreen = Boolean(getFullscreenElement());
			fullscreenButton.classList.toggle('is-active', isFullscreen);
			fullscreenButton.setAttribute('aria-pressed', String(isFullscreen));
			fullscreenButton.textContent = isFullscreen ? 'Exit Full Screen' : '⛶ Present Full Screen';
		};
		const enterFullscreen = async () => {
			if (fullscreenTarget.requestFullscreen) return fullscreenTarget.requestFullscreen();
			if (fullscreenTarget.webkitRequestFullscreen) return fullscreenTarget.webkitRequestFullscreen();
			if (fullscreenTarget.msRequestFullscreen) return fullscreenTarget.msRequestFullscreen();
			throw new Error('Fullscreen is not supported in this browser.');
		};
		const exitFullscreen = async () => {
			if (document.exitFullscreen) return document.exitFullscreen();
			if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
			if (document.msExitFullscreen) return document.msExitFullscreen();
		};
		fullscreenButton?.addEventListener('click', async () => {
			try {
				if (getFullscreenElement()) await exitFullscreen();
				else await enterFullscreen();
				updateFullscreenButton();
			} catch (error) {
				fullscreenButton.textContent = 'Fullscreen unavailable';
				fullscreenButton.disabled = true;
			}
		});
		document.addEventListener('fullscreenchange', updateFullscreenButton);
		document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
		document.addEventListener('MSFullscreenChange', updateFullscreenButton);

		teacherNotesToggle?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
		teacherNotesClose?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = true; });

		root.querySelectorAll('[data-toggle-target]').forEach((button) => {
			button.addEventListener('click', () => {
				const id = button.dataset.toggleTarget || '';
				const target = root.querySelector('#' + CSS.escape(id));
				if (target) {
					target.classList.toggle('is-visible');
					renderMath(target);
				}
			});
		});

		function makeOption(text, correctText, feedback, correctMessage, wrongMessage, points, optionIndex = 0, onCorrect = null) {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'game-option';
			button.dataset.optionValue = text;
			const badge = document.createElement('span');
			badge.className = 'option-badge';
			badge.textContent = String.fromCharCode(65 + (optionIndex % 26));
			const textSpan = document.createElement('span');
			textSpan.className = 'option-text math-render';
			textSpan.setAttribute('data-tex', text);
			button.append(badge, textSpan);
			button.addEventListener('click', () => {
				const parent = button.parentElement;
				if (parent) Array.from(parent.children).forEach((child) => child.disabled = true);
				const correct = text === correctText;
				button.classList.add(correct ? 'is-correct' : 'is-wrong');
				if (!correct && parent) Array.from(parent.children).forEach((child) => {
					if (child.dataset.optionValue === correctText) child.classList.add('is-correct');
				});
				if (feedback) feedback.textContent = correct ? correctMessage : wrongMessage;
				if (correct) {
					updateTotalScore(points);
					if (typeof onCorrect === 'function') onCorrect();
				}
			});
			return button;
		}

		function setupTranslatorGame() {
			const game = root.querySelector('[data-translator-game]');
			if (!game) return;
			const items = [
				{ phrase: 'Five more than twice a number', variable: 'n = the number', clue: 'twice first, then add 5', answer: '2n + 5', options: ['2n + 5', '2(n + 5)', 'n + 10', '5n + 2'] },
				{ phrase: 'Three less than half of a number', variable: 'x = the number', clue: 'half first, then subtract 3', answer: '\\frac{x}{2} - 3', options: ['\\frac{x}{2} - 3', '3 - \\frac{x}{2}', '\\frac{x - 3}{2}', '2x - 3'] },
				{ phrase: 'The product of 7 and a number', variable: 'm = the number', clue: 'product means multiply', answer: '7m', options: ['7m', '7 + m', '\\frac{m}{7}', '7 - m'] },
				{ phrase: 'A number divided by 4, then increased by 9', variable: 'a = the number', clue: 'divide first, then add 9', answer: '\\frac{a}{4} + 9', options: ['\\frac{a}{4} + 9', '\\frac{a + 9}{4}', '4a + 9', '\\frac{9a}{4}'] },
				{ phrase: 'The difference between 20 and a number', variable: 'b = the number', clue: 'order matters: 20 first', answer: '20 - b', options: ['20 - b', 'b - 20', '20b', '20 + b'] },
				{ phrase: 'One third of a number plus 6', variable: 't = the number', clue: 'one third means divide by 3', answer: '\\frac{t}{3} + 6', options: ['\\frac{t}{3} + 6', '3t + 6', '\\frac{t + 6}{3}', '\\frac{6t}{3}'] }
			];
			let index = 0;
			let score = 0;
			const round = game.querySelector('[data-translator-round]');
			const phrase = game.querySelector('[data-translator-phrase]');
			const variable = game.querySelector('[data-translator-variable]');
			const clue = game.querySelector('[data-translator-clue]');
			const scoreNode = game.querySelector('[data-translator-score]');
			const optionsBox = game.querySelector('[data-translator-options]');
			const feedback = game.querySelector('[data-translator-feedback]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Phrase ' + (index + 1) + ' / ' + items.length;
				if (phrase) phrase.textContent = item.phrase;
				if (variable) variable.textContent = item.variable;
				if (clue) clue.textContent = item.clue;
				if (feedback) feedback.textContent = 'Choose the expression that matches the words.';
				if (scoreNode) scoreNode.textContent = String(score);
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => optionsBox.appendChild(makeOption(option, item.answer, feedback, 'Correct. The operation order matches the phrase.', 'Not quite. Check the keyword and operation order.', 1, optionIndex, () => { score += 1; if (scoreNode) scoreNode.textContent = String(score); })));
					renderMath(optionsBox);
				}
			}
			game.querySelector('[data-translator-next]')?.addEventListener('click', () => { index = (index + 1) % items.length; draw(); });
			game.querySelector('[data-translator-reset]')?.addEventListener('click', () => { index = 0; score = 0; draw(); });
			draw();
		}

		function setupFormulaGame() {
			const game = root.querySelector('[data-formula-game]');
			if (!game) return;
			const items = [
				{ context: 'A taxi costs 4 units plus 2 units per kilometre.', vars: 'Let C = total cost and k = kilometres.', answer: 'C = 2k + 4', options: ['C = 2k + 4', 'C = 4k + 2', 'C = 6k', 'C = k + 6'] },
				{ context: 'A rectangle has length l and width w. Find the perimeter P.', vars: 'Let P = perimeter, l = length, and w = width.', answer: 'P = 2l + 2w', options: ['P = 2l + 2w', 'P = lw', 'P = l + w', 'P = 2lw'] },
				{ context: 'A phone plan costs $12 per month plus $0.10 per message.', vars: 'Let C = cost and m = number of messages.', answer: 'C = 12 + 0.10m', options: ['C = 12 + 0.10m', 'C = 12m + 0.10', 'C = 0.10 + m', 'C = 12.10m'] },
				{ context: 'The total score is 5 marks for each question plus 10 bonus marks.', vars: 'Let T = total score and q = number of questions.', answer: 'T = 5q + 10', options: ['T = 5q + 10', 'T = 10q + 5', 'T = 15q', 'T = q + 15'] },
				{ context: 'A cube has edge length s. Find its volume V.', vars: 'Let V = volume and s = edge length.', answer: 'V = s^3', options: ['V = s^3', 'V = 3s', 'V = 6s^2', 'V = s + 3'] }
			];
			let index = 0;
			let score = 0;
			const round = game.querySelector('[data-formula-round]');
			const context = game.querySelector('[data-formula-context]');
			const vars = game.querySelector('[data-formula-variables]');
			const scoreNode = game.querySelector('[data-formula-score]');
			const optionsBox = game.querySelector('[data-formula-options]');
			const feedback = game.querySelector('[data-formula-feedback]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Scenario ' + (index + 1) + ' / ' + items.length;
				if (context) context.textContent = item.context;
				if (vars) vars.textContent = item.vars;
				if (scoreNode) scoreNode.textContent = String(score);
				if (feedback) feedback.textContent = 'Choose the formula that matches the situation.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => optionsBox.appendChild(makeOption(option, item.answer, feedback, 'Correct. The formula connects the variables properly.', 'Not this one. Identify the fixed amount and repeated amount.', 1, optionIndex, () => { score += 1; if (scoreNode) scoreNode.textContent = String(score); })));
					renderMath(optionsBox);
				}
			}
			game.querySelector('[data-formula-next]')?.addEventListener('click', () => { index = (index + 1) % items.length; draw(); });
			game.querySelector('[data-formula-reset]')?.addEventListener('click', () => { index = 0; score = 0; draw(); });
			draw();
		}

		function setupSubstitutionLab() {
			const lab = root.querySelector('[data-substitution-lab]');
			if (!lab) return;
			const slider = lab.querySelector('[data-sub-slider]');
			const nNode = lab.querySelector('[data-sub-n]');
			const working = lab.querySelector('[data-sub-working]');
			const feedback = lab.querySelector('[data-sub-feedback]');
			function draw() {
				const n = Number(slider?.value || 0);
				const product = 3 * n;
				const total = product + 5;
				if (nNode) nNode.textContent = String(n);
				if (working) {
					working.innerHTML = '<div><span class="math-render">$C = 3(' + n + ') + 5$</span></div><div><span class="math-render">$C = ' + product + ' + 5$</span></div><div><span class="math-render">$C = ' + total + '$</span></div>';
					renderMath(working);
				}
				if (feedback) feedback.textContent = 'If n = ' + n + ', the total cost is ' + total + '.';
			}
			slider?.addEventListener('input', draw);
			draw();
		}

		function setupSubjectLab() {
			const lab = root.querySelector('[data-subject-lab]');
			if (!lab) return;
			const items = [
				{ original: 'C = 3n + 5', target: 'n', steps: ['C - 5 = 3n', '\\frac{C - 5}{3} = n', 'n = \\frac{C - 5}{3}'] },
				{ original: 'y = 5x - 2', target: 'x', steps: ['y + 2 = 5x', '\\frac{y + 2}{5} = x', 'x = \\frac{y + 2}{5}'] },
				{ original: 'P = 2l + 2w', target: 'l', steps: ['P - 2w = 2l', '\\frac{P - 2w}{2} = l', 'l = \\frac{P - 2w}{2}'] },
				{ original: 'v = u + at', target: 't', steps: ['v - u = at', '\\frac{v - u}{a} = t', 't = \\frac{v - u}{a}'] }
			];
			let index = 0;
			let step = 0;
			const round = lab.querySelector('[data-subject-round]');
			const target = lab.querySelector('[data-subject-target]');
			const original = lab.querySelector('[data-subject-original]');
			const stepsBox = lab.querySelector('[data-subject-steps]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Formula ' + (index + 1) + ' / ' + items.length;
				if (target) target.textContent = item.target;
				setMath(original, item.original);
				if (stepsBox) {
					stepsBox.innerHTML = '';
					if (step === 0) {
						const p = document.createElement('p');
						p.textContent = 'Tap “Reveal next step” to solve it.';
						stepsBox.appendChild(p);
					} else {
						item.steps.slice(0, step).forEach((text, stepIndex) => {
							const div = document.createElement('div');
							div.className = 'math-render';
							div.textContent = '$' + text + '$';
							stepsBox.appendChild(div);
						});
						renderMath(stepsBox);
					}
				}
			}
			lab.querySelector('[data-subject-step]')?.addEventListener('click', () => { step = Math.min(step + 1, items[index].steps.length); draw(); });
			lab.querySelector('[data-subject-reset]')?.addEventListener('click', () => { step = 0; draw(); });
			lab.querySelector('[data-subject-new]')?.addEventListener('click', () => { index = (index + 1) % items.length; step = 0; draw(); });
			draw();
		}

		function setupDetectiveGame() {
			const game = root.querySelector('[data-detective-game]');
			if (!game) return;
			const items = [
				{ work: 'C = 3n + 5,\\quad n = C - 5 \\div 3', answer: 'Missing brackets', options: ['Missing brackets', 'Wrong variable', 'Should multiply by 3', 'No mistake'], correct: 'Correct. It should be n = (C - 5) ÷ 3.' },
				{ work: '\\text{Twice a number plus 6} = 2(n + 6)', answer: 'Operation order error', options: ['Operation order error', 'Correct expression', 'Wrong letter only', 'Should be n ÷ 2 + 6'], correct: 'Correct. “Twice a number plus 6” means 2n + 6.' },
				{ work: 'y = 4x - 1,\\quad x = \\frac{y - 1}{4}', answer: 'Used the wrong inverse', options: ['Used the wrong inverse', 'Forgot to divide', 'Correct answer', 'Wrong subject'], correct: 'Correct. Add 1 first: x = (y + 1) ÷ 4.' },
				{ work: 'P = 2l + 2w,\\quad l = P - 2w \\div 2', answer: 'Missing brackets', options: ['Missing brackets', 'Should add 2w', 'Should divide by w', 'Correct answer'], correct: 'Correct. It should be l = (P - 2w) ÷ 2.' }
			];
			let index = 0;
			let score = 0;
			const round = game.querySelector('[data-detective-round]');
			const work = game.querySelector('[data-detective-work]');
			const optionsBox = game.querySelector('[data-detective-options]');
			const feedback = game.querySelector('[data-detective-feedback]');
			const scoreNode = game.querySelector('[data-detective-score]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Mistake ' + (index + 1) + ' / ' + items.length;
				if (scoreNode) scoreNode.textContent = String(score);
				setMath(work, item.work);
				if (feedback) feedback.textContent = 'Choose the best explanation.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => {
						const button = document.createElement('button');
						button.type = 'button';
						button.className = 'game-option';
						button.dataset.optionValue = option;
						const badge = document.createElement('span');
						badge.className = 'option-badge';
						badge.textContent = String.fromCharCode(65 + (optionIndex % 26));
						const textSpan = document.createElement('span');
						textSpan.className = 'option-text';
						textSpan.textContent = option;
						button.append(badge, textSpan);
						button.addEventListener('click', () => {
							Array.from(optionsBox.children).forEach((child) => child.disabled = true);
							const correct = option === item.answer;
							button.classList.add(correct ? 'is-correct' : 'is-wrong');
							if (!correct) {
								Array.from(optionsBox.children).forEach((child) => { if (child.dataset.optionValue === item.answer) child.classList.add('is-correct'); });
							}
							if (correct) { score += 1; updateTotalScore(1); }
							if (scoreNode) scoreNode.textContent = String(score);
							if (feedback) feedback.textContent = correct ? item.correct : 'Not quite. Expand or reverse the operation again.';
						});
						optionsBox.appendChild(button);
					});
				}
			}
			game.querySelector('[data-detective-next]')?.addEventListener('click', () => { index = (index + 1) % items.length; draw(); });
			game.querySelector('[data-detective-reset]')?.addEventListener('click', () => { index = 0; score = 0; draw(); });
			draw();
		}

		setupTranslatorGame();
		setupFormulaGame();
		setupSubstitutionLab();
		setupSubjectLab();
		setupDetectiveGame();
		updateSlide(0);
	})();
</script>
