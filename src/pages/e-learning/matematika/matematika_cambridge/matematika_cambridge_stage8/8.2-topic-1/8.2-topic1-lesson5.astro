---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 5: Words, Expressions and Formulae — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive full-screen IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics 8Ae.04–8Ae.05: translating words into algebra, writing formulae, substituting values, and changing the subject.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<main id="top" class="lesson-page ifp-fullscreen lesson-5-page">
		<section class="lesson-shell" data-lesson-root tabindex="-1">
			<div class="lesson-topbar">
				<div class="lesson-topbar-left">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-1">← Back to Topic 1</a>
					<p class="eyebrow">Cambridge Stage 8 · Unit 8.2 Topic 1</p>
					<h1>Lesson 5: Words, Expressions and Formulae</h1>
				</div>
				<div class="lesson-topbar-right" aria-label="Lesson controls">
					<span class="objective-pill">8Ae.04–05</span>
					<button class="score-pill" type="button" data-total-score aria-live="polite">Score 0</button>
					<button class="mode-toggle" type="button" data-mode-toggle aria-pressed="false">Teach Mode</button>
					<button class="fullscreen-toggle" type="button" data-fullscreen-toggle aria-pressed="false">Exit Full Screen</button>
				</div>
			</div>

			<div class="progress-area" aria-label="Lesson progress">
				<div class="progress-meta">
					<span data-progress-label>Slide 1 of 10</span>
					<span>50 minutes</span>
				</div>
				<div class="progress-track"><span data-progress-bar></span></div>
			</div>

			<div class="deck-layout">
				<aside class="slide-map" aria-label="Lesson sections">
					<button type="button" class="slide-dot is-active" data-go-slide="0"><span>1</span> Goal</button>
					<button type="button" class="slide-dot" data-go-slide="1"><span>2</span> Theory</button>
					<button type="button" class="slide-dot" data-go-slide="2"><span>3</span> Words</button>
					<button type="button" class="slide-dot" data-go-slide="3"><span>4</span> Formula</button>
					<button type="button" class="slide-dot" data-go-slide="4"><span>5</span> Substitute</button>
					<button type="button" class="slide-dot" data-go-slide="5"><span>6</span> Subject</button>
					<button type="button" class="slide-dot" data-go-slide="6"><span>7</span> Lab</button>
					<button type="button" class="slide-dot" data-go-slide="7"><span>8</span> Detective</button>
					<button type="button" class="slide-dot" data-go-slide="8"><span>9</span> Board</button>
					<button type="button" class="slide-dot" data-go-slide="9"><span>10</span> Exit</button>
				</aside>

				<section class="slide-stage" aria-live="polite">
					<article class="lesson-slide is-active" data-slide data-slide-title="Learning Goal">
						<div class="slide-label"><span>Slide 1</span><strong>Learning Goal</strong></div>
						<div class="hero-grid">
							<div>
								<p class="mini-kicker">8Ae.04–8Ae.05</p>
								<h2>Turn words into algebra, then rearrange formulae.</h2>
								<p class="slide-lede">Today we translate phrases into expressions, write simple formulae, substitute values, and change the subject using inverse operations.</p>
								<div class="outcome-box">
									<h3>By the end, I can...</h3>
									<ul>
										<li>translate keywords such as “twice”, “more than”, and “divided by”</li>
										<li>write formulae for simple situations</li>
										<li>substitute values into a formula</li>
										<li>make a chosen letter the subject</li>
									</ul>
								</div>
							</div>
							<div class="lesson-badge-card">
								<span class="badge-number">4</span>
								<span>core skills</span>
								<hr />
								<p>Translate · Model · Substitute · Rearrange</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Theory Foundation">
						<div class="slide-label"><span>Slide 2</span><strong>Theory</strong></div>
						<p class="mini-kicker">Concept foundation</p>
						<h2>Know the difference before solving.</h2>
						<div class="theory-grid">
							<section class="theory-card">
								<span>01</span>
								<h3>Expression</h3>
								<p>An expression has no equals sign. It shows a calculation using numbers, letters, and operations.</p>
								<div class="expression-banner small-math"><span class="math-render" data-tex="2n + 5"></span></div>
							</section>
							<section class="theory-card">
								<span>02</span>
								<h3>Formula</h3>
								<p>A formula uses an equals sign to connect two or more quantities.</p>
								<div class="expression-banner small-math"><span class="math-render" data-tex="C = 3n + 5"></span></div>
							</section>
							<section class="theory-card">
								<span>03</span>
								<h3>Subject</h3>
								<p>The subject is the letter by itself. To change the subject, undo operations in reverse order.</p>
								<div class="expression-banner small-math"><span class="math-render" data-tex="n = \frac&#123;C - 5&#125;&#123;3&#125;"></span></div>
							</section>
						</div>
						<div class="keyword-board">
							<div><strong>more than</strong><span>add after</span></div>
							<div><strong>less than</strong><span>subtract carefully</span></div>
							<div><strong>product of</strong><span>multiply</span></div>
							<div><strong>quotient of</strong><span>divide</span></div>
							<div><strong>twice</strong><span>multiply by 2</span></div>
							<div><strong>half of</strong><span>divide by 2</span></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Words to Algebra">
						<div class="slide-label"><span>Slide 3</span><strong>Game 1</strong></div>
						<p class="mini-kicker">Words → expression</p>
						<h2>Translate the phrase into algebra.</h2>
						<div class="game-panel" data-translator-game>
							<div class="game-head">
								<div><span class="round-label" data-translator-round>Phrase 1 / 6</span><h3 data-translator-phrase>Five more than twice a number</h3></div>
								<div class="local-score"><span>Score</span><strong data-translator-score>0</strong></div>
							</div>
							<div class="clue-strip"><div><span>Let</span><strong data-translator-variable>n = the number</strong></div><div><span>Think</span><strong data-translator-clue>twice first, then add 5</strong></div></div>
							<div class="option-row" data-translator-options></div>
							<p class="feedback-line" data-translator-feedback>Choose the expression that matches the words.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-translator-next>Next phrase</button><button type="button" class="secondary-button" data-translator-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Formula Builder">
						<div class="slide-label"><span>Slide 4</span><strong>Game 2</strong></div>
						<p class="mini-kicker">Situation → formula</p>
						<h2>Build a formula from the situation.</h2>
						<div class="formula-layout" data-formula-game>
							<div class="game-panel">
								<div class="game-head">
									<div><span class="round-label" data-formula-round>Scenario 1 / 5</span><h3 data-formula-context>A taxi costs 4 units plus 2 units per kilometre.</h3></div>
									<div class="local-score"><span>Score</span><strong data-formula-score>0</strong></div>
								</div>
								<div class="variables-pill" data-formula-variables>Let C = total cost and k = kilometres.</div>
								<div class="option-row" data-formula-options></div>
								<p class="feedback-line" data-formula-feedback>Choose the formula that matches the situation.</p>
								<div class="activity-actions"><button type="button" class="secondary-button" data-formula-next>Next scenario</button><button type="button" class="secondary-button" data-formula-reset>Reset game</button></div>
							</div>
							<aside class="method-card">
								<h3>Formula checklist</h3>
								<ol>
									<li>Choose letters for quantities.</li>
									<li>Identify the fixed amount.</li>
									<li>Identify the repeated amount.</li>
									<li>Use an equals sign.</li>
								</ol>
							</aside>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Substitution Checkpoint">
						<div class="slide-label"><span>Slide 5</span><strong>Checkpoint</strong></div>
						<p class="mini-kicker">Use the formula</p>
						<h2>Substitute values before rearranging.</h2>
						<div class="substitution-layout" data-substitution-lab>
							<div class="game-panel sub-left">
								<p class="mini-kicker">Formula</p>
								<div class="challenge-expression"><span class="math-render" data-tex="C = 3n + 5"></span></div>
								<p class="slide-lede compact-lede">A club charges a 5-unit joining fee plus 3 units per class.</p>
								<label class="slider-label" for="subValue">Choose the number of classes</label>
								<input id="subValue" type="range" min="0" max="12" value="4" data-sub-slider />
								<div class="value-pill">n = <strong data-sub-n>4</strong></div>
							</div>
							<div class="game-panel sub-right">
								<h3>Working</h3>
								<div class="step-stack" data-sub-working>
									<div><span class="math-render" data-tex="C = 3(4) + 5"></span></div>
									<div><span class="math-render" data-tex="C = 12 + 5"></span></div>
									<div><span class="math-render" data-tex="C = 17"></span></div>
								</div>
								<p class="feedback-line" data-sub-feedback>If n = 4, the total cost is 17.</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Change the Subject">
						<div class="slide-label"><span>Slide 6</span><strong>Core Skill</strong></div>
						<p class="mini-kicker">Formulae → new subject</p>
						<h2>Undo operations in reverse order.</h2>
						<div class="recipe-board subject-recipe">
							<div><span>1</span><strong>Start</strong><em class="math-render" data-tex="C = 3n + 5"></em></div>
							<div><span>2</span><strong>Undo +5</strong><em class="math-render" data-tex="C - 5 = 3n"></em></div>
							<div><span>3</span><strong>Undo ×3</strong><em class="math-render" data-tex="\frac&#123;C - 5&#125;&#123;3&#125; = n"></em></div>
							<div><span>4</span><strong>Write subject first</strong><em class="math-render" data-tex="n = \frac&#123;C - 5&#125;&#123;3&#125;"></em></div>
						</div>
						<div class="teacher-prompt"><strong>Important:</strong> if a whole expression is divided, use brackets or a fraction bar so the meaning is clear.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Change the Subject Lab">
						<div class="slide-label"><span>Slide 7</span><strong>Interactive Lab</strong></div>
						<p class="mini-kicker">Solve the formula</p>
						<h2>Make the target letter the subject.</h2>
						<div class="subject-lab" data-subject-lab>
							<div class="game-panel">
								<div class="game-head">
									<div><span class="round-label" data-subject-round>Formula 1 / 4</span><h3>Target letter: <strong data-subject-target>n</strong></h3></div>
								</div>
								<div class="challenge-expression"><span data-subject-original class="math-render" data-tex="C = 3n + 5"></span></div>
								<div class="step-stack" data-subject-steps><p>Tap “Reveal next step” to solve it.</p></div>
								<div class="activity-actions"><button type="button" class="primary-button" data-subject-step>Reveal next step</button><button type="button" class="secondary-button" data-subject-new>New formula</button><button type="button" class="secondary-button" data-subject-reset>Reset</button></div>
							</div>
							<aside class="method-card navy-card">
								<h3>Teacher prompt</h3>
								<p>Before revealing each step, ask: “What operation is currently trapping the target letter?”</p>
							</aside>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Error Detective">
						<div class="slide-label"><span>Slide 8</span><strong>Game 3</strong></div>
						<p class="mini-kicker">Find the mistake</p>
						<h2>Error Detective</h2>
						<div class="game-panel" data-detective-game>
							<div class="game-head">
								<div><span class="round-label" data-detective-round>Mistake 1 / 4</span><h3 data-detective-prompt>What went wrong?</h3></div>
								<div class="local-score"><span>Score</span><strong data-detective-score>0</strong></div>
							</div>
							<div class="student-work"><span>Student work</span><p data-detective-work class="math-render" data-tex="C = 3n + 5,\quad n = C - 5 \div 3"></p></div>
							<div class="option-row" data-detective-options></div>
							<p class="feedback-line" data-detective-feedback>Choose the best explanation.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-detective-next>Next mistake</button><button type="button" class="secondary-button" data-detective-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Board Challenge">
						<div class="slide-label"><span>Slide 9</span><strong>Class Challenge</strong></div>
						<p class="mini-kicker">Pair work</p>
						<h2>Choose a card. Translate, build, or rearrange.</h2>
						<div class="board-grid">
							<div class="challenge-card board-card">
								<div class="board-card-head"><span class="board-card-tag">Card A</span><strong>Translate</strong></div>
								<p class="board-card-task">Seven less than three times a number.</p>
								<button type="button" class="secondary-button" data-toggle-target="answer-a">Reveal answer</button>
								<p id="answer-a" class="hidden-answer math-render" data-tex="3x - 7"></p>
							</div>
							<div class="challenge-card board-card">
								<div class="board-card-head"><span class="board-card-tag">Card B</span><strong>Build a formula</strong></div>
								<p class="board-card-task">A rental costs 15 units plus 4 units per hour.</p>
								<button type="button" class="secondary-button" data-toggle-target="answer-b">Reveal answer</button>
								<p id="answer-b" class="hidden-answer math-render" data-tex="C = 4h + 15"></p>
							</div>
							<div class="challenge-card board-card">
								<div class="board-card-head"><span class="board-card-tag">Card C</span><strong>Change the subject</strong></div>
								<p class="board-card-task">Make <strong>x</strong> the subject.</p>
								<div class="board-card-equation math-render" data-tex="y = 2x + 9"></div>
								<button type="button" class="secondary-button" data-toggle-target="answer-c">Reveal answer</button>
								<p id="answer-c" class="hidden-answer math-render" data-tex="x = \frac&#123;y - 9&#125;&#123;2&#125;"></p>
							</div>
						</div>
						<div class="teacher-prompt">Students must explain their operation order. Award one point for the answer and one point for reasoning.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Exit Ticket">
						<div class="slide-label"><span>Slide 10</span><strong>Exit Ticket</strong></div>
						<p class="mini-kicker">Quick formative check</p>
						<h2>Before leaving, answer these three questions.</h2>
						<div class="exit-grid">
							<div><span>1</span><p>Translate: four more than half of a number.</p></div>
							<div><span>2</span><p>Write a formula for: 8-unit entry fee plus 3 units per ride.</p></div>
							<div><span>3</span><p>Make m the subject: <span class="math-render" data-tex="P = 4m + 6"></span></p></div>
						</div>
						<button type="button" class="primary-button" data-toggle-target="exit-answer">Reveal sample answers</button>
						<div id="exit-answer" class="hidden-answer sample-answer">
							<p><strong>1.</strong> <span class="math-render" data-tex="\frac&#123;x&#125;&#123;2&#125; + 4"></span></p>
							<p><strong>2.</strong> <span class="math-render" data-tex="C = 3r + 8"></span></p>
							<p><strong>3.</strong> <span class="math-render" data-tex="m = \frac&#123;P - 6&#125;&#123;4&#125;"></span></p>
						</div>
					</article>
				</section>
			</div>

			<div class="deck-controls">
				<button type="button" class="secondary-button" data-prev-slide>Back</button>
				<button type="button" class="teacher-note-button" data-teacher-notes-toggle>Teacher Notes</button>
				<button type="button" class="secondary-button" data-reset-slide>Reset Slide</button>
				<button type="button" class="primary-button" data-next-slide>Next</button>
			</div>

			<aside class="teacher-notes" data-teacher-notes hidden>
				<div class="teacher-notes-card">
					<div class="teacher-notes-head"><strong>Teacher Notes</strong><button type="button" data-teacher-notes-close aria-label="Close teacher notes">×</button></div>
					<p data-teacher-notes-text>Use the slide as an IFP prompt. Ask students to explain the operation before revealing the answer.</p>
				</div>
			</aside>
		</section>
	</main>
</Layout>

<script is:inline type="text/javascript">
	window.MathJax = {
		tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$']] },
		svg: { fontCache: 'global' }
	};
</script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>

<style>
	.lesson-page { background: radial-gradient(circle at top left, rgba(62, 182, 234, 0.18), transparent 31rem), radial-gradient(circle at bottom right, rgba(242, 118, 30, 0.14), transparent 32rem), #fffaf4; min-height: 100vh; padding: 24px 0 56px; }
	.lesson-shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
	.lesson-topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding: 22px; background: rgba(255,255,255,0.92); border: 1px solid rgba(43,53,77,0.12); border-radius: 28px; box-shadow: 0 20px 60px rgba(30,41,59,0.08); }
	.back-link { display: inline-flex; margin-bottom: 12px; font-weight: 900; color: #2b5b76; text-decoration: none; }
	.eyebrow, .mini-kicker { margin: 0 0 8px; font-size: 0.78rem; font-weight: 950; letter-spacing: 0.12em; text-transform: uppercase; color: #f2761e; }
	.lesson-topbar h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 0.95; color: #23304d; }
	.lesson-topbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
	.objective-pill, .mode-toggle, .fullscreen-toggle, .score-pill { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 10px 16px; border-radius: 999px; font-weight: 950; border: 0; }
	.objective-pill, .fullscreen-toggle, .score-pill { background: #23304d; color: #fff; }
	.mode-toggle, .primary-button { background: #f2761e; color: #fff; border: 0; }
	.lesson-shell.is-self-study .mode-toggle { background: #3eb6ea; }
	.fullscreen-toggle.is-active { background: #3eb6ea; }
	.progress-area { margin: 18px 0; padding: 16px 18px; background: rgba(255,255,255,0.78); border: 1px solid rgba(43,53,77,0.1); border-radius: 22px; }
	.progress-meta { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 10px; font-weight: 900; color: #23304d; }
	.progress-track { height: 12px; background: rgba(35,48,77,0.12); border-radius: 999px; overflow: hidden; }
	.progress-track span { display: block; height: 100%; width: 10%; background: linear-gradient(90deg, #f2761e, #3eb6ea); border-radius: inherit; transition: width 0.25s ease; }
	.deck-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 18px; align-items: start; }
	.slide-map { position: sticky; top: 104px; display: grid; gap: 8px; padding: 12px; background: rgba(255,255,255,0.88); border: 1px solid rgba(43,53,77,0.1); border-radius: 24px; box-shadow: 0 18px 50px rgba(30,41,59,0.08); }
	.slide-dot { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 8px 10px; border: 1px solid transparent; border-radius: 16px; background: transparent; color: #46536b; font-weight: 900; text-align: left; cursor: pointer; }
	.slide-dot span { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(35,48,77,0.1); color: #23304d; font-size: 0.84rem; font-weight: 950; }
	.slide-dot.is-active { background: #23304d; color: #fff; border-color: #23304d; }
	.slide-dot.is-active span { background: #fff; color: #23304d; }
	.lesson-slide { display: none; min-height: 650px; padding: clamp(24px,4vw,44px); background: rgba(255,255,255,0.95); border: 1px solid rgba(43,53,77,0.12); border-radius: 34px; box-shadow: 0 24px 80px rgba(30,41,59,0.1); overflow: hidden; }
	.lesson-slide.is-active { display: block; }
	.slide-label { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; font-weight: 950; color: #526077; }
	.slide-label span { background: #fff3e9; color: #f2761e; border: 1px solid rgba(242,118,30,0.18); padding: 8px 12px; border-radius: 999px; }
	.lesson-slide h2 { margin: 0 0 16px; font-size: clamp(2rem,4.2vw,4.2rem); line-height: 0.98; color: #23304d; letter-spacing: -0.04em; max-width: 1100px; }
	.lesson-slide h3 { color: #23304d; }
	.slide-lede { max-width: 860px; font-size: clamp(1.1rem,2vw,1.42rem); line-height: 1.48; color: #4b5870; }
	.compact-lede { font-size: clamp(0.98rem,1.3vw,1.16rem); }
	.hero-grid { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: 28px; align-items: stretch; }
	.outcome-box, .teacher-prompt, .game-panel, .student-work, .sample-answer, .method-card, .challenge-card, .theory-card { border-radius: 24px; padding: 22px; border: 1px solid rgba(43,53,77,0.12); background: #fff; }
	.outcome-box { margin-top: 22px; background: #f3fbff; }
	.outcome-box ul { margin: 12px 0 0; padding-left: 22px; font-size: 1.1rem; line-height: 1.6; color: #334155; }
	.lesson-badge-card { display: grid; place-items: center; align-content: center; text-align: center; padding: 28px; border-radius: 30px; background: linear-gradient(145deg,#23304d,#35507d); color: #fff; }
	.lesson-badge-card .badge-number { font-size: 5.8rem; line-height: 0.9; font-weight: 950; color: #fff; }
