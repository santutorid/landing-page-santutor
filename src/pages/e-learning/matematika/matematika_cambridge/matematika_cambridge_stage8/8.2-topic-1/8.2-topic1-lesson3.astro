	.lesson-page.ifp-fullscreen .board-card-head strong { font-size: clamp(1.2rem,1.65vw,1.6rem); }
	.lesson-page.ifp-fullscreen .board-card-equation { min-height: 70px; font-size: clamp(1.2rem,1.8vw,1.7rem); }
	.lesson-page.ifp-fullscreen .hidden-answer.is-visible { min-height: 58px; }
	.lesson-page.ifp-fullscreen .exit-grid { grid-template-columns: repeat(3,minmax(0,1fr)); margin: 12px 0; }
	.lesson-page.ifp-fullscreen .exit-card { min-height: 132px; padding: 14px; }
	.lesson-page.ifp-fullscreen .exit-answer-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
	.lesson-page.ifp-fullscreen .exit-text { font-size: clamp(0.95rem,1.2vw,1.12rem); }
	.lesson-page.ifp-fullscreen .deck-controls { margin: 0; padding: 8px; border-radius: 18px; align-items: center; flex-wrap: nowrap; }
	.lesson-page.ifp-fullscreen .primary-button, .lesson-page.ifp-fullscreen .secondary-button, .lesson-page.ifp-fullscreen .teacher-note-button, .lesson-page.ifp-fullscreen .fullscreen-toggle { min-height: 50px; padding: 10px 20px; font-size: clamp(0.92rem,1.05vw,1.06rem); white-space: nowrap; }
	.lesson-page.ifp-fullscreen .teacher-notes { position: fixed; right: 18px; bottom: 84px; z-index: 10020; width: min(500px, calc(100vw - 36px)); }
	@media (max-width: 980px) { .lesson-3-page .deck-layout, .lesson-3-page .hero-grid, .lesson-3-page .sort-layout, .lesson-3-page .expand-lab, .lesson-3-page .concept-grid { grid-template-columns: 1fr; } .lesson-3-page .slide-map { display: none; } .lesson-3-page .pipeline, .lesson-3-page .trap-grid, .lesson-3-page .board-grid, .lesson-3-page .exit-grid, .lesson-3-page .exit-answer-grid { grid-template-columns: 1fr; } .lesson-3-page .pipeline-arrow, .lesson-3-page .lesson-badge-card { display: none; } }
</style>

<script is:inline type="text/javascript">
	// @ts-nocheck
	(function () {
		const root = document.querySelector('[data-lesson-root]');
		if (!root || root.dataset.initialized === 'true') return;
		root.dataset.initialized = 'true';

		const slides = Array.from(root.querySelectorAll('[data-slide]'));
		const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
		const progressLabel = root.querySelector('[data-progress-label]');
		const progressBar = root.querySelector('[data-progress-bar]');
		const nextButton = root.querySelector('[data-next-slide]');
		const prevButton = root.querySelector('[data-prev-slide]');
		const resetSlideButton = root.querySelector('[data-reset-slide]');
		const modeToggle = root.querySelector('[data-mode-toggle]');
		const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
		const fullscreenTarget = document.querySelector('.lesson-page.ifp-fullscreen') || root;
		const totalScoreButton = root.querySelector('[data-total-score]');
		const teacherNotes = root.querySelector('[data-teacher-notes]');
		const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
		const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
		const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');

		const notes = [
			'Use this overview to connect the lesson with Lesson 4 later: factorising reverses expanding.',
			'Pause on the phrase “same letter part”. Ask why x and x² cannot be collected.',
			'Use arrows or fingers on the board: the outside term multiplies both terms inside.',
			'Ask students to say both products aloud before revealing the final answer.',
			'Remind students to collect coefficients only. The variable part stays the same.',
			'Insist on a middle line after expanding. It prevents skipped-step errors.',
			'This slide addresses the common x and x² misconception.',
			'Let students explain the mistake verbally before choosing an option.',
			'Use this for pair work. Award one point for the middle line and one point for the final answer.',
			'Collect quick notebook answers before revealing sample answers.'
		];

		let currentSlide = 0;
		let totalScore = 0;

		const renderMath = (scope = root) => {
			const targetScope = scope || root;
			const mathNodes = targetScope.matches?.('[data-tex]')
				? [targetScope]
				: Array.from(targetScope.querySelectorAll?.('[data-tex]') || []);
			mathNodes.forEach((node) => {
				const tex = node.getAttribute('data-tex') || '';
				if (tex) node.textContent = '$' + tex + '$';
			});
			if (window.MathJax && window.MathJax.typesetPromise) {
				window.MathJax.typesetClear?.([targetScope]);
				window.MathJax.typesetPromise([targetScope]).catch(() => {});
			}
		};

		const setMath = (element, tex) => {
			if (!element) return;
			element.setAttribute('data-tex', tex);
			element.textContent = '$' + tex + '$';
			renderMath(element);
		};

		const updateTotalScore = (points = 1) => {
			totalScore += points;
			if (totalScoreButton) totalScoreButton.textContent = 'Score ' + totalScore;
		};

		const updateSlide = (index) => {
			currentSlide = Math.max(0, Math.min(index, slides.length - 1));
			slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === currentSlide));
			dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === currentSlide));
			if (progressLabel) progressLabel.textContent = 'Slide ' + (currentSlide + 1) + ' of ' + slides.length;
			if (progressBar) progressBar.style.width = ((currentSlide + 1) / slides.length * 100) + '%';
			if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || notes[0];
			renderMath(slides[currentSlide]);
		};

		nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
		prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));
		dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
		resetSlideButton?.addEventListener('click', () => updateSlide(currentSlide));
		modeToggle?.addEventListener('click', () => {
			root.classList.toggle('is-self-study');
			const active = root.classList.contains('is-self-study');
			modeToggle.setAttribute('aria-pressed', String(active));
			modeToggle.textContent = active ? 'Self-study Mode' : 'Teach Mode';
		});

		const getFullscreenElement = () => document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement;
		const updateFullscreenButton = () => {
			const isFullscreen = Boolean(getFullscreenElement());
			fullscreenButton?.classList.toggle('is-active', isFullscreen);
			fullscreenButton?.setAttribute('aria-pressed', String(isFullscreen));
			if (fullscreenButton) fullscreenButton.textContent = isFullscreen ? 'Exit Full Screen' : '⛶ Present Full Screen';
		};
		const enterFullscreen = async () => {
			if (fullscreenTarget.requestFullscreen) return fullscreenTarget.requestFullscreen();
			if (fullscreenTarget.webkitRequestFullscreen) return fullscreenTarget.webkitRequestFullscreen();
			if (fullscreenTarget.msRequestFullscreen) return fullscreenTarget.msRequestFullscreen();
			throw new Error('Fullscreen is not supported in this browser.');
		};
		const exitFullscreen = async () => {
			if (document.exitFullscreen) return document.exitFullscreen();
			if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
			if (document.msExitFullscreen) return document.msExitFullscreen();
		};
		fullscreenButton?.addEventListener('click', async () => {
			try {
				if (getFullscreenElement()) await exitFullscreen();
				else await enterFullscreen();
				updateFullscreenButton();
			} catch (error) {
				fullscreenButton.textContent = 'Fullscreen unavailable';
				fullscreenButton.disabled = true;
			}
		});
		document.addEventListener('fullscreenchange', updateFullscreenButton);
		document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
		document.addEventListener('MSFullscreenChange', updateFullscreenButton);

		teacherNotesToggle?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
		teacherNotesClose?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = true; });

		root.querySelectorAll('[data-toggle-target]').forEach((button) => {
			button.addEventListener('click', () => {
				const id = button.dataset.toggleTarget || '';
				const target = root.querySelector('#' + CSS.escape(id));
				if (target) {
					target.classList.toggle('is-visible');
					renderMath(target);
				}
			});
		});

		function makeOption(text, correctText, feedback, correctMessage, wrongMessage, points, optionIndex = 0, onCorrect = null, isMath = true) {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'game-option';
			button.dataset.optionValue = text;
			const badge = document.createElement('span');
			badge.className = 'option-badge';
			badge.textContent = String.fromCharCode(65 + (optionIndex % 26));
			const textSpan = document.createElement('span');
			textSpan.className = 'option-text' + (isMath ? ' math-render' : '');
			if (isMath) textSpan.setAttribute('data-tex', text);
			else textSpan.textContent = text;
			button.append(badge, textSpan);
			button.addEventListener('click', () => {
				const parent = button.parentElement;
				if (parent) Array.from(parent.children).forEach((child) => child.disabled = true);
				const correct = text === correctText;
				button.classList.add(correct ? 'is-correct' : 'is-wrong');
				if (!correct && parent) Array.from(parent.children).forEach((child) => {
					if (child.dataset.optionValue === correctText) child.classList.add('is-correct');
				});
				if (feedback) feedback.textContent = correct ? correctMessage : wrongMessage;
				if (correct) {
					updateTotalScore(points);
					if (typeof onCorrect === 'function') onCorrect();
				}
			});
			return button;
		}

		function setupSortGame() {
			const game = root.querySelector('[data-sort-game]');
			if (!game) return;
			const items = [
				{ target: '3x', answer: '-5x', options: ['-5x', '5', '5x^2', '5y'] },
				{ target: '4a^2', answer: '-2a^2', options: ['-2a^2', '2a', '2a^3', '2b^2'] },
				{ target: '-7m', answer: '12m', options: ['12m', '12', '12m^2', '12n'] },
				{ target: '6pq', answer: '-pq', options: ['-pq', 'p^2q', '6p', '6q'] },
				{ target: '8', answer: '-3', options: ['-3', '3x', 'x^3', '3y'] }
			];
			let index = 0;
			let score = 0;
			const round = game.querySelector('[data-sort-round]');
			const target = game.querySelector('[data-sort-target]');
			const prompt = game.querySelector('[data-sort-prompt]');
			const optionsBox = game.querySelector('[data-sort-options]');
			const feedback = game.querySelector('[data-sort-feedback]');
			const scoreNode = game.querySelector('[data-sort-score]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Round ' + (index + 1) + ' / ' + items.length;
				setMath(target, item.target);
				if (prompt) prompt.innerHTML = 'Choose the term that is like <span class="math-render" data-tex="' + item.target + '"></span>.';
				renderMath(prompt);
				if (scoreNode) scoreNode.textContent = String(score);
				if (feedback) feedback.textContent = 'Like terms have exactly the same letter part.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => optionsBox.appendChild(makeOption(option, item.answer, feedback, 'Correct. Same variable and same power.', 'Not quite. Check the letter part and the power.', 1, optionIndex, () => { score += 1; if (scoreNode) scoreNode.textContent = String(score); })));
					renderMath(optionsBox);
				}
			}
			game.querySelector('[data-sort-next]')?.addEventListener('click', () => { index = (index + 1) % items.length; draw(); });
			game.querySelector('[data-sort-reset]')?.addEventListener('click', () => { index = 0; score = 0; draw(); });
			draw();
		}

		function setupExpandLab() {
			const lab = root.querySelector('[data-expand-lab]');
			if (!lab) return;
			const items = [
				{ original: '4(x + 3)', first: '4 \times x = 4x', second: '4 \times 3 = 12', answer: '4x + 12' },
				{ original: '5(a - 2)', first: '5 \times a = 5a', second: '5 \times (-2) = -10', answer: '5a - 10' },
				{ original: '2(3m + 4)', first: '2 \times 3m = 6m', second: '2 \times 4 = 8', answer: '6m + 8' },
				{ original: '-3(y - 6)', first: '-3 \times y = -3y', second: '-3 \times (-6) = 18', answer: '-3y + 18' }
			];
			let index = 0;
			let leftDone = false;
			let rightDone = false;
			const round = lab.querySelector('[data-expand-round]');
			const original = lab.querySelector('[data-expand-original]');
			const leftButton = lab.querySelector('[data-expand-left]');
			const rightButton = lab.querySelector('[data-expand-right]');
			const steps = lab.querySelector('[data-expand-steps]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Example ' + (index + 1) + ' / ' + items.length;
				setMath(original, item.original);
				leftButton?.classList.toggle('is-done', leftDone);
				rightButton?.classList.toggle('is-done', rightDone);
				if (!steps) return;
				steps.innerHTML = '';
				if (!leftDone && !rightDone) {
					const p = document.createElement('p');
					p.textContent = 'Tap both multiplication moves to reveal the expanded form.';
					steps.appendChild(p);
				} else {
					if (leftDone) {
						const div = document.createElement('div');
						div.className = 'math-render';
						div.setAttribute('data-tex', item.first);
						steps.appendChild(div);
					}
					if (rightDone) {
						const div = document.createElement('div');
						div.className = 'math-render';
						div.setAttribute('data-tex', item.second);
						steps.appendChild(div);
					}
					if (leftDone && rightDone) {
						const div = document.createElement('div');
						div.className = 'math-render';
						div.setAttribute('data-tex', item.original + ' = ' + item.answer);
						steps.appendChild(div);
					}
					renderMath(steps);
				}
			}
			leftButton?.addEventListener('click', () => { leftDone = true; draw(); });
			rightButton?.addEventListener('click', () => { rightDone = true; draw(); });
			lab.querySelector('[data-expand-answer]')?.addEventListener('click', () => { leftDone = true; rightDone = true; draw(); });
			lab.querySelector('[data-expand-reset]')?.addEventListener('click', () => { leftDone = false; rightDone = false; draw(); });
			lab.querySelector('[data-expand-new]')?.addEventListener('click', () => { index = (index + 1) % items.length; leftDone = false; rightDone = false; draw(); });
			draw();
		}

		function setupCollectGame() {
			const game = root.querySelector('[data-collect-game]');
			if (!game) return;
			const items = [
				{ prompt: '3x + 5x - 2', answer: '8x - 2', options: ['8x - 2', '8x', '6x', '3x + 3'] },
				{ prompt: '7a - 2a + 9', answer: '5a + 9', options: ['5a + 9', '9a + 9', '14a + 9', '5a'] },
				{ prompt: '4m + 6 - m', answer: '3m + 6', options: ['3m + 6', '9m', '4m + 5', '5m + 6'] },
				{ prompt: '2x^2 + 5x + 3x^2', answer: '5x^2 + 5x', options: ['5x^2 + 5x', '10x^2', '10x', '5x^4 + 5x'] },
				{ prompt: '9p - 4 + p + 7', answer: '10p + 3', options: ['10p + 3', '10p - 11', '13p', '9p + 3'] }
			];
			let index = 0;
			let score = 0;
			const round = game.querySelector('[data-collect-round]');
			const prompt = game.querySelector('[data-collect-prompt]');
			const optionsBox = game.querySelector('[data-collect-options]');
			const feedback = game.querySelector('[data-collect-feedback]');
			const scoreNode = game.querySelector('[data-collect-score]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Round ' + (index + 1) + ' / ' + items.length;
				setMath(prompt, item.prompt);
				if (scoreNode) scoreNode.textContent = String(score);
				if (feedback) feedback.textContent = 'Collect the coefficients of the like terms.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => optionsBox.appendChild(makeOption(option, item.answer, feedback, 'Correct. The like terms have been combined.', 'Not quite. Only collect terms with the same letter part.', 1, optionIndex, () => { score += 1; if (scoreNode) scoreNode.textContent = String(score); })));
					renderMath(optionsBox);
				}
			}
			game.querySelector('[data-collect-next]')?.addEventListener('click', () => { index = (index + 1) % items.length; draw(); });
			game.querySelector('[data-collect-reset]')?.addEventListener('click', () => { index = 0; score = 0; draw(); });
			draw();
		}

		function setupPipeline() {
			const lab = root.querySelector('[data-pipeline]');
			if (!lab) return;
			let step = 0;
			const cards = Array.from(lab.querySelectorAll('[data-pipeline-step]'));
			const draw = () => cards.forEach((card, index) => card.classList.toggle('is-muted', index >= step));
			root.querySelector('[data-pipeline-next]')?.addEventListener('click', () => { step = Math.min(step + 1, cards.length); draw(); });
			root.querySelector('[data-pipeline-reset]')?.addEventListener('click', () => { step = 0; draw(); });
			draw();
		}

		function setupDetectiveGame() {
			const game = root.querySelector('[data-detective-game]');
			if (!game) return;
			const items = [
				{ work: '3(x + 4) = 3x + 4', answer: 'Forgot to multiply 4 by 3', options: ['Forgot to multiply 4 by 3', 'Wrong variable', 'Should divide by 3', 'No mistake'], correct: 'Correct. 3 must multiply both x and 4, so the answer is 3x + 12.' },
				{ work: '5a + 2a^2 = 7a^2', answer: 'Collected unlike terms', options: ['Collected unlike terms', 'Sign error', 'Forgot brackets', 'No mistake'], correct: 'Correct. a and a² are unlike terms, so they cannot be collected.' },
				{ work: '2(3x - 5) = 6x + 10', answer: 'Sign error', options: ['Sign error', 'Missing x', 'Wrong HCF', 'No mistake'], correct: 'Correct. 2 × -5 is -10, so the answer is 6x - 10.' },
				{ work: '4y + 7 - y = 4y + 6', answer: 'Forgot to collect y terms', options: ['Forgot to collect y terms', 'Should multiply', 'Wrong constant', 'No mistake'], correct: 'Correct. 4y - y = 3y, so the answer is 3y + 7.' }
			];
			let index = 0;
			let score = 0;
			const round = game.querySelector('[data-detective-round]');
			const work = game.querySelector('[data-detective-work]');
			const optionsBox = game.querySelector('[data-detective-options]');
			const feedback = game.querySelector('[data-detective-feedback]');
			const scoreNode = game.querySelector('[data-detective-score]');
			function draw() {
				const item = items[index];
				if (round) round.textContent = 'Mistake ' + (index + 1) + ' / ' + items.length;
				if (scoreNode) scoreNode.textContent = String(score);
				setMath(work, item.work);
				if (feedback) feedback.textContent = 'Choose the best explanation.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => optionsBox.appendChild(makeOption(option, item.answer, feedback, item.correct, 'Not quite. Check the distributive law and like terms again.', 1, optionIndex, () => { score += 1; if (scoreNode) scoreNode.textContent = String(score); }, false)));
				}
			}
			game.querySelector('[data-detective-next]')?.addEventListener('click', () => { index = (index + 1) % items.length; draw(); });
			game.querySelector('[data-detective-reset]')?.addEventListener('click', () => { index = 0; score = 0; draw(); });
			draw();
		}

		setupSortGame();
		setupExpandLab();
		setupCollectGame();
		setupPipeline();
		setupDetectiveGame();
		renderMath(root);
		updateSlide(0);
	})();
</script>
