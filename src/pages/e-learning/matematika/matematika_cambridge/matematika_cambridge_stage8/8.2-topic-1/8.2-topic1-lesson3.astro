---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 3: Simplifying Expressions with the Distributive Law — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive full-screen IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics 8Ae.03: collecting like terms, expanding single brackets, and simplifying expressions using the distributive law.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<main id="top" class="lesson-page ifp-fullscreen lesson-3-page">
		<section class="lesson-shell" data-lesson-root tabindex="-1">
			<div class="lesson-topbar">
				<div class="lesson-topbar-left">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-1">← Back to Topic 1</a>
					<p class="eyebrow">Cambridge Lower Secondary Mathematics · Stage 8 · 8Ae.03</p>
					<h1>Lesson 3: Simplifying Expressions with the Distributive Law</h1>
				</div>
				<div class="lesson-topbar-right" aria-label="Lesson controls">
					<span class="objective-pill">8Ae.03</span>
					<button class="score-pill" type="button" data-total-score aria-live="polite">Score 0</button>
					<button class="mode-toggle" type="button" data-mode-toggle aria-pressed="false">Teach Mode</button>
					<button class="fullscreen-toggle" type="button" data-fullscreen-toggle aria-pressed="false">Exit Full Screen</button>
				</div>
			</div>

			<div class="progress-area" aria-label="Lesson progress">
				<div class="progress-meta">
					<span data-progress-label>Slide 1 of 10</span>
					<span>50 minutes</span>
				</div>
				<div class="progress-track"><span data-progress-bar></span></div>
			</div>

			<div class="deck-layout">
				<aside class="slide-map" aria-label="Lesson sections">
					<button type="button" class="slide-dot is-active" data-go-slide="0"><span>1</span> Goal</button>
					<button type="button" class="slide-dot" data-go-slide="1"><span>2</span> Warm-up</button>
					<button type="button" class="slide-dot" data-go-slide="2"><span>3</span> Law</button>
					<button type="button" class="slide-dot" data-go-slide="3"><span>4</span> Expand</button>
					<button type="button" class="slide-dot" data-go-slide="4"><span>5</span> Collect</button>
					<button type="button" class="slide-dot" data-go-slide="5"><span>6</span> Simplify</button>
					<button type="button" class="slide-dot" data-go-slide="6"><span>7</span> Powers</button>
					<button type="button" class="slide-dot" data-go-slide="7"><span>8</span> Detective</button>
					<button type="button" class="slide-dot" data-go-slide="8"><span>9</span> Board</button>
					<button type="button" class="slide-dot" data-go-slide="9"><span>10</span> Exit</button>
				</aside>

				<section class="slide-stage" aria-live="polite">
					<article class="lesson-slide is-active" data-slide data-slide-title="Learning Goal">
						<div class="slide-label"><span>Slide 1</span><strong>Learning Goal</strong></div>
						<div class="hero-grid">
							<div>
								<p class="mini-kicker">8Ae.03</p>
								<h2>Expand brackets, collect like terms, and simplify.</h2>
								<p class="slide-lede">Today students connect arithmetic laws to algebra. They will multiply a single term into brackets, then combine like terms to write expressions in a simpler form.</p>
								<div class="outcome-box">
									<h3>By the end, I can...</h3>
									<ul>
										<li>identify like terms correctly</li>
										<li>expand a single bracket using the distributive law</li>
										<li>simplify expressions after expanding</li>
										<li>explain why unlike terms cannot be combined</li>
									</ul>
								</div>
							</div>
							<div class="lesson-badge-card">
								<span class="badge-number">3</span>
								<span>core moves</span>
								<hr />
								<p>Spot like terms · Distribute · Simplify</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Warm-up: Like Terms">
						<div class="slide-label"><span>Slide 2</span><strong>Warm-up</strong></div>
						<p class="mini-kicker">Sort before simplifying</p>
						<h2>Which terms can sit together?</h2>
						<div class="sort-layout" data-sort-game>
							<div class="game-panel">
								<div class="game-head">
									<div><span class="round-label" data-sort-round>Round 1 / 5</span><h3 data-sort-prompt>Choose the term that is like <span class="math-render" data-tex="3x"></span>.</h3></div>
									<div class="local-score"><span>Score</span><strong data-sort-score>0</strong></div>
								</div>
								<div class="challenge-expression"><span data-sort-target class="math-render" data-tex="3x"></span></div>
								<div class="option-row" data-sort-options></div>
								<p class="feedback-line" data-sort-feedback>Like terms have exactly the same letter part.</p>
								<div class="activity-actions"><button type="button" class="secondary-button" data-sort-next>Next round</button><button type="button" class="secondary-button" data-sort-reset>Reset game</button></div>
							</div>
							<aside class="method-card">
								<h3>Quick rule</h3>
								<p><strong>Like terms</strong> have the same variable and the same power.</p>
								<div class="mini-example"><span class="math-render" data-tex="3x"></span> and <span class="math-render" data-tex="-5x"></span></div>
								<div class="mini-example bad"><span class="math-render" data-tex="3x"></span> and <span class="math-render" data-tex="3x^2"></span></div>
							</aside>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Concept: Distributive Law">
						<div class="slide-label"><span>Slide 3</span><strong>Concept</strong></div>
						<p class="mini-kicker">Theory foundation</p>
						<h2>The outside term multiplies everything inside.</h2>
						<div class="concept-grid">
							<section class="theory-card law-card">
								<span>Distributive law</span>
								<div class="expression-banner"><span class="math-render" data-tex="a(b + c) = ab + ac"></span></div>
								<p>The multiplier outside the bracket is shared with every term inside the bracket.</p>
							</section>
							<section class="theory-card law-card orange-card">
								<span>Example</span>
								<div class="step-stack compact-stack">
									<div><span class="math-render" data-tex="3(x + 4)"></span></div>
									<div><span class="math-render" data-tex="3 \times x + 3 \times 4"></span></div>
									<div><span class="math-render" data-tex="3x + 12"></span></div>
								</div>
							</section>
						</div>
						<div class="teacher-prompt"><strong>IFP prompt:</strong> ask students to point to the two terms inside the bracket before multiplying.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Expand Lab">
						<div class="slide-label"><span>Slide 4</span><strong>Interactive Lab</strong></div>
						<p class="mini-kicker">Single bracket expansion</p>
						<h2>Tap each part to expand the expression.</h2>
						<div class="expand-lab" data-expand-lab>
							<div class="game-panel">
								<div class="game-head">
									<div><span class="round-label" data-expand-round>Example 1 / 4</span><h3>Expand the bracket step by step.</h3></div>
								</div>
								<div class="challenge-expression"><span data-expand-original class="math-render" data-tex="4(x + 3)"></span></div>
								<div class="distribute-visual">
									<button type="button" class="factor-chip" data-expand-left>Multiply first term</button>
									<button type="button" class="factor-chip" data-expand-right>Multiply second term</button>
								</div>
								<div class="step-stack" data-expand-steps><p>Tap both multiplication moves to reveal the expanded form.</p></div>
								<div class="activity-actions"><button type="button" class="primary-button" data-expand-answer>Show final answer</button><button type="button" class="secondary-button" data-expand-new>Next example</button><button type="button" class="secondary-button" data-expand-reset>Reset</button></div>
							</div>
							<aside class="method-card navy-card">
								<h3>Teacher cue</h3>
								<p>Do not let students multiply only the first term. The outside multiplier must reach every term inside the bracket.</p>
							</aside>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Collect Like Terms">
						<div class="slide-label"><span>Slide 5</span><strong>Game 2</strong></div>
						<p class="mini-kicker">Combine safely</p>
						<h2>Collect only the terms that match.</h2>
						<div class="game-panel" data-collect-game>
							<div class="game-head">
								<div><span class="round-label" data-collect-round>Round 1 / 5</span><h3>Simplify the expression.</h3></div>
								<div class="local-score"><span>Score</span><strong data-collect-score>0</strong></div>
							</div>
							<div class="challenge-expression"><span data-collect-prompt class="math-render" data-tex="3x + 5x - 2"></span></div>
							<div class="option-row" data-collect-options></div>
							<p class="feedback-line" data-collect-feedback>Collect the coefficients of the like terms.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-collect-next>Next expression</button><button type="button" class="secondary-button" data-collect-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Simplify After Expanding">
						<div class="slide-label"><span>Slide 6</span><strong>Guided Practice</strong></div>
						<p class="mini-kicker">Expand then collect</p>
						<h2>Simplify in two moves.</h2>
						<div class="pipeline" data-pipeline>
							<div class="pipeline-card"><span>Start</span><strong class="math-render" data-tex="2(x + 5) + 3x"></strong></div>
							<div class="pipeline-arrow">→</div>
							<div class="pipeline-card" data-pipeline-step="1"><span>Expand</span><strong class="math-render" data-tex="2x + 10 + 3x"></strong></div>
							<div class="pipeline-arrow">→</div>
							<div class="pipeline-card" data-pipeline-step="2"><span>Collect</span><strong class="math-render" data-tex="5x + 10"></strong></div>
						</div>
						<div class="activity-actions"><button type="button" class="primary-button" data-pipeline-next>Reveal next move</button><button type="button" class="secondary-button" data-pipeline-reset>Reset</button></div>
						<div class="teacher-prompt"><strong>Board check:</strong> students write their own two-line working before the final answer appears.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Powers and Brackets">
						<div class="slide-label"><span>Slide 7</span><strong>Common Trap</strong></div>
						<p class="mini-kicker">Squares and cubes</p>
						<h2>Powers must match before terms can combine.</h2>
						<div class="trap-grid">
							<div class="trap-card good"><span>Can combine</span><strong class="math-render" data-tex="4x^2 + 3x^2 = 7x^2"></strong><p>The letter part is the same: <span class="math-render" data-tex="x^2"></span>.</p></div>
							<div class="trap-card bad"><span>Cannot combine</span><strong class="math-render" data-tex="4x^2 + 3x"></strong><p><span class="math-render" data-tex="x^2"></span> and <span class="math-render" data-tex="x"></span> are different kinds of terms.</p></div>
						</div>
						<div class="teacher-prompt">Ask students: “What is the letter part?” If the letter part changes, do not collect them.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Error Detective">
						<div class="slide-label"><span>Slide 8</span><strong>Game 3</strong></div>
						<p class="mini-kicker">Find the mistake</p>
						<h2>Error Detective</h2>
						<div class="game-panel" data-detective-game>
							<div class="game-head">
								<div><span class="round-label" data-detective-round>Mistake 1 / 4</span><h3>What went wrong?</h3></div>
								<div class="local-score"><span>Score</span><strong data-detective-score>0</strong></div>
							</div>
							<div class="student-work"><span>Student work</span><p data-detective-work class="math-render" data-tex="3(x + 4) = 3x + 4"></p></div>
							<div class="option-row" data-detective-options></div>
							<p class="feedback-line" data-detective-feedback>Choose the best explanation.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-detective-next>Next mistake</button><button type="button" class="secondary-button" data-detective-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Board Challenge">
						<div class="slide-label"><span>Slide 9</span><strong>Class Challenge</strong></div>
						<p class="mini-kicker">Pair work</p>
						<h2>Choose a card. Expand, collect, or simplify.</h2>
						<div class="board-grid">
							<div class="challenge-card board-card">
								<div class="board-card-head"><span class="board-card-tag">Card A</span><strong>Expand</strong></div>
								<div class="board-card-equation math-render" data-tex="5(x + 2)"></div>
								<button type="button" class="secondary-button" data-toggle-target="answer-a">Reveal answer</button>
								<p id="answer-a" class="hidden-answer math-render" data-tex="5x + 10"></p>
							</div>
							<div class="challenge-card board-card">
								<div class="board-card-head"><span class="board-card-tag">Card B</span><strong>Collect</strong></div>
								<div class="board-card-equation math-render" data-tex="7a - 3a + 9"></div>
								<button type="button" class="secondary-button" data-toggle-target="answer-b">Reveal answer</button>
								<p id="answer-b" class="hidden-answer math-render" data-tex="4a + 9"></p>
							</div>
							<div class="challenge-card board-card">
								<div class="board-card-head"><span class="board-card-tag">Card C</span><strong>Simplify</strong></div>
								<div class="board-card-equation math-render" data-tex="2(3x + 4) - x"></div>
								<button type="button" class="secondary-button" data-toggle-target="answer-c">Reveal answer</button>
								<p id="answer-c" class="hidden-answer math-render" data-tex="5x + 8"></p>
							</div>
						</div>
						<div class="teacher-prompt">Students must show the middle line, not only the final answer.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Exit Ticket">
						<div class="slide-label"><span>Slide 10</span><strong>Exit Ticket</strong></div>
						<p class="mini-kicker">Quick formative check</p>
						<h2>Before leaving, answer these three questions.</h2>
						<div class="exit-grid">
							<div class="exit-card">
								<div class="exit-card-head"><span class="exit-number">1</span><span class="exit-skill">Collect like terms</span></div>
								<div class="exit-equation"><span class="math-render" data-tex="6x + 2x - 5"></span></div>
							</div>
							<div class="exit-card">
								<div class="exit-card-head"><span class="exit-number">2</span><span class="exit-skill">Expand</span></div>
								<div class="exit-equation"><span class="math-render" data-tex="4(y - 3)"></span></div>
							</div>
							<div class="exit-card">
								<div class="exit-card-head"><span class="exit-number">3</span><span class="exit-skill">Simplify</span></div>
								<div class="exit-equation"><span class="math-render" data-tex="3(x + 2) + 4x"></span></div>
							</div>
						</div>
						<button type="button" class="primary-button" data-toggle-target="exit-answer">Reveal sample answers</button>
						<div id="exit-answer" class="hidden-answer sample-answer exit-answer-grid">
							<p><strong>1.</strong> <span class="math-render" data-tex="8x - 5"></span></p>
							<p><strong>2.</strong> <span class="math-render" data-tex="4y - 12"></span></p>
							<p><strong>3.</strong> <span class="math-render" data-tex="7x + 6"></span></p>
						</div>
					</article>
				</section>
			</div>

			<div class="deck-controls">
				<button type="button" class="secondary-button" data-prev-slide>Back</button>
				<button type="button" class="teacher-note-button" data-teacher-notes-toggle>Teacher Notes</button>
				<button type="button" class="secondary-button" data-reset-slide>Reset Slide</button>
				<button type="button" class="primary-button" data-next-slide>Next</button>
			</div>

			<aside class="teacher-notes" data-teacher-notes hidden>
				<div class="teacher-notes-card">
					<div class="teacher-notes-head"><strong>Teacher Notes</strong><button type="button" data-teacher-notes-close aria-label="Close teacher notes">×</button></div>
					<p data-teacher-notes-text>Use the slide as an IFP prompt. Ask students to explain each operation before revealing the answer.</p>
				</div>
			</aside>
		</section>
	</main>
</Layout>

<script is:inline type="text/javascript">
	window.MathJax = {
		tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$']] },
		svg: { fontCache: 'global' }
	};
</script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>

<style is:global>
	.lesson-3-page { --navy: #23304d; --orange: #f2761e; --sky: #3eb6ea; --ink: #23304d; --muted: #4b5870; --soft: #f3fbff; --cream: #fff8ee; font-family: 'Figtree', Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: radial-gradient(circle at top left, rgba(62, 182, 234, 0.18), transparent 31rem), radial-gradient(circle at bottom right, rgba(242, 118, 30, 0.14), transparent 32rem), #fffaf4; min-height: 100vh; padding: 24px 0 56px; }
	.lesson-3-page * { box-sizing: border-box; }
	.lesson-3-page .lesson-shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
	.lesson-3-page .lesson-topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding: 22px; background: rgba(255,255,255,0.92); border: 1px solid rgba(43,53,77,0.12); border-radius: 28px; box-shadow: 0 20px 60px rgba(30,41,59,0.08); }
	.lesson-3-page .back-link { display: inline-flex; margin-bottom: 12px; font-weight: 900; color: #2b5b76; text-decoration: none; }
	.lesson-3-page .eyebrow, .lesson-3-page .mini-kicker { margin: 0 0 8px; font-size: 0.78rem; font-weight: 950; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); }
	.lesson-3-page .lesson-topbar h1 { margin: 0; font-size: clamp(1.8rem, 3.2vw, 3.15rem); line-height: 1; color: var(--navy); letter-spacing: -0.035em; }
	.lesson-3-page .lesson-topbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
	.lesson-3-page .objective-pill, .lesson-3-page .mode-toggle, .lesson-3-page .fullscreen-toggle, .lesson-3-page .score-pill { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 10px 16px; border-radius: 999px; font-weight: 950; border: 0; }
	.lesson-3-page .objective-pill, .lesson-3-page .score-pill { background: var(--navy); color: #fff; }
	.lesson-3-page .fullscreen-toggle { background: #2c91bd; color: #fff; }
	.lesson-3-page .mode-toggle, .lesson-3-page .primary-button { background: var(--orange); color: #fff; border: 0; }
	.lesson-3-page .lesson-shell.is-self-study .mode-toggle { background: var(--sky); }
	.lesson-3-page .progress-area { margin: 18px 0; padding: 16px 18px; background: rgba(255,255,255,0.78); border: 1px solid rgba(43,53,77,0.1); border-radius: 22px; }
	.lesson-3-page .progress-meta { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 10px; font-weight: 900; color: var(--navy); }
	.lesson-3-page .progress-track { height: 12px; background: rgba(35,48,77,0.12); border-radius: 999px; overflow: hidden; }
	.lesson-3-page .progress-track span { display: block; height: 100%; width: 10%; background: linear-gradient(90deg, var(--orange), var(--sky)); border-radius: inherit; transition: width 0.25s ease; }
	.lesson-3-page .deck-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 18px; align-items: start; }
	.lesson-3-page .slide-map { position: sticky; top: 104px; display: grid; gap: 8px; padding: 12px; background: rgba(255,255,255,0.88); border: 1px solid rgba(43,53,77,0.1); border-radius: 24px; box-shadow: 0 18px 50px rgba(30,41,59,0.08); }
	.lesson-3-page .slide-dot { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 8px 10px; border: 1px solid transparent; border-radius: 16px; background: transparent; color: #46536b; font-weight: 900; text-align: left; cursor: pointer; }
	.lesson-3-page .slide-dot span { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(35,48,77,0.1); color: var(--navy); font-size: 0.84rem; font-weight: 950; }
	.lesson-3-page .slide-dot.is-active { background: var(--navy); color: #fff; border-color: var(--navy); }
	.lesson-3-page .slide-dot.is-active span { background: #fff; color: var(--navy); }
	.lesson-3-page .lesson-slide { display: none; min-height: 650px; padding: clamp(24px,4vw,44px); background: rgba(255,255,255,0.95); border: 1px solid rgba(43,53,77,0.12); border-radius: 34px; box-shadow: 0 24px 80px rgba(30,41,59,0.1); overflow: hidden; }
	.lesson-3-page .lesson-slide.is-active { display: block; }
	.lesson-3-page .slide-label { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; font-weight: 950; color: #526077; }
	.lesson-3-page .slide-label span { background: #fff3e9; color: var(--orange); border: 1px solid rgba(242,118,30,0.18); padding: 8px 12px; border-radius: 999px; }
	.lesson-3-page .lesson-slide h2 { margin: 0 0 16px; font-size: clamp(2rem,4.2vw,4.2rem); line-height: 0.98; color: var(--navy); letter-spacing: -0.04em; max-width: 1120px; }
	.lesson-3-page .lesson-slide h3 { color: var(--navy); }
	.lesson-3-page .slide-lede { max-width: 860px; font-size: clamp(1.05rem,1.7vw,1.3rem); line-height: 1.45; color: var(--muted); }
	.lesson-3-page .hero-grid { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: 28px; align-items: stretch; }
