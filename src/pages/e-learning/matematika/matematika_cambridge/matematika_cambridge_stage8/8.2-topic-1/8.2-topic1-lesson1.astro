---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 1: Letters in Algebra — Cambridge Stage 8 Mathematics';
const pageDescription = 'IFP full-screen interactive teaching deck for Cambridge Lower Secondary Stage 8 Mathematics 8Ae.01.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<main id="top" class="lesson-page ifp-fullscreen">
		<section class="lesson-shell" data-lesson-root>
			<div class="lesson-topbar">
				<div class="lesson-topbar-left">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-1">← Back to Topic 1</a>
					<p class="eyebrow">Cambridge Lower Secondary Mathematics · Stage 8</p>
					<h1>Lesson 1: Letters in Algebra</h1>
				</div>
				<div class="lesson-topbar-right" aria-label="Lesson controls">
					<span class="objective-pill">8Ae.01</span>
					<button class="mode-toggle" type="button" data-mode-toggle aria-pressed="false">Teach Mode</button>
					<button class="fullscreen-toggle" type="button" data-fullscreen-toggle aria-pressed="false">⛶ Present Full Screen</button>
				</div>
			</div>

			<div class="progress-area" aria-label="Lesson progress">
				<div class="progress-meta">
					<span data-progress-label>Slide 1 of 11</span>
					<span>50 minutes</span>
				</div>
				<div class="progress-track"><span data-progress-bar></span></div>
			</div>

			<div class="deck-layout">
				<aside class="slide-map" aria-label="Lesson sections">
					<button type="button" class="slide-dot is-active" data-go-slide="0"><span>1</span> Goal</button>
					<button type="button" class="slide-dot" data-go-slide="1"><span>2</span> Hook</button>
					<button type="button" class="slide-dot" data-go-slide="2"><span>3</span> Meaning</button>
					<button type="button" class="slide-dot" data-go-slide="3"><span>4</span> Vocabulary</button>
					<button type="button" class="slide-dot" data-go-slide="4"><span>5</span> Parts</button>
					<button type="button" class="slide-dot" data-go-slide="5"><span>6</span> Forms</button>
					<button type="button" class="slide-dot" data-go-slide="6"><span>7</span> Sort Race</button>
					<button type="button" class="slide-dot" data-go-slide="7"><span>8</span> Label Game</button>
					<button type="button" class="slide-dot" data-go-slide="8"><span>9</span> Myth Buster</button>
					<button type="button" class="slide-dot" data-go-slide="9"><span>10</span> Boss Quiz</button>
					<button type="button" class="slide-dot" data-go-slide="10"><span>11</span> Exit</button>
				</aside>

				<section class="slide-stage" aria-live="polite">
					<article class="lesson-slide is-active" data-slide data-slide-title="Learning Goal">
						<div class="slide-label"><span>Slide 1</span><strong>Learning Goal</strong></div>
						<div class="hero-slide-grid">
							<div>
								<p class="mini-kicker">Lesson objective</p>
								<h2>Letters can mean different things in algebra.</h2>
								<p class="slide-lede">Today we will distinguish letters as unknowns, variables, constants, coefficients, terms, expressions, formulae, and equations.</p>
								<div class="success-box">
									<h3>By the end, I can...</h3>
									<ul>
										<li>explain what a letter can represent</li>
										<li>identify the parts of <span class="math">5x + 3</span></li>
										<li>sort expressions, formulae, and equations</li>
									</ul>
								</div>
							</div>
							<div class="time-card">
								<span class="time-number">50</span>
								<span>minutes</span>
								<hr />
								<p>Full-screen IFP deck with built-in games and math notation.</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Hook: Everyday Algebra">
						<div class="slide-label"><span>Slide 2</span><strong>Hook</strong></div>
						<p class="mini-kicker">Everyday algebra language</p>
						<h2>A notebook costs <span class="math">n</span> rupiah.</h2>
						<div class="context-card">
							<p>One notebook costs <span class="math">n</span> rupiah.</p>
							<p>Three notebooks cost <span class="math">3n</span> rupiah.</p>
						</div>
						<h3 class="question-title">What does <span class="math">n</span> represent?</h3>
						<div class="choice-grid" data-choice-group>
							<button type="button" class="choice-button" data-correct="false" data-feedback="Not quite. The number of notebooks is already shown by 3 in 3n.">The number of notebooks</button>
							<button type="button" class="choice-button" data-correct="true" data-feedback="Yes. n represents the price of one notebook, so 3n means three times that price.">The price of one notebook</button>
							<button type="button" class="choice-button" data-correct="false" data-feedback="Not quite. The total price for three notebooks is represented by 3n, not n alone.">The total price</button>
							<button type="button" class="choice-button" data-correct="false" data-feedback="Not quite. A letter is not always the final answer; it can represent a quantity.">The final answer</button>
						</div>
						<p class="feedback-line" data-feedback-line>Ask students to vote before revealing the answer.</p>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="What Can Letters Mean?">
						<div class="slide-label"><span>Slide 3</span><strong>Concept</strong></div>
						<p class="mini-kicker">Meaning of letters</p>
						<h2>A letter is not always “the answer”.</h2>
						<div class="meaning-grid">
							<button type="button" class="meaning-card" data-reveal-card>
								<strong>Unknown</strong>
								<span>Tap to reveal</span>
								<em>A value we need to find. Example: <span class="math">x + 5 = 12</span>.</em>
							</button>
							<button type="button" class="meaning-card" data-reveal-card>
								<strong>Variable</strong>
								<span>Tap to reveal</span>
								<em>A value that can change. Example: <span class="math">y = 2x + 1</span>.</em>
							</button>
							<button type="button" class="meaning-card" data-reveal-card>
								<strong>Formula quantity</strong>
								<span>Tap to reveal</span>
								<em>A letter can represent a measurement. Example: <span class="math">A = l × w</span>.</em>
							</button>
						</div>
						<div class="teacher-prompt">Class talk: Can the same letter have different values in different questions?</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Vocabulary Cards">
						<div class="slide-label"><span>Slide 4</span><strong>Vocabulary</strong></div>
						<p class="mini-kicker">Tap-to-learn cards</p>
						<h2>Build the algebra vocabulary.</h2>
						<div class="vocab-grid">
							<button type="button" class="vocab-card" data-reveal-card><strong>Variable</strong><span>Letter that can change.</span><em>In <span class="math">3x + 5</span>, <span class="math">x</span> is the variable.</em></button>
							<button type="button" class="vocab-card" data-reveal-card><strong>Constant</strong><span>A fixed value.</span><em>In <span class="math">3x + 5</span>, <span class="math">5</span> is the constant.</em></button>
							<button type="button" class="vocab-card" data-reveal-card><strong>Coefficient</strong><span>Number multiplying a variable.</span><em>In <span class="math">3x</span>, the coefficient is <span class="math">3</span>.</em></button>
							<button type="button" class="vocab-card" data-reveal-card><strong>Term</strong><span>A single algebra part.</span><em>In <span class="math">3x + 5</span>, the terms are <span class="math">3x</span> and <span class="math">5</span>.</em></button>
							<button type="button" class="vocab-card" data-reveal-card><strong>Expression</strong><span>No equals sign.</span><em>Example: <span class="math">3x + 5</span>.</em></button>
							<button type="button" class="vocab-card" data-reveal-card><strong>Equation</strong><span>Shows equality.</span><em>Example: <span class="math">3x + 5 = 20</span>.</em></button>
							<button type="button" class="vocab-card" data-reveal-card><strong>Formula</strong><span>A rule connecting quantities.</span><em>Example: <span class="math">A = l × w</span>.</em></button>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Identify the Parts">
						<div class="slide-label"><span>Slide 5</span><strong>Identify Parts</strong></div>
						<p class="mini-kicker">Guided check</p>
						<h2>Look carefully at this expression.</h2>
						<div class="big-expression" aria-label="5x plus 3"><span class="math">5x + 3</span></div>
						<div class="reveal-grid">
							<button type="button" class="reveal-chip" data-toggle-target="answer-variable">Variable?</button>
							<button type="button" class="reveal-chip" data-toggle-target="answer-coefficient">Coefficient?</button>
							<button type="button" class="reveal-chip" data-toggle-target="answer-constant">Constant?</button>
							<button type="button" class="reveal-chip" data-toggle-target="answer-terms">Terms?</button>
						</div>
						<div class="answer-grid">
							<p id="answer-variable" class="hidden-answer"><strong>Variable:</strong> <span class="math">x</span></p>
							<p id="answer-coefficient" class="hidden-answer"><strong>Coefficient:</strong> <span class="math">5</span></p>
							<p id="answer-constant" class="hidden-answer"><strong>Constant:</strong> <span class="math">3</span></p>
							<p id="answer-terms" class="hidden-answer"><strong>Terms:</strong> <span class="math">5x</span> and <span class="math">3</span></p>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Expression, Formula, or Equation?">
						<div class="slide-label"><span>Slide 6</span><strong>Forms</strong></div>
						<p class="mini-kicker">Three important forms</p>
						<h2>Expression, formula, or equation?</h2>
						<div class="definition-row">
							<div><strong>Expression</strong><span>No equals sign</span><em><span class="math">3x + 5</span></em></div>
							<div><strong>Equation</strong><span>Has an equals sign</span><em><span class="math">3x + 5 = 20</span></em></div>
							<div><strong>Formula</strong><span>A rule connecting quantities</span><em><span class="math">A = l × w</span></em></div>
						</div>
						<div class="callout-warning">
							<strong>Careful:</strong> A formula often looks like an equation because it has <span class="math">=</span>. In this lesson, sort by its main purpose.
						</div>
					</article>

					<article class="lesson-slide game-slide" data-slide data-slide-title="Game: Algebra Sort Race">
						<div class="slide-label"><span>Slide 7</span><strong>Game 1</strong></div>
						<div class="game-header">
							<div>
								<p class="mini-kicker">IFP game</p>
								<h2>Algebra Sort Race</h2>
							</div>
							<div class="score-card"><span>Score</span><strong data-sort-score>0</strong></div>
						</div>
						<p class="slide-lede">Tap a card, then choose its category. Correct answer = +10 points.</p>
						<div class="sort-activity" data-sort-activity>
							<div class="sort-card-bank" aria-label="Cards to sort">
								<button type="button" class="sort-card" data-card="3x + 5" data-answer="Expression"><span class="math">3x + 5</span></button>
								<button type="button" class="sort-card" data-card="A = l × w" data-answer="Formula"><span class="math">A = l × w</span></button>
								<button type="button" class="sort-card" data-card="2x + 7 = 15" data-answer="Equation"><span class="math">2x + 7 = 15</span></button>
								<button type="button" class="sort-card" data-card="p + q" data-answer="Expression"><span class="math">p + q</span></button>
								<button type="button" class="sort-card" data-card="C = 2πr" data-answer="Formula"><span class="math">C = 2πr</span></button>
								<button type="button" class="sort-card" data-card="y = 4x − 1" data-answer="Equation"><span class="math">y = 4x − 1</span></button>
							</div>
							<div class="category-buttons" aria-label="Categories">
								<button type="button" data-category="Expression">Expression</button>
								<button type="button" data-category="Formula">Formula</button>
								<button type="button" data-category="Equation">Equation</button>
							</div>
							<p class="sort-status" data-sort-status>Select a card first.</p>
							<div class="sort-columns">
								<div><h3>Expression</h3><ul data-sort-list="Expression"></ul></div>
								<div><h3>Formula</h3><ul data-sort-list="Formula"></ul></div>
								<div><h3>Equation</h3><ul data-sort-list="Equation"></ul></div>
							</div>
							<div class="activity-actions">
								<button type="button" class="secondary-button" data-reset-sort>Reset game</button>
							</div>
						</div>
					</article>

					<article class="lesson-slide game-slide" data-slide data-slide-title="Game: Label the Expression">
						<div class="slide-label"><span>Slide 8</span><strong>Game 2</strong></div>
						<div class="game-header">
							<div>
								<p class="mini-kicker">Tap challenge</p>
								<h2>Label the Expression</h2>
							</div>
							<div class="score-card"><span>Streak</span><strong data-label-streak>0</strong></div>
						</div>
						<div class="label-game" data-label-game>
							<div class="big-expression game-expression" data-label-expression><span class="math">7m + 2</span></div>
							<h3 class="question-title" data-label-question>Find the coefficient.</h3>
							<div class="choice-grid compact" data-label-options></div>
							<p class="feedback-line" data-label-feedback>Choose the correct answer, then move to the next challenge.</p>
							<div class="activity-actions">
								<button type="button" class="primary-button" data-next-label>Next challenge</button>
								<button type="button" class="secondary-button" data-reset-label>Reset streak</button>
							</div>
						</div>
					</article>

					<article class="lesson-slide game-slide" data-slide data-slide-title="Game: Myth Buster">
						<div class="slide-label"><span>Slide 9</span><strong>Game 3</strong></div>
						<div class="game-header">
							<div>
								<p class="mini-kicker">Misconception check</p>
								<h2>Myth Buster</h2>
							</div>
							<div class="score-card"><span>Score</span><strong data-myth-score>0</strong></div>
						</div>
						<div class="myth-game" data-myth-game>
							<div class="myth-statement" data-myth-statement><span class="myth-statement-inner">“<span class="math">5x</span> means <span class="math">5 + x</span>.”</span></div>
							<div class="myth-buttons">
								<button type="button" class="primary-button" data-myth-answer="fact">Fact</button>
								<button type="button" class="primary-button danger" data-myth-answer="myth">Myth</button>
							</div>
							<p class="feedback-line" data-myth-feedback>Choose Fact or Myth.</p>
							<div class="activity-actions">
								<button type="button" class="secondary-button" data-next-myth>Next statement</button>
								<button type="button" class="secondary-button" data-reset-myth>Reset game</button>
							</div>
						</div>
					</article>

					<article class="lesson-slide game-slide" data-slide data-slide-title="Mini Boss Quiz">
						<div class="slide-label"><span>Slide 10</span><strong>Boss Quiz</strong></div>
						<div class="game-header">
							<div>
								<p class="mini-kicker">Final class challenge</p>
								<h2>Mini Boss Quiz</h2>
							</div>
							<div class="score-card"><span>Points</span><strong data-boss-score>0</strong></div>
						</div>
						<div class="boss-grid" data-boss-quiz>
							<div class="boss-question">
								<h3>1. Which is the variable in <span class="math">9a + 4</span>?</h3>
								<div class="choice-grid compact" data-boss-group>
									<button type="button" class="choice-button" data-correct="false" data-feedback="9 is the coefficient."><span class="math">9</span></button>
									<button type="button" class="choice-button" data-correct="true" data-feedback="a is the letter that can change value."><span class="math">a</span></button>
									<button type="button" class="choice-button" data-correct="false" data-feedback="4 is the constant."><span class="math">4</span></button>
									<button type="button" class="choice-button" data-correct="false" data-feedback="9a is a term."><span class="math">9a</span></button>
								</div>
							</div>
							<div class="boss-question">
								<h3>2. Which is a formula?</h3>
								<div class="choice-grid compact" data-boss-group>
									<button type="button" class="choice-button" data-correct="false" data-feedback="This is an expression because it has no equals sign."><span class="math">4x − 1</span></button>
									<button type="button" class="choice-button" data-correct="true" data-feedback="P = 2l + 2w is a rule for perimeter, so it is a formula."><span class="math">P = 2l + 2w</span></button>
									<button type="button" class="choice-button" data-correct="false" data-feedback="This is an equation, but not mainly presented as a real-world formula here."><span class="math">x + 5 = 12</span></button>
									<button type="button" class="choice-button" data-correct="false" data-feedback="This is an expression because it has no equals sign."><span class="math">p + q</span></button>
								</div>
							</div>
							<div class="boss-question">
								<h3>3. In <span class="math">6x + 4</span>, what are the terms?</h3>
								<div class="choice-grid compact" data-boss-group>
									<button type="button" class="choice-button" data-correct="false" data-feedback="x is the variable, not the full list of terms."><span class="math">x</span></button>
									<button type="button" class="choice-button" data-correct="false" data-feedback="6 is the coefficient and 4 is the constant, but 6 alone is not a term in the expression."><span class="math">6</span> and <span class="math">4</span></button>
									<button type="button" class="choice-button" data-correct="true" data-feedback="The terms are the algebra parts separated by plus or minus signs: 6x and 4."><span class="math">6x</span> and <span class="math">4</span></button>
									<button type="button" class="choice-button" data-correct="false" data-feedback="6x + 4 is the whole expression, not the separate terms."><span class="math">6x + 4</span></button>
								</div>
							</div>
						</div>
						<p class="feedback-line" data-boss-feedback>Let students come to the board. Each correct first tap gives +10 points.</p>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Exit Ticket">
						<div class="slide-label"><span>Slide 11</span><strong>Exit Ticket</strong></div>
						<p class="mini-kicker">Final check</p>
						<h2>Exit ticket</h2>
						<p class="slide-lede">Students answer in their notebook, then compare with the sample answers.</p>
						<form class="exit-form" data-exit-form>
							<label>
								<span>1. What is the difference between an expression and an equation?</span>
								<textarea rows="2" placeholder="Write your answer here..."></textarea>
							</label>
							<label>
								<span>2. In <span class="math">6x + 4</span>, what is the coefficient?</span>
								<input type="text" placeholder="Type your answer..." />
							</label>
							<label>
								<span>3. Give one real-life formula.</span>
								<input type="text" placeholder="Example: A = l × w" />
							</label>
						</form>
						<button type="button" class="primary-button" data-toggle-target="sample-exit">Show sample answers</button>
						<div id="sample-exit" class="sample-answer hidden-answer">
							<p><strong>1.</strong> An expression has no equals sign. An equation has an equals sign and says two expressions are equal.</p>
							<p><strong>2.</strong> The coefficient is <span class="math">6</span>.</p>
							<p><strong>3.</strong> Example: <span class="math">A = l × w</span>, <span class="math">C = 2πr</span>, or <span class="math">speed = distance ÷ time</span>.</p>
						</div>
					</article>
				</section>
			</div>

			<div class="deck-controls">
				<button type="button" class="secondary-button" data-prev-slide>Back</button>
				<button type="button" class="teacher-note-button" data-teacher-notes-toggle>Teacher Notes</button>
				<button type="button" class="secondary-button" data-reset-slide>Reset Slide</button>
				<button type="button" class="primary-button" data-next-slide>Next</button>
			</div>

			<aside class="teacher-notes" data-teacher-notes hidden>
				<div class="teacher-notes-card">
					<div class="teacher-notes-head">
						<strong>Teacher Notes</strong>
						<button type="button" data-teacher-notes-close aria-label="Close teacher notes">×</button>
					</div>
					<p data-teacher-notes-text>Use this slide to set the learning target clearly.</p>
				</div>
			</aside>
		</section>
	</main>
</Layout>

<script is:inline>
	window.MathJax = {
		startup: { typeset: false },
		options: { enableMenu: false },
		chtml: { scale: 1.08 }
	};
</script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

<style>
	:global(body.lesson-active-page) {
		overflow: hidden !important;
	}

	:global(body.lesson-active-page .site-header),
	:global(body.lesson-active-page .site-footer),
	:global(body.lesson-active-page .floating-whatsapp),
	:global(body.lesson-active-page .whatsapp-float) {
		display: none !important;
	}

	.lesson-page.ifp-fullscreen {
		position: fixed;
		inset: 0;
		z-index: 10000;
		height: 100vh;
		width: 100vw;
		overflow: hidden;
		padding: 0;
		background: radial-gradient(circle at 10% 10%, rgba(62, 182, 234, 0.22), transparent 28rem), radial-gradient(circle at 90% 90%, rgba(242, 118, 30, 0.18), transparent 28rem), #fffaf4;
	}

	.lesson-shell {
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 12px;
		display: grid;
		grid-template-rows: 76px 12px minmax(0, 1fr) 68px;
		gap: 10px;
		box-sizing: border-box;
	}

	.lesson-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		min-height: 0;
		padding: 10px 16px;
		background: rgba(255, 255, 255, 0.93);
		border: 1px solid rgba(43, 53, 77, 0.12);
		border-radius: 20px;
		box-shadow: 0 16px 40px rgba(30, 41, 59, 0.08);
	}

	.lesson-topbar-left { min-width: 0; }

	.back-link {
		display: inline-flex;
		margin: 0 0 4px;
		font-size: 0.85rem;
		line-height: 1;
		font-weight: 800;
		color: #2b5b76;
		text-decoration: none;
	}

	.eyebrow,
	.mini-kicker {
		margin: 0 0 6px;
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #f2761e;
	}

	.lesson-topbar h1 {
		margin: 0;
		font-size: clamp(1.5rem, 2.25vw, 2.45rem);
		line-height: 0.98;
