<script>
	const root = document.querySelector('[data-lesson-root]');

	if (root) {
		document.body.classList.add('lesson-active-page');
		window.addEventListener('pagehide', function () {
			document.body.classList.remove('lesson-active-page');
		});

		const slides = Array.from(root.querySelectorAll('[data-slide]'));
		const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
		const progressLabel = root.querySelector('[data-progress-label]');
		const progressBar = root.querySelector('[data-progress-bar]');
		const nextButton = root.querySelector('[data-next-slide]');
		const prevButton = root.querySelector('[data-prev-slide]');
		const resetSlideButton = root.querySelector('[data-reset-slide]');
		const modeToggle = root.querySelector('[data-mode-toggle]');
		const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
		const fullscreenTarget = document.querySelector('.lesson-page.ifp-fullscreen') || root;
		const teacherNotes = root.querySelector('[data-teacher-notes]');
		const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
		const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
		const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');


		const slash = String.fromCharCode(92);
		const texMap = {
			'A = l × w': 'A = l ' + slash + 'times w',
			'C = 2πr': 'C = 2' + slash + 'pi r',
			'speed = distance ÷ time': slash + 'text{speed} = ' + slash + 'text{distance} ' + slash + 'div ' + slash + 'text{time}',
			'4p − 9': '4p - 9',
			'y = 4x − 1': 'y = 4x - 1',
			'4x − 1': '4x - 1',
			'−9': '-9'
		};

		function escapeHtml(value) {
			return String(value)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function texFor(value) {
			const raw = String(value || '').trim();
			if (texMap[raw]) return texMap[raw];
			return raw
				.replace(/×/g, slash + 'times ')
				.replace(/π/g, slash + 'pi ')
				.replace(/−/g, '-')
				.replace(/÷/g, slash + 'div ');
		}

		function mathMarkup(value) {
			const raw = String(value || '').trim();
			if (raw.includes(' and ')) {
				return raw.split(' and ').map(function (part) {
					return mathMarkup(part);
				}).join(' and ');
			}
			return '<span class="math" data-tex="' + escapeHtml(texFor(raw)) + '">' + escapeHtml(raw) + '</span>';
		}


		function mathTextMarkup(text) {
			let output = escapeHtml(text || '');
			[
				'A = l × w',
				'C = 2πr',
				'P = 2l + 2w',
				'3x + 5 = 20',
				'3x + 5',
				'2x + 7 = 15',
				'x + 5 = 12',
				'y = 4x − 1',
				'9a + 4',
				'7m + 2',
				'6x + 4',
				'5 × x',
				'5 + x',
				'5x',
				'6x',
				'9a',
				'7m',
				'3n'
			].forEach(function (phrase) {
				output = output.split(escapeHtml(phrase)).join(mathMarkup(phrase));
			});
			return output;
		}

		function setFeedback(element, text) {
			if (!element) return;
			element.innerHTML = mathTextMarkup(text || '');
			renderMath(element);
		}

		function renderMath(container) {
			const target = container || root;
			if (!target) return;
			const mathNodes = Array.from(target.querySelectorAll('.math'));
			if (!mathNodes.length) return;

			function run() {
				if (!window.MathJax || !window.MathJax.tex2chtmlPromise) {
					window.setTimeout(run, 80);
					return;
				}

				mathNodes.forEach(function (node) {
					if (node.dataset.mathRendered === 'true') return;
					const tex = node.dataset.tex || texFor(node.textContent || '');
					node.dataset.tex = tex;
					window.MathJax.tex2chtmlPromise(tex, { display: false }).then(function (rendered) {
						node.innerHTML = '';
						node.appendChild(rendered);
						node.dataset.mathRendered = 'true';
						if (window.MathJax.startup && window.MathJax.startup.document) {
							window.MathJax.startup.document.clear();
							window.MathJax.startup.document.updateDocument();
						}
					}).catch(function () {
						node.textContent = node.textContent || tex;
					});
				});
			}

			run();
		}

		const notes = [
			'Set the target briefly. Ask students where they have seen letters in maths before.',
			'Let students vote first. The key point is that n represents one notebook price, while 3n is three times that price.',
			'Push the misconception: letters are not always the final answer.',
			'Do not open all cards yourself. Let students come to the board and choose a card.',
			'Ask students orally first. Reveal one part at a time.',
			'Make the distinction clear: expression has no equals sign; equation has equals sign; formula is a rule connecting quantities.',
			'Use this as a team race. Invite one student from each team to sort one card.',
			'Run this as a quick board challenge. Students tap the option, then justify their answer.',
			'Use this for misconception discussion. Ask why the myth sounds tempting before revealing.',
			'Final class challenge. Award points only when students can explain the reason.',
			'Students can answer in notebooks for live class. In self-study, they can type and compare with sample answers.'
		];

		let currentSlide = 0;

		function updateSlide(index) {
			currentSlide = Math.max(0, Math.min(index, slides.length - 1));
			slides.forEach(function (slide, slideIndex) {
				slide.classList.toggle('is-active', slideIndex === currentSlide);
			});
			dots.forEach(function (dot, dotIndex) {
				dot.classList.toggle('is-active', dotIndex === currentSlide);
			});
			if (progressLabel) progressLabel.textContent = 'Slide ' + (currentSlide + 1) + ' of ' + slides.length;
			if (progressBar) progressBar.style.width = (((currentSlide + 1) / slides.length) * 100) + '%';
			if (prevButton) prevButton.disabled = currentSlide === 0;
			if (nextButton) nextButton.textContent = currentSlide === slides.length - 1 ? 'Finish' : 'Next';
			if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || '';
			renderMath(slides[currentSlide]);
		}

		dots.forEach(function (dot) {
			dot.addEventListener('click', function () {
				updateSlide(Number(dot.dataset.goSlide || 0));
			});
		});

		if (nextButton) nextButton.addEventListener('click', function () { updateSlide(currentSlide + 1); });
		if (prevButton) prevButton.addEventListener('click', function () { updateSlide(currentSlide - 1); });

		if (modeToggle) {
			modeToggle.addEventListener('click', function () {
				const isSelfStudy = root.classList.toggle('is-self-study');
				modeToggle.setAttribute('aria-pressed', String(isSelfStudy));
				modeToggle.textContent = isSelfStudy ? 'Self-Study Mode' : 'Teach Mode';
			});
		}

		function getFullscreenElement() {
			return document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement;
		}

		function updateFullscreenButton() {
			if (!fullscreenButton) return;
			const isFullscreen = Boolean(getFullscreenElement());
			fullscreenButton.classList.toggle('is-active', isFullscreen);
			fullscreenButton.setAttribute('aria-pressed', String(isFullscreen));
			fullscreenButton.textContent = isFullscreen ? 'Exit Full Screen' : '⛶ Present Full Screen';
		}

		function enterFullscreen() {
			if (fullscreenTarget.requestFullscreen) return fullscreenTarget.requestFullscreen();
			if (fullscreenTarget.webkitRequestFullscreen) return fullscreenTarget.webkitRequestFullscreen();
			if (fullscreenTarget.msRequestFullscreen) return fullscreenTarget.msRequestFullscreen();
			throw new Error('Fullscreen is not supported in this browser.');
		}

		function exitFullscreen() {
			if (document.exitFullscreen) return document.exitFullscreen();
			if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
			if (document.msExitFullscreen) return document.msExitFullscreen();
		}

		if (fullscreenButton) {
			fullscreenButton.addEventListener('click', function () {
				try {
					if (getFullscreenElement()) {
						exitFullscreen();
					} else {
						enterFullscreen();
					}
					updateFullscreenButton();
				} catch (error) {
					fullscreenButton.textContent = 'Fullscreen unavailable';
					fullscreenButton.disabled = true;
				}
			});
		}

		document.addEventListener('fullscreenchange', updateFullscreenButton);
		document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
		document.addEventListener('MSFullscreenChange', updateFullscreenButton);

		if (teacherNotesToggle) teacherNotesToggle.addEventListener('click', function () { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
		if (teacherNotesClose) teacherNotesClose.addEventListener('click', function () { if (teacherNotes) teacherNotes.hidden = true; });

		root.querySelectorAll('[data-choice-group]').forEach(function (group) {
			const buttons = Array.from(group.querySelectorAll('.choice-button'));
			const feedbackLine = group.parentElement ? group.parentElement.querySelector('[data-feedback-line]') : null;
			buttons.forEach(function (button) {
				button.addEventListener('click', function () {
					buttons.forEach(function (item) { item.classList.remove('is-correct', 'is-wrong'); });
					const isCorrect = button.dataset.correct === 'true';
					button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
					setFeedback(feedbackLine, button.dataset.feedback || '');
				});
			});
		});

		root.querySelectorAll('[data-reveal-card]').forEach(function (card) {
			card.addEventListener('click', function () { card.classList.toggle('is-revealed'); });
		});

		root.querySelectorAll('[data-toggle-target]').forEach(function (button) {
			button.addEventListener('click', function () {
				const target = root.querySelector('#' + CSS.escape(button.dataset.toggleTarget || ''));
				if (target) target.classList.toggle('is-visible');
			});
		});

		const sortActivity = root.querySelector('[data-sort-activity]');
		if (sortActivity) {
			const cards = Array.from(sortActivity.querySelectorAll('[data-card]'));
			const categories = Array.from(sortActivity.querySelectorAll('[data-category]'));
			const status = sortActivity.querySelector('[data-sort-status]');
			const scoreLabel = root.querySelector('[data-sort-score]');
			let selectedCard = null;
			let sortScore = 0;

			function updateSortScore() {
				if (scoreLabel) scoreLabel.textContent = String(sortScore);
			}

			cards.forEach(function (card) {
				card.addEventListener('click', function () {
					if (card.classList.contains('is-assigned')) return;
					cards.forEach(function (item) { item.classList.remove('is-selected'); });
					selectedCard = card;
					card.classList.add('is-selected');
					if (status) { status.innerHTML = 'Selected: ' + mathMarkup(card.dataset.card || '') + '. Choose a category.'; renderMath(status); }
				});
			});

			categories.forEach(function (button) {
				button.addEventListener('click', function () {
					if (!selectedCard) {
						if (status) status.textContent = 'Select a card first.';
						return;
					}
					const category = button.dataset.category || '';
					const correctCategory = selectedCard.dataset.answer || '';
					const cardText = selectedCard.dataset.card || '';
					const list = sortActivity.querySelector('[data-sort-list="' + category + '"]');
					const item = document.createElement('li');
					item.innerHTML = mathMarkup(cardText);
					if (list) { list.appendChild(item); renderMath(item); }
					selectedCard.classList.remove('is-selected');
					selectedCard.classList.add('is-assigned', category === correctCategory ? 'is-correct' : 'is-wrong');
					selectedCard.disabled = true;
					if (category === correctCategory) {
						sortScore += 10;
						if (status) { status.innerHTML = 'Correct. ' + mathMarkup(cardText) + ' is a ' + correctCategory + '.'; renderMath(status); }
					} else {
						if (status) { status.innerHTML = 'Not quite. ' + mathMarkup(cardText) + ' is best sorted as ' + correctCategory + '.'; renderMath(status); }
					}
					selectedCard = null;
					updateSortScore();
				});
			});

			const resetSort = sortActivity.querySelector('[data-reset-sort]');
			if (resetSort) resetSort.addEventListener('click', function () {
				sortScore = 0;
				selectedCard = null;
				cards.forEach(function (card) {
					card.disabled = false;
					card.classList.remove('is-selected', 'is-assigned', 'is-correct', 'is-wrong');
				});
				sortActivity.querySelectorAll('[data-sort-list]').forEach(function (list) { list.innerHTML = ''; });
				if (status) status.textContent = 'Select a card first.';
				updateSortScore();
			});
		}

		const labelGame = root.querySelector('[data-label-game]');
		if (labelGame) {
			const expression = labelGame.querySelector('[data-label-expression]');
			const question = labelGame.querySelector('[data-label-question]');
			const options = labelGame.querySelector('[data-label-options]');
			const feedback = labelGame.querySelector('[data-label-feedback]');
			const streakLabel = root.querySelector('[data-label-streak]');
			const challenges = [
				{ expression: '7m + 2', prompt: 'Find the coefficient.', answer: '7', options: ['m', '7', '2', '7m'], explanation: 'The coefficient is the number multiplying the variable.' },
				{ expression: '4p − 9', prompt: 'Find the constant.', answer: '−9', options: ['4', 'p', '−9', '4p'], explanation: 'The constant is the fixed number term.' },
				{ expression: '8a + 1', prompt: 'Find the variable.', answer: 'a', options: ['8', 'a', '1', '8a'], explanation: 'The variable is the letter that can change value.' },
				{ expression: '6x + 4', prompt: 'Find the terms.', answer: '6x and 4', options: ['x', '6 and 4', '6x and 4', '6x + 4'], explanation: 'Terms are separated by plus or minus signs.' }
			];
			let currentChallenge = 0;
			let streak = 0;
			let answered = false;

			function mathSpan(value) {
				return mathMarkup(value);
			}

			function renderChallenge() {
				const challenge = challenges[currentChallenge];
				answered = false;
				if (expression) expression.innerHTML = mathSpan(challenge.expression);
				if (question) question.textContent = challenge.prompt;
				if (options) {
					options.innerHTML = '';
					challenge.options.forEach(function (option) {
						const button = document.createElement('button');
						button.type = 'button';
						button.className = 'choice-button';
						button.innerHTML = mathSpan(option);
						button.addEventListener('click', function () {
							if (answered) return;
							answered = true;
							const isCorrect = option === challenge.answer;
							button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
							if (isCorrect) {
								streak += 1;
								setFeedback(feedback, 'Correct. ' + challenge.explanation);
							} else {
								streak = 0;
								if (feedback) { feedback.innerHTML = 'Not quite. The answer is ' + mathMarkup(challenge.answer) + '. ' + challenge.explanation; renderMath(feedback); }
							}
							if (streakLabel) streakLabel.textContent = String(streak);
						});
						options.appendChild(button);
					});
				}
				if (feedback) feedback.textContent = 'Choose the correct answer, then move to the next challenge.';
				renderMath(labelGame);
			}

			const nextLabel = labelGame.querySelector('[data-next-label]');
			if (nextLabel) nextLabel.addEventListener('click', function () {
				currentChallenge = (currentChallenge + 1) % challenges.length;
				renderChallenge();
			});

			const resetLabel = labelGame.querySelector('[data-reset-label]');
			if (resetLabel) resetLabel.addEventListener('click', function () {
				streak = 0;
				currentChallenge = 0;
				if (streakLabel) streakLabel.textContent = '0';
				renderChallenge();
			});

			renderChallenge();
		}

		const mythGame = root.querySelector('[data-myth-game]');
		if (mythGame) {
			const statement = mythGame.querySelector('[data-myth-statement]');
			const feedback = mythGame.querySelector('[data-myth-feedback]');
			const scoreLabel = root.querySelector('[data-myth-score]');
			const myths = [
				{ text: 'Myth or Fact? <br><span class="math">5x</span> means <span class="math">5 + x</span>.', answer: 'myth', feedback: mathMarkup('5x') + ' means ' + mathMarkup('5 × x') + ', not ' + mathMarkup('5 + x') + '.' },
				{ text: 'Myth or Fact? <br>In <span class="math">3x + 5</span>, <span class="math">5</span> is a constant.', answer: 'fact', feedback: 'The value 5 is fixed, so it is a constant.' },
				{ text: 'Myth or Fact? <br>An expression must have an equals sign.', answer: 'myth', feedback: 'An expression does not have an equals sign.' },
				{ text: 'Myth or Fact? <br>A formula connects quantities.', answer: 'fact', feedback: 'A formula is a rule connecting quantities, such as ' + mathMarkup('A = l × w') + '.' }
			];
			let mythIndex = 0;
			let mythScore = 0;
			let mythAnswered = false;

			function renderMyth() {
				mythAnswered = false;
				if (statement) { statement.innerHTML = '<span class="myth-statement-inner">' + myths[mythIndex].text + '</span>'; renderMath(statement); }
				if (feedback) feedback.textContent = 'Choose Fact or Myth.';
			}

			mythGame.querySelectorAll('[data-myth-answer]').forEach(function (button) {
				button.addEventListener('click', function () {
					if (mythAnswered) return;
					mythAnswered = true;
					const choice = button.dataset.mythAnswer;
					const item = myths[mythIndex];
					if (choice === item.answer) {
						mythScore += 10;
						if (feedback) { feedback.innerHTML = 'Correct. ' + item.feedback; renderMath(feedback); }
					} else {
						if (feedback) { feedback.innerHTML = 'Not quite. ' + item.feedback; renderMath(feedback); }
					}
					if (scoreLabel) scoreLabel.textContent = String(mythScore);
				});
			});

			const nextMyth = mythGame.querySelector('[data-next-myth]');
			if (nextMyth) nextMyth.addEventListener('click', function () {
				mythIndex = (mythIndex + 1) % myths.length;
				renderMyth();
			});

			const resetMyth = mythGame.querySelector('[data-reset-myth]');
			if (resetMyth) resetMyth.addEventListener('click', function () {
				mythIndex = 0;
				mythScore = 0;
				if (scoreLabel) scoreLabel.textContent = '0';
				renderMyth();
			});

			renderMyth();
		}

		const bossQuiz = root.querySelector('[data-boss-quiz]');
		if (bossQuiz) {
			const scoreLabel = root.querySelector('[data-boss-score]');
			const feedback = root.querySelector('[data-boss-feedback]');
			let bossScore = 0;
			bossQuiz.querySelectorAll('[data-boss-group]').forEach(function (group) {
				let answered = false;
				const buttons = Array.from(group.querySelectorAll('.choice-button'));
				buttons.forEach(function (button) {
					button.addEventListener('click', function () {
						if (answered) return;
						answered = true;
						const isCorrect = button.dataset.correct === 'true';
						button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
						if (isCorrect) bossScore += 10;
						if (scoreLabel) scoreLabel.textContent = String(bossScore);
						setFeedback(feedback, button.dataset.feedback || '');
					});
				});
			});
		}

		function resetCurrentSlide() {
			const slide = slides[currentSlide];
			if (!slide) return;
			slide.querySelectorAll('.is-revealed').forEach(function (item) { item.classList.remove('is-revealed'); });
			slide.querySelectorAll('.hidden-answer.is-visible').forEach(function (item) { item.classList.remove('is-visible'); });
			slide.querySelectorAll('.choice-button').forEach(function (button) { button.classList.remove('is-correct', 'is-wrong'); });
			slide.querySelectorAll('[data-feedback-line]').forEach(function (line) {
				line.textContent = line.closest('.practice-card') ? 'Choose one answer.' : 'Ask students to vote before revealing the answer.';
			});
		}

		if (resetSlideButton) resetSlideButton.addEventListener('click', resetCurrentSlide);

		root.addEventListener('keydown', function (event) {
			const target = event.target;
			if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
			if (event.key === 'ArrowRight') updateSlide(currentSlide + 1);
			if (event.key === 'ArrowLeft') updateSlide(currentSlide - 1);
		});

		updateSlide(0);
		updateFullscreenButton();
		renderMath(root);
	}
</script>
