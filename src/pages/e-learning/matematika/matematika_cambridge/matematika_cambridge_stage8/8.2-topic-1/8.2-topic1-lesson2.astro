		const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
		const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');
		const totalScoreButton = root.querySelector('[data-total-score]');

		const notes = [
			'Set the aim clearly. This lesson is more procedural than Lesson 1, so keep the first slide short.',
			'Let students vote before revealing. The main idea: algebra removes the multiplication sign but keeps multiplication meaning.',
			'Tap cards one by one. Ask students to give another example for each rule before revealing the explanation.',
			'Game round. Invite students to the IFP. One student taps the answer, another explains why.',
			'Slow down here. Students often read 3x as a two-digit number after substitution. Make the multiplication meaning explicit.',
			'Use the animated machine as a modelling moment. Reveal substitute, calculate, and answer one step at a time.',
			'Remind students that algebra follows arithmetic. Powers come before multiplication and addition.',
			'Order Battle checks whether students know which operation happens first after substitution.',
			'Power Cards is a quick energy round. Emphasise x squared is x times x, not 2 times x.',
			'Error Detective is for misconception discussion. Ask why the mistake is tempting before showing the correct reason.',
			'Boss Challenge combines notation, substitution, powers, and order of operations.',
			'For live class, students answer in notebooks. For self-study, they can compare with sample answers.'
		];

		let currentSlide = 0;
		let totalScore = 0;

		const escapeHtml = (value) => String(value)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#039;');

		const math = (tex) => `<span class="math-render">$${escapeHtml(tex)}$</span>`;

		const typesetMath = () => {
			const run = () => {
				if (window.MathJax && window.MathJax.typesetPromise) {
					window.MathJax.typesetPromise([root]).catch(() => {});
				}
			};
			window.setTimeout(run, 0);
		};

		const addScore = (points) => {
			const safePoints = Number(points) || 0;
			if (safePoints > 0) totalScore += safePoints;
			if (totalScoreButton) totalScoreButton.textContent = `Score ${totalScore}`;
		};

		const updateSlide = (index) => {
			currentSlide = Math.max(0, Math.min(index, slides.length - 1));
			slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === currentSlide));
			dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === currentSlide));
			if (progressLabel) progressLabel.textContent = `Slide ${currentSlide + 1} of ${slides.length}`;
			if (progressBar) progressBar.style.width = `${((currentSlide + 1) / slides.length) * 100}%`;
			if (prevButton) prevButton.disabled = currentSlide === 0;
			if (nextButton) nextButton.textContent = currentSlide === slides.length - 1 ? 'Finish' : 'Next';
			if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || '';
			typesetMath();
		};

		dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
		nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
		prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));

		modeToggle?.addEventListener('click', () => {
			const isSelfStudy = root.classList.toggle('is-self-study');
			modeToggle.setAttribute('aria-pressed', String(isSelfStudy));
			modeToggle.textContent = isSelfStudy ? 'Self-Study Mode' : 'Teach Mode';
		});

		const getFullscreenElement = () => document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement;
		const updateFullscreenButton = () => {
			if (!fullscreenButton) return;
			const isFullscreen = Boolean(getFullscreenElement());
			fullscreenButton.classList.toggle('is-active', isFullscreen);
			fullscreenButton.setAttribute('aria-pressed', String(isFullscreen));
			fullscreenButton.textContent = isFullscreen ? 'Exit Full Screen' : '⛶ Present Full Screen';
		};
		const enterFullscreen = async () => {
			if (fullscreenTarget.requestFullscreen) return fullscreenTarget.requestFullscreen();
			if (fullscreenTarget.webkitRequestFullscreen) return fullscreenTarget.webkitRequestFullscreen();
			if (fullscreenTarget.msRequestFullscreen) return fullscreenTarget.msRequestFullscreen();
			throw new Error('Fullscreen is not supported in this browser.');
		};
		const exitFullscreen = async () => {
			if (document.exitFullscreen) return document.exitFullscreen();
			if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
			if (document.msExitFullscreen) return document.msExitFullscreen();
		};
		fullscreenButton?.addEventListener('click', async () => {
			try {
				if (getFullscreenElement()) await exitFullscreen();
				else await enterFullscreen();
				updateFullscreenButton();
			} catch (error) {
				fullscreenButton.textContent = 'Fullscreen unavailable';
				fullscreenButton.disabled = true;
			}
		});
		document.addEventListener('fullscreenchange', updateFullscreenButton);
		document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
		document.addEventListener('MSFullscreenChange', updateFullscreenButton);

		teacherNotesToggle?.addEventListener('click', () => {
			if (!teacherNotes) return;
			teacherNotes.hidden = !teacherNotes.hidden;
		});
		teacherNotesClose?.addEventListener('click', () => {
			if (teacherNotes) teacherNotes.hidden = true;
		});

		root.querySelectorAll('[data-choice-group]').forEach((group) => {
			const buttons = Array.from(group.querySelectorAll('.choice-button'));
			const feedbackLine = group.parentElement?.querySelector('[data-feedback-line]');
			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					if (button.dataset.answered === 'true') return;
					buttons.forEach((item) => item.classList.remove('is-correct', 'is-wrong'));
					const isCorrect = button.dataset.correct === 'true';
					button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
					if (isCorrect) addScore(button.dataset.points || 0);
					button.dataset.answered = 'true';
					if (feedbackLine) feedbackLine.textContent = button.dataset.feedback || '';
				});
			});
		});

		root.querySelectorAll('[data-reveal-card]').forEach((card) => {
			card.addEventListener('click', () => {
				card.classList.toggle('is-revealed');
				typesetMath();
			});
		});

		root.querySelectorAll('[data-toggle-target]').forEach((button) => {
			button.addEventListener('click', () => {
				const targetId = button.dataset.toggleTarget || '';
				const target = root.querySelector(`#${CSS.escape(targetId)}`);
				if (target) target.classList.toggle('is-visible');
				typesetMath();
			});
		});

		const makeOptionButton = (option, correctValue, feedbackTarget, onCorrect) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'game-option';
			button.innerHTML = math(option.value);
			button.addEventListener('click', () => {
				const parent = button.parentElement;
				parent?.querySelectorAll('.game-option').forEach((item) => item.classList.remove('is-correct', 'is-wrong'));
				const isCorrect = option.value === correctValue;
				button.classList.add(isCorrect ? 'is-correct' : 'is-wrong');
				if (feedbackTarget) feedbackTarget.textContent = isCorrect ? option.correctText : option.wrongText;
				if (isCorrect && !button.dataset.scored) {
					button.dataset.scored = 'true';
					onCorrect?.();
				}
			});
			return button;
		};

		const notationGame = root.querySelector('[data-notation-game]');
		if (notationGame) {
			const questions = [
				{ prompt: '7 × y', answer: '7y', options: ['7y', 'y7', '7 + y', '7 ÷ y'] },
				{ prompt: 'm × m', answer: 'm^2', options: ['m^2', '2m', 'm + m', 'm^3'] },
				{ prompt: 'a × b', answer: 'ab', options: ['ab', 'a + b', 'a^b', 'a ÷ b'] },
				{ prompt: 'x × x × x', answer: 'x^3', options: ['x^3', '3x', 'x^2', 'x + 3'] },
				{ prompt: '2 × p × p', answer: '2p^2', options: ['2p^2', '2p^3', '4p', 'p^2 + 2'] }
			];
			let index = 0;
			let score = 0;
			const round = notationGame.querySelector('[data-notation-round]');
			const prompt = notationGame.querySelector('[data-notation-prompt]');
			const optionsBox = notationGame.querySelector('[data-notation-options]');
			const feedback = notationGame.querySelector('[data-notation-feedback]');
			const scoreBox = notationGame.querySelector('[data-notation-score]');
			const render = () => {
				const q = questions[index];
				if (round) round.textContent = `Round ${index + 1} / ${questions.length}`;
				if (prompt) prompt.innerHTML = `$${escapeHtml(q.prompt)}$`;
				if (feedback) feedback.textContent = 'Choose the neat algebraic form.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					q.options.forEach((value) => optionsBox.appendChild(makeOptionButton(
						{ value, correctText: 'Fixed. This is the correct algebraic notation.', wrongText: 'Check the multiplication rule or repeated variable again.' },
						q.answer,
						feedback,
						() => { score += 5; addScore(5); if (scoreBox) scoreBox.textContent = String(score); }
					)));
				}
				typesetMath();
			};
			notationGame.querySelector('[data-notation-next]')?.addEventListener('click', () => { index = (index + 1) % questions.length; render(); });
			notationGame.querySelector('[data-notation-reset]')?.addEventListener('click', () => { index = 0; score = 0; if (scoreBox) scoreBox.textContent = '0'; render(); });
			render();
		}

		const machineGame = root.querySelector('[data-machine-game]');
		if (machineGame) {
			const examples = [
				{ variable: 'x = 4', expression: '3x + 2', steps: ['3(4) + 2', '12 + 2', '14'] },
				{ variable: 'a = 5', expression: '2a^2 + 1', steps: ['2(5^2) + 1', '2(25) + 1', '51'] },
				{ variable: 'm = 3', expression: '4m + 7', steps: ['4(3) + 7', '12 + 7', '19'] }
			];
			let exampleIndex = 0;
			let stepIndex = 0;
			const input = machineGame.querySelector('[data-machine-input] strong');
			const inputCard = machineGame.querySelector('[data-machine-input]');
			const expression = machineGame.querySelector('[data-machine-expression]');
			const output = machineGame.querySelector('[data-machine-output]');
			const stepsBox = machineGame.querySelector('[data-machine-steps]');
			const stepButton = machineGame.querySelector('[data-machine-step]');
			const render = () => {
				const item = examples[exampleIndex];
				if (input) input.innerHTML = `$${escapeHtml(item.variable)}$`;
				if (expression) expression.innerHTML = `$${escapeHtml(item.expression)}$`;
				if (output) output.textContent = '?';
				if (stepsBox) stepsBox.innerHTML = '<p>Tap Substitute to reveal the working step by step.</p>';
				if (stepButton) stepButton.textContent = 'Substitute';
				stepIndex = 0;
				typesetMath();
			};
			stepButton?.addEventListener('click', () => {
				const item = examples[exampleIndex];
				inputCard?.classList.remove('is-running');
				void inputCard?.offsetWidth;
				inputCard?.classList.add('is-running');
				const visibleSteps = item.steps.slice(0, stepIndex + 1);
				if (stepsBox) stepsBox.innerHTML = visibleSteps.map((line, i) => `<p>${i === 0 ? '=' : '='} ${math(line)}</p>`).join('');
				if (stepIndex >= item.steps.length - 1 && output) output.innerHTML = math(item.steps[item.steps.length - 1]);
				stepIndex = Math.min(stepIndex + 1, item.steps.length - 1);
				if (stepButton) stepButton.textContent = stepIndex >= item.steps.length - 1 ? 'Reveal answer' : 'Calculate';
				typesetMath();
			});
			machineGame.querySelector('[data-machine-new]')?.addEventListener('click', () => { exampleIndex = (exampleIndex + 1) % examples.length; render(); });
			machineGame.querySelector('[data-machine-reset]')?.addEventListener('click', render);
			render();
		}

		const orderGame = root.querySelector('[data-order-game]');
		if (orderGame) {
			const battles = [
				{ question: 'Evaluate when x = 6.', expression: '4 + 2x', substitution: '4 + 2(6)', answer: '2(6)', options: ['4 + 2', '2(6)', '6 + 4', '4 × 6'] },
				{ question: 'Evaluate when a = 3.', expression: '5a^2 + 1', substitution: '5(3^2) + 1', answer: '3^2', options: ['5 + 3', '3^2', '5(3)', '1 + 3'] },
				{ question: 'Evaluate when p = 4.', expression: '2(p + 3)', substitution: '2(4 + 3)', answer: '4 + 3', options: ['2 × 4', '4 + 3', '2 + 3', '2 + 4'] },
				{ question: 'Evaluate when y = 2.', expression: '10 - y^3', substitution: '10 - 2^3', answer: '2^3', options: ['10 - 2', '2^3', '10 ÷ 2', '10 + 3'] }
			];
			let index = 0;
			let score = 0;
			const round = orderGame.querySelector('[data-order-round]');
			const question = orderGame.querySelector('[data-order-question]');
			const expression = orderGame.querySelector('[data-order-expression]');
			const substitution = orderGame.querySelector('[data-order-substitution]');
			const optionsBox = orderGame.querySelector('[data-order-options]');
			const feedback = orderGame.querySelector('[data-order-feedback]');
			const scoreBox = orderGame.querySelector('[data-order-score]');
			const render = () => {
				const item = battles[index];
				if (round) round.textContent = `Battle ${index + 1} / ${battles.length}`;
				if (question) question.textContent = item.question;
				if (expression) expression.innerHTML = `$${escapeHtml(item.expression)}$`;
				if (substitution) substitution.innerHTML = `$${escapeHtml(item.substitution)}$`;
				if (feedback) feedback.textContent = 'Pick the first operation.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((value) => optionsBox.appendChild(makeOptionButton(
						{ value, correctText: 'Yes. That operation should be completed before moving on.', wrongText: 'Not first. Check brackets, powers, multiplication/division, then addition/subtraction.' },
						item.answer,
						feedback,
						() => { score += 5; addScore(5); if (scoreBox) scoreBox.textContent = String(score); }
					)));
				}
				typesetMath();
			};
			orderGame.querySelector('[data-order-next]')?.addEventListener('click', () => { index = (index + 1) % battles.length; render(); });
			orderGame.querySelector('[data-order-reset]')?.addEventListener('click', () => { index = 0; score = 0; if (scoreBox) scoreBox.textContent = '0'; render(); });
			render();
		}

		const powerGame = root.querySelector('[data-power-game]');
		if (powerGame) {
			const cards = [
				{ prompt: 'x × x', answer: 'x^2', options: ['x^2', '2x', 'x^3', 'x + 2'] },
				{ prompt: 'a × a × a', answer: 'a^3', options: ['a^3', '3a', 'a^2', 'a + 3'] },
				{ prompt: '3 × y × y', answer: '3y^2', options: ['3y^2', '3y^3', '6y', 'y^2 + 3'] },
				{ prompt: '2 × p × p × p', answer: '2p^3', options: ['2p^3', '2p^2', '6p', 'p^3 + 2'] }
			];
			let index = 0;
			let streak = 0;
			const prompt = powerGame.querySelector('[data-power-prompt]');
			const optionsBox = powerGame.querySelector('[data-power-options]');
			const feedback = powerGame.querySelector('[data-power-feedback]');
			const streakBox = powerGame.querySelector('[data-power-streak]');
			const render = () => {
				const card = cards[index];
				if (prompt) prompt.innerHTML = `$${escapeHtml(card.prompt)}$`;
				if (feedback) feedback.textContent = 'Choose the index form.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					card.options.forEach((value) => optionsBox.appendChild(makeOptionButton(
						{ value, correctText: 'Power up. Repeated multiplication is written using an index.', wrongText: 'Count how many times the variable is multiplied by itself.' },
						card.answer,
						feedback,
						() => { streak += 1; addScore(3); if (streakBox) streakBox.textContent = String(streak); }
					)));
				}
				typesetMath();
			};
			powerGame.querySelector('[data-power-next]')?.addEventListener('click', () => { index = (index + 1) % cards.length; render(); });
			powerGame.querySelector('[data-power-reset]')?.addEventListener('click', () => { index = 0; streak = 0; if (streakBox) streakBox.textContent = '0'; render(); });
			render();
		}

		const detectiveGame = root.querySelector('[data-detective-game]');
		if (detectiveGame) {
			const cases = [
				{ work: ['If x = 5', 'x^2 = 2 × 5 = 10'], answer: 'x^2 means x × x', options: ['x^2 means x × x', 'x^2 means x + x', 'x^2 means 2 × x', 'x^2 means x ÷ 2'] },
				{ work: ['If x = 4', '3x + 2 = 34 + 2 = 36'], answer: '3x means 3 × x', options: ['3x means 3 × x', '3x means the number 34', '3x means 3 + x', '3x means x^3'] },
				{ work: ['If a = 3', '5a^2 = (5a)^2 = 225'], answer: 'Do a^2 before multiplying by 5', options: ['Do a^2 before multiplying by 5', 'Add 5 and a first', 'Square only the 5', 'Ignore the exponent'] }
			];
			let index = 0;
			const workBox = detectiveGame.querySelector('[data-detective-work]');
			const optionsBox = detectiveGame.querySelector('[data-detective-options]');
			const feedback = detectiveGame.querySelector('[data-detective-feedback]');
			const render = () => {
				const item = cases[index];
				if (workBox) workBox.innerHTML = item.work.map((line) => `<p>${math(line)}</p>`).join('');
				if (feedback) feedback.textContent = 'Choose the best explanation.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((value) => optionsBox.appendChild(makeOptionButton(
						{ value, correctText: 'Detective solved. That explanation identifies the exact misconception.', wrongText: 'That does not explain the mistake shown in the student work.' },
						item.answer,
						feedback,
						() => addScore(5)
					)));
				}
				typesetMath();
			};
			detectiveGame.querySelector('[data-detective-next]')?.addEventListener('click', () => { index = (index + 1) % cases.length; render(); });
			detectiveGame.querySelector('[data-detective-reset]')?.addEventListener('click', () => { index = 0; render(); });
			render();
		}

		const bossGame = root.querySelector('[data-boss-game]');
		if (bossGame) {
			const questions = [
				{ task: 'Write this in algebraic notation.', prompt: '6 × p', answer: '6p', options: ['6p', 'p6', '6 + p', '6 ÷ p'] },
				{ task: 'Evaluate when x = 3.', prompt: '2x + 5', answer: '11', options: ['11', '10', '21', '2^3 + 5'] },
				{ task: 'Write this using an index.', prompt: 'y × y × y', answer: 'y^3', options: ['y^3', '3y', 'y^2', 'y + 3'] },
				{ task: 'Choose the correct value when a = 2.', prompt: '3a^2 + 4', answer: '16', options: ['16', '10', '40', '12'] }
			];
			let index = 0;
			let score = 0;
			const round = bossGame.querySelector('[data-boss-round]');
			const prompt = bossGame.querySelector('[data-boss-prompt]');
			const task = bossGame.querySelector('[data-boss-task]');
			const optionsBox = bossGame.querySelector('[data-boss-options]');
			const feedback = bossGame.querySelector('[data-boss-feedback]');
			const scoreBox = bossGame.querySelector('[data-boss-score]');
			const rank = bossGame.querySelector('[data-boss-rank]');
			const updateRank = () => {
				if (!rank) return;
				if (score >= 16) rank.textContent = 'Rank: Algebra Master';
				else if (score >= 10) rank.textContent = 'Rank: Algebra Pro';
				else if (score >= 5) rank.textContent = 'Rank: Algebra Apprentice';
				else rank.textContent = 'Rank: Algebra Rookie';
			};
			const render = () => {
				const item = questions[index];
				if (round) round.textContent = `Question ${index + 1} / ${questions.length}`;
				if (prompt) prompt.innerHTML = `$${escapeHtml(item.prompt)}$`;
				if (task) task.textContent = item.task;
				if (feedback) feedback.textContent = 'Choose an answer.';
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((value) => optionsBox.appendChild(makeOptionButton(
						{ value, correctText: 'Boss hit. This answer follows the notation or operation rule.', wrongText: 'Not this one. Check notation, substitution, powers, and order of operations.' },
						item.answer,
						feedback,
						() => { score += 5; addScore(5); if (scoreBox) scoreBox.textContent = String(score); updateRank(); }
					)));
				}
				typesetMath();
			};
			bossGame.querySelector('[data-boss-next]')?.addEventListener('click', () => { index = (index + 1) % questions.length; render(); });
			bossGame.querySelector('[data-boss-reset]')?.addEventListener('click', () => { index = 0; score = 0; if (scoreBox) scoreBox.textContent = '0'; updateRank(); render(); });
			render();
		}

		const resetCurrentSlide = () => {
			const slide = slides[currentSlide];
			if (!slide) return;
			slide.querySelectorAll('.is-revealed').forEach((item) => item.classList.remove('is-revealed'));
			slide.querySelectorAll('.hidden-answer.is-visible').forEach((item) => item.classList.remove('is-visible'));
			slide.querySelectorAll('.choice-button, .game-option').forEach((button) => {
				button.classList.remove('is-correct', 'is-wrong');
				delete button.dataset.answered;
				delete button.dataset.scored;
			});
			slide.querySelectorAll('[data-feedback-line]').forEach((line) => {
				line.textContent = 'Ask students to vote first, then tap one answer.';
			});
			typesetMath();
		};
		resetSlideButton?.addEventListener('click', resetCurrentSlide);

		root.addEventListener('keydown', (event) => {
			const target = event.target;
			if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
			if (event.key === 'ArrowRight') updateSlide(currentSlide + 1);
			if (event.key === 'ArrowLeft') updateSlide(currentSlide - 1);
		});

		window.setTimeout(typesetMath, 500);
		updateSlide(0);
		updateFullscreenButton();
	}
</script>
