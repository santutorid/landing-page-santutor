---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 2: Algebraic Conventions & Order of Operations — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics 8Ae.02: algebraic notation, substitution, order of operations, squares, and cubes.';
const pageTitleEn = 'Lesson 2: Algebraic Conventions & Order of Operations — Cambridge Stage 8 Mathematics';
const pageDescriptionEn = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics 8Ae.02: algebraic notation, substitution, order of operations, squares, and cubes.';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<main id="top" class="lesson-page ifp-fullscreen lesson-2-page">
		<section class="lesson-shell" data-lesson-root tabindex="-1">
			<div class="lesson-topbar">
				<div class="lesson-topbar-left">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-1">← Back to Topic 1</a>
					<p class="eyebrow">Cambridge Lower Secondary Mathematics · Stage 8 · 8Ae.02</p>
					<h1>Lesson 2: Algebraic Conventions & Order of Operations</h1>
				</div>
				<div class="lesson-topbar-right" aria-label="Lesson controls">
					<span class="objective-pill">8Ae.02</span>
					<button class="score-pill" type="button" data-total-score aria-live="polite">Score 0</button>
					<button class="mode-toggle" type="button" data-mode-toggle aria-pressed="false">Teach Mode</button>
					<button class="fullscreen-toggle" type="button" data-fullscreen-toggle aria-pressed="false">⛶ Present Full Screen</button>
				</div>
			</div>

			<div class="progress-area" aria-label="Lesson progress">
				<div class="progress-meta">
					<span data-progress-label>Slide 1 of 12</span>
					<span>50 minutes</span>
				</div>
				<div class="progress-track"><span data-progress-bar></span></div>
			</div>

			<div class="deck-layout">
				<aside class="slide-map" aria-label="Lesson sections">
					<button type="button" class="slide-dot is-active" data-go-slide="0"><span>1</span> Goal</button>
					<button type="button" class="slide-dot" data-go-slide="1"><span>2</span> Hook</button>
					<button type="button" class="slide-dot" data-go-slide="2"><span>3</span> Rules</button>
					<button type="button" class="slide-dot" data-go-slide="3"><span>4</span> Fixer</button>
					<button type="button" class="slide-dot" data-go-slide="4"><span>5</span> Meaning</button>
					<button type="button" class="slide-dot" data-go-slide="5"><span>6</span> Machine</button>
					<button type="button" class="slide-dot" data-go-slide="6"><span>7</span> Order</button>
					<button type="button" class="slide-dot" data-go-slide="7"><span>8</span> Battle</button>
					<button type="button" class="slide-dot" data-go-slide="8"><span>9</span> Powers</button>
					<button type="button" class="slide-dot" data-go-slide="9"><span>10</span> Detective</button>
					<button type="button" class="slide-dot" data-go-slide="10"><span>11</span> Boss</button>
					<button type="button" class="slide-dot" data-go-slide="11"><span>12</span> Exit</button>
				</aside>

				<section class="slide-stage" aria-live="polite">
					<article class="lesson-slide is-active" data-slide data-slide-title="Learning Goal">
						<div class="slide-label"><span>Slide 1</span><strong>Learning Goal</strong></div>
						<div class="hero-grid">
							<div>
								<p class="mini-kicker">Lesson objective</p>
								<h2>Algebra still follows arithmetic rules.</h2>
								<p class="slide-lede">Today we will write algebraic expressions neatly, substitute values, and follow the correct order of operations.</p>
								<div class="outcome-box">
									<h3>By the end, I can...</h3>
									<ul>
										<li>write multiplication in algebraic notation</li>
										<li>substitute values into expressions</li>
										<li>evaluate expressions with powers and operations in the correct order</li>
									</ul>
								</div>
							</div>
							<div class="lesson-badge-card">
								<span class="badge-number">4</span>
								<span>game rounds</span>
								<hr />
								<p>Notation Fixer · Algebra Machine · Order Battle · Error Detective</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Hook: Same or Different?">
						<div class="slide-label"><span>Slide 2</span><strong>Hook</strong></div>
						<p class="mini-kicker">Algebra looks shorter</p>
						<h2>Are these the same?</h2>
						<div class="compare-board">
							<div class="math-tile"><span class="math-render">$3 &bsol;times x + 2$</span></div>
							<div class="equal-arrow">→</div>
							<div class="math-tile"><span class="math-render">$3x + 2$</span></div>
						</div>
						<div class="choice-grid" data-choice-group>
							<button type="button" class="choice-button" data-correct="true" data-points="5" data-feedback="Yes. In algebra, 3x means 3 multiplied by x.">Same meaning</button>
							<button type="button" class="choice-button" data-correct="false" data-points="0" data-feedback="Not quite. The multiplication sign is usually removed, but the meaning is still multiplication.">Different meaning</button>
						</div>
						<p class="feedback-line" data-feedback-line>Ask students to vote first, then tap one answer.</p>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Algebra Writing Rules">
						<div class="slide-label"><span>Slide 3</span><strong>Concept</strong></div>
						<p class="mini-kicker">Notation rules</p>
						<h2>Algebra has writing shortcuts.</h2>
						<div class="rule-grid">
							<button type="button" class="rule-card" data-reveal-card><strong>Number × letter</strong><span class="math-render">$5 &bsol;times x = 5x$</span><em>Write the number first, then the letter.</em></button>
							<button type="button" class="rule-card" data-reveal-card><strong>Letter × letter</strong><span class="math-render">$a &bsol;times b = ab$</span><em>Two letters next to each other mean multiplication.</em></button>
							<button type="button" class="rule-card" data-reveal-card><strong>Square</strong><span class="math-render">$x &bsol;times x = x^2$</span><em>The same variable multiplied twice gives a square.</em></button>
							<button type="button" class="rule-card" data-reveal-card><strong>Cube</strong><span class="math-render">$y &bsol;times y &bsol;times y = y^3$</span><em>The same variable multiplied three times gives a cube.</em></button>
						</div>
						<div class="teacher-prompt">IFP prompt: ask one student to explain why <span class="math-render">$x^2$</span> is not the same as <span class="math-render">$2x$</span>.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Game 1: Notation Fixer">
						<div class="slide-label"><span>Slide 4</span><strong>Game 1</strong></div>
						<p class="mini-kicker">Repair the broken notation</p>
						<h2>Notation Fixer</h2>
						<div class="game-panel notation-game" data-notation-game>
							<div class="game-head">
								<div><span class="round-label" data-notation-round>Round 1 / 5</span><h3>Fix this algebra notation.</h3></div>
								<div class="local-score"><span>Score</span><strong data-notation-score>0</strong></div>
							</div>
							<div class="broken-box"><span>Broken:</span><strong data-notation-prompt class="math-render">$7 &bsol;times y$</strong></div>
							<div class="option-row" data-notation-options></div>
							<p class="feedback-line" data-notation-feedback>Choose the neat algebraic form.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-notation-next>Next notation</button><button type="button" class="secondary-button" data-notation-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="What Does Multiplication Mean?">
						<div class="slide-label"><span>Slide 5</span><strong>Meaning</strong></div>
						<p class="mini-kicker">Do not read algebra like a normal number</p>
						<h2><span class="math-render">$3x$</span> means <span class="math-render">$3 &bsol;times x$</span>.</h2>
						<div class="meaning-board">
							<div class="do-card"><span>Correct</span><strong class="math-render">$x = 4$</strong><p class="math-render">$3x = 3 &bsol;times 4 = 12$</p></div>
							<div class="dont-card"><span>Common mistake</span><strong>Do not read it as “34”.</strong><p>When <span class="math-render">$x = 4$</span>, <span class="math-render">$3x$</span> is multiplication, not a two-digit number.</p></div>
						</div>
						<div class="quick-reveal">
							<button type="button" class="primary-button" data-toggle-target="meaning-check">Reveal quick check</button>
							<p id="meaning-check" class="hidden-answer"><strong>Quick check:</strong> If <span class="math-render">$a = 6$</span>, then <span class="math-render">$4a = 4 &bsol;times 6 = 24$</span>.</p>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Game 2: Algebra Machine">
						<div class="slide-label"><span>Slide 6</span><strong>Game 2</strong></div>
						<p class="mini-kicker">Substitution animation</p>
						<h2>Algebra Machine</h2>
						<div class="machine-game" data-machine-game>
							<div class="machine-left">
								<div class="machine-card input-card" data-machine-input><span>Input</span><strong class="math-render">$x = 4$</strong></div>
								<div class="machine-card expression-card"><span>Expression</span><strong data-machine-expression class="math-render">$3x + 2$</strong></div>
							</div>
							<div class="machine-center" aria-hidden="true">
								<div class="machine-body"><span>Algebra<br />Machine</span><div class="machine-light"></div></div>
							</div>
							<div class="machine-right">
								<div class="machine-card output-card"><span>Output</span><strong data-machine-output>?</strong></div>
								<div class="machine-steps" data-machine-steps><p>Tap the buttons below to reveal the working step by step.</p></div>
							</div>
							<div class="machine-actions">
								<button type="button" class="primary-button" data-machine-step>Substitute</button>
								<button type="button" class="secondary-button" data-machine-new>New example</button>
								<button type="button" class="secondary-button" data-machine-reset>Reset</button>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Order of Operations">
						<div class="slide-label"><span>Slide 7</span><strong>Order</strong></div>
						<p class="mini-kicker">Arithmetic laws still apply</p>
						<h2>Do the operations in the correct order.</h2>
						<div class="order-ladder">
							<div><span>1</span><strong>Brackets</strong><em class="math-render">$(2 + x)$</em></div>
							<div><span>2</span><strong>Powers</strong><em class="math-render">$x^2, x^3$</em></div>
							<div><span>3</span><strong>Multiply / Divide</strong><em class="math-render">$3(5)$</em></div>
							<div><span>4</span><strong>Add / Subtract</strong><em class="math-render">$2 + 15$</em></div>
						</div>
						<div class="worked-line"><span class="math-render">$2 + 3(5)$</span><span>→ multiply first</span><span class="math-render">$2 + 15 = 17$</span></div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Game 3: Order Battle">
						<div class="slide-label"><span>Slide 8</span><strong>Game 3</strong></div>
						<p class="mini-kicker">Choose the first correct step</p>
						<h2>Order Battle</h2>
						<div class="game-panel order-game" data-order-game>
							<div class="game-head"><div><span class="round-label" data-order-round>Battle 1 / 4</span><h3 data-order-question>Evaluate when <span class="math-render">$x = 6$</span>.</h3></div><div class="local-score"><span>Score</span><strong data-order-score>0</strong></div></div>
							<div class="battle-expression"><span data-order-expression class="math-render">$4 + 2x$</span><small>After substitution: <b data-order-substitution class="math-render">$4 + 2(6)$</b></small></div>
							<h3 class="question-title">Which part should be done first?</h3>
							<div class="option-row" data-order-options></div>
							<p class="feedback-line" data-order-feedback>Pick the first operation.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-order-next>Next battle</button><button type="button" class="secondary-button" data-order-reset>Reset battle</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Mini Game: Power Cards">
						<div class="slide-label"><span>Slide 9</span><strong>Mini Game</strong></div>
						<p class="mini-kicker">Squares and cubes</p>
						<h2>Power Cards</h2>
						<div class="power-game" data-power-game>
							<div class="power-card-display"><span>Convert this repeated multiplication:</span><strong data-power-prompt class="math-render">$x &bsol;times x$</strong></div>
							<div class="power-options" data-power-options></div>
							<div class="power-footer"><p class="feedback-line" data-power-feedback>Choose the index form.</p><div class="local-score"><span>Streak</span><strong data-power-streak>0</strong></div></div>
							<div class="activity-actions"><button type="button" class="secondary-button" data-power-next>Next card</button><button type="button" class="secondary-button" data-power-reset>Reset cards</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Game 4: Error Detective">
						<div class="slide-label"><span>Slide 10</span><strong>Game 4</strong></div>
						<p class="mini-kicker">Find the mistake</p>
						<h2>Error Detective</h2>
						<div class="detective-game" data-detective-game>
							<div class="student-work">
								<span>Student work</span>
								<div data-detective-work class="math-work"></div>
							</div>
							<h3>What is the mistake?</h3>
							<div class="option-row" data-detective-options></div>
							<p class="feedback-line" data-detective-feedback>Choose the best explanation.</p>
							<div class="activity-actions"><button type="button" class="secondary-button" data-detective-next>Next case</button><button type="button" class="secondary-button" data-detective-reset>Reset cases</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Boss Challenge">
						<div class="slide-label"><span>Slide 11</span><strong>Boss Round</strong></div>
						<p class="mini-kicker">Final game check</p>
						<h2>Boss Challenge</h2>
						<div class="boss-game" data-boss-game>
							<div class="boss-question"><span data-boss-round>Question 1 / 4</span><strong data-boss-prompt class="math-render">$6 &bsol;times p$</strong><em data-boss-task>Write this in algebraic notation.</em></div>
							<div class="option-row boss-options" data-boss-options></div>
							<p class="feedback-line" data-boss-feedback>Choose an answer.</p>
							<div class="boss-rank"><span data-boss-rank>Rank: Algebra Rookie</span><strong data-boss-score>0</strong></div>
							<div class="activity-actions"><button type="button" class="secondary-button" data-boss-next>Next boss question</button><button type="button" class="secondary-button" data-boss-reset>Reset boss</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Exit Ticket">
						<div class="slide-label"><span>Slide 12</span><strong>Exit Ticket</strong></div>
						<p class="mini-kicker">Final reflection</p>
						<h2>Exit Ticket</h2>
						<div class="exit-grid">
							<div class="exit-card"><strong>1</strong><p>What does <span class="math-render">$4x$</span> mean?</p></div>
							<div class="exit-card"><strong>2</strong><p>Evaluate <span class="math-render">$3x + 1$</span> when <span class="math-render">$x = 5$</span>.</p></div>
							<div class="exit-card"><strong>3</strong><p>Write <span class="math-render">$y &bsol;times y &bsol;times y$</span> using an index.</p></div>
						</div>
						<button type="button" class="primary-button" data-toggle-target="exit-samples">Show sample answers</button>
						<div id="exit-samples" class="sample-answer hidden-answer">
							<p><strong>1.</strong> <span class="math-render">$4x$</span> means <span class="math-render">$4 &bsol;times x$</span>.</p>
							<p><strong>2.</strong> <span class="math-render">$3(5) + 1 = 15 + 1 = 16$</span>.</p>
							<p><strong>3.</strong> <span class="math-render">$y &bsol;times y &bsol;times y = y^3$</span>.</p>
						</div>
					</article>
				</section>
			</div>

			<div class="deck-controls">
				<button type="button" class="secondary-button" data-prev-slide>Back</button>
				<button type="button" class="teacher-note-button" data-teacher-notes-toggle>Teacher Notes</button>
				<button type="button" class="secondary-button" data-reset-slide>Reset Slide</button>
				<button type="button" class="primary-button" data-next-slide>Next</button>
			</div>

			<aside class="teacher-notes" data-teacher-notes hidden>
				<div class="teacher-notes-card">
					<div class="teacher-notes-head">
						<strong>Teacher Notes</strong>
						<button type="button" data-teacher-notes-close aria-label="Close teacher notes">×</button>
					</div>
					<p data-teacher-notes-text>Use this slide to set the learning target clearly.</p>
				</div>
			</aside>
		</section>
	</main>
</Layout>

<script is:inline>
	window.MathJax = {
		tex: {
			inlineMath: [['$', '$']],
			displayMath: [['$$', '$$']],
			processEscapes: false
		},
		svg: { fontCache: 'global' },
		startup: { typeset: false }
	};
</script>
<script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>

<style>
	:global(body) {
		overflow: hidden !important;
	}

	:global(.site-header),
	:global(.site-footer),
	:global(.floating-whatsapp),
	:global(.whatsapp-float) {
		display: none !important;
	}

	.lesson-page {
		position: fixed;
		inset: 0;
		z-index: 10000;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
		background:
			radial-gradient(circle at 8% 10%, rgba(62, 182, 234, 0.22), transparent 28rem),
			radial-gradient(circle at 92% 90%, rgba(242, 118, 30, 0.18), transparent 28rem),
			#fffaf4;
	}

	.lesson-shell {
		width: 100%;
		height: 100%;
		padding: 12px;
		display: grid;
		grid-template-rows: 78px 12px minmax(0, 1fr) 68px;
		gap: 10px;
		box-sizing: border-box;
		font-family: inherit;
		color: #23304d;
	}

	.lesson-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 10px 16px;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid rgba(43, 53, 77, 0.12);
		border-radius: 20px;
		box-shadow: 0 16px 40px rgba(30, 41, 59, 0.08);
	}

	.lesson-topbar-left {
		min-width: 0;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		margin: 0 0 4px;
		font-size: 0.85rem;
		line-height: 1;
		font-weight: 900;
		color: #2b5b76;
		text-decoration: none;
	}

	.eyebrow,
	.mini-kicker {
		margin: 0 0 5px;
		font-size: 0.72rem;
		font-weight: 950;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: #f2761e;
	}

	.lesson-topbar h1 {
		margin: 0;
		font-size: clamp(1.35rem, 2vw, 2.2rem);
		line-height: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: #23304d;
	}

	.lesson-topbar-right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 8px;
		flex-wrap: wrap;
	}

	.objective-pill,
	.mode-toggle,
	.fullscreen-toggle,
	.score-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 8px 14px;
		border-radius: 999px;
		font-weight: 950;
		font-size: 0.92rem;
		border: 0;
		white-space: nowrap;
	}

	.objective-pill,
	.fullscreen-toggle,
	.score-pill {
		background: #23304d;
		color: #ffffff;
	}

	.mode-toggle,
	.primary-button {
		background: #f2761e;
		color: #ffffff;
	}

	button {
		font: inherit;
		cursor: pointer;
	}

	button:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.progress-area {
		margin: 0;
		padding: 0;
		background: transparent;
	}

	.progress-meta {
		display: none;
	}

	.progress-track {
		height: 12px;
		background: rgba(35, 48, 77, 0.12);
		border-radius: 999px;
		overflow: hidden;
	}

	.progress-track span {
		display: block;
		height: 100%;
		width: 8.3%;
		background: linear-gradient(90deg, #f2761e, #3eb6ea);
		border-radius: inherit;
		transition: width 0.25s ease;
	}

	.deck-layout {
		height: 100%;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(116px, 10.5vw) minmax(0, 1fr);
		gap: 10px;
		align-items: stretch;
	}

	.slide-map {
		height: 100%;
		min-height: 0;
		overflow: hidden;
		display: grid;
		gap: 5px;
		align-content: start;
		padding: 8px;
		background: rgba(255, 255, 255, 0.88);
		border: 1px solid rgba(43, 53, 77, 0.1);
		border-radius: 18px;
		box-shadow: 0 18px 50px rgba(30, 41, 59, 0.08);
	}

	.slide-dot {
		display: flex;
		align-items: center;
		gap: 6px;
		width: 100%;
		height: min(5vh, 39px);
		min-height: 0;
		padding: 5px 7px;
		border: 1px solid transparent;
		border-radius: 12px;
		background: transparent;
		color: #46536b;
		font-weight: 900;
		font-size: clamp(0.6rem, 0.75vw, 0.78rem);
		line-height: 1.05;
		text-align: left;
	}

	.slide-dot span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 23px;
		height: 23px;
		border-radius: 50%;
		background: rgba(35, 48, 77, 0.1);
