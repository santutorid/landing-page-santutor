<script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>

<script is:inline type="text/javascript">
// @ts-nocheck
	(() => {
		const root = document.querySelector('[data-lesson-root]');
		if (!root) return;

		const BS = String.fromCharCode(92);
		const setMathText = (scope = root) => {
			scope.querySelectorAll('[data-tex]').forEach((node) => {
				const tex = node.getAttribute('data-tex') || '';
				node.textContent = BS + '(' + tex + BS + ')';
			});
		};
		const renderMath = (scope = root) => {
			setMathText(scope);
			if (window.MathJax && typeof window.MathJax.typesetPromise === 'function') {
				window.MathJax.typesetClear?.([scope]);
				window.MathJax.typesetPromise([scope]).catch(() => {});
			}
		};
		setMathText(root);
		let mathTries = 0;
		const waitForMath = () => {
			mathTries += 1;
			if (window.MathJax && typeof window.MathJax.typesetPromise === 'function') renderMath(root);
			else if (mathTries < 30) window.setTimeout(waitForMath, 180);
		};
		waitForMath();

		const slides = Array.from(root.querySelectorAll('[data-slide]'));
		const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
		const progressLabel = root.querySelector('[data-progress-label]');
		const progressBar = root.querySelector('[data-progress-bar]');
		const nextButton = root.querySelector('[data-next-slide]');
		const prevButton = root.querySelector('[data-prev-slide]');
		const resetSlideButton = root.querySelector('[data-reset-slide]');
		const totalScoreButton = root.querySelector('[data-total-score]');
		const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
		const teacherNotes = root.querySelector('[data-teacher-notes]');
		const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
		const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
		const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');

		let currentSlide = 0;
		let totalScore = 0;
		let raceTimer = null;
		const notes = [
			'Set the purpose: factorising reverses expanding brackets.',
			'Use the shepherd story as a warm-up only. The goal is for students to feel the idea of equal groups before seeing x-tiles.',
			'Use this as the algebra visual. Students should connect 6 chickens + 9 ducks to 6x + 9, then discover three groups of 2x + 3.',
			'Emphasise highest common factor, not just any common factor.',
			'Reveal one step at a time. Ask students to predict before each reveal.',
			'Ask students to justify the option by multiplying the bracket back out.',
			'Use this to target common errors: not dividing every term, using a common factor that is not highest, and sign mistakes.',
			'Use as a short energiser. Teams solve first, then reveal answers.',
			'Exit ticket should be done individually in notebooks.'
		];

		const updateTotalScore = (points) => {
			totalScore += points;
			if (totalScoreButton) totalScoreButton.textContent = 'Score ' + totalScore;
		};

		const updateSlide = (index) => {
			currentSlide = Math.max(0, Math.min(index, slides.length - 1));
			slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === currentSlide));
			dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === currentSlide));
			if (progressLabel) progressLabel.textContent = 'Slide ' + (currentSlide + 1) + ' of ' + slides.length;
			if (progressBar) progressBar.style.width = (((currentSlide + 1) / slides.length) * 100) + '%';
			if (prevButton) prevButton.disabled = currentSlide === 0;
			if (nextButton) nextButton.textContent = currentSlide === slides.length - 1 ? 'Finish' : 'Next';
			if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || '';
			renderMath(slides[currentSlide]);
		};

		dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
		nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
		prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));

		const getFullscreenElement = () => document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement;
		const updateFullscreenButton = () => {
			if (!fullscreenButton) return;
			const isFullscreen = Boolean(getFullscreenElement());
			fullscreenButton.classList.toggle('is-active', isFullscreen);
			fullscreenButton.setAttribute('aria-pressed', String(isFullscreen));
			fullscreenButton.textContent = isFullscreen ? 'Exit Full Screen' : '⛶ Present Full Screen';
		};
		fullscreenButton?.addEventListener('click', async () => {
			try {
				if (getFullscreenElement()) {
					if (document.exitFullscreen) await document.exitFullscreen();
					else if (document.webkitExitFullscreen) await document.webkitExitFullscreen();
					else if (document.msExitFullscreen) await document.msExitFullscreen();
				} else {
					const target = document.querySelector('.factor-page') || root;
					if (target.requestFullscreen) await target.requestFullscreen();
					else if (target.webkitRequestFullscreen) await target.webkitRequestFullscreen();
					else if (target.msRequestFullscreen) await target.msRequestFullscreen();
				}
				updateFullscreenButton();
			} catch (error) {
				fullscreenButton.textContent = 'Fullscreen unavailable';
				fullscreenButton.disabled = true;
			}
		});
		document.addEventListener('fullscreenchange', updateFullscreenButton);
		document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
		document.addEventListener('MSFullscreenChange', updateFullscreenButton);

		teacherNotesToggle?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
		teacherNotesClose?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = true; });

		root.querySelectorAll('[data-toggle-target]').forEach((button) => {
			button.addEventListener('click', () => {
				const id = button.getAttribute('data-toggle-target') || '';
				const target = root.querySelector('#' + CSS.escape(id));
				if (target) {
					target.classList.toggle('is-visible');
					renderMath(target);
				}
			});
		});


		const setupShepherdGame = () => {
			const game = root.querySelector('[data-shepherd-game]');
			if (!game) return;

			const yard = game.querySelector('[data-animal-yard]');
			const animals = Array.from(game.querySelectorAll('[data-animal-id]'));
			const pens = Array.from(game.querySelectorAll('[data-animal-pen]'));
			const status = game.querySelector('[data-shepherd-status]');
			const result = game.querySelector('[data-shepherd-result]');
			const autoButton = game.querySelector('[data-shepherd-auto]');
			const resetButton = game.querySelector('[data-shepherd-reset]');
			let autoTimer = null;

			const target = { chicken: 2, duck: 3 };
			const label = { chicken: 'chicken', duck: 'duck' };
			const countText = (counts) => counts.chicken + '🐔 + ' + counts.duck + '🦆';

			const setStatus = (message) => {
				if (status) status.textContent = message;
			};

			const getCounts = (pen) => {
				const inPen = Array.from(pen.querySelectorAll('[data-animal-kind]'));
				return {
					chicken: inPen.filter((item) => item.getAttribute('data-animal-kind') === 'chicken').length,
					duck: inPen.filter((item) => item.getAttribute('data-animal-kind') === 'duck').length
				};
			};

			const updateCounts = () => {
				pens.forEach((pen) => {
					const counts = getCounts(pen);
					const counter = pen.querySelector('[data-animal-count]');
					if (counter) counter.textContent = countText(counts);
					pen.classList.toggle('is-ready', counts.chicken === target.chicken && counts.duck === target.duck);
				});
			};

			const isComplete = () => pens.every((pen) => {
				const counts = getCounts(pen);
				return counts.chicken === target.chicken && counts.duck === target.duck;
			});

			const findPen = (kind) => {
				return pens.find((pen) => getCounts(pen)[kind] < target[kind]) || null;
			};

			const showComplete = () => {
				if (!isComplete()) return;
				if (result) result.classList.add('is-visible');
				setStatus('Solved: 6 chickens and 9 ducks make 3 equal pens. One pen has 2 chickens and 3 ducks.');
				renderMath(game);
			};

			const moveAnimal = (animal) => {
				const kind = animal.getAttribute('data-animal-kind');
				if (!kind) return;
				const destination = findPen(kind);
				if (!destination) {
					setStatus('Every pen already has enough ' + label[kind] + 's. Try the other animal or reset.');
					return;
				}
				const area = destination.querySelector('.animal-area');
				if (!area) return;
				area.appendChild(animal);
				animal.classList.add('is-hopping');
				window.setTimeout(() => animal.classList.remove('is-hopping'), 280);
				updateCounts();
				const penNumber = destination.getAttribute('data-animal-pen') || '';
				setStatus('A ' + label[kind] + ' jumped into Pen ' + penNumber + '. Keep the pens identical.');
				showComplete();
			};

			const reset = () => {
				if (autoTimer) window.clearInterval(autoTimer);
				autoTimer = null;
				if (autoButton) autoButton.disabled = false;
				if (!yard) return;
				animals.forEach((animal) => {
					animal.classList.remove('is-hopping');
					yard.appendChild(animal);
				});
				if (result) result.classList.remove('is-visible');
				updateCounts();
				setStatus('Tap an animal to start. The aim is 3 identical pens.');
			};

			animals.forEach((animal) => {
				animal.addEventListener('click', () => {
					if (animal.closest('[data-animal-yard]')) moveAnimal(animal);
					else if (yard) {
						yard.appendChild(animal);
						if (result) result.classList.remove('is-visible');
						updateCounts();
						setStatus('Animal returned to the yard. Try making the pens identical again.');
					}
				});
			});

			autoButton?.addEventListener('click', () => {
				reset();
				if (autoButton) autoButton.disabled = true;
				const sequence = [
					...animals.filter((animal) => animal.getAttribute('data-animal-kind') === 'chicken'),
					...animals.filter((animal) => animal.getAttribute('data-animal-kind') === 'duck')
				];
				let index = 0;
				autoTimer = window.setInterval(() => {
					if (index >= sequence.length) {
						if (autoTimer) window.clearInterval(autoTimer);
						autoTimer = null;
						if (autoButton) autoButton.disabled = false;
						showComplete();
						return;
					}
					moveAnimal(sequence[index]);
					index += 1;
				}, 140);
			});

			resetButton?.addEventListener('click', reset);
			updateCounts();
		};

		const setupGroupingGame = () => {
			const game = root.querySelector('[data-grouping-game]');
			if (!game) return;

			const bank = game.querySelector('[data-tile-bank]');
			const tiles = Array.from(game.querySelectorAll('[data-tile-id]'));
			const drops = Array.from(game.querySelectorAll('[data-group-drop]'));
			const status = game.querySelector('[data-group-status]');
			const answer = game.querySelector('[data-group-answer]');
			let scored = false;

			const target = { x: 2, one: 3 };
			const kindLabel = { x: 'x-tile', one: 'unit tile' };

			const setStatus = (message) => {
				if (status) status.textContent = message;
			};

			const getCounts = (drop) => {
				const groupTiles = Array.from(drop.querySelectorAll('[data-kind]'));
				return {
					x: groupTiles.filter((tile) => tile.getAttribute('data-kind') === 'x').length,
					one: groupTiles.filter((tile) => tile.getAttribute('data-kind') === 'one').length
				};
			};

			const updateCounts = () => {
				drops.forEach((drop) => {
					const counts = getCounts(drop);
					const label = drop.querySelector('[data-count]');
					if (label) label.textContent = counts.x + 'x + ' + counts.one;
					const ready = counts.x === target.x && counts.one === target.one;
					drop.classList.toggle('is-ready', ready);
					drop.classList.toggle('needs-x', counts.x < target.x);
					drop.classList.toggle('needs-one', counts.one < target.one);
				});
			};

			const isComplete = () => drops.every((drop) => {
				const counts = getCounts(drop);
				return counts.x === target.x && counts.one === target.one;
			});

			const placedCount = (kind) => drops.reduce((total, drop) => {
				return total + getCounts(drop)[kind];
			}, 0);

			const findBestDrop = (kind) => {
				const openDrops = drops.filter((drop) => getCounts(drop)[kind] < target[kind]);
				if (openDrops.length === 0) return null;
				return openDrops.sort((a, b) => {
					const aCounts = getCounts(a);
					const bCounts = getCounts(b);
					if (aCounts[kind] !== bCounts[kind]) return aCounts[kind] - bCounts[kind];
					return Number(a.getAttribute('data-group-drop')) - Number(b.getAttribute('data-group-drop'));
				})[0];
			};

			const showResultIfComplete = () => {
				if (!isComplete()) return;
				if (answer) answer.classList.add('is-visible');
				game.classList.add('is-complete');
				setStatus('Complete: each group shows 2x + 3. The explanation is on the right, so the grouped tiles stay visible.');
				if (!scored) {
					updateTotalScore(6);
					scored = true;
				}
				renderMath(game);
			};

			const moveToGroup = (tile) => {
				const kind = tile.getAttribute('data-kind');
				if (!kind || !target[kind]) return;
				const destination = findBestDrop(kind);
				if (!destination) {
					setStatus('All groups already have enough ' + kindLabel[kind] + 's. Click Reset to try again.');
					return;
				}
				const area = destination.querySelector('.tile-area');
				if (!area) return;
				tile.classList.remove('is-selected');
				tile.classList.add('just-moved');
				area.appendChild(tile);
				window.setTimeout(() => tile.classList.remove('just-moved'), 260);
				updateCounts();

				const groupNumber = destination.getAttribute('data-group-drop') || '';
				const counts = getCounts(destination);
				setStatus('Placed one ' + kindLabel[kind] + ' into Group ' + groupNumber + '. That group now has ' + counts.x + 'x + ' + counts.one + '.');
				showResultIfComplete();
			};

			const returnToBank = (tile) => {
				if (!bank) return;
				tile.classList.remove('is-selected');
				bank.appendChild(tile);
				if (answer) answer.classList.remove('is-visible');
				game.classList.remove('is-complete');
				updateCounts();
				setStatus('Tile returned to the bank. Keep the three groups equal: each should be 2x + 3.');
			};

			tiles.forEach((tile) => {
				tile.addEventListener('click', () => {
					if (tile.closest('[data-tile-bank]')) {
						moveToGroup(tile);
					} else {
						returnToBank(tile);
					}
				});
			});

			game.querySelector('[data-check-groups]')?.addEventListener('click', () => {
				const allPlaced = tiles.every((tile) => Boolean(tile.closest('[data-group-drop]')));
				if (allPlaced && isComplete()) {
					showResultIfComplete();
				} else if (!allPlaced) {
					setStatus('Some tiles are still in the bank. Keep clicking until all 6 x-tiles and 9 unit tiles are grouped.');
				} else {
					setStatus('Not equal yet. Each group must contain exactly 2x + 3. Click a placed tile to send it back to the bank.');
				}
			});

			game.querySelector('[data-auto-groups]')?.addEventListener('click', () => {
				if (!bank) return;
				if (answer) answer.classList.remove('is-visible');
				tiles.forEach((tile) => bank.appendChild(tile));
				updateCounts();
				const xTiles = tiles.filter((tile) => tile.getAttribute('data-kind') === 'x');
				const oneTiles = tiles.filter((tile) => tile.getAttribute('data-kind') === 'one');
				drops.forEach((drop, index) => {
					const area = drop.querySelector('.tile-area');
					if (!area) return;
					xTiles.slice(index * 2, index * 2 + 2).forEach((tile) => area.appendChild(tile));
					oneTiles.slice(index * 3, index * 3 + 3).forEach((tile) => area.appendChild(tile));
				});
				updateCounts();
				game.classList.add('is-complete');
				if (answer) answer.classList.add('is-visible');
				setStatus('Auto demo: 6x and 9 can both be divided into 3 equal groups. One group is 2x + 3.');
				renderMath(game);
			});

			game.querySelector('[data-reset-groups]')?.addEventListener('click', () => {
				if (!bank) return;
				tiles.forEach((tile) => {
					tile.classList.remove('is-selected', 'just-moved');
					bank.appendChild(tile);
				});
				if (answer) answer.classList.remove('is-visible');
				scored = false;
				updateCounts();
				setStatus('Click an x-tile or a unit tile to start filling the equal groups.');
			});

			updateCounts();
		};

		const makeOption = (option, optionIndex, onSelect) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'option-card';
			if (option.tex) button.classList.add('math-option');
			button.setAttribute('aria-label', 'Option ' + String.fromCharCode(65 + optionIndex) + ': ' + option.label);
			const letter = document.createElement('span');
			letter.className = 'option-letter';
			letter.textContent = String.fromCharCode(65 + optionIndex);
			const content = document.createElement('span');
			content.className = 'option-content';
			if (option.tex) {
				const math = document.createElement('span');
				math.className = 'mathjax';
				math.setAttribute('data-tex', option.label);
				content.appendChild(math);
			} else {
				content.textContent = option.label;
			}
			button.append(letter, content);
			button.addEventListener('click', () => onSelect(button, option));
			return button;
		};

		const setupChoiceGame = (key, items, settings) => {
			const area = root.querySelector('[data-choice-game="' + key + '"]');
			if (!area) return;
			const prompt = area.querySelector('[data-prompt]');
			const optionsBox = area.querySelector('[data-options]');
			const feedback = area.querySelector('[data-feedback]');
			const round = area.querySelector('[data-round]');
			const scoreEl = area.querySelector('[data-score]');
			const next = area.querySelector('[data-next-round]');
			const reset = area.querySelector('[data-reset-game]');
			let index = 0;
			let score = 0;
			let answered = false;
			const render = () => {
				const item = items[index];
				answered = false;
				if (round) round.textContent = settings.roundPrefix + ' ' + (index + 1) + ' / ' + items.length;
				if (scoreEl) scoreEl.textContent = String(score);
				if (feedback) feedback.textContent = settings.defaultFeedback;
				if (prompt) prompt.setAttribute('data-tex', item.prompt);
				if (next) next.textContent = index === items.length - 1 ? 'Finish game' : settings.nextLabel;
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => {
						optionsBox.appendChild(makeOption(option, optionIndex, (button, selected) => {
							if (answered) return;
							answered = true;
							const correct = selected.label === item.answer;
							button.classList.add(correct ? 'is-correct' : 'is-wrong');
							Array.from(optionsBox.querySelectorAll('.option-card')).forEach((card) => { card.disabled = true; });
							if (feedback) feedback.textContent = correct ? item.correctFeedback : item.wrongFeedback;
							if (correct) {
								score += settings.points;
								if (scoreEl) scoreEl.textContent = String(score);
								updateTotalScore(settings.points);
							}
						}));
					});
				}
				renderMath(area);
			};
			next?.addEventListener('click', () => {
				if (index >= items.length - 1) {
					if (feedback) feedback.textContent = 'Game complete. Reset to play again.';
					return;
				}
				index += 1;
				render();
			});
			reset?.addEventListener('click', () => {
				index = 0;
				score = 0;
				render();
			});
			render();
		};

		const setupSteps = () => {
			const area = root.querySelector('[data-step-reveal]');
			if (!area) return;
			const steps = Array.from(area.querySelectorAll('[data-step]'));
			const next = area.querySelector('[data-next-step]');
			const reset = area.querySelector('[data-reset-steps]');
			let visible = 0;
			const render = () => {
				steps.forEach((step, stepIndex) => step.classList.toggle('is-visible', stepIndex <= visible));
				if (next) next.disabled = visible >= steps.length - 1;
				renderMath(area);
			};
			next?.addEventListener('click', () => { visible = Math.min(visible + 1, steps.length - 1); render(); });
			reset?.addEventListener('click', () => { visible = 0; render(); });
			render();
		};

		const setupRace = () => {
			const area = root.querySelector('[data-race-game]');
			if (!area) return;

			const time = area.querySelector('[data-race-time]');
			const roundEl = area.querySelector('[data-race-round]');
			const status = area.querySelector('[data-race-status]');
			const start = area.querySelector('[data-race-start]');
			const next = area.querySelector('[data-race-next]');
			const reset = area.querySelector('[data-race-reset]');
			const teamCards = Array.from(area.querySelectorAll('[data-team-card]'));

			let remaining = 60;
			let round = 1;
			const maxRounds = 10;
			const teamScores = { A: 0, B: 0, C: 0, D: 0, E: 0, F: 0 };

			const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
			const randomOutsideFactor = () => {
				const factors = [-9, -8, -7, -6, -5, -4, -3, -2, 2, 3, 4, 5, 6, 7, 8, 9];
				return factors[randInt(0, factors.length - 1)];
			};
			const randomInsideNumber = () => {
				const values = [-6, -5, -4, -3, -2, 2, 3, 4, 5, 6];
				return values[randInt(0, values.length - 1)];
			};
			const latexTerm = (coefficient, variable = 'x') => {
				if (coefficient === 1) return variable;
				if (coefficient === -1) return '-' + variable;
				return String(coefficient) + variable;
			};
			const latexExpression = (xCoefficient, constant) => {
				const first = latexTerm(xCoefficient);
				const second = constant >= 0 ? ' + ' + constant : ' - ' + Math.abs(constant);
				return first + second;
			};
			const makeQuestion = () => {
				const outside = randomOutsideFactor();
				const insideX = randomInsideNumber();
				const insideConstant = randomInsideNumber();
				const expression = latexExpression(outside * insideX, outside * insideConstant);
				const inside = latexExpression(insideX, insideConstant);
				const outsideText = outside < 0 ? String(outside) : String(outside);
				const answer = outsideText + '(' + inside + ')';
				return { expression, answer, outside };
			};

			const setStatus = (message) => {
				if (status) status.textContent = message;
			};

			const renderTimer = () => {
				if (time) time.textContent = String(remaining);
				if (roundEl) roundEl.textContent = String(round);
			};

			const stopTimer = () => {
				if (raceTimer) window.clearInterval(raceTimer);
				raceTimer = null;
			};

			const updateTeamScores = () => {
				teamCards.forEach((card) => {
					const team = card.getAttribute('data-team-card') || '';
					const score = card.querySelector('[data-team-score]');
					if (score) score.textContent = String(teamScores[team] || 0);
				});
			};

			const generateRound = () => {
				teamCards.forEach((card) => {
					const question = makeQuestion();
					const expression = card.querySelector('[data-race-expression]');
					const answer = card.querySelector('[data-race-answer]');
					if (expression) expression.setAttribute('data-tex', question.expression);
					if (answer) {
						answer.innerHTML = 'Answer: <span class="mathjax" data-tex="' + question.answer.replaceAll('"', '&quot;') + '"></span>';
						answer.hidden = true;
					}
				});
				setStatus('Round ' + round + ': factorise the expression for your team. Outside factor is randomly chosen from -9 to 9, excluding -1, 0, and 1.');
				renderMath(area);
			};

			start?.addEventListener('click', () => {
				if (raceTimer) return;
				if (remaining <= 0) remaining = 60;
				renderTimer();
				setStatus('Timer started. Teams solve their expressions. When time is up, reveal answers and add scores manually.');
				raceTimer = window.setInterval(() => {
					remaining = Math.max(0, remaining - 1);
					renderTimer();
					if (remaining === 0) {
						stopTimer();
						setStatus('Time is up. Teacher checks answers, reveals if needed, and taps + Score for correct teams.');
					}
				}, 1000);
			});

			next?.addEventListener('click', () => {
				stopTimer();
				if (round >= maxRounds) {
					setStatus('Game finished after 10 rounds. Check the team scores to choose the winner.');
					return;
				}
				round += 1;
				remaining = 60;
				renderTimer();
				generateRound();
			});

			reset?.addEventListener('click', () => {
				stopTimer();
				remaining = 60;
				round = 1;
				Object.keys(teamScores).forEach((team) => { teamScores[team] = 0; });
				updateTeamScores();
				renderTimer();
				generateRound();
			});

			teamCards.forEach((card) => {
				const team = card.getAttribute('data-team-card') || '';
				const reveal = card.querySelector('[data-reveal-answer]');
				const add = card.querySelector('[data-add-score]');
				const answer = card.querySelector('[data-race-answer]');
				reveal?.addEventListener('click', () => {
					if (!answer) return;
					answer.hidden = !answer.hidden;
					renderMath(card);
				});
				add?.addEventListener('click', () => {
					teamScores[team] = (teamScores[team] || 0) + 1;
					updateTeamScores();
					updateTotalScore(1);
					setStatus('Added 1 point to Team ' + team + '. Use Next round for a new random set.');
				});
			});

			renderTimer();
			updateTeamScores();
			generateRound();
		};

		setupShepherdGame();
		setupGroupingGame();
		setupSteps();
		setupRace();

		setupChoiceGame('hcf', [
			{ prompt: '8x + 12', answer: '4', options: [{ label: '2', tex: true }, { label: '4', tex: true }, { label: '8', tex: true }, { label: '12', tex: true }], correctFeedback: 'Yes. 4 is the highest common factor of 8 and 12.', wrongFeedback: 'Choose the greatest number that divides both coefficients.' },
			{ prompt: '10a + 15', answer: '5', options: [{ label: '2', tex: true }, { label: '3', tex: true }, { label: '5', tex: true }, { label: '10', tex: true }], correctFeedback: 'Yes. The HCF of 10 and 15 is 5.', wrongFeedback: 'Find the greatest factor shared by 10 and 15.' },
			{ prompt: '6m - 9', answer: '3', options: [{ label: '2', tex: true }, { label: '3', tex: true }, { label: '6', tex: true }, { label: '9', tex: true }], correctFeedback: 'Yes. 3 divides both 6 and 9.', wrongFeedback: 'The outside factor must divide both terms.' },
			{ prompt: '4x^2 + 8x', answer: '4x', options: [{ label: '4', tex: true }, { label: 'x', tex: true }, { label: '4x', tex: true }, { label: '8x', tex: true }], correctFeedback: 'Yes. Both terms share 4 and x.', wrongFeedback: 'Look for the numerical factor and the letter factor.' },
			{ prompt: '15p + 25', answer: '5', options: [{ label: '3', tex: true }, { label: '5', tex: true }, { label: '10', tex: true }, { label: '15', tex: true }], correctFeedback: 'Yes. 5 divides both 15 and 25.', wrongFeedback: 'Choose a factor that divides both coefficients.' }
		], { roundPrefix: 'Round', nextLabel: 'Next round', defaultFeedback: 'Choose the greatest factor shared by both terms.', points: 2 });

		setupChoiceGame('factory', [
			{ prompt: '10x + 15', answer: '5(2x + 3)', options: [{ label: '5(2x + 3)', tex: true }, { label: '10(x + 5)', tex: true }, { label: '2(5x + 15)', tex: true }, { label: '5(2x + 15)', tex: true }], correctFeedback: 'Good. 10x ÷ 5 = 2x and 15 ÷ 5 = 3.', wrongFeedback: 'Divide every term by the HCF and check by expanding.' },
			{ prompt: '12a + 16', answer: '4(3a + 4)', options: [{ label: '2(6a + 8)', tex: true }, { label: '4(3a + 4)', tex: true }, { label: '4(12a + 16)', tex: true }, { label: '8(a + 2)', tex: true }], correctFeedback: 'Good. 4 is the HCF.', wrongFeedback: 'The factor outside should be the HCF.' },
			{ prompt: '9m - 6', answer: '3(3m - 2)', options: [{ label: '3(3m - 2)', tex: true }, { label: '3(3m + 2)', tex: true }, { label: '6(3m - 1)', tex: true }, { label: '9(m - 6)', tex: true }], correctFeedback: 'Good. 9m ÷ 3 = 3m and -6 ÷ 3 = -2.', wrongFeedback: 'Watch the minus sign and divide both terms.' },
			{ prompt: '14x + 21', answer: '7(2x + 3)', options: [{ label: '2(7x + 21)', tex: true }, { label: '7(2x + 3)', tex: true }, { label: '7(14x + 3)', tex: true }, { label: '3(2x + 7)', tex: true }], correctFeedback: 'Good. The HCF is 7.', wrongFeedback: 'Expand the option to check it returns the original expression.' },
			{ prompt: '6y + 18', answer: '6(y + 3)', options: [{ label: '6(y + 3)', tex: true }, { label: '3(2y + 18)', tex: true }, { label: '6(y + 18)', tex: true }, { label: '2(3y + 6)', tex: true }], correctFeedback: 'Good. 6 is the HCF.', wrongFeedback: 'The bracket must contain each term divided by the HCF.' }
		], { roundPrefix: 'Job', nextLabel: 'Next job', defaultFeedback: 'Use the HCF, then divide every term.', points: 3 });

		setupChoiceGame('detective', [
			{ prompt: '8x + 12 = 2(4x + 10)', answer: 'The 12 was not divided by 2 correctly.', options: [{ label: 'The 12 was not divided by 2 correctly.' }, { label: 'The coefficient of x disappeared.' }, { label: 'The expression should not have brackets.' }, { label: 'The sign should change to minus.' }], correctFeedback: 'Yes. If 2 is outside, 12 ÷ 2 should be 6, not 10.', wrongFeedback: 'Check each term by dividing it by the outside factor.' },
			{ prompt: '12a + 18 = 3(4a + 6)', answer: 'It is correct but not fully factorised.', options: [{ label: 'It is correct but not fully factorised.' }, { label: 'The expression was expanded instead.' }, { label: 'The bracket should contain 12a.' }, { label: 'The outside factor must be 18.' }], correctFeedback: 'Yes. It expands correctly, but the HCF is 6.', wrongFeedback: 'Expand first, then check if the outside factor is the HCF.' },
			{ prompt: '6x - 9 = 3(2x + 3)', answer: 'The sign inside the bracket is wrong.', options: [{ label: 'The sign inside the bracket is wrong.' }, { label: 'The HCF should be 9.' }, { label: 'The variable x should be outside.' }, { label: 'The 6 was divided incorrectly.' }], correctFeedback: 'Yes. -9 ÷ 3 = -3, so it should be 3(2x - 3).', wrongFeedback: 'Look closely at the sign of the second term.' }
		], { roundPrefix: 'Mistake', nextLabel: 'Next mistake', defaultFeedback: 'Choose the best explanation.', points: 3 });

		const resetCurrentSlide = () => {
			const slide = slides[currentSlide];
			if (!slide) return;
			slide.querySelectorAll('.hidden-answer.is-visible').forEach((item) => item.classList.remove('is-visible'));
			slide.querySelectorAll('.option-card').forEach((button) => {
				button.classList.remove('is-correct', 'is-wrong');
			});
		};
		resetSlideButton?.addEventListener('click', resetCurrentSlide);

		root.addEventListener('keydown', (event) => {
			const target = event.target;
			if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
			if (event.key === 'ArrowRight') updateSlide(currentSlide + 1);
			if (event.key === 'ArrowLeft') updateSlide(currentSlide - 1);
		});

		updateSlide(0);
		updateFullscreenButton();
	})();
</script>
