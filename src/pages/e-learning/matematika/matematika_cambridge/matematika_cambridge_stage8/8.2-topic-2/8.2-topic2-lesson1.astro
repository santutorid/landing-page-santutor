<script is:inline type="text/javascript">
	// @ts-nocheck
	const root = document.querySelector('[data-lesson-root]');

	if (root) {
		const slides = Array.from(root.querySelectorAll('[data-slide]'));
		const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
		const progressLabel = root.querySelector('[data-progress-label]');
		const progressBar = root.querySelector('[data-progress-bar]');
		const nextButton = root.querySelector('[data-next-slide]');
		const prevButton = root.querySelector('[data-prev-slide]');
		const resetSlideButton = root.querySelector('[data-reset-slide]');
		const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
		const fullscreenTarget = document.querySelector('.ifp-lesson-page.topic2-lesson1') || root;
		const teacherNotes = root.querySelector('[data-teacher-notes]');
		const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
		const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
		const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');
		const totalScore = root.querySelector('[data-total-score]');
		let currentSlide = 0;
		let scoreTotal = 0;
		let mathReady = false;

		root.querySelectorAll('.feedback-line[data-feedback], [data-builder-feedback]').forEach((item) => {
			item.dataset.defaultFeedbackText = item.textContent || '';
		});

		const notes = [
			'Set the goal: today students translate words into equations. Emphasise meaning before solving.',
			'Use the mystery box as an accessible hook. Do not solve yet; just ask what the unknown is.',
			'Use the balance simulator to solve. For x + 4 = 10, remove 1 from both sides. For 2x - 3 = 7, add 1 to both sides to cancel the negative tiles, then split the x groups.',
			'Model the detective routine: unknown, operation, total, equation.',
			'Let one student build on the IFP. Discuss why 4x is used instead of x4 or 4 + x.',
			'Ask students to justify why each wrong equation does not match the story.',
			'Push reverse thinking: the same equation can be read as a story.',
			'Use as a quick whiteboard round. Generate a new story, let students write, then reveal.',
			'Focus on common translation mistakes: wrong operation, missing coefficient, and confusing total with unknown.',
			'Use the exit ticket as notebook work. Reveal sample answers only after students attempt it.'
		];

		const updateTotalScore = (points) => {
			scoreTotal += points;
			if (totalScore) totalScore.textContent = String(scoreTotal);
		};

		const waitForMathJax = (callback) => {
			let attempts = 0;
			const check = () => {
				attempts += 1;
				if (window.MathJax && window.MathJax.tex2chtmlPromise) {
					mathReady = true;
					callback();
				} else if (attempts < 80) {
					window.setTimeout(check, 100);
				}
			};
			check();
		};

		const renderMath = (container = root) => {
			if (!mathReady || !window.MathJax || !window.MathJax.tex2chtmlPromise) return;
			const elements = Array.from(container.querySelectorAll('.mathjax'));
			elements.forEach((element) => {
				const tex = element.getAttribute('data-tex') || '';
				if (!tex) return;
				window.MathJax.tex2chtmlPromise(tex, { display: false }).then((node) => {
					element.replaceChildren(node);
					element.classList.add('is-rendered');
					if (window.MathJax.startup && window.MathJax.startup.document) {
						window.MathJax.startup.document.clear();
						window.MathJax.startup.document.updateDocument();
					}
				}).catch(() => {});
			});
		};

		const updateSlide = (index) => {
			currentSlide = Math.max(0, Math.min(index, slides.length - 1));
			slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === currentSlide));
			dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === currentSlide));
			if (progressLabel) progressLabel.textContent = `Slide ${currentSlide + 1} of ${slides.length}`;
			if (progressBar) progressBar.style.width = `${((currentSlide + 1) / slides.length) * 100}%`;
			if (prevButton) prevButton.disabled = currentSlide === 0;
			if (nextButton) nextButton.textContent = currentSlide === slides.length - 1 ? 'Finish' : 'Next';
			if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || '';
			renderMath(slides[currentSlide]);
		};

		dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
		nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
		prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));

		fullscreenButton?.addEventListener('click', async () => {
			try {
				if (document.fullscreenElement) {
					await document.exitFullscreen();
				} else if (fullscreenTarget.requestFullscreen) {
					await fullscreenTarget.requestFullscreen();
				}
			} catch (error) {}
		});

		const updateFullscreenButton = () => {
			if (!fullscreenButton) return;
			const active = Boolean(document.fullscreenElement);
			fullscreenButton.classList.toggle('is-active', active);
			fullscreenButton.textContent = active ? 'Exit Full Screen' : '⛶ Present Full Screen';
		};
		document.addEventListener('fullscreenchange', updateFullscreenButton);

		teacherNotesToggle?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
		teacherNotesClose?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = true; });

		root.querySelectorAll('[data-toggle-target]').forEach((button) => {
			button.addEventListener('click', () => {
				const id = button.getAttribute('data-toggle-target') || '';
				const target = root.querySelector('#' + CSS.escape(id));
				if (target) {
					target.classList.toggle('is-visible');
					renderMath(target);
				}
			});
		});

		const setupStaticQuizzes = () => {
			root.querySelectorAll('[data-static-quiz]').forEach((quiz) => {
				const feedback = quiz.parentElement?.querySelector('.feedback-line[data-feedback]');
				const buttons = Array.from(quiz.querySelectorAll('.option-card'));
				buttons.forEach((button) => {
					button.addEventListener('click', () => {
						buttons.forEach((item) => item.classList.remove('is-correct', 'is-wrong'));
						const correct = button.dataset.correct === 'true';
						button.classList.add(correct ? 'is-correct' : 'is-wrong');
						if (feedback) feedback.textContent = button.dataset.optionFeedback || '';
						if (correct && !button.dataset.scored) {
							button.dataset.scored = 'true';
							updateTotalScore(1);
						}
					});
				});
			});
		};

		const setupBalance = () => {
			const game = root.querySelector('[data-balance-game]');
			if (!game) return;

			const title = game.querySelector('[data-balance-title]');
			const message = game.querySelector('[data-balance-message]');
			const statusBox = game.querySelector('[data-status-box]');
			const statusLabel = game.querySelector('[data-status-label]');
			const leftPan = game.querySelector('[data-balance-pan="left"]');
			const rightPan = game.querySelector('[data-balance-pan="right"]');
			const stage = game.querySelector('[data-scale-stage]');
			const leftLabel = game.querySelector('[data-left-label]');
			const rightLabel = game.querySelector('[data-right-label]');
			const output = game.querySelector('[data-solution-output]');
			const solutionCard = game.querySelector('.solve-control-card');
			const examples = Array.from(game.querySelectorAll('[data-example]'));

			const problems = [
				{ left: { x: 1, c: 4 }, right: { x: 0, c: 10 }, answer: 6, hint: 'Start balanced. Remove 1 from the left and right four times to isolate x.' },
				{ left: { x: 2, c: -3 }, right: { x: 0, c: 7 }, answer: 5, hint: 'The red block is negative. Add 1 to both sides three times, then split the x groups.' },
				{ left: { x: 2, c: 2 }, right: { x: 1, c: 8 }, answer: 6, hint: 'Remove x from both sides first, then remove 1 from both sides.' }
			];

			let problemIndex = 0;
			let state = {
				left: { ...problems[0].left },
				right: { ...problems[0].right }
			};

			const cloneProblem = (problem) => ({
				left: { ...problem.left },
				right: { ...problem.right }
			});

			const formatNumber = (value) => Number.isInteger(value) ? String(value) : String(Math.round(value * 100) / 100);

			const formatSide = (side) => {
				const parts = [];
				if (side.x !== 0) {
					if (side.x === 1) parts.push('x');
					else if (side.x === -1) parts.push('-x');
					else parts.push(side.x + 'x');
				}
				if (side.c !== 0 || parts.length === 0) {
					if (parts.length && side.c > 0) parts.push('+ ' + formatNumber(side.c));
					else if (parts.length && side.c < 0) parts.push('- ' + formatNumber(Math.abs(side.c)));
					else parts.push(formatNumber(side.c));
				}
				return parts.join(' ');
			};

			const sideValue = (side) => side.x * problems[problemIndex].answer + side.c;

			const makeBlocks = (side) => {
				const blocks = [];
				if (side.x !== 0) {
					blocks.push({ type: side.x < 0 ? 'negative' : 'variable', text: side.x === 1 ? 'x' : side.x === -1 ? '-x' : side.x + 'x' });
				}
				if (side.c !== 0) {
					blocks.push({ type: side.c < 0 ? 'negative' : 'number', text: side.c > 0 ? formatNumber(side.c) : '-' + formatNumber(Math.abs(side.c)) });
				}
				if (blocks.length === 0) blocks.push({ type: 'zero-block', text: '0' });
				return blocks;
			};

			const renderPan = (pan, side) => {
				if (!pan) return;
				pan.innerHTML = '';
				makeBlocks(side).forEach((item, index) => {
					const block = document.createElement('span');
					block.className = 'scale-block ' + item.type;
					block.textContent = item.text;
					block.style.setProperty('--delay', String(Math.min(index * 40, 160)) + 'ms');
					pan.appendChild(block);
				});
			};

			const setTilt = (leftValue, rightValue) => {
				if (!stage) return;
				stage.classList.remove('left-heavy', 'right-heavy');
				if (leftValue > rightValue) stage.classList.add('left-heavy');
				if (rightValue > leftValue) stage.classList.add('right-heavy');
			};

			const updateSolution = (balanced) => {
				if (!output) return;
				solutionCard?.classList.remove('is-solved');
				const left = state.left;
				const right = state.right;
				if (!balanced) {
					output.textContent = 'Make both sides balanced again.';
					return;
				}
				if (left.x === 1 && left.c === 0 && right.x === 0) {
					output.innerHTML = '<span class="mathjax" data-tex="x = ' + formatNumber(right.c) + '"></span>';
					solutionCard?.classList.add('is-solved');
					renderMath(solutionCard || game);
					return;
				}
				if (right.x === 1 && right.c === 0 && left.x === 0) {
					output.innerHTML = '<span class="mathjax" data-tex="x = ' + formatNumber(left.c) + '"></span>';
					solutionCard?.classList.add('is-solved');
					renderMath(solutionCard || game);
					return;
				}
				if ((left.x > 1 && left.c === 0 && right.x === 0) || (right.x > 1 && right.c === 0 && left.x === 0)) {
					output.textContent = 'Now press Split x groups.';
					return;
				}
				output.textContent = 'Keep simplifying until one x is alone.';
			};

			const render = (customMessage) => {
				renderPan(leftPan, state.left);
				renderPan(rightPan, state.right);
				const leftText = formatSide(state.left);
				const rightText = formatSide(state.right);
				if (title) title.innerHTML = '<span class="mathjax" data-tex="' + leftText + ' = ' + rightText + '"></span>';
				if (leftLabel) leftLabel.textContent = leftText;
				if (rightLabel) rightLabel.textContent = rightText;

				const leftValue = sideValue(state.left);
				const rightValue = sideValue(state.right);
				const balanced = leftValue === rightValue;
				setTilt(leftValue, rightValue);

				if (statusBox) statusBox.classList.toggle('is-unbalanced', !balanced);
				if (statusLabel) statusLabel.textContent = balanced ? 'Balanced' : (leftValue > rightValue ? 'Left is heavier' : 'Right is heavier');
				if (message) {
					message.textContent = customMessage || (balanced ? problems[problemIndex].hint : 'Not balanced yet. Do the matching operation on the other side.');
				}
				updateSolution(balanced);
				renderMath(game);
			};

			const applySideOperation = (sideName, kind, delta) => {
				const side = state[sideName];
				if (!side) return;
				side[kind] += delta;
				const symbol = delta > 0 ? '+' : '-';
				const item = kind === 'x' ? 'x' : '1';
				render('You changed the ' + sideName + ' side by ' + symbol + item + '. If the scale tilts, do the same to the other side.');
			};

			const splitX = () => {
				const leftValue = sideValue(state.left);
				const rightValue = sideValue(state.right);
				if (leftValue !== rightValue) {
					render('Balance the scale first. You can split only when both sides are equal.');
					return;
				}
				if (state.left.x > 1 && state.left.c === 0 && state.right.x === 0) {
					const value = state.right.c / state.left.x;
					state.left.x = 1;
					state.right.c = value;
					render('The right side is shared equally between the x groups. Now one x is visible.');
					return;
				}
				if (state.right.x > 1 && state.right.c === 0 && state.left.x === 0) {
					const value = state.left.c / state.right.x;
					state.right.x = 1;
					state.left.c = value;
					render('The left side is shared equally between the x groups. Now one x is visible.');
					return;
				}
				render('Split is useful after the equation looks like 2x = 10 or 3x = 12.');
			};

			const loadProblem = (index) => {
				problemIndex = index;
				state = cloneProblem(problems[problemIndex]);
				examples.forEach((button, buttonIndex) => button.classList.toggle('is-selected', buttonIndex === problemIndex));
				render('New equation loaded. ' + problems[problemIndex].hint);
			};

			game.querySelectorAll('[data-side]').forEach((button) => {
				button.addEventListener('click', () => {
					const side = button.getAttribute('data-side');
					const kind = button.getAttribute('data-kind');
					const delta = Number(button.getAttribute('data-delta') || 0);
					if (!side || !kind || !Number.isFinite(delta)) return;
					applySideOperation(side, kind, delta);
				});
			});

			game.querySelector('[data-split-x]')?.addEventListener('click', splitX);
			game.querySelector('[data-reset-balance]')?.addEventListener('click', () => loadProblem(problemIndex));
			game.querySelector('[data-next-balance]')?.addEventListener('click', () => loadProblem((problemIndex + 1) % problems.length));
			examples.forEach((button) => {
				button.addEventListener('click', () => loadProblem(Number(button.getAttribute('data-example') || 0)));
			});

			render();
		};

		const setupDetective = () => {
			const game = root.querySelector('[data-detective-game]');
			if (!game) return;
			const chips = Array.from(game.querySelectorAll('[data-target]'));
			const infos = Array.from(game.querySelectorAll('[data-info]'));
			chips.forEach((chip) => {
				chip.addEventListener('click', () => {
					chips.forEach((item) => item.classList.remove('is-active'));
					chip.classList.add('is-active');
					infos.forEach((info) => info.classList.toggle('is-visible', info.dataset.info === chip.dataset.target));
					renderMath(game);
				});
			});
		};

		const setupBuilder = () => {
			const game = root.querySelector('[data-builder-game]');
			if (!game) return;
			const display = game.querySelector('[data-builder-display]');
			const feedback = game.querySelector('[data-builder-feedback]');
			let tokens = [];
			const render = () => {
				if (!display) return;
				if (tokens.length === 0) {
					display.textContent = 'Tap tiles to build...';
					display.classList.remove('has-equation');
					return;
				}
				display.classList.add('has-equation');
				display.innerHTML = '';
				const math = document.createElement('span');
				math.className = 'mathjax';
				math.setAttribute('data-tex', tokens.join(''));
				display.appendChild(math);
				renderMath(display);
			};
			game.querySelectorAll('[data-token]').forEach((button) => {
				button.addEventListener('click', () => {
					tokens.push(button.dataset.token || '');
					render();
				});
			});
			game.querySelector('[data-undo-builder]')?.addEventListener('click', () => { tokens.pop(); render(); });
			game.querySelector('[data-reset-builder]')?.addEventListener('click', () => { tokens = []; if (feedback) feedback.textContent = 'Expected structure: multiplication first, then subtraction, then equals the result.'; render(); });
			game.querySelector('[data-check-builder]')?.addEventListener('click', () => {
				const answer = tokens.join('');
				if (answer === '4x-3=21') {
					if (feedback) feedback.textContent = 'Correct. 4x means 4 times the number, then −3, and the result is 21.';
					updateTotalScore(3);
				} else if (feedback) {
					feedback.textContent = 'Not yet. Try to build 4x − 3 = 21.';
				}
			});
			render();
		};

		const makeOption = (option, optionIndex, onSelect) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'option-card';
			if (option.tex) button.classList.add('math-option');
			button.setAttribute('aria-label', 'Option ' + String.fromCharCode(65 + optionIndex) + ': ' + option.label);
			const letter = document.createElement('span');
			letter.className = 'option-letter';
			letter.textContent = String.fromCharCode(65 + optionIndex);
			const content = document.createElement('span');
			content.className = 'option-content';
			if (option.tex) {
				const math = document.createElement('span');
				math.className = 'mathjax';
				math.setAttribute('data-tex', option.label);
				content.appendChild(math);
			} else {
				content.textContent = option.label;
			}
			button.append(letter, content);
			button.addEventListener('click', () => onSelect(button, option));
			return button;
		};

		const setupChoiceGame = (key, items, settings) => {
			const area = root.querySelector('[data-choice-game="' + key + '"]');
			if (!area) return;
			const promptMath = area.querySelector('[data-prompt]');
			const promptText = area.querySelector('[data-prompt-text]');
			const optionsBox = area.querySelector('[data-options]');
			const feedback = area.querySelector('[data-feedback]');
			const round = area.querySelector('[data-round]');
			const scoreEl = area.querySelector('[data-score]');
			const next = area.querySelector('[data-next-round]');
			const reset = area.querySelector('[data-reset-game]');
			let index = 0;
			let score = 0;
			let answered = false;
			const render = () => {
				const item = items[index];
				answered = false;
				if (round) round.textContent = settings.roundPrefix + ' ' + (index + 1) + ' / ' + items.length;
				if (scoreEl) scoreEl.textContent = String(score);
				if (feedback) feedback.textContent = settings.defaultFeedback;
				if (promptMath) promptMath.setAttribute('data-tex', item.prompt);
				if (promptText) promptText.textContent = item.prompt;
				if (next) next.textContent = index === items.length - 1 ? 'Finish game' : settings.nextLabel;
				if (optionsBox) {
					optionsBox.innerHTML = '';
					item.options.forEach((option, optionIndex) => {
						optionsBox.appendChild(makeOption(option, optionIndex, (button, selected) => {
							if (answered) return;
							answered = true;
							const correct = selected.label === item.answer;
							button.classList.add(correct ? 'is-correct' : 'is-wrong');
							Array.from(optionsBox.querySelectorAll('.option-card')).forEach((card) => card.disabled = true);
							if (correct) {
								score += settings.points;
								updateTotalScore(settings.points);
								if (feedback) feedback.textContent = item.correctFeedback;
							} else if (feedback) {
								feedback.textContent = item.wrongFeedback;
							}
							if (scoreEl) scoreEl.textContent = String(score);
						}));
					});
				}
				renderMath(area);
			};
			next?.addEventListener('click', () => {
				index = Math.min(index + 1, items.length - 1);
				render();
			});
			reset?.addEventListener('click', () => {
				index = 0;
				score = 0;
				render();
			});
			render();
		};

		const setupBoardGame = () => {
			const game = root.querySelector('[data-board-game]');
			if (!game) return;
			const storyEl = game.querySelector('[data-board-story]');
			const equationEl = game.querySelector('[data-board-equation]');
			const stories = [
				{ story: 'A number plus 9 is 31.', equation: 'x + 9 = 31' },
				{ story: 'Three times a number is 27.', equation: '3x = 27' },
				{ story: 'A number divided by 5 is 8.', equation: 'x/5 = 8' },
				{ story: 'Seven less than a number is 14.', equation: 'x - 7 = 14' },
				{ story: 'Double a number, then add 6, gives 30.', equation: '2x + 6 = 30' },
				{ story: 'Four bags have the same number of marbles. With 3 extra marbles, there are 35 marbles.', equation: '4m + 3 = 35' }
			];
			let index = 0;
			const render = () => {
				const item = stories[index];
				if (storyEl) storyEl.textContent = item.story;
				if (equationEl) {
					equationEl.innerHTML = '<span class="mathjax" data-tex="' + item.equation + '"></span>';
					renderMath(equationEl);
				}
			};
			game.querySelector('[data-new-story]')?.addEventListener('click', () => {
				index = (index + 1) % stories.length;
				equationEl?.classList.remove('is-visible');
				render();
			});
			game.querySelector('[data-reveal-story]')?.addEventListener('click', () => { equationEl?.classList.add('is-visible'); renderMath(game); });
			game.querySelector('[data-hide-story]')?.addEventListener('click', () => equationEl?.classList.remove('is-visible'));
			render();
		};

		setupStaticQuizzes();
		setupBalance();
		setupDetective();
		setupBuilder();
		setupBoardGame();

		setupChoiceGame('story', [
			{ prompt: 'A number plus 6 is 18.', answer: 'x + 6 = 18', options: [{ label: 'x + 6 = 18', tex: true }, { label: '6x = 18', tex: true }, { label: 'x - 6 = 18', tex: true }, { label: 'x = 6 + 18', tex: true }], correctFeedback: 'Correct. “Plus 6” means add 6, and “is 18” means equals 18.', wrongFeedback: 'Look for the operation and the total.' },
			{ prompt: 'Five times a number is 40.', answer: '5n = 40', options: [{ label: 'n + 5 = 40', tex: true }, { label: '5n = 40', tex: true }, { label: 'n - 5 = 40', tex: true }, { label: '40n = 5', tex: true }], correctFeedback: 'Correct. Five times a number is 5n.', wrongFeedback: '“Times” means multiplication.' },
			{ prompt: 'A number divided by 3 is 12.', answer: 'x/3 = 12', options: [{ label: '3x = 12', tex: true }, { label: 'x + 3 = 12', tex: true }, { label: 'x/3 = 12', tex: true }, { label: '12/3 = x', tex: true }], correctFeedback: 'Correct. The unknown is divided by 3.', wrongFeedback: 'Focus on which value is being divided.' },
			{ prompt: 'A ticket costs 12 dollars. Some tickets cost 60 dollars in total.', answer: '12t = 60', options: [{ label: 't + 12 = 60', tex: true }, { label: '12t = 60', tex: true }, { label: '60t = 12', tex: true }, { label: 't - 12 = 60', tex: true }], correctFeedback: 'Correct. 12 multiplied by the number of tickets gives the total.', wrongFeedback: 'The unknown is the number of tickets.' }
		], { roundPrefix: 'Round', nextLabel: 'Next round', defaultFeedback: 'Choose the equation that matches the story.', points: 2 });

		setupChoiceGame('reverse', [
			{ prompt: '3n + 5 = 29', answer: 'Three notebooks cost the same price each. With 5 extra dollars, the total is 29 dollars.', options: [{ label: 'Three notebooks cost the same price each. With 5 extra dollars, the total is 29 dollars.' }, { label: 'A number plus 3 is 5, and the total is 29.' }, { label: 'Five notebooks plus 3 dollars cost 29 dollars.' }, { label: 'A number is divided by 3, then 5 is added.' }], correctFeedback: 'Correct. 3n means three equal amounts, then add 5.', wrongFeedback: 'Match 3n, +5, and =29.' },
			{ prompt: 'x - 8 = 17', answer: 'A number loses 8 and becomes 17.', options: [{ label: 'A number gains 8 and becomes 17.' }, { label: 'A number loses 8 and becomes 17.' }, { label: 'Eight times a number is 17.' }, { label: 'A number divided by 8 is 17.' }], correctFeedback: 'Correct. The minus sign means subtract 8.', wrongFeedback: 'Pay attention to the operation.' },
			{ prompt: 'p/4 = 9', answer: 'A total is shared equally into 4 groups. Each group has 9.', options: [{ label: 'A total is shared equally into 4 groups. Each group has 9.' }, { label: 'A number is multiplied by 4 to get 9.' }, { label: 'A number plus 4 is 9.' }, { label: 'Four is subtracted from a number to get 9.' }], correctFeedback: 'Correct. p/4 means the unknown total divided by 4.', wrongFeedback: 'A fraction bar means division.' }
		], { roundPrefix: 'Round', nextLabel: 'Next round', defaultFeedback: 'Look at the operation and the final total.', points: 2 });

		setupChoiceGame('error', [
			{ prompt: 'Story: A number plus 5 is 19. Student writes 5x = 19.', answer: 'The student used multiplication instead of addition.', options: [{ label: 'The student used multiplication instead of addition.' }, { label: 'The student forgot the total.' }, { label: 'The student used the wrong unknown letter.' }, { label: 'The equation should not have an equals sign.' }], correctFeedback: 'Correct. “Plus 5” should be x + 5, not 5x.', wrongFeedback: 'Look at the word “plus”.' },
			{ prompt: 'Story: 4 boxes have the same number of pencils. Total is 28. Student writes x + 4 = 28.', answer: 'The student used addition instead of 4 groups of x.', options: [{ label: 'The student used addition instead of 4 groups of x.' }, { label: 'The total should be 4.' }, { label: 'The unknown should be 28.' }, { label: 'The equation is already correct.' }], correctFeedback: 'Correct. Four equal boxes means 4x = 28.', wrongFeedback: 'Think about equal groups.' },
			{ prompt: 'Story: A number divided by 2 is 10. Student writes 2x = 10.', answer: 'The student multiplied by 2 instead of dividing by 2.', options: [{ label: 'The student multiplied by 2 instead of dividing by 2.' }, { label: 'The student should use plus.' }, { label: 'The total should be 2.' }, { label: 'The letter is not allowed.' }], correctFeedback: 'Correct. Divided by 2 should be x/2 = 10.', wrongFeedback: 'Watch the division phrase.' }
		], { roundPrefix: 'Mistake', nextLabel: 'Next mistake', defaultFeedback: 'Choose the best explanation.', points: 2 });

		const resetCurrentSlide = () => {
			const slide = slides[currentSlide];
			if (!slide) return;

			// Trigger each built-in game reset when the active slide has one.
			slide.querySelectorAll('[data-reset-balance], [data-reset-builder], [data-reset-game], [data-hide-story]').forEach((button) => {
				button.click();
			});

			// Reset static multiple-choice cards without changing their labels.
			slide.querySelectorAll('[data-static-quiz] .option-card').forEach((button) => {
				button.classList.remove('is-correct', 'is-wrong');
				button.disabled = false;
				delete button.dataset.scored;
			});

			// Reset revealed chips, detective panels, and sample answers.
			slide.querySelectorAll('.is-active').forEach((item) => item.classList.remove('is-active'));
			slide.querySelectorAll('.is-visible').forEach((item) => item.classList.remove('is-visible'));

			// Only reset actual feedback paragraphs. Never overwrite option cards.
			slide.querySelectorAll('.feedback-line[data-feedback], [data-builder-feedback]').forEach((line) => {
				line.textContent = line.dataset.defaultFeedbackText || 'Choose the best answer.';
			});

			renderMath(slide);
		};

		resetSlideButton?.addEventListener('click', resetCurrentSlide);

		root.addEventListener('keydown', (event) => {
			if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
			if (event.key === 'ArrowRight') updateSlide(currentSlide + 1);
			if (event.key === 'ArrowLeft') updateSlide(currentSlide - 1);
		});

		waitForMathJax(() => renderMath(root));
		updateSlide(0);
		updateFullscreenButton();
	}
</script>
