---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 1: From Words to Equations — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics 8Ae.06: represent situations in words and as equations.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	
<style is:global>
	/* Revised Slide 3: equation balance solver */
	.topic2-lesson1 .balance-solver {
		display: grid;
		grid-template-rows: auto minmax(260px, 1fr) auto;
		gap: 10px;
		flex: 1 1 auto;
		min-height: 0;
	}

	.topic2-lesson1 .solver-top-row {
		display: grid;
		grid-template-columns: minmax(270px, 0.6fr) minmax(0, 1fr);
		gap: 10px;
		align-items: stretch;
	}

	.topic2-lesson1 .equation-strip,
	.topic2-lesson1 .solver-message,
	.topic2-lesson1 .solution-panel {
		border-radius: 18px;
		border: 1px solid rgba(35,48,77,0.12);
		background: #ffffff;
		box-shadow: 0 8px 18px rgba(35,48,77,0.05);
	}

	.topic2-lesson1 .equation-strip {
		padding: 11px 14px;
		display: grid;
		gap: 4px;
		align-content: center;
		background: linear-gradient(135deg, #fff8ee, #f3fbff);
	}

	.topic2-lesson1 .equation-strip span,
	.topic2-lesson1 .solution-panel span {
		color: #f2761e;
		font-size: 0.72rem;
		font-weight: 950;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.topic2-lesson1 .equation-strip strong {
		font-size: clamp(1.5rem, 3vw, 3rem);
		line-height: 1;
		color: #23304d;
	}

	.topic2-lesson1 .solver-message {
		display: flex;
		align-items: center;
		padding: 12px 16px;
		color: #34445f;
		font-weight: 850;
		line-height: 1.28;
	}

	.topic2-lesson1 .solver-board {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr);
		gap: 12px;
		align-items: end;
		min-height: 0;
		padding: 16px 18px 26px;
		border-radius: 24px;
		border: 1px solid rgba(35,48,77,0.12);
		background: linear-gradient(180deg, #f5f7f8, #ffffff);
		overflow: hidden;
		--tilt: 0deg;
		--left-shift: 0px;
		--right-shift: 0px;
	}

	.topic2-lesson1 .solver-board.is-left-heavy {
		--tilt: -4.2deg;
		--left-shift: 18px;
		--right-shift: -10px;
	}

	.topic2-lesson1 .solver-board.is-right-heavy {
		--tilt: 4.2deg;
		--left-shift: -10px;
		--right-shift: 18px;
	}

	.topic2-lesson1 .solver-side {
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		gap: 10px;
		min-width: 0;
		min-height: 0;
		align-self: end;
		z-index: 2;
		transition: transform 0.34s ease;
	}

	.topic2-lesson1 .solver-side.side-left { transform: translateY(var(--left-shift)); }
	.topic2-lesson1 .solver-side.side-right { transform: translateY(var(--right-shift)); }

	.topic2-lesson1 .side-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 8px 10px;
		border-radius: 14px;
		background: rgba(255,255,255,0.92);
		border: 1px solid rgba(35,48,77,0.10);
	}

	.topic2-lesson1 .side-title strong {
		font-size: 0.95rem;
		color: #23304d;
	}

	.topic2-lesson1 .side-title small {
		padding: 5px 9px;
		border-radius: 999px;
		background: #eef4f8;
		color: #23304d;
		font-weight: 950;
	}

	.topic2-lesson1 .solver-pan {
		position: relative;
		display: grid;
		grid-template-columns: repeat(6, minmax(38px, 54px));
		grid-auto-rows: minmax(42px, 50px);
		align-content: end;
		justify-content: center;
		gap: 7px;
		min-height: 220px;
		padding: 18px 16px 26px;
		margin-bottom: 56px;
		border-radius: 22px 22px 14px 14px;
		border-bottom: 18px solid #9a4f19;
		background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(244,248,250,0.94));
		box-shadow: inset 0 0 0 1px rgba(35,48,77,0.08), 0 10px 18px rgba(35,48,77,0.06);
		overflow: hidden;
	}

	.topic2-lesson1 .solver-pan::before {
		content: '';
		position: absolute;
		top: -22px;
		left: 18%;
		width: 3px;
		height: 28px;
		background: rgba(35,48,77,0.22);
		box-shadow: calc(64% + 12px) 0 0 rgba(35,48,77,0.22);
	}

	.topic2-lesson1 .solver-pan::after {
		content: '';
		position: absolute;
		left: 8%;
		right: 8%;
		bottom: 12px;
		height: 10px;
		border-radius: 999px;
		background: #8b4518;
	}

	.topic2-lesson1 .solver-tile {
		display: grid;
		place-items: center;
		min-width: 0;
		height: 100%;
		border-radius: 8px;
		border: 2px solid rgba(35,48,77,0.32);
		font-weight: 950;
		font-size: clamp(0.9rem, 1.2vw, 1.16rem);
		box-shadow: 0 4px 0 rgba(35,48,77,0.10);
		animation: solver-pop 0.26s ease both;
		animation-delay: var(--delay, 0ms);
	}

	.topic2-lesson1 .solver-tile.x-tile {
		background: #5aa4ec;
		color: #ffffff;
	}

	.topic2-lesson1 .solver-tile.unit-tile {
		background: #ffd22e;
		color: #111827;
	}

	.topic2-lesson1 .solver-tile.negative-tile {
		background: #ef5b5b;
		color: #ffffff;
	}

	@keyframes solver-pop {
		0% { transform: translateY(-10px) scale(0.94); opacity: 0; }
		100% { transform: translateY(0) scale(1); opacity: 1; }
	}

	.topic2-lesson1 .solver-middle {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	.topic2-lesson1 .solver-equals {
		position: absolute;
		top: 18px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		border-radius: 50%;
		background: #23304d;
		color: #ffffff;
		font-size: 2rem;
		font-weight: 950;
	}

	.topic2-lesson1 .solver-beam {
		position: absolute;
		left: 50%;
		bottom: 62px;
		width: calc(100% - 110px);
		height: 16px;
		border-radius: 999px;
		background: #9a4f19;
		transform: translateX(-50%) rotate(var(--tilt));
		transform-origin: 50% 50%;
		transition: transform 0.34s ease;
	}

	.topic2-lesson1 .solver-stand {
		position: absolute;
		bottom: 18px;
		left: 50%;
		transform: translateX(-50%);
		width: 0;
		height: 0;
		border-left: 34px solid transparent;
		border-right: 34px solid transparent;
		border-bottom: 88px solid #9a4f19;
	}

	.topic2-lesson1 .solver-bottom-row {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
		gap: 10px;
		align-items: stretch;
		min-height: 0;
	}

	.topic2-lesson1 .solver-controls {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		padding: 10px;
		border-radius: 18px;
		background: #ffffff;
		border: 1px solid rgba(35,48,77,0.10);
	}

	.topic2-lesson1 .solver-controls .primary-button,
	.topic2-lesson1 .solver-controls .secondary-button {
		min-height: 42px;
		padding: 8px 12px;
		border-radius: 14px;
		font-size: clamp(0.78rem, 0.92vw, 0.95rem);
	}

	.topic2-lesson1 .solver-controls .ghost-positive {
		background: #2d9f66;
	}

	.topic2-lesson1 .solution-panel {
		display: grid;
		gap: 5px;
		align-content: center;
		padding: 10px 12px;
		background: #fff8ee;
	}

	.topic2-lesson1 .solution-panel strong {
		font-size: clamp(1rem, 1.2vw, 1.28rem);
		line-height: 1.15;
		color: #23304d;
	}

	.topic2-lesson1 .solution-panel p {
		margin: 0;
		font-size: clamp(0.78rem, 0.88vw, 0.92rem);
		line-height: 1.2;
		color: #5f3b19;
		font-weight: 800;
	}

	.topic2-lesson1 .solution-panel.is-solved {
		background: #ecfdf3;
		border-color: rgba(47,159,101,0.32);
	}
	@media (max-height: 760px) {
		.topic2-lesson1 .lesson-slide[data-slide-title="Balance Puzzle"] h2 { font-size: clamp(1.55rem, 3vw, 3rem); }
		.topic2-lesson1 .balance-solver { grid-template-rows: auto minmax(210px, 1fr) auto; gap: 7px; }
		.topic2-lesson1 .solver-top-row { grid-template-columns: minmax(240px, 0.55fr) minmax(0, 1fr); gap: 7px; }
		.topic2-lesson1 .equation-strip, .topic2-lesson1 .solver-message { padding: 8px 10px; border-radius: 15px; }
		.topic2-lesson1 .equation-strip strong { font-size: clamp(1.25rem, 2.2vw, 2.25rem); }
		.topic2-lesson1 .solver-board { padding: 10px 10px 18px; gap: 8px; grid-template-columns: minmax(0, 1fr) 74px minmax(0, 1fr); }
		.topic2-lesson1 .solver-pan { grid-template-columns: repeat(6, minmax(30px, 1fr)); grid-auto-rows: minmax(30px, 36px); gap: 5px; min-height: 170px; padding: 10px 10px 20px; margin-bottom: 44px; border-bottom-width: 12px; }
		.topic2-lesson1 .solver-tile { border-radius: 6px; font-size: 0.92rem; }
		.topic2-lesson1 .solver-equals { width: 44px; height: 44px; font-size: 1.5rem; }
		.topic2-lesson1 .solver-beam { bottom: 52px; width: calc(100% - 84px); height: 12px; }
		.topic2-lesson1 .solver-stand { border-left-width: 24px; border-right-width: 24px; border-bottom-width: 66px; bottom: 14px; }
		.topic2-lesson1 .solver-bottom-row { grid-template-columns: minmax(0, 1fr) 260px; gap: 7px; }
		.topic2-lesson1 .solver-controls { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; padding: 8px; }
		.topic2-lesson1 .solver-controls .primary-button, .topic2-lesson1 .solver-controls .secondary-button { min-height: 34px; padding: 6px 8px; font-size: 0.76rem; }
		.topic2-lesson1 .solution-panel { padding: 8px 10px; }
	}

	@media (max-width: 900px) {
		.topic2-lesson1 .solver-top-row,
		.topic2-lesson1 .solver-bottom-row { grid-template-columns: 1fr; }
		.topic2-lesson1 .solver-board { grid-template-columns: 1fr; }
		.topic2-lesson1 .solver-middle { display: none; }
	}


	/* Slide 3 compact balance simulator final patch */
	.topic2-lesson1 .lesson-slide[data-slide-title="Balance Puzzle"] h2 {
		font-size: clamp(1.65rem, 3.4vw, 3.45rem) !important;
		line-height: 0.96;
		margin-bottom: 4px;
	}

	.topic2-lesson1 .lesson-slide[data-slide-title="Balance Puzzle"] .tight-lede {
		font-size: clamp(0.82rem, 0.98vw, 1rem);
		line-height: 1.16;
		margin-bottom: 8px;
	}

	.topic2-lesson1 .balance-solver {
		grid-template-rows: auto minmax(230px, 1fr) auto !important;
		gap: 8px !important;
	}

	.topic2-lesson1 .solver-top-row {
		grid-template-columns: minmax(230px, 0.48fr) minmax(0, 1fr) !important;
		gap: 8px !important;
	}

	.topic2-lesson1 .equation-strip,
	.topic2-lesson1 .solver-message,
	.topic2-lesson1 .solution-panel {
		border-radius: 16px !important;
	}

	.topic2-lesson1 .equation-strip {
		padding: 8px 12px !important;
		gap: 3px !important;
	}

	.topic2-lesson1 .equation-strip > span,
	.topic2-lesson1 .solution-panel > span {
		font-size: 0.62rem !important;
		letter-spacing: 0.07em !important;
		color: #f2761e !important;
	}

	.topic2-lesson1 .equation-strip strong {
		font-size: clamp(1.55rem, 2.7vw, 2.55rem) !important;
		line-height: 1 !important;
		color: #23304d !important;
	}

	.topic2-lesson1 .equation-strip strong span,
	.topic2-lesson1 .equation-strip .mathjax {
		color: #23304d !important;
		font-size: inherit !important;
		letter-spacing: 0 !important;
		text-transform: none !important;
		font-weight: 950 !important;
	}

	.topic2-lesson1 .solver-message {
		padding: 9px 12px !important;
		font-size: clamp(0.82rem, 0.95vw, 0.98rem) !important;
		line-height: 1.18 !important;
	}

	.topic2-lesson1 .solver-board {
		position: relative !important;
		display: grid !important;
		grid-template-columns: minmax(0, 1fr) 82px minmax(0, 1fr) !important;
		grid-template-rows: 1fr !important;
		gap: 10px !important;
		align-items: end !important;
		min-height: 245px !important;
		padding: 12px 14px 18px !important;
		border-radius: 22px !important;
		overflow: hidden !important;
		--tilt: 0deg;
		--left-shift: 0px;
		--right-shift: 0px;
	}

	.topic2-lesson1 .solver-board.is-left-heavy {
		--tilt: -3.3deg;
		--left-shift: 14px;
		--right-shift: -7px;
	}

	.topic2-lesson1 .solver-board.is-right-heavy {
		--tilt: 3.3deg;
		--left-shift: -7px;
		--right-shift: 14px;
	}

	.topic2-lesson1 .solver-side {
		align-self: end !important;
		z-index: 3 !important;
		transition: transform 0.28s ease !important;
		gap: 7px !important;
		min-width: 0 !important;
	}

	.topic2-lesson1 .solver-side.side-left {
		grid-column: 1 !important;
		grid-row: 1 !important;
		transform: translateY(var(--left-shift)) !important;
	}

	.topic2-lesson1 .solver-side.side-right {
		grid-column: 3 !important;
		grid-row: 1 !important;
		transform: translateY(var(--right-shift)) !important;
	}

	.topic2-lesson1 .side-title {
		padding: 6px 9px !important;
		border-radius: 12px !important;
		background: rgba(255,255,255,0.94) !important;
	}

	.topic2-lesson1 .side-title strong {
		font-size: 0.82rem !important;
	}

	.topic2-lesson1 .side-title small {
		font-size: 0.72rem !important;
		padding: 4px 7px !important;
	}

	.topic2-lesson1 .solver-pan {
		position: relative !important;
		display: grid !important;
		grid-template-columns: repeat(6, minmax(28px, 46px)) !important;
		grid-auto-rows: minmax(30px, 38px) !important;
		align-content: end !important;
		justify-content: center !important;
		gap: 5px !important;
		min-height: 168px !important;
		padding: 11px 10px 21px !important;
		margin-bottom: 43px !important;
		border-radius: 16px 16px 10px 10px !important;
		border-bottom: 13px solid #9a4f19 !important;
		background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(245,248,250,0.94)) !important;
		overflow: hidden !important;
	}

	.topic2-lesson1 .solver-pan::after {
		bottom: 8px !important;
		height: 7px !important;
	}

	.topic2-lesson1 .solver-tile {
		height: 100% !important;
		border-radius: 6px !important;
		font-size: clamp(0.76rem, 1vw, 0.95rem) !important;
		border-width: 1.5px !important;
		box-shadow: 0 3px 0 rgba(35,48,77,0.10) !important;
		animation: solver-pop 0.2s ease both !important;
	}

	.topic2-lesson1 .solver-middle {
		position: absolute !important;
		inset: 0 !important;
		grid-column: 1 / -1 !important;
		grid-row: 1 !important;
		display: block !important;
		pointer-events: none !important;
		z-index: 1 !important;
	}

	.topic2-lesson1 .solver-equals {
		position: absolute !important;
		top: 12px !important;
		left: 50% !important;
		transform: translateX(-50%) !important;
		width: 42px !important;
		height: 42px !important;
		font-size: 1.45rem !important;
		z-index: 5 !important;
	}

	.topic2-lesson1 .solver-beam {
		position: absolute !important;
		left: 50% !important;
		bottom: 51px !important;
		width: calc(100% - 86px) !important;
		height: 12px !important;
		border-radius: 999px !important;
		background: #9a4f19 !important;
		transform: translateX(-50%) rotate(var(--tilt)) !important;
		transform-origin: 50% 50% !important;
		transition: transform 0.28s ease !important;
	}

	.topic2-lesson1 .solver-stand {
		position: absolute !important;
		bottom: 14px !important;
		left: 50% !important;
		transform: translateX(-50%) !important;
		border-left-width: 25px !important;
		border-right-width: 25px !important;
		border-bottom-width: 65px !important;
	}

	.topic2-lesson1 .solver-bottom-row {
		grid-template-columns: minmax(0, 1.3fr) minmax(255px, 0.72fr) !important;
		gap: 8px !important;
	}

	.topic2-lesson1 .solver-controls {
		grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
		gap: 7px !important;
		padding: 8px !important;
		border-radius: 15px !important;
	}

	.topic2-lesson1 .solver-controls .primary-button,
	.topic2-lesson1 .solver-controls .secondary-button {
		min-height: 36px !important;
		padding: 7px 9px !important;
		border-radius: 12px !important;
		font-size: clamp(0.7rem, 0.82vw, 0.86rem) !important;
	}

	.topic2-lesson1 .solution-panel {
		padding: 8px 10px !important;
		border-radius: 15px !important;
		gap: 3px !important;
	}

	.topic2-lesson1 .solution-panel strong {
		font-size: clamp(0.9rem, 1vw, 1.08rem) !important;
	}

	.topic2-lesson1 .solution-panel p {
		font-size: clamp(0.68rem, 0.8vw, 0.82rem) !important;
		line-height: 1.16 !important;
	}

	.topic2-lesson1 .solver-board.is-balanced .solver-beam {
		box-shadow: 0 0 0 3px rgba(47,159,101,0.08);
	}


	/* Slide 3 final reference-style balance lab */
	.topic2-lesson1 .lesson-slide[data-slide-title="Balance Puzzle"] {
		gap: 6px;
	}

	.topic2-lesson1 .lesson-slide[data-slide-title="Balance Puzzle"] h2 {
		font-size: clamp(1.85rem, 3.45vw, 3.7rem);
		line-height: 0.98;
		margin-bottom: 4px;
	}

	.topic2-lesson1 .balance-lab {
		display: grid;
		grid-template-rows: auto minmax(250px, 1fr) auto;
		gap: 9px;
		flex: 1 1 auto;
		min-height: 0;
	}

	.topic2-lesson1 .balance-lab-top {
		display: grid;
		grid-template-columns: minmax(210px, 0.7fr) minmax(0, 1fr) auto;
		gap: 10px;
		align-items: stretch;
	}

	.topic2-lesson1 .balance-equation-box,
	.topic2-lesson1 .balance-status-box,
	.topic2-lesson1 .balance-example-row,
	.topic2-lesson1 .side-control-card,
	.topic2-lesson1 .solve-control-card {
		border: 1px solid rgba(35,48,77,0.12);
		border-radius: 18px;
		background: #ffffff;
		box-shadow: 0 8px 18px rgba(35,48,77,0.05);
	}

	.topic2-lesson1 .balance-equation-box {
		display: grid;
		align-content: center;
		gap: 3px;
		padding: 10px 14px;
		background: linear-gradient(135deg, #fff8ee, #f3fbff);
	}

	.topic2-lesson1 .balance-equation-box > span,
	.topic2-lesson1 .solve-control-card span,
	.topic2-lesson1 .balance-status-box > span {
		color: #f2761e;
		font-size: 0.68rem;
		font-weight: 950;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.topic2-lesson1 .balance-equation-box strong {
		font-size: clamp(1.2rem, 2.2vw, 2.4rem);
		line-height: 1;
		color: #23304d;
	}

	.topic2-lesson1 .balance-status-box {
		display: grid;
		align-content: center;
		gap: 3px;
		padding: 10px 14px;
		border-left: 5px solid #2f9f65;
	}

	.topic2-lesson1 .balance-status-box.is-unbalanced {
		background: #fff5f0;
		border-left-color: #f2761e;
	}

	.topic2-lesson1 .balance-status-box p {
		margin: 0;
		font-size: clamp(0.78rem, 0.92vw, 0.94rem);
		line-height: 1.25;
		font-weight: 850;
		color: #34445f;
	}

	.topic2-lesson1 .balance-example-row {
		display: grid;
		grid-template-columns: repeat(3, minmax(72px, 1fr));
