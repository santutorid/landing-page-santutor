---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 4: Inequalities and Integer Solutions — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics: inequalities and integer solutions.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<script is:inline type="text/javascript">
		// @ts-nocheck
		window.MathJax = {
			startup: { typeset: false },
			chtml: { scale: 1.04, matchFontHeight: false }
		};
	</script>
	<script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

	<main id="top" class="ifp-lesson-page topic2-lesson4">
		<section class="lesson-shell" data-lesson-root>
			<header class="lesson-topbar">
				<div class="lesson-title-block">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-2">← Back to Topic 2</a>
					<p class="eyebrow">Cambridge Stage 8 · Unit 8.2 Topic 2</p>
					<h1>Lesson 4: Inequalities and Integer Solutions</h1>
				</div>
				<div class="topbar-actions">
					<span class="objective-pill">8Ae.07</span>
					<span class="score-pill">Score <strong data-total-score>0</strong></span>
					<button class="fullscreen-toggle" type="button" data-fullscreen-toggle>⛶ Present Full Screen</button>
				</div>
			</header>

			<div class="deck-layout">
				<nav class="slide-nav" aria-label="Lesson slides">
					<button type="button" class="slide-dot is-active" data-go-slide="0"><span>1</span>Goal</button>
					<button type="button" class="slide-dot" data-go-slide="1"><span>2</span>Theory</button>
					<button type="button" class="slide-dot" data-go-slide="2"><span>3</span>Number Line</button>
					<button type="button" class="slide-dot" data-go-slide="3"><span>4</span>Rules</button>
					<button type="button" class="slide-dot" data-go-slide="4"><span>5</span>Step Lab</button>
					<button type="button" class="slide-dot" data-go-slide="5"><span>6</span>Flip Game</button>
					<button type="button" class="slide-dot" data-go-slide="6"><span>7</span>Integers</button>
					<button type="button" class="slide-dot" data-go-slide="7"><span>8</span>Detective</button>
					<button type="button" class="slide-dot" data-go-slide="8"><span>9</span>Race</button>
					<button type="button" class="slide-dot" data-go-slide="9"><span>10</span>Exit</button>
				</nav>

				<section class="slide-stage" aria-live="polite">
					<article class="lesson-slide is-active" data-slide data-slide-title="Goal">
						<div class="slide-label"><span>Slide 1</span><strong>Lesson Goal</strong></div>
						<p class="mini-kicker">Today’s mission</p>
						<div class="hero-grid">
							<div>
								<h2>Understand inequalities, not just equations.</h2>
								<p class="slide-lede">Students learn that an inequality can have many possible answers. Then they practise finding integer solutions.</p>
								<div class="success-box">
									<h3>By the end, students can:</h3>
									<ul>
										<li>read symbols <span class="mathjax" data-tex="&lt;"></span>, <span class="mathjax" data-tex="&gt;"></span>, <span class="mathjax" data-tex="≤"></span>, and <span class="mathjax" data-tex="≥"></span></li>
										<li>solve inequalities using inverse operations</li>
										<li>list integer solutions from a number line</li>
									</ul>
								</div>
							</div>
							<div class="badge-card">
								<span>50</span>
								<strong>minutes</strong>
								<p>IFP-ready deck with concept slides, number line games, and team race.</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Theory Foundation">
						<div class="slide-label"><span>Slide 2</span><strong>Core Theory</strong></div>
						<p class="mini-kicker">Concepts students must understand first</p>
						<h2>What is an inequality?</h2>
						<div class="theory-grid">
							<div class="theory-card main-theory">
								<span class="card-tag">Big idea</span>
								<h3>An inequality compares two sides.</h3>
								<p>It does not always give one exact answer. It often gives a <strong>set of possible values</strong>.</p>
								<div class="math-strip"><span class="mathjax" data-tex="x + 3 &lt; 8"></span></div>
								<p class="teacher-cue">Ask: “Is there only one value of x that works?”</p>
							</div>
							<div class="symbol-board">
								<div><strong><span class="mathjax" data-tex="&lt;"></span></strong><span>less than</span></div>
								<div><strong><span class="mathjax" data-tex="&gt;"></span></strong><span>greater than</span></div>
								<div><strong><span class="mathjax" data-tex="≤"></span></strong><span>less than or equal to</span></div>
								<div><strong><span class="mathjax" data-tex="≥"></span></strong><span>greater than or equal to</span></div>
							</div>
						</div>
						<div class="concept-row">
							<div><strong>Open circle</strong><p>Use for <span class="mathjax" data-tex="&lt;"></span> or <span class="mathjax" data-tex="&gt;"></span>. The endpoint is not included.</p></div>
							<div><strong>Closed circle</strong><p>Use for <span class="mathjax" data-tex="≤"></span> or <span class="mathjax" data-tex="≥"></span>. The endpoint is included.</p></div>
							<div><strong>Integer solutions</strong><p>Whole numbers on the number line that make the inequality true.</p></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Number Line Explorer">
						<div class="slide-label"><span>Slide 3</span><strong>Interactive Concept</strong></div>
						<p class="mini-kicker">Visualise the solution set</p>
						<h2>See inequalities move on a number line.</h2>
						<div class="numberline-lab" data-numberline-lab>
							<div class="nl-main-grid">
								<section class="nl-select-card" aria-label="Choose an inequality">
									<div class="lab-top compact-lab-top">
										<div>
											<span class="round-label">Selected inequality</span>
											<strong data-nl-title><span class="mathjax" data-tex="x &gt; 2"></span></strong>
										</div>
										<button type="button" class="primary-button" data-nl-random>Random</button>
									</div>
									<p class="nl-help">Choose an inequality. Watch the endpoint, shaded direction, and test number move.</p>
									<div class="nl-choice-grid" data-nl-choices></div>
								</section>
								<section class="nl-meaning-card" aria-label="Meaning of the inequality">
									<span class="round-label">Meaning</span>
									<h3 data-nl-meaning-title>x is greater than 2.</h3>
									<p data-nl-meaning-text>2 is not included. The solution goes to the right.</p>
									<div class="endpoint-key">
										<span><i class="open-dot"></i> open circle: not included</span>
										<span><i class="closed-dot"></i> closed circle: included</span>
									</div>
								</section>
							</div>
							<div class="moving-numberline-card">
								<div class="moving-numberline" data-nl-track>
									<div class="nl-axis"></div>
									<div class="nl-solution-fill" data-nl-fill></div>
									<div class="nl-arrow" data-nl-arrow>➜</div>
									<div class="nl-boundary" data-nl-boundary></div>
									<div class="nl-probe-line" data-nl-probe-line></div>
									<div class="nl-probe-dot" data-nl-probe-dot></div>
									<div class="nl-probe-label" data-nl-probe-label>x = 3</div>
									<div class="nl-ticks" data-nl-ticks></div>
								</div>
								<div class="probe-controls">
									<button type="button" class="secondary-button" data-probe-left>← Move left</button>
									<label>Test value <input type="range" min="-6" max="6" step="1" value="3" data-nl-slider /></label>
									<button type="button" class="secondary-button" data-probe-right>Move right →</button>
								</div>
							</div>
							<div class="nl-feedback" data-nl-feedback>Pick an inequality, then move the blue test point.</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Inequality Rules">
						<div class="slide-label"><span>Slide 4</span><strong>Key Rule</strong></div>
						<p class="mini-kicker">The rule that students often forget</p>
						<h2>When do we flip the sign?</h2>
						<div class="rule-board">
							<div class="rule-card safe">
								<span>Keep the sign</span>
								<h3>Add or subtract the same number.</h3>
								<div class="rule-equation"><span class="mathjax" data-tex="x + 3 &lt; 8"></span><span class="mathjax" data-tex="x &lt; 5"></span></div>
							</div>
							<div class="rule-card safe">
								<span>Keep the sign</span>
								<h3>Multiply or divide by a positive number.</h3>
								<div class="rule-equation"><span class="mathjax" data-tex="2x ≤ 10"></span><span class="mathjax" data-tex="x ≤ 5"></span></div>
							</div>
							<div class="rule-card danger">
								<span>Flip the sign</span>
								<h3>Multiply or divide by a negative number.</h3>
								<div class="rule-equation"><span class="mathjax" data-tex="-2x &lt; 8"></span><span class="mathjax" data-tex="x &gt; -4"></span></div>
							</div>
						</div>
						<div class="teacher-cue large-cue">Teacher prompt: “Why does the sign flip when we divide by a negative?” Try substituting values to test it.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Step Lab">
						<div class="slide-label"><span>Slide 5</span><strong>Solving Lab</strong></div>
						<p class="mini-kicker">Random two-step inequality</p>
						<h2>Solve one step at a time.</h2>
						<div class="step-lab" data-step-lab>
							<div class="step-lab-card">
								<span class="round-label">Original inequality</span>
								<strong data-step-original><span class="mathjax" data-tex="2x + 3 &lt; 11"></span></strong>
								<p>Original stays fixed so students remember the starting question.</p>
							</div>
							<div class="step-lab-card working-card">
								<span class="round-label">Working line</span>
								<strong data-step-working><span class="mathjax" data-tex="2x + 3 &lt; 11"></span></strong>
								<p data-step-message>First cancel the constant.</p>
							</div>
							<div class="step-buttons">
								<button type="button" class="primary-button" data-cancel-constant>Cancel constant</button>
								<button type="button" class="primary-button" data-divide-coef>Divide coefficient</button>
								<button type="button" class="secondary-button" data-show-step-answer>Show answer</button>
								<button type="button" class="secondary-button" data-new-step-ineq>New inequality</button>
								<button type="button" class="secondary-button" data-reset-step-lab>Reset</button>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Flip Game">
						<div class="slide-label"><span>Slide 6</span><strong>Game 1</strong></div>
						<p class="mini-kicker">Keep or flip?</p>
						<h2>Sign Flip Challenge</h2>
						<div class="choice-game" data-choice-game="flip">
							<div class="game-header">
								<div><span class="round-label" data-round>Round 1 / 5</span><h3>Should the inequality sign flip?</h3></div>
								<div class="local-score"><span>Score</span><strong data-score>0</strong></div>
							</div>
							<div class="big-expression"><span class="mathjax" data-prompt data-tex="-3x ≥ 12"></span></div>
							<div class="option-grid compact-options" data-options></div>
							<p class="feedback-line" data-feedback>Look at the operation used to isolate x.</p>
							<div class="button-row"><button type="button" class="secondary-button" data-next-round>Next round</button><button type="button" class="secondary-button" data-reset-game>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Integer Hunter">
						<div class="slide-label"><span>Slide 7</span><strong>Game 2</strong></div>
						<p class="mini-kicker">Select all answers</p>
						<h2>Integer Solution Hunter</h2>
						<div class="integer-game" data-integer-game>
							<div class="integer-top">
								<div><span class="round-label">Inequality</span><strong data-int-title><span class="mathjax" data-tex="x ≤ 3"></span></strong></div>
								<div class="local-score"><span>Correct</span><strong data-int-count>0</strong></div>
							</div>
							<div class="integer-tiles" data-int-tiles></div>
							<div class="integer-actions">
								<p data-int-feedback>Tap all integer solutions shown on the board.</p>
								<button type="button" class="primary-button" data-check-integers>Check</button>
								<button type="button" class="secondary-button" data-new-integers>New set</button>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Error Detective">
						<div class="slide-label"><span>Slide 8</span><strong>Game 3</strong></div>
						<p class="mini-kicker">Misconception check</p>
						<h2>Error Detective</h2>
						<div class="choice-game" data-choice-game="detective">
							<div class="game-header">
								<div><span class="round-label" data-round>Mistake 1 / 4</span><h3>What went wrong?</h3></div>
								<div class="local-score"><span>Score</span><strong data-score>0</strong></div>
							</div>
							<div class="student-work"><span>Student work</span><p><span class="mathjax" data-prompt data-tex="-2x &lt; 8, so x &lt; -4"></span></p></div>
							<div class="option-grid text-options" data-options></div>
							<p class="feedback-line" data-feedback>Choose the best explanation.</p>
							<div class="button-row"><button type="button" class="secondary-button" data-next-round>Next mistake</button><button type="button" class="secondary-button" data-reset-game>Reset detective</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Team Race">
						<div class="slide-label"><span>Slide 9</span><strong>Class Game</strong></div>
						<p class="mini-kicker">Teacher-led checking</p>
						<h2>Inequality Team Race</h2>
						<div class="team-race" data-team-race>
							<div class="race-top">
								<div><span class="round-label" data-race-round>Round 1 / 10</span><strong data-race-prompt><span class="mathjax" data-tex="2x + 3 &lt; 11"></span></strong></div>
								<div class="race-actions"><button type="button" class="primary-button" data-next-race>Next round</button><button type="button" class="secondary-button" data-reset-race>Reset scores</button></div>
							</div>
							<div class="team-grid" data-team-grid></div>
							<div class="race-answer"><button type="button" class="secondary-button" data-toggle-race-answer>Reveal answer</button><span data-race-answer hidden><span class="mathjax" data-tex="x &lt; 4"></span></span></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Exit Ticket">
						<div class="slide-label"><span>Slide 10</span><strong>Exit Ticket</strong></div>
						<p class="mini-kicker">Final check</p>
						<h2>Exit ticket</h2>
						<div class="exit-grid">
							<div><strong>1</strong><p>Solve <span class="mathjax" data-tex="x + 5 ≥ 12"></span>.</p></div>
							<div><strong>2</strong><p>Solve <span class="mathjax" data-tex="-3x &lt; 15"></span>. Should the sign flip?</p></div>
							<div><strong>3</strong><p>List the integer solutions for <span class="mathjax" data-tex="-2 &lt; x ≤ 3"></span>.</p></div>
						</div>
						<button type="button" class="primary-button" data-toggle-target="exit-answers">Show sample answers</button>
						<div id="exit-answers" class="sample-answer hidden-answer">
							<p><strong>1.</strong> <span class="mathjax" data-tex="x ≥ 7"></span></p>
							<p><strong>2.</strong> <span class="mathjax" data-tex="x &gt; -5"></span>. Yes, flip the sign because we divide by a negative number.</p>
							<p><strong>3.</strong> <span class="mathjax" data-tex="x = -1, 0, 1, 2, 3"></span></p>
						</div>
					</article>
				</section>
			</div>

			<footer class="deck-controls">
				<button type="button" class="secondary-button" data-prev-slide>Back</button>
				<button type="button" class="teacher-button" data-teacher-notes-toggle>Teacher Notes</button>
				<button type="button" class="secondary-button" data-reset-slide>Reset Slide</button>
				<button type="button" class="primary-button" data-next-slide>Next</button>
			</footer>

			<aside class="teacher-notes" data-teacher-notes hidden>
				<div class="teacher-notes-card">
					<div class="teacher-notes-head"><strong>Teacher Notes</strong><button type="button" data-teacher-notes-close aria-label="Close teacher notes">×</button></div>
					<p data-teacher-notes-text>Use this slide to set the goal clearly.</p>
				</div>
			</aside>
		</section>
	</main>

	<style is:global>
		body:has(.ifp-lesson-page) > header,
		body:has(.ifp-lesson-page) > footer,
		body:has(.ifp-lesson-page) .site-header,
		body:has(.ifp-lesson-page) .site-footer,
		body:has(.ifp-lesson-page) .floating-whatsapp,
		body:has(.ifp-lesson-page) .whatsapp-float { display: none !important; }
		body:has(.ifp-lesson-page) { margin: 0; overflow: hidden; }

		.topic2-lesson4, .topic2-lesson4 * { box-sizing: border-box; }
		.topic2-lesson4 {
			--navy: #23304d;
			--orange: #f2761e;
			--blue: #3eb6ea;
			--text: #23304d;
			--muted: #536178;
			--soft: #f5f8fb;
			--line: rgba(35, 48, 77, 0.13);
			width: 100%;
			height: 100vh;
			overflow: hidden;
			background: radial-gradient(circle at top left, rgba(62, 182, 234, 0.16), transparent 30%), linear-gradient(135deg, #f8fbff 0%, #fff8ee 100%);
			color: var(--text);
			font-family: Figtree, Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		}

		.topic2-lesson4 .lesson-shell { height: 100vh; display: grid; grid-template-rows: auto 1fr auto; gap: 10px; padding: 12px; }
		.topic2-lesson4 .lesson-topbar { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px; border-radius: 24px; background: rgba(255,255,255,0.92); border: 1px solid var(--line); box-shadow: 0 14px 34px rgba(35,48,77,0.08); }
		.topic2-lesson4 .back-link { color: var(--orange); text-decoration: none; font-weight: 900; font-size: 0.84rem; }
		.topic2-lesson4 .eyebrow { margin: 2px 0 0; color: var(--muted); font-size: 0.78rem; font-weight: 850; letter-spacing: 0.06em; text-transform: uppercase; }
		.topic2-lesson4 h1 { margin: 1px 0 0; font-size: clamp(1.1rem, 1.7vw, 1.55rem); line-height: 1.05; color: var(--navy); }
		.topic2-lesson4 .topbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
		.topic2-lesson4 .objective-pill, .topic2-lesson4 .score-pill { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 9px 12px; border-radius: 999px; background: #eef7ff; color: var(--navy); font-weight: 950; }
		.topic2-lesson4 .score-pill strong { margin-left: 5px; color: var(--orange); }
		.topic2-lesson4 .fullscreen-toggle { min-height: 40px; border: 0; border-radius: 999px; padding: 9px 14px; background: var(--navy); color: #fff; font-weight: 950; cursor: pointer; }
		.topic2-lesson4 .fullscreen-toggle.is-active { background: var(--orange); }

		.topic2-lesson4 .deck-layout { min-height: 0; display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: 10px; }
		.topic2-lesson4 .slide-nav { min-height: 0; padding: 10px; border-radius: 22px; background: rgba(255,255,255,0.86); border: 1px solid var(--line); display: grid; gap: 7px; align-content: start; overflow: hidden; }
		.topic2-lesson4 .slide-dot { min-height: 44px; border: 1px solid var(--line); border-radius: 15px; background: #fff; color: var(--muted); display: grid; grid-template-columns: 28px 1fr; align-items: center; gap: 6px; padding: 6px; font-size: 0.72rem; font-weight: 900; text-align: left; cursor: pointer; }
		.topic2-lesson4 .slide-dot span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #edf3f8; color: var(--navy); }
		.topic2-lesson4 .slide-dot.is-active { border-color: var(--blue); color: var(--navy); background: #f3fbff; }
		.topic2-lesson4 .slide-dot.is-active span { background: var(--blue); color: #fff; }

		.topic2-lesson4 .slide-stage { min-height: 0; border-radius: 28px; background: rgba(255,255,255,0.92); border: 1px solid var(--line); box-shadow: 0 14px 34px rgba(35,48,77,0.08); overflow: hidden; }
		.topic2-lesson4 .lesson-slide { display: none; height: 100%; min-height: 0; padding: clamp(16px, 2vw, 30px); flex-direction: column; overflow: hidden; }
		.topic2-lesson4 .lesson-slide.is-active { display: flex; }
		.topic2-lesson4 .slide-label { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 8px; }
		.topic2-lesson4 .slide-label span { padding: 6px 10px; border-radius: 999px; background: #fff3e9; color: var(--orange); font-weight: 950; font-size: 0.78rem; }
		.topic2-lesson4 .slide-label strong { color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; }
		.topic2-lesson4 .mini-kicker { margin: 0 0 6px; color: var(--orange); font-weight: 950; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.82rem; }
		.topic2-lesson4 h2 { margin: 0 0 10px; color: var(--navy); font-size: clamp(2rem, 4vw, 4.4rem); line-height: 0.98; letter-spacing: -0.045em; }
		.topic2-lesson4 [data-slide-title='Number Line Explorer'] h2 { font-size: clamp(2rem, 3.4vw, 3.7rem); margin-bottom: 8px; }
		.topic2-lesson4 [data-numberline-lab] .primary-button, .topic2-lesson4 [data-numberline-lab] .secondary-button { min-height: 38px; padding: 7px 12px; border-radius: 14px; font-size: 0.86rem; }
		.topic2-lesson4 h3 { margin: 0; color: var(--navy); }
