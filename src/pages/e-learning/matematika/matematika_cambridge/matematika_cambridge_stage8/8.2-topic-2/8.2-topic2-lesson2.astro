	<script is:inline type="text/javascript">
		// @ts-nocheck
		(() => {
			const root = document.querySelector('[data-lesson-root]');
			if (!root || root.dataset.initialised === 'true') return;
			root.dataset.initialised = 'true';

			const slides = Array.from(root.querySelectorAll('[data-slide]'));
			const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
			const progressFill = root.querySelector('[data-progress-fill]');
			const prevButton = root.querySelector('[data-prev-slide]');
			const nextButton = root.querySelector('[data-next-slide]');
			const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
			const fullscreenTarget = root.querySelector('.lesson-shell') || root;
			const teacherNotes = root.querySelector('[data-teacher-notes]');
			const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
			const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');
			const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
			const totalScore = root.querySelector('[data-total-score]');

			let currentSlide = 0;
			let score = 0;

			const notes = [
				'Set the goal: solving means isolating x while preserving equality.',
				'Ask students to vote first. The inverse operation removes the operation attached to x.',
				'Use the random balance simulator for teacher-led practice. Show that one-sided moves break the balance.',
				'Keep this quick. Students should say the inverse operation aloud before solving.',
				'Reveal one step at a time. Do not skip the cancelling step.',
				'Let students answer first on mini whiteboards, then tap an option.',
				'Ask students to explain the mistake, not only choose the answer.',
				'Use this as a short group race. Reveal answers only after teams commit.',
				'Connect the recipe back to the balance model.',
				'Students answer individually. Then show sample answers for checking.'
			];

			const renderMath = (container = document) => {
				const slash = String.fromCharCode(92);
				const mathItems = Array.from(container.querySelectorAll('.mathjax[data-tex]'));
				mathItems.forEach((el) => {
					const tex = el.getAttribute('data-tex') || '';
					if (el.dataset.rendered !== tex || !el.querySelector('mjx-container')) {
						el.textContent = slash + '(' + tex + slash + ')';
						el.dataset.rendered = tex;
					}
				});

				if (window.MathJax?.typesetPromise) {
					try { window.MathJax.typesetClear?.(mathItems); } catch (error) {}
					window.MathJax.typesetPromise(mathItems).catch(() => {
						mathItems.forEach((el) => {
							el.textContent = el.getAttribute('data-tex') || '';
						});
					});
				} else {
					mathItems.forEach((el) => {
						el.textContent = el.getAttribute('data-tex') || '';
					});
					window.setTimeout(() => {
						if (window.MathJax?.typesetPromise) renderMath(container);
					}, 500);
				}
			};

			const updateTotalScore = (points) => {
				score += points;
				if (totalScore) totalScore.textContent = String(score);
			};

			const updateSlide = (index) => {
				currentSlide = Math.max(0, Math.min(index, slides.length - 1));
				slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === currentSlide));
				dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === currentSlide));
				if (progressFill) progressFill.style.width = ((currentSlide + 1) / slides.length * 100) + '%';
				if (teacherNotesText) teacherNotesText.textContent = notes[currentSlide] || '';
				renderMath(slides[currentSlide]);
			};

			dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
			nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
			prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));

			fullscreenButton?.addEventListener('click', async () => {
				try {
					if (document.fullscreenElement) await document.exitFullscreen();
					else if (fullscreenTarget.requestFullscreen) await fullscreenTarget.requestFullscreen();
				} catch (error) {}
			});

			const updateFullscreenButton = () => {
				if (!fullscreenButton) return;
				const active = Boolean(document.fullscreenElement);
				fullscreenButton.classList.toggle('is-active', active);
				fullscreenButton.textContent = active ? 'Exit Full Screen' : '⛶ Present Full Screen';
			};
			document.addEventListener('fullscreenchange', updateFullscreenButton);

			teacherNotesToggle?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
			teacherNotesClose?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = true; });

			root.querySelectorAll('[data-toggle-target]').forEach((button) => {
				button.addEventListener('click', () => {
					const id = button.getAttribute('data-toggle-target') || '';
					const target = root.querySelector('#' + CSS.escape(id));
					if (target) {
						target.classList.toggle('is-visible');
						renderMath(target);
					}
				});
			});

			const setupStaticQuizzes = () => {
				root.querySelectorAll('[data-static-quiz]').forEach((quiz) => {
					const feedback = quiz.parentElement?.querySelector('.feedback-line[data-feedback]');
					const buttons = Array.from(quiz.querySelectorAll('.option-card'));
					buttons.forEach((button) => {
						button.addEventListener('click', () => {
							buttons.forEach((item) => item.classList.remove('is-correct', 'is-wrong'));
							const correct = button.dataset.correct === 'true';
							button.classList.add(correct ? 'is-correct' : 'is-wrong');
							if (feedback) feedback.textContent = button.dataset.optionFeedback || '';
							if (correct && !button.dataset.scored) {
								button.dataset.scored = 'true';
								updateTotalScore(1);
							}
						});
					});
				});
			};

			const setupBalanceLab = () => {
				const game = root.querySelector('[data-balance-game]');
				if (!game) return;

				const title = game.querySelector('[data-balance-title]');
				const workingTitle = game.querySelector('[data-working-title]');
				const message = game.querySelector('[data-balance-message]');
				const statusBox = game.querySelector('[data-status-box]');
				const statusLabel = game.querySelector('[data-status-label]');
				const leftPan = game.querySelector('[data-balance-pan="left"]');
				const rightPan = game.querySelector('[data-balance-pan="right"]');
				const stage = game.querySelector('[data-scale-stage]');
				const leftLabel = game.querySelector('[data-left-label]');
				const rightLabel = game.querySelector('[data-right-label]');
				const output = game.querySelector('[data-solution-output]');
				const solutionCard = game.querySelector('.solve-control-card');

				let currentAnswer = 6;
				let original = {
					left: { x: 1, c: 4 },
					right: { x: 0, c: 10 },
					answer: 6,
					hint: 'Start balanced. Remove 1 from both sides four times to isolate x.'
				};
				let state = {
					left: { ...original.left },
					right: { ...original.right }
				};

				const cloneProblem = (problem) => ({
					left: { ...problem.left },
					right: { ...problem.right },
					answer: problem.answer,
					hint: problem.hint
				});

				const formatNumber = (value) => Number.isInteger(value) ? String(value) : String(Math.round(value * 100) / 100);

				const randomInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;

				const formatSide = (side) => {
					const parts = [];
					if (side.x !== 0) {
						if (side.x === 1) parts.push('x');
						else if (side.x === -1) parts.push('-x');
						else parts.push(side.x + 'x');
					}
					if (side.c !== 0 || parts.length === 0) {
						if (parts.length && side.c > 0) parts.push('+ ' + formatNumber(side.c));
						else if (parts.length && side.c < 0) parts.push('- ' + formatNumber(Math.abs(side.c)));
						else parts.push(formatNumber(side.c));
					}
					return parts.join(' ');
				};

				const makeRandomProblem = () => {
					let problem = null;
					for (let attempt = 0; attempt < 100; attempt += 1) {
						const answer = randomInt(2, 9);
						const leftX = randomInt(1, 4);
						let leftC = randomInt(-9, 9);
						if (leftC === 0) leftC = randomInt(1, 9);
						const useBothSides = Math.random() < 0.28 && leftX > 1;
						const rightX = useBothSides ? randomInt(1, leftX - 1) : 0;
						const rightC = (leftX - rightX) * answer + leftC;
						if (Math.abs(rightC) <= 28 && rightC !== 0) {
							problem = {
								left: { x: leftX, c: leftC },
								right: { x: rightX, c: rightC },
								answer,
								hint: 'Random equation. Keep the scale balanced, then isolate x.'
							};
							break;
						}
					}
					return problem || {
						left: { x: 2, c: -3 },
						right: { x: 0, c: 7 },
						answer: 5,
						hint: 'Random equation. Add 1 to both sides three times, then split.'
					};
				};

				const sideValue = (side) => side.x * currentAnswer + side.c;

				const makeBlocks = (side) => {
					const blocks = [];
					if (side.x !== 0) {
						blocks.push({
							type: side.x < 0 ? 'negative' : 'variable',
							text: side.x === 1 ? 'x' : side.x === -1 ? '-x' : side.x + 'x'
						});
					}
					if (side.c !== 0) {
						blocks.push({
							type: side.c < 0 ? 'negative' : 'number',
							text: side.c > 0 ? formatNumber(side.c) : '-' + formatNumber(Math.abs(side.c))
						});
					}
					if (blocks.length === 0) blocks.push({ type: 'zero-block', text: '0' });
					return blocks;
				};

				const renderPan = (pan, side) => {
					if (!pan) return;
					pan.innerHTML = '';
					makeBlocks(side).forEach((item, index) => {
						const block = document.createElement('span');
						block.className = 'scale-block ' + item.type;
						block.textContent = item.text;
						block.style.setProperty('--delay', String(Math.min(index * 40, 160)) + 'ms');
						pan.appendChild(block);
					});
				};

				const setTilt = (leftValue, rightValue) => {
					if (!stage) return;
					stage.classList.remove('left-heavy', 'right-heavy');
					if (leftValue > rightValue) stage.classList.add('left-heavy');
					if (rightValue > leftValue) stage.classList.add('right-heavy');
				};

				const updateSolution = (balanced) => {
					if (!output) return;
					solutionCard?.classList.remove('is-solved');
					const left = state.left;
					const right = state.right;
					if (!balanced) {
						output.textContent = 'Make both sides balanced again.';
						return;
					}
					if (left.x === 1 && left.c === 0 && right.x === 0) {
						output.innerHTML = '<span class="mathjax" data-tex="x = ' + formatNumber(right.c) + '"></span>';
						solutionCard?.classList.add('is-solved');
						renderMath(solutionCard || game);
						return;
					}
					if (right.x === 1 && right.c === 0 && left.x === 0) {
						output.innerHTML = '<span class="mathjax" data-tex="x = ' + formatNumber(left.c) + '"></span>';
						solutionCard?.classList.add('is-solved');
						renderMath(solutionCard || game);
						return;
					}
					if ((left.x > 1 && left.c === 0 && right.x === 0) || (right.x > 1 && right.c === 0 && left.x === 0)) {
						output.textContent = 'Now press Split x groups.';
						return;
					}
					output.textContent = 'Keep simplifying until one x is alone.';
				};

				const render = (customMessage) => {
					renderPan(leftPan, state.left);
					renderPan(rightPan, state.right);
					const leftText = formatSide(state.left);
					const rightText = formatSide(state.right);
					const originalLeftText = formatSide(original.left);
					const originalRightText = formatSide(original.right);
					if (title) title.innerHTML = '<span class="mathjax" data-tex="' + originalLeftText + ' = ' + originalRightText + '"></span>';
					if (workingTitle) workingTitle.innerHTML = '<span class="mathjax" data-tex="' + leftText + ' = ' + rightText + '"></span>';
					if (leftLabel) leftLabel.textContent = leftText;
					if (rightLabel) rightLabel.textContent = rightText;

					const leftValue = sideValue(state.left);
					const rightValue = sideValue(state.right);
					const balanced = leftValue === rightValue;
					setTilt(leftValue, rightValue);

					if (statusBox) statusBox.classList.toggle('is-unbalanced', !balanced);
					if (statusLabel) statusLabel.textContent = balanced ? 'Balanced' : (leftValue > rightValue ? 'Left is heavier' : 'Right is heavier');
					if (message) message.textContent = customMessage || (balanced ? original.hint : 'Not balanced yet. Do the matching operation on the other side.');
					updateSolution(balanced);
					renderMath(game);
				};

				const applySideOperation = (sideName, kind, delta) => {
					const side = state[sideName];
					if (!side) return;
					side[kind] += delta;
					const symbol = delta > 0 ? '+' : '-';
					const item = kind === 'x' ? 'x' : '1';
					render('You changed the working equation on the ' + sideName + ' side by ' + symbol + item + '. The original equation stays visible at the top.');
				};

				const splitX = () => {
					const leftValue = sideValue(state.left);
					const rightValue = sideValue(state.right);
					if (leftValue !== rightValue) {
						render('Balance the scale first. You can split only when both sides are equal.');
						return;
					}
					if (state.left.x > 1 && state.left.c === 0 && state.right.x === 0) {
						const value = state.right.c / state.left.x;
						state.left.x = 1;
						state.right.c = value;
						currentAnswer = value;
						render('The right side is shared equally between the x groups. Now one x is visible.');
						return;
					}
					if (state.right.x > 1 && state.right.c === 0 && state.left.x === 0) {
						const value = state.left.c / state.right.x;
						state.right.x = 1;
						state.left.c = value;
						currentAnswer = value;
						render('The left side is shared equally between the x groups. Now one x is visible.');
						return;
					}
					render('Split is useful after the equation looks like 2x = 10 or 3x = 12.');
				};

				const loadProblem = (problem) => {
					original = cloneProblem(problem);
					currentAnswer = original.answer;
					state = {
						left: { ...original.left },
						right: { ...original.right }
					};
					render('New equation loaded. ' + original.hint);
				};

				game.querySelectorAll('[data-side]').forEach((button) => {
					button.addEventListener('click', () => {
						const side = button.getAttribute('data-side');
						const kind = button.getAttribute('data-kind');
						const delta = Number(button.getAttribute('data-delta') || 0);
						if (!side || !kind || !Number.isFinite(delta)) return;
						applySideOperation(side, kind, delta);
					});
				});

				game.querySelector('[data-split-x]')?.addEventListener('click', splitX);
				game.querySelector('[data-reset-balance]')?.addEventListener('click', () => loadProblem(original));
				game.querySelectorAll('[data-random-balance]').forEach((button) => {
					button.addEventListener('click', () => loadProblem(makeRandomProblem()));
				});

				render();
			};

			
			const setupSteps = () => {
				root.querySelectorAll('[data-step-reveal]').forEach((box) => {
					const steps = Array.from(box.querySelectorAll('[data-step]'));
					const next = box.querySelector('[data-next-step]');
					const reset = box.querySelector('[data-reset-steps]');
					let index = 0;
					const render = () => {
						steps.forEach((step, stepIndex) => {
							const visible = stepIndex <= index;
							step.classList.toggle('is-visible', visible);
							step.classList.toggle('is-hidden', !visible);
						});
						renderMath(box);
					};
					next?.addEventListener('click', () => { index = Math.min(index + 1, steps.length - 1); render(); });
					reset?.addEventListener('click', () => { index = 0; render(); });
					render();
				});
			};

			const makeOption = (option, optionIndex, onSelect) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'option-card';
				if (option.text) button.classList.add('text-option');
				button.setAttribute('aria-label', 'Option ' + String.fromCharCode(65 + optionIndex) + ': ' + option.label);
				const letter = document.createElement('span');
				letter.className = 'option-letter';
				letter.textContent = String.fromCharCode(65 + optionIndex);
				const content = document.createElement('span');
				content.className = 'option-content';
				if (option.text) {
					content.textContent = option.label;
				} else {
					const math = document.createElement('span');
					math.className = 'mathjax';
					math.setAttribute('data-tex', option.label);
					content.appendChild(math);
				}
				button.append(letter, content);
				button.addEventListener('click', () => onSelect(button, option));
				return button;
			};

			const setupChoiceGame = (key, items, settings) => {
				const area = root.querySelector('[data-choice-game="' + key + '"]');
				if (!area) return;
				const prompt = area.querySelector('[data-prompt]');
				const optionsBox = area.querySelector('[data-options]');
				const feedback = area.querySelector('[data-feedback]');
				const round = area.querySelector('[data-round]');
				const scoreEl = area.querySelector('[data-score]');
				const next = area.querySelector('[data-next-round]');
				const reset = area.querySelector('[data-reset-game]');
				let index = 0;
				let localScore = 0;
				let answered = false;

				const render = () => {
					const item = items[index];
					answered = false;
					if (round) round.textContent = settings.roundPrefix + ' ' + (index + 1) + ' / ' + items.length;
					if (scoreEl) scoreEl.textContent = String(localScore);
					if (feedback) feedback.textContent = settings.defaultFeedback;
					if (prompt) prompt.setAttribute('data-tex', item.prompt);
					if (next) next.textContent = index === items.length - 1 ? 'Finish game' : settings.nextLabel;
					if (optionsBox) {
						optionsBox.innerHTML = '';
						item.options.forEach((option, optionIndex) => {
							optionsBox.appendChild(makeOption(option, optionIndex, (button, selected) => {
								if (answered) return;
								answered = true;
								const correct = selected.label === item.answer;
								button.classList.add(correct ? 'is-correct' : 'is-wrong');
								Array.from(optionsBox.querySelectorAll('.option-card')).forEach((card) => card.disabled = true);
								if (feedback) feedback.textContent = correct ? item.correctFeedback : item.wrongFeedback;
								if (correct) {
									localScore += settings.points;
									updateTotalScore(settings.points);
									if (scoreEl) scoreEl.textContent = String(localScore);
								}
							}));
						});
					}
					renderMath(area);
				};

				next?.addEventListener('click', () => {
					if (index < items.length - 1) {
						index += 1;
						render();
					} else if (feedback) {
						feedback.textContent = 'Game complete. Final score: ' + localScore + '.';
					}
				});

				reset?.addEventListener('click', () => {
					index = 0;
					localScore = 0;
					render();
				});

				render();
			};

			const setupBoard = () => {
				const board = root.querySelector('[data-board-grid]');
				if (!board) return;
				const cards = Array.from(board.querySelectorAll('.board-card'));
				const make = () => {
					const a = Math.floor(Math.random() * 4) + 1;
					let b = Math.floor(Math.random() * 15) - 7;
					if (b === 0) b = 3;
					const x = Math.floor(Math.random() * 8) + 1;
					const c = a * x + b;
					const left = (a === 1 ? 'x' : a + 'x') + (b > 0 ? ' + ' + b : ' - ' + Math.abs(b));
					return { equation: left + ' = ' + c, answer: 'x = ' + x };
				};

				const newSet = () => {
					cards.forEach((card) => {
						const item = make();
						const eq = card.querySelector('[data-board-eq]');
						const answer = card.querySelector('[data-board-answer]');
						if (eq) eq.setAttribute('data-tex', item.equation);
						if (answer) {
							answer.classList.remove('is-visible');
							answer.innerHTML = '<span class="mathjax" data-tex="' + item.answer + '"></span>';
						}
					});
					renderMath(board);
				};

				cards.forEach((card) => {
					card.querySelector('[data-board-reveal]')?.addEventListener('click', () => {
						const answer = card.querySelector('[data-board-answer]');
						answer?.classList.toggle('is-visible');
						renderMath(card);
					});
				});
				root.querySelector('[data-new-board]')?.addEventListener('click', newSet);
				root.querySelector('[data-reveal-board-all]')?.addEventListener('click', () => {
					cards.forEach((card) => card.querySelector('[data-board-answer]')?.classList.add('is-visible'));
					renderMath(board);
				});
				newSet();
			};

			const resetCurrentSlide = () => {
				const slide = slides[currentSlide];
				if (!slide) return;
				slide.querySelectorAll('.hidden-answer.is-visible').forEach((item) => item.classList.remove('is-visible'));
				slide.querySelectorAll('.option-card').forEach((button) => {
					button.classList.remove('is-correct', 'is-wrong');
					button.disabled = false;
				});
				slide.querySelectorAll('[data-feedback]').forEach((feedback) => {
					if (!feedback.closest('[data-choice-game]')) feedback.textContent = 'Choose the best answer.';
				});
				const resetBalance = slide.querySelector('[data-reset-balance]');
				if (resetBalance) resetBalance.click();
				const resetSteps = slide.querySelector('[data-reset-steps]');
				if (resetSteps) resetSteps.click();
				const resetGame = slide.querySelector('[data-reset-game]');
				if (resetGame) resetGame.click();
				renderMath(slide);
			};

			root.querySelector('[data-reset-slide]')?.addEventListener('click', resetCurrentSlide);

			setupStaticQuizzes();
			setupBalanceLab();
			setupSteps();
			setupBoard();

			setupChoiceGame('sprint', [
				{ prompt: 'x + 6 = 14', answer: '8', options: [{ label: '6' }, { label: '8' }, { label: '14' }, { label: '20' }], correctFeedback: 'Correct. Subtract 6 from both sides.', wrongFeedback: 'Subtract 6 from 14.' },
				{ prompt: 'x - 9 = 4', answer: '13', options: [{ label: '5' }, { label: '9' }, { label: '13' }, { label: '36' }], correctFeedback: 'Correct. Add 9 to both sides.', wrongFeedback: 'The inverse of -9 is +9.' },
				{ prompt: '3x = 24', answer: '8', options: [{ label: '6' }, { label: '8' }, { label: '21' }, { label: '72' }], correctFeedback: 'Correct. Divide both sides by 3.', wrongFeedback: 'Split 24 into 3 equal groups.' },
				{ prompt: '2x + 5 = 17', answer: '6', options: [{ label: '6' }, { label: '8' }, { label: '11' }, { label: '12' }], correctFeedback: 'Correct. First subtract 5, then divide by 2.', wrongFeedback: 'Do two steps: cancel +5, then split 2x.' },
				{ prompt: '4x - 3 = 21', answer: '6', options: [{ label: '4' }, { label: '5' }, { label: '6' }, { label: '9' }], correctFeedback: 'Correct. Add 3, then divide by 4.', wrongFeedback: 'Cancel -3 first.' }
			], { roundPrefix: 'Round', nextLabel: 'Next round', defaultFeedback: 'Choose the value of x.', points: 2 });

			setupChoiceGame('detective', [
				{ prompt: '2x + 3 = 11, so 2x = 14', answer: 'They added 3 instead of subtracting 3.', options: [{ label: 'They added 3 instead of subtracting 3.', text: true }, { label: 'They divided too early.', text: true }, { label: 'The equation has no solution.', text: true }, { label: 'The x should disappear.', text: true }], correctFeedback: 'Correct. To cancel +3, subtract 3 from both sides.', wrongFeedback: 'Look at the constant +3.' },
				{ prompt: '3x - 4 = 20, so 3x = 16', answer: 'They should add 4, not subtract 4.', options: [{ label: 'They should add 4, not subtract 4.', text: true }, { label: 'They should multiply by 4.', text: true }, { label: 'The answer is already x.', text: true }, { label: '3x means 3 + x.', text: true }], correctFeedback: 'Correct. The inverse of −4 is +4.', wrongFeedback: 'A negative constant is cancelled by adding.' },
				{ prompt: '5x = 30, so x = 25', answer: 'They subtracted 5 instead of dividing by 5.', options: [{ label: 'They subtracted 5 instead of dividing by 5.', text: true }, { label: 'They should add 30.', text: true }, { label: 'They should multiply both sides by 5.', text: true }, { label: 'There is no mistake.', text: true }], correctFeedback: 'Correct. 5x means 5 times x.', wrongFeedback: 'Think about what 5x means.' }
			], { roundPrefix: 'Mistake', nextLabel: 'Next mistake', defaultFeedback: 'Choose the best explanation.', points: 3 });

			updateSlide(0);
			window.setTimeout(() => renderMath(root), 700);
		})();
	</script>
</Layout>
