---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 2: Solving One-Step and Two-Step Equations — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics: solving one-step and two-step linear equations using balance reasoning.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<style is:global>
		body:has(.topic2-lesson2) {
			margin: 0;
			overflow: hidden;
			background: #f7f3ed;
		}

		body:has(.topic2-lesson2) header:not(.lesson-topbar),
		body:has(.topic2-lesson2) footer:not(.deck-controls),
		body:has(.topic2-lesson2) .floating-whatsapp,
		body:has(.topic2-lesson2) .whatsapp-float,
		body:has(.topic2-lesson2) .site-header,
		body:has(.topic2-lesson2) .site-footer {
			display: none !important;
		}

		.topic2-lesson2 {
			--navy: #23304d;
			--navy-soft: #314466;
			--orange: #f2761e;
			--sky: #35b6ea;
			--cream: #fff8ee;
			--green: #2f9f65;
			--red: #d75b5b;
			--muted: #40506a;
			--line: rgba(35, 48, 77, 0.12);
			min-height: 100vh;
			height: 100vh;
			overflow: hidden;
			background:
				radial-gradient(circle at 12% 18%, rgba(53, 182, 234, 0.12), transparent 28%),
				radial-gradient(circle at 86% 86%, rgba(242, 118, 30, 0.12), transparent 26%),
				#f7f3ed;
			color: var(--navy);
			font-family: 'Figtree', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}

		.topic2-lesson2 * { box-sizing: border-box; }

		.topic2-lesson2 .lesson-shell {
			height: 100vh;
			padding: 10px 14px;
			display: grid;
			grid-template-rows: auto 10px minmax(0, 1fr) auto;
			gap: 8px;
		}

		.topic2-lesson2 .lesson-topbar,
		.topic2-lesson2 .deck-controls,
		.topic2-lesson2 .slide-nav,
		.topic2-lesson2 .slide-stage {
			background: rgba(255, 255, 255, 0.92);
			border: 1px solid var(--line);
			box-shadow: 0 12px 30px rgba(35, 48, 77, 0.06);
		}

		.topic2-lesson2 .lesson-topbar {
			border-radius: 22px;
			padding: 10px 18px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
		}

		.topic2-lesson2 .back-link {
			display: inline-flex;
			text-decoration: none;
			font-weight: 900;
			color: #26526d;
			font-size: 0.88rem;
			margin-bottom: 2px;
		}

		.topic2-lesson2 .eyebrow,
		.topic2-lesson2 .mini-kicker,
		.topic2-lesson2 .round-label {
			margin: 0;
			color: var(--orange);
			font-size: clamp(0.68rem, 0.85vw, 0.82rem);
			font-weight: 950;
			text-transform: uppercase;
			letter-spacing: 0.14em;
		}

		.topic2-lesson2 h1,
		.topic2-lesson2 h2,
		.topic2-lesson2 h3,
		.topic2-lesson2 p {
			margin-top: 0;
		}

		.topic2-lesson2 h1 {
			margin-bottom: 0;
			font-size: clamp(1.45rem, 2.5vw, 2.25rem);
			line-height: 0.98;
			font-weight: 950;
			letter-spacing: -0.05em;
		}

		.topic2-lesson2 .topbar-actions {
			display: flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
			justify-content: flex-end;
		}

		.topic2-lesson2 .objective-pill,
		.topic2-lesson2 .score-pill,
		.topic2-lesson2 .fullscreen-toggle,
		.topic2-lesson2 .primary-button,
		.topic2-lesson2 .secondary-button,
		.topic2-lesson2 .teacher-button {
			border: 0;
			border-radius: 999px;
			min-height: 46px;
			padding: 0 18px;
			font-weight: 950;
			font-size: clamp(0.86rem, 1vw, 1rem);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			white-space: nowrap;
			cursor: pointer;
		}

		.topic2-lesson2 .objective-pill,
		.topic2-lesson2 .teacher-button {
			background: var(--navy);
			color: #ffffff;
		}

		.topic2-lesson2 .score-pill {
			background: #fff1e6;
			color: #c6530c;
		}

		.topic2-lesson2 .fullscreen-toggle {
			background: #267fa6;
			color: #ffffff;
		}

		.topic2-lesson2 .primary-button {
			background: var(--orange);
			color: #ffffff;
		}

		.topic2-lesson2 .secondary-button {
			background: #eef4f8;
			color: var(--navy);
		}

		.topic2-lesson2 .primary-button:hover,
		.topic2-lesson2 .secondary-button:hover,
		.topic2-lesson2 .fullscreen-toggle:hover,
		.topic2-lesson2 .teacher-button:hover {
			transform: translateY(-1px);
		}

		.topic2-lesson2 button:focus-visible,
		.topic2-lesson2 a:focus-visible {
			outline: 3px solid var(--sky);
			outline-offset: 3px;
		}

		.topic2-lesson2 .progress-track {
			position: relative;
			height: 10px;
			border-radius: 999px;
			background: rgba(35, 48, 77, 0.10);
			overflow: hidden;
		}

		.topic2-lesson2 .progress-fill {
			height: 100%;
			width: 10%;
			border-radius: inherit;
			background: linear-gradient(90deg, var(--orange), var(--sky));
			transition: width 0.25s ease;
		}

		.topic2-lesson2 .deck-grid {
			display: grid;
			grid-template-columns: 150px minmax(0, 1fr);
			gap: 10px;
			min-height: 0;
		}

		.topic2-lesson2 .slide-nav {
			border-radius: 22px;
			padding: 12px 8px;
			display: grid;
			align-content: start;
			gap: 8px;
			overflow: hidden;
		}

		.topic2-lesson2 .slide-dot {
			border: 0;
			background: transparent;
			border-radius: 15px;
			min-height: 40px;
			padding: 5px 9px;
			display: grid;
			grid-template-columns: 28px minmax(0, 1fr);
			align-items: center;
			gap: 8px;
			color: var(--muted);
			font-weight: 900;
			text-align: left;
			cursor: pointer;
		}

		.topic2-lesson2 .slide-dot span {
			display: grid;
			place-items: center;
			width: 26px;
			height: 26px;
			border-radius: 999px;
			background: #eef2f5;
			font-size: 0.82rem;
			font-weight: 950;
		}

		.topic2-lesson2 .slide-dot.is-active {
			background: var(--navy);
			color: #ffffff;
		}

		.topic2-lesson2 .slide-dot.is-active span {
			background: #ffffff;
			color: var(--navy);
		}

		.topic2-lesson2 .slide-stage {
			position: relative;
			border-radius: 24px;
			min-height: 0;
			overflow: hidden;
		}

		.topic2-lesson2 .lesson-slide {
			position: absolute;
			inset: 0;
			padding: clamp(18px, 2vw, 28px);
			display: none;
			flex-direction: column;
			min-height: 0;
			overflow: hidden;
		}

		.topic2-lesson2 .lesson-slide.is-active {
			display: flex;
		}

		.topic2-lesson2 .slide-label {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 8px;
			color: var(--muted);
			font-weight: 950;
		}

		.topic2-lesson2 .slide-label span {
			padding: 8px 13px;
			border-radius: 999px;
			background: #fff1e6;
			border: 1px solid rgba(242, 118, 30, 0.18);
			color: var(--orange);
		}

		.topic2-lesson2 h2 {
			font-size: clamp(2.1rem, 4vw, 4.6rem);
			line-height: 0.94;
			letter-spacing: -0.06em;
			font-weight: 950;
			margin-bottom: 12px;
			color: var(--navy);
		}

		.topic2-lesson2 .slide-lede {
			font-size: clamp(1rem, 1.35vw, 1.25rem);
			line-height: 1.35;
			color: var(--muted);
			font-weight: 760;
			margin-bottom: 14px;
		}

		.topic2-lesson2 .card,
		.topic2-lesson2 .success-box,
		.topic2-lesson2 .question-box,
		.topic2-lesson2 .feedback-line,
		.topic2-lesson2 .sample-answer {
			border: 1px solid var(--line);
			background: #ffffff;
			border-radius: 22px;
			box-shadow: 0 12px 24px rgba(35, 48, 77, 0.05);
		}

		.topic2-lesson2 .hero-grid {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 320px;
			gap: 18px;
			align-items: stretch;
			min-height: 0;
		}

		.topic2-lesson2 .success-box {
			padding: 20px;
			background: #f3fbff;
		}

		.topic2-lesson2 .success-box h3,
		.topic2-lesson2 .card h3,
		.topic2-lesson2 .question-box h3 {
			margin-bottom: 10px;
			font-size: clamp(1rem, 1.25vw, 1.25rem);
			color: var(--navy);
		}

		.topic2-lesson2 .success-box ul {
			margin: 0;
			padding-left: 22px;
			color: var(--muted);
			font-weight: 800;
			line-height: 1.6;
		}

		.topic2-lesson2 .badge-card {
			display: grid;
			place-items: center;
			align-content: center;
			text-align: center;
			gap: 10px;
			padding: 28px;
			border-radius: 28px;
			background: linear-gradient(145deg, var(--navy), #36547d);
			color: #ffffff;
		}

		.topic2-lesson2 .badge-card span {
			font-size: clamp(4rem, 8vw, 8rem);
			line-height: 0.8;
			font-weight: 950;
		}

		.topic2-lesson2 .badge-card strong,
		.topic2-lesson2 .badge-card p {
			color: #ffffff;
		}

		.topic2-lesson2 .deck-controls {
			border-radius: 22px;
			padding: 10px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
		}

		/* Option card system: global because some cards are created by JavaScript. */
		.topic2-lesson2 .option-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
			margin-top: 8px;
		}

		.topic2-lesson2 .option-card {
			position: relative;
			min-height: 68px;
			padding: 0;
			border: 2px solid rgba(35, 48, 77, 0.12);
			background: linear-gradient(180deg, #ffffff, #f8fbff);
			border-radius: 18px;
			overflow: hidden;
			font: inherit;
			cursor: pointer;
			display: grid;
			grid-template-columns: 58px minmax(0, 1fr);
			color: var(--navy);
			box-shadow: 0 8px 18px rgba(35, 48, 77, 0.05);
			transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
		}

		.topic2-lesson2 .option-card:hover,
		.topic2-lesson2 .option-card:focus-visible {
			transform: translateY(-1px);
			border-color: var(--sky);
		}

		.topic2-lesson2 .option-letter {
			display: grid;
			place-items: center;
			background: var(--navy);
			color: #ffffff;
			font-weight: 950;
			font-size: 1.05rem;
		}

		.topic2-lesson2 .option-content {
			display: grid;
			align-content: center;
			justify-items: center;
			text-align: center;
			padding: 10px 14px;
			font-weight: 950;
			font-size: clamp(1rem, 1.35vw, 1.35rem);
			line-height: 1.2;
		}

		.topic2-lesson2 .text-options .option-content {
			justify-items: start;
			text-align: left;
			font-size: clamp(0.86rem, 1vw, 1rem);
			font-weight: 850;
		}

		.topic2-lesson2 .option-card.is-correct {
			border-color: var(--green);
			background: #ecfdf3;
		}

		.topic2-lesson2 .option-card.is-correct .option-letter {
			background: var(--green);
		}

		.topic2-lesson2 .option-card.is-wrong {
			border-color: var(--red);
			background: #fff1f1;
		}

		.topic2-lesson2 .option-card.is-wrong .option-letter {
			background: var(--red);
		}

		.topic2-lesson2 .feedback-line {
			margin: 10px 0 0;
			padding: 12px 14px;
			background: #f7f8fb;
			color: var(--navy);
			font-weight: 880;
			line-height: 1.22;
		}

		.topic2-lesson2 .button-row {
			display: flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
			margin-top: 12px;
		}

		/* Slide 2 */
		.topic2-lesson2 .warmup-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
			gap: 16px;
			align-items: stretch;
			min-height: 0;
			flex: 1 1 auto;
		}

		.topic2-lesson2 .unlock-card {
			display: grid;
			gap: 12px;
			align-content: center;
			padding: 22px;
			border-radius: 26px;
			background: linear-gradient(145deg, #fff8ee, #f3fbff);
			border: 1px solid var(--line);
		}

		.topic2-lesson2 .giant-equation {
			display: grid;
			place-items: center;
			min-height: 160px;
			border-radius: 24px;
			background: #ffffff;
			border: 1px solid var(--line);
			font-size: clamp(2.4rem, 6vw, 5.8rem);
		}

		.topic2-lesson2 .rule-card {
			padding: 20px;
			border-radius: 24px;
			background: var(--navy);
			color: #ffffff;
			display: grid;
			align-content: center;
			gap: 12px;
		}

		.topic2-lesson2 .rule-card strong,
		.topic2-lesson2 .rule-card p {
			color: #ffffff;
		}

		.topic2-lesson2 .rule-card p {
			margin: 0;
			line-height: 1.45;
			font-weight: 800;
		}

		/* Slide 3 balance simulator */
		.topic2-lesson2 .lesson-slide[data-slide-title="Random Balance"] h2 {
			font-size: clamp(1.7rem, 3.1vw, 3.35rem);
			margin-bottom: 6px;
		}

		.topic2-lesson2 .lesson-slide[data-slide-title="Random Balance"] .slide-lede {
			font-size: clamp(0.9rem, 1.05vw, 1.05rem);
			line-height: 1.24;
			margin-bottom: 8px;
		}

		.topic2-lesson2 .balance-lab {
			display: grid;
			grid-template-rows: auto minmax(250px, 1fr) auto;
			gap: 8px;
			flex: 1 1 auto;
			min-height: 0;
		}

		.topic2-lesson2 .balance-top {
			display: grid;
			grid-template-columns: minmax(250px, 0.48fr) minmax(0, 1fr);
			gap: 9px;
		}

		.topic2-lesson2 .equation-panel,
		.topic2-lesson2 .message-panel,
		.topic2-lesson2 .solution-panel {
			border: 1px solid var(--line);
			border-radius: 18px;
			background: #ffffff;
			box-shadow: 0 8px 18px rgba(35, 48, 77, 0.05);
		}

		.topic2-lesson2 .equation-panel {
			padding: 10px 13px;
			background: linear-gradient(135deg, #fff8ee, #f3fbff);
		}

		.topic2-lesson2 .equation-panel span,
		.topic2-lesson2 .solution-panel span {
			display: block;
			color: var(--orange);
			font-size: 0.68rem;
			font-weight: 950;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			margin-bottom: 4px;
		}

		.topic2-lesson2 .equation-panel strong {
			display: block;
			font-size: clamp(1.45rem, 2.4vw, 2.6rem);
			line-height: 1;
			color: var(--navy);
		}

		.topic2-lesson2 .message-panel {
			padding: 12px 14px;
			display: flex;
			align-items: center;
			color: var(--muted);
			font-weight: 850;
			line-height: 1.25;
		}

		.topic2-lesson2 .scale-stage {
			position: relative;
			min-height: 0;
			border: 1px solid var(--line);
			border-radius: 24px;
			background: linear-gradient(180deg, #f5f7f8, #ffffff);
			overflow: hidden;
			--tilt: 0deg;
			--left-drop: 0px;
			--right-drop: 0px;
		}

		.topic2-lesson2 .scale-stage.is-left-heavy {
			--tilt: -5deg;
			--left-drop: 16px;
			--right-drop: -12px;
		}

		.topic2-lesson2 .scale-stage.is-right-heavy {
			--tilt: 5deg;
			--left-drop: -12px;
			--right-drop: 16px;
		}

		.topic2-lesson2 .scale-beam {
			position: absolute;
			left: 9%;
			right: 9%;
			bottom: 68px;
			height: 14px;
			border-radius: 999px;
			background: linear-gradient(180deg, #a65a20, #88420f);
			transform: rotate(var(--tilt));
			transform-origin: center;
			transition: transform 0.45s cubic-bezier(.2,.8,.2,1);
			z-index: 1;
		}

		.topic2-lesson2 .scale-stand {
			position: absolute;
			left: 50%;
			bottom: 16px;
			width: 0;
			height: 0;
			border-left: 36px solid transparent;
			border-right: 36px solid transparent;
			border-bottom: 100px solid #9a4f19;
			transform: translateX(-50%);
			z-index: 0;
		}

		.topic2-lesson2 .scale-pan {
			position: absolute;
			bottom: 84px;
			width: min(35%, 360px);
			min-height: 116px;
			padding: 15px 13px 17px;
			display: flex;
			align-items: flex-end;
			justify-content: center;
			gap: 9px;
			flex-wrap: wrap;
			border: 4px solid #334463;
			border-top: 0;
			border-radius: 0 0 44px 44px;
			background: rgba(255,255,255,0.86);
			box-shadow: inset 0 -8px rgba(35,48,77,0.06), 0 10px 0 rgba(35,48,77,0.08);
			z-index: 2;
			transition: transform 0.45s cubic-bezier(.2,.8,.2,1);
		}

		.topic2-lesson2 .scale-pan::before,
		.topic2-lesson2 .scale-pan::after {
			content: '';
			position: absolute;
			top: -54px;
			width: 3px;
			height: 58px;
			background: rgba(35,48,77,0.35);
		}

		.topic2-lesson2 .scale-pan::before { left: 22%; }
		.topic2-lesson2 .scale-pan::after { right: 22%; }

		.topic2-lesson2 .scale-pan.left {
			left: 7%;
			transform: translateY(var(--left-drop));
		}

		.topic2-lesson2 .scale-pan.right {
			right: 7%;
			transform: translateY(var(--right-drop));
		}

		.topic2-lesson2 .pan-label {
			position: absolute;
			top: 14px;
			padding: 6px 11px;
			border-radius: 999px;
			background: #ffffff;
			border: 1px solid var(--line);
			font-weight: 950;
			color: var(--navy);
			font-size: 0.82rem;
			z-index: 4;
		}

		.topic2-lesson2 .pan-label.left { left: 10%; }
		.topic2-lesson2 .pan-label.right { right: 10%; }

		.topic2-lesson2 .scale-tile {
			display: inline-grid;
			place-items: center;
			min-width: 58px;
			height: 50px;
			padding: 0 12px;
			border-radius: 12px 12px 8px 8px;
			font-weight: 950;
			font-size: clamp(1rem, 1.35vw, 1.25rem);
			border: 2px solid rgba(35,48,77,0.25);
			box-shadow: inset 0 -5px rgba(0,0,0,0.08), 0 4px 0 rgba(35,48,77,0.12);
			animation: tile-drop 0.28s ease both;
		}

		.topic2-lesson2 .scale-tile.var { background: #35a9df; color: #ffffff; }
		.topic2-lesson2 .scale-tile.pos { background: #f8cb39; color: #172033; }
		.topic2-lesson2 .scale-tile.neg { background: #ef6b5b; color: #ffffff; }

		@keyframes tile-drop {
			from { transform: translateY(-10px) scale(0.92); opacity: 0; }
			to { transform: translateY(0) scale(1); opacity: 1; }
		}

		.topic2-lesson2 .balance-bottom {
			display: grid;
			grid-template-columns: minmax(0, 1.25fr) minmax(290px, 0.75fr);
			gap: 9px;
		}

		.topic2-lesson2 .balance-controls {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 8px;
			padding: 9px;
			border-radius: 18px;
			border: 1px solid var(--line);
			background: #ffffff;
		}

		.topic2-lesson2 .balance-controls button {
			min-height: 42px;
			padding: 6px 10px;
			border-radius: 14px;
			font-size: clamp(0.74rem, 0.9vw, 0.92rem);
		}

		.topic2-lesson2 .solution-panel {
