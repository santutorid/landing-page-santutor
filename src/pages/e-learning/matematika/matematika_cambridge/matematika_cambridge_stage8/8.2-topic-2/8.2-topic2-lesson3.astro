			<footer class="deck-controls">
				<button type="button" class="secondary-button" data-prev-slide>Back</button>
				<button type="button" class="teacher-button" data-teacher-notes-toggle>Teacher Notes</button>
				<button type="button" class="secondary-button" data-reset-slide>Reset Slide</button>
				<button type="button" class="primary-button" data-next-slide>Next</button>
			</footer>

			<aside class="teacher-notes" data-teacher-notes hidden>
				<div class="teacher-notes-card">
					<div class="teacher-notes-head"><strong>Teacher Notes</strong><button type="button" data-teacher-notes-close aria-label="Close teacher notes">×</button></div>
					<p data-teacher-notes-text>Set the goal clearly: students must keep the equation balanced while isolating x.</p>
				</div>
			</aside>
		</section>
	</main>

	<script is:inline type="text/javascript">
		// @ts-nocheck
		(() => {
			const root = document.querySelector('[data-lesson-root]');
			if (!root || root.dataset.initialized === 'true') return;
			root.dataset.initialized = 'true';

			const slides = Array.from(root.querySelectorAll('[data-slide]'));
			const dots = Array.from(root.querySelectorAll('[data-go-slide]'));
			const progressBar = root.querySelector('[data-progress-bar]');
			const nextButton = root.querySelector('[data-next-slide]');
			const prevButton = root.querySelector('[data-prev-slide]');
			const resetSlideButton = root.querySelector('[data-reset-slide]');
			const fullscreenButton = root.querySelector('[data-fullscreen-toggle]');
			const fullscreenTarget = document.querySelector('.topic2-lesson3');
			const teacherNotes = root.querySelector('[data-teacher-notes]');
			const teacherNotesText = root.querySelector('[data-teacher-notes-text]');
			const teacherNotesToggle = root.querySelector('[data-teacher-notes-toggle]');
			const teacherNotesClose = root.querySelector('[data-teacher-notes-close]');
			const scoreText = root.querySelector('[data-total-score]');

			let currentSlide = 0;
			let totalScore = 0;
			const choiceControllers = {};
			let balanceController = null;
			let stepController = null;

			const teacherNotesBySlide = [
				'Set the learning target. Mention that the new challenge is x appears on both sides.',
				'Ask students to predict the first legal move before revealing the idea.',
				'Use this slide slowly. New equation gives random x-on-both-sides examples; ask students to make matching moves on left and right.',
				'Emphasise: remove the smaller x group from both sides first.',
				'Do not rush. Ask students to explain why each line is still equivalent.',
				'Ask students to justify each next equation, not just pick the answer.',
				'Use this to catch common mistakes: changing only one side, sign errors, and forgetting to divide.',
				'Let teams solve on mini whiteboards. Reveal answers only after discussion.',
				'Use as a fast individual check before the exit ticket.',
				'Collect written answers or ask students to submit in their notebook.'
			];

			const renderMath = (target = document) => {
				const bs = String.fromCharCode(92);
				const scope = target instanceof Element || target instanceof Document ? target : document;
				scope.querySelectorAll('.mathjax[data-tex]').forEach((node) => {
					const tex = node.getAttribute('data-tex') || '';
					if (node.dataset.renderedTex !== tex) {
						node.textContent = bs + '(' + tex + bs + ')';
						node.dataset.renderedTex = tex;
					}
				});
				if (window.MathJax && window.MathJax.typesetPromise) {
					window.MathJax.typesetPromise([scope]).catch(() => {});
				}
			};

			const updateTotalScore = (points) => {
				totalScore += points;
				if (scoreText) scoreText.textContent = String(totalScore);
			};

			const updateSlide = (index) => {
				currentSlide = Math.max(0, Math.min(slides.length - 1, index));
				slides.forEach((slide, i) => slide.classList.toggle('is-active', i === currentSlide));
				dots.forEach((dot, i) => dot.classList.toggle('is-active', i === currentSlide));
				if (progressBar) progressBar.style.width = ((currentSlide + 1) / slides.length * 100) + '%';
				if (prevButton) prevButton.disabled = currentSlide === 0;
				if (nextButton) nextButton.textContent = currentSlide === slides.length - 1 ? 'Finish' : 'Next';
				if (teacherNotesText) teacherNotesText.textContent = teacherNotesBySlide[currentSlide] || '';
				if (teacherNotes) teacherNotes.hidden = true;
				renderMath(slides[currentSlide]);
			};

			dots.forEach((dot) => dot.addEventListener('click', () => updateSlide(Number(dot.dataset.goSlide || 0))));
			nextButton?.addEventListener('click', () => updateSlide(currentSlide + 1));
			prevButton?.addEventListener('click', () => updateSlide(currentSlide - 1));

			fullscreenButton?.addEventListener('click', async () => {
				try {
					if (document.fullscreenElement) await document.exitFullscreen();
					else if (fullscreenTarget?.requestFullscreen) await fullscreenTarget.requestFullscreen();
				} catch (error) {}
			});

			const updateFullscreenButton = () => {
				if (!fullscreenButton) return;
				const active = Boolean(document.fullscreenElement);
				fullscreenButton.textContent = active ? 'Exit Full Screen' : '⛶ Present Full Screen';
			};
			document.addEventListener('fullscreenchange', updateFullscreenButton);

			teacherNotesToggle?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = !teacherNotes.hidden; });
			teacherNotesClose?.addEventListener('click', () => { if (teacherNotes) teacherNotes.hidden = true; });

			root.querySelectorAll('[data-toggle-target]').forEach((button) => {
				button.addEventListener('click', () => {
					const id = button.getAttribute('data-toggle-target') || '';
					const target = root.querySelector('#' + CSS.escape(id));
					if (target) {
						target.classList.toggle('is-visible');
						renderMath(target);
					}
				});
			});

			const setupBalance = () => {
				const game = root.querySelector('[data-balance-game]');
				if (!game) return null;

				const title = game.querySelector('[data-balance-title]');
				const workingTitle = game.querySelector('[data-working-title]');
				const message = game.querySelector('[data-balance-message]');
				const statusBox = game.querySelector('[data-status-box]');
				const statusLabel = game.querySelector('[data-status-label]');
				const leftPan = game.querySelector('[data-balance-pan="left"]');
				const rightPan = game.querySelector('[data-balance-pan="right"]');
				const stage = game.querySelector('[data-scale-stage]');
				const leftLabel = game.querySelector('[data-left-label]');
				const rightLabel = game.querySelector('[data-right-label]');
				const output = game.querySelector('[data-solution-output]');
				const solutionCard = game.querySelector('.solve-control-card');

				let currentAnswer = 4;
				let original = {
					left: { x: 3, c: 2 },
					right: { x: 1, c: 10 },
					answer: 4,
					hint: 'Start balanced. Remove x from both sides, then cancel the constant, then split.'
				};
				let state = {
					left: { ...original.left },
					right: { ...original.right }
				};

				const cloneProblem = (problem) => ({
					left: { ...problem.left },
					right: { ...problem.right },
					answer: problem.answer,
					hint: problem.hint
				});

				const formatNumber = (value) => Number.isInteger(value) ? String(value) : String(Math.round(value * 100) / 100);
				const randomInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;

				const formatSide = (side) => {
					const parts = [];
					if (side.x !== 0) {
						if (side.x === 1) parts.push('x');
						else if (side.x === -1) parts.push('-x');
						else parts.push(side.x + 'x');
					}
					if (side.c !== 0 || parts.length === 0) {
						if (parts.length && side.c > 0) parts.push('+ ' + formatNumber(side.c));
						else if (parts.length && side.c < 0) parts.push('- ' + formatNumber(Math.abs(side.c)));
						else parts.push(formatNumber(side.c));
					}
					return parts.join(' ');
				};

				const makeRandomProblem = () => {
					for (let attempt = 0; attempt < 120; attempt += 1) {
						const answer = randomInt(2, 9);
						const rightX = randomInt(1, 3);
						const leftX = randomInt(rightX + 1, rightX + 4);
						let leftC = randomInt(-9, 9);
						if (leftC === 0) leftC = randomInt(1, 9);
						const rightC = (leftX - rightX) * answer + leftC;
						if (rightC >= -9 && rightC <= 30 && rightC !== leftC) {
							return {
								left: { x: leftX, c: leftC },
								right: { x: rightX, c: rightC },
								answer,
								hint: 'Random both-sides equation. Remove the smaller x group from both sides first.'
							};
						}
					}
					return {
						left: { x: 4, c: -3 },
						right: { x: 1, c: 12 },
						answer: 5,
						hint: 'Random both-sides equation. Remove x from both sides, add 3 to both sides, then split.'
					};
				};

				const sideValue = (side) => side.x * currentAnswer + side.c;

				const makeBlocks = (side) => {
					const blocks = [];
					if (side.x !== 0) {
						blocks.push({
							type: side.x < 0 ? 'negative' : 'variable',
							text: side.x === 1 ? 'x' : side.x === -1 ? '-x' : side.x + 'x'
						});
					}
					if (side.c !== 0) {
						blocks.push({
							type: side.c < 0 ? 'negative' : 'number',
							text: side.c > 0 ? formatNumber(side.c) : '-' + formatNumber(Math.abs(side.c))
						});
					}
					if (blocks.length === 0) blocks.push({ type: 'zero-block', text: '0' });
					return blocks;
				};

				const renderPan = (pan, side) => {
					if (!pan) return;
					pan.innerHTML = '';
					makeBlocks(side).forEach((item, index) => {
						const block = document.createElement('span');
						block.className = 'scale-block ' + item.type;
						block.textContent = item.text;
						block.style.setProperty('--delay', String(Math.min(index * 40, 160)) + 'ms');
						pan.appendChild(block);
					});
				};

				const setTilt = (leftValue, rightValue) => {
					if (!stage) return;
					stage.classList.remove('left-heavy', 'right-heavy');
					if (leftValue > rightValue) stage.classList.add('left-heavy');
					if (rightValue > leftValue) stage.classList.add('right-heavy');
				};

				const updateSolution = (balanced) => {
					if (!output) return;
					solutionCard?.classList.remove('is-solved');
					const left = state.left;
					const right = state.right;
					if (!balanced) {
						output.textContent = 'Make both sides balanced again.';
						return;
					}
					if (left.x === 1 && left.c === 0 && right.x === 0) {
						output.innerHTML = '<span class="mathjax" data-tex="x = ' + formatNumber(right.c) + '"></span>';
						solutionCard?.classList.add('is-solved');
						renderMath(solutionCard || game);
						return;
					}
					if (right.x === 1 && right.c === 0 && left.x === 0) {
						output.innerHTML = '<span class="mathjax" data-tex="x = ' + formatNumber(left.c) + '"></span>';
						solutionCard?.classList.add('is-solved');
						renderMath(solutionCard || game);
						return;
					}
					if ((left.x > 1 && left.c === 0 && right.x === 0) || (right.x > 1 && right.c === 0 && left.x === 0)) {
						output.textContent = 'Now press Split x groups.';
						return;
					}
					output.textContent = 'Keep simplifying until one x is alone.';
				};

				const render = (customMessage) => {
					renderPan(leftPan, state.left);
					renderPan(rightPan, state.right);
					const leftText = formatSide(state.left);
					const rightText = formatSide(state.right);
					const originalLeftText = formatSide(original.left);
					const originalRightText = formatSide(original.right);
					if (title) title.innerHTML = '<span class="mathjax" data-tex="' + originalLeftText + ' = ' + originalRightText + '"></span>';
					if (workingTitle) workingTitle.innerHTML = '<span class="mathjax" data-tex="' + leftText + ' = ' + rightText + '"></span>';
					if (leftLabel) leftLabel.textContent = leftText;
					if (rightLabel) rightLabel.textContent = rightText;

					const leftValue = sideValue(state.left);
					const rightValue = sideValue(state.right);
					const balanced = leftValue === rightValue;
					setTilt(leftValue, rightValue);

					if (statusBox) statusBox.classList.toggle('is-unbalanced', !balanced);
					if (statusLabel) statusLabel.textContent = balanced ? 'Balanced' : (leftValue > rightValue ? 'Left is heavier' : 'Right is heavier');
					if (message) message.textContent = customMessage || (balanced ? original.hint : 'Not balanced yet. Do the matching operation on the other side.');
					updateSolution(balanced);
					renderMath(game);
				};

				const applySideOperation = (sideName, kind, delta) => {
					const side = state[sideName];
					if (!side) return;
					side[kind] += delta;
					const symbol = delta > 0 ? '+' : '-';
					const item = kind === 'x' ? 'x' : '1';
					render('You changed the working equation on the ' + sideName + ' side by ' + symbol + item + '. Do the matching move on the other side to keep balance.');
				};

				const splitX = () => {
					const leftValue = sideValue(state.left);
					const rightValue = sideValue(state.right);
					if (leftValue !== rightValue) {
						render('Balance the scale first. You can split only when both sides are equal.');
						return;
					}
					if (state.left.x > 1 && state.left.c === 0 && state.right.x === 0) {
						const value = state.right.c / state.left.x;
						state.left.x = 1;
						state.right.c = value;
						currentAnswer = value;
						render('The right side is shared equally between the x groups. Now one x is visible.');
						return;
					}
					if (state.right.x > 1 && state.right.c === 0 && state.left.x === 0) {
						const value = state.left.c / state.right.x;
						state.right.x = 1;
						state.left.c = value;
						currentAnswer = value;
						render('The left side is shared equally between the x groups. Now one x is visible.');
						return;
					}
					render('Split is useful after the equation looks like 2x = 10, 3x = 12, or another x-group equation.');
				};

				const loadProblem = (problem) => {
					original = cloneProblem(problem);
					currentAnswer = original.answer;
					state = {
						left: { ...original.left },
						right: { ...original.right }
					};
					render('New both-sides equation loaded. Keep the original equation fixed while the working equation changes.');
				};

				game.querySelectorAll('[data-side]').forEach((button) => {
					button.addEventListener('click', () => {
						const side = button.getAttribute('data-side');
						const kind = button.getAttribute('data-kind');
						const delta = Number(button.getAttribute('data-delta') || 0);
						if (!side || !kind || !Number.isFinite(delta)) return;
						applySideOperation(side, kind, delta);
					});
				});

				game.querySelector('[data-split-x]')?.addEventListener('click', splitX);
				game.querySelector('[data-reset-balance]')?.addEventListener('click', () => loadProblem(original));
				game.querySelectorAll('[data-random-balance]').forEach((button) => {
					button.addEventListener('click', () => loadProblem(makeRandomProblem()));
				});

				render();
				return { reset: () => loadProblem(original) };
			};

			const makeOption = (option, optionIndex, onSelect) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'option-card';
				if (option.tex) button.classList.add('math-option');
				button.setAttribute('aria-label', 'Option ' + String.fromCharCode(65 + optionIndex) + ': ' + option.label);
				const letter = document.createElement('span');
				letter.className = 'option-letter';
				letter.textContent = String.fromCharCode(65 + optionIndex);
				const content = document.createElement('span');
				content.className = 'option-content';
				if (option.tex) {
					const math = document.createElement('span');
					math.className = 'mathjax';
					math.setAttribute('data-tex', option.label);
					content.appendChild(math);
				} else {
					content.textContent = option.label;
				}
				button.append(letter, content);
				button.addEventListener('click', () => onSelect(button, option));
				return button;
			};

			const setupChoiceGame = (key, items, settings) => {
				const area = root.querySelector('[data-choice-game="' + key + '"]');
				if (!area) return null;
				const prompt = area.querySelector('[data-prompt]');
				const optionsBox = area.querySelector('[data-options]');
				const feedback = area.querySelector('[data-feedback]');
				const round = area.querySelector('[data-round]');
				const next = area.querySelector('[data-next-round]');
				const reset = area.querySelector('[data-reset-game]');
				let index = 0;
				let answered = false;
				let scoredRounds = new Set();

				const render = () => {
					const item = items[index];
					answered = false;
					if (round) round.textContent = settings.roundPrefix + ' ' + (index + 1) + ' / ' + items.length;
					if (feedback) feedback.textContent = settings.defaultFeedback;
					if (prompt) prompt.setAttribute('data-tex', item.prompt);
					if (next) next.textContent = index === items.length - 1 ? 'Finish game' : settings.nextLabel;
					if (optionsBox) {
						optionsBox.innerHTML = '';
						item.options.forEach((option, optionIndex) => {
							optionsBox.appendChild(makeOption(option, optionIndex, (button, selected) => {
								if (answered) return;
								answered = true;
								const correct = selected.label === item.answer;
								button.classList.add(correct ? 'is-correct' : 'is-wrong');
								Array.from(optionsBox.querySelectorAll('.option-card')).forEach((card) => {
									card.disabled = true;
									const content = card.querySelector('.option-content');
									const text = content?.textContent?.trim() || '';
									if (text === item.answer) card.classList.add('is-correct');
								});
								if (feedback) feedback.textContent = correct ? item.correctFeedback : item.wrongFeedback;
								if (correct && !scoredRounds.has(index)) {
									scoredRounds.add(index);
									updateTotalScore(settings.points || 1);
								}
							}));
						});
					}
					renderMath(area);
				};

				next?.addEventListener('click', () => {
					if (index < items.length - 1) {
						index += 1;
						render();
					} else if (feedback) {
						feedback.textContent = settings.finishFeedback || 'Game complete.';
					}
				});

				reset?.addEventListener('click', () => {
					index = 0;
					scoredRounds = new Set();
					render();
				});

				render();
				return { reset: render };
			};

			const setupSteps = () => {
				const area = root.querySelector('[data-step-reveal]');
				if (!area) return null;
				const cards = Array.from(area.querySelectorAll('[data-step]'));
				const next = area.querySelector('[data-next-step]');
				const reset = area.querySelector('[data-reset-steps]');
				let visibleIndex = 0;

				const render = () => {
					cards.forEach((card, i) => card.classList.toggle('is-visible', i <= visibleIndex));
					if (next) next.textContent = visibleIndex >= cards.length - 1 ? 'All steps shown' : 'Next step';
					renderMath(area);
				};

				next?.addEventListener('click', () => {
					visibleIndex = Math.min(cards.length - 1, visibleIndex + 1);
					render();
				});

				reset?.addEventListener('click', () => {
					visibleIndex = 0;
					render();
				});

				render();
				return { reset: () => { visibleIndex = 0; render(); } };
			};

			balanceController = setupBalance();
			stepController = setupSteps();

			choiceControllers.firstmove = setupChoiceGame('firstmove', [
				{ prompt: '4x + 3 = x + 15', answer: 'Subtract x from both sides', options: [{ label: 'Subtract x from both sides' }, { label: 'Subtract 3 from both sides' }, { label: 'Divide by 4' }, { label: 'Add x to both sides' }], correctFeedback: 'Correct. First collect x terms on one side.', wrongFeedback: 'Start by removing the smaller x group from both sides.' },
				{ prompt: '5x - 2 = 2x + 10', answer: 'Subtract 2x from both sides', options: [{ label: 'Subtract 2x from both sides' }, { label: 'Add 2 to both sides' }, { label: 'Divide by 5' }, { label: 'Subtract 10 from both sides' }], correctFeedback: 'Correct. This leaves 3x on the left.', wrongFeedback: 'Handle the x terms first.' },
				{ prompt: '2x + 9 = x + 16', answer: 'Subtract x from both sides', options: [{ label: 'Subtract 9 from both sides' }, { label: 'Subtract x from both sides' }, { label: 'Divide by 2' }, { label: 'Add x to both sides' }], correctFeedback: 'Correct. This leaves x + 9 = 16.', wrongFeedback: 'Remove the smaller x group from both sides.' },
				{ prompt: '6x + 1 = 3x + 19', answer: 'Subtract 3x from both sides', options: [{ label: 'Subtract 3x from both sides' }, { label: 'Subtract 1 from both sides' }, { label: 'Divide by 6' }, { label: 'Add 19 to both sides' }], correctFeedback: 'Correct. This gives 3x + 1 = 19.', wrongFeedback: 'Choose the move that reduces the x terms.' },
				{ prompt: '7x - 4 = 2x + 21', answer: 'Subtract 2x from both sides', options: [{ label: 'Add 4 to both sides' }, { label: 'Subtract 2x from both sides' }, { label: 'Divide by 7' }, { label: 'Subtract 21 from both sides' }], correctFeedback: 'Correct. Then cancel the -4.', wrongFeedback: 'Start with the x terms, then constants.' }
			], { roundPrefix: 'Round', nextLabel: 'Next round', defaultFeedback: 'Choose a move that keeps the equation balanced.', points: 2 });

			choiceControllers.pathway = setupChoiceGame('pathway', [
				{ prompt: '5x - 4 = 2x + 8', answer: '3x - 4 = 8', options: [{ label: '3x - 4 = 8', tex: true }, { label: '5x = 2x + 12', tex: true }, { label: '7x - 4 = 8', tex: true }, { label: '3x = 12', tex: true }], correctFeedback: 'Correct: subtract 2x from both sides.', wrongFeedback: 'The first step should remove 2x from both sides.' },
				{ prompt: '3x - 4 = 8', answer: '3x = 12', options: [{ label: '3x = 12', tex: true }, { label: '3x = 4', tex: true }, { label: 'x - 4 = 8', tex: true }, { label: '3x = -12', tex: true }], correctFeedback: 'Correct: add 4 to both sides.', wrongFeedback: 'Cancel -4 by adding 4 to both sides.' },
				{ prompt: '3x = 12', answer: 'x = 4', options: [{ label: 'x = 4', tex: true }, { label: 'x = 9', tex: true }, { label: 'x = 15', tex: true }, { label: 'x = 36', tex: true }], correctFeedback: 'Correct: divide both sides by 3.', wrongFeedback: 'Share 12 into 3 equal x groups.' },
				{ prompt: 'x = 4', answer: 'Check by substitution', options: [{ label: 'Change x to 0' }, { label: 'Check by substitution' }, { label: 'Add both sides' }, { label: 'Erase the bracket' }], correctFeedback: 'Correct. Substitute x = 4 into the original equation.', wrongFeedback: 'The final step is to check the solution.' }
			], { roundPrefix: 'Step', nextLabel: 'Next step', defaultFeedback: 'Follow the legal balance move.', points: 2 });

			choiceControllers.detective = setupChoiceGame('detective', [
				{ prompt: '3x + 5 = x + 13', answer: 'They subtracted x from one side only.', options: [{ label: 'They subtracted x from one side only.' }, { label: 'They divided too early.' }, { label: 'They forgot the constant.' }, { label: 'There is no mistake.' }], correctFeedback: 'Yes. Any operation must be done to both sides.', wrongFeedback: 'Look for whether the balance was kept.' },
				{ prompt: '4x - 6 = x + 9', answer: 'The sign of -6 was handled incorrectly.', options: [{ label: 'The sign of -6 was handled incorrectly.' }, { label: 'They should add x to both sides.' }, { label: 'x should be zero.' }, { label: 'They cannot subtract x.' }], correctFeedback: 'Correct. To cancel -6, add 6 to both sides.', wrongFeedback: 'Watch the negative constant.' },
				{ prompt: '5x + 2 = 2x + 14', answer: 'They forgot to divide by the coefficient of x.', options: [{ label: 'They forgot to divide by the coefficient of x.' }, { label: 'The equation has no solution.' }, { label: 'They should subtract 14 first.' }, { label: 'The +2 should become +14.' }], correctFeedback: 'Correct. After 3x = 12, divide by 3.', wrongFeedback: 'Think about the last step after isolating the x term.' },
				{ prompt: '2x + 8 = x + 3', answer: 'The solution can be negative.', options: [{ label: 'The solution can be negative.' }, { label: 'The equation is impossible.' }, { label: 'x must always be positive.' }, { label: 'The 8 disappears.' }], correctFeedback: 'Correct. This gives x = -5.', wrongFeedback: 'Equations may have negative answers.' }
			], { roundPrefix: 'Mistake', nextLabel: 'Next mistake', defaultFeedback: 'Find the mistake before solving.', points: 2 });

			choiceControllers.boss = setupChoiceGame('boss', [
				{ prompt: '6x + 4 = 2x + 20', answer: 'x = 4', options: [{ label: 'x = 4', tex: true }, { label: 'x = 6', tex: true }, { label: 'x = 8', tex: true }, { label: 'x = 12', tex: true }], correctFeedback: 'Correct. 4x + 4 = 20, so 4x = 16 and x = 4.', wrongFeedback: 'Remove 2x first, then cancel the constant.' },
				{ prompt: '3x - 5 = x + 7', answer: 'x = 6', options: [{ label: 'x = 4', tex: true }, { label: 'x = 5', tex: true }, { label: 'x = 6', tex: true }, { label: 'x = 12', tex: true }], correctFeedback: 'Correct. 2x - 5 = 7, so 2x = 12.', wrongFeedback: 'Cancel -5 by adding 5.' },
				{ prompt: '5x + 1 = 2x + 16', answer: 'x = 5', options: [{ label: 'x = 3', tex: true }, { label: 'x = 5', tex: true }, { label: 'x = 7', tex: true }, { label: 'x = 15', tex: true }], correctFeedback: 'Correct. 3x + 1 = 16, so 3x = 15.', wrongFeedback: 'Remove 2x first.' },
				{ prompt: '4x - 3 = x + 15', answer: 'x = 6', options: [{ label: 'x = 4', tex: true }, { label: 'x = 5', tex: true }, { label: 'x = 6', tex: true }, { label: 'x = 9', tex: true }], correctFeedback: 'Correct. 3x - 3 = 15, so 3x = 18.', wrongFeedback: 'After removing x, add 3 to both sides.' }
			], { roundPrefix: 'Question', nextLabel: 'Next question', defaultFeedback: 'Choose the value of x.', points: 3 });

			resetSlideButton?.addEventListener('click', () => {
				const slide = slides[currentSlide];
				if (!slide) return;
				slide.querySelectorAll('.hidden-answer.is-visible').forEach((item) => item.classList.remove('is-visible'));
				if (slide.querySelector('[data-balance-game]')) balanceController?.reset();
				if (slide.querySelector('[data-step-reveal]')) stepController?.reset();
				Object.entries(choiceControllers).forEach(([key, controller]) => {
					if (slide.querySelector('[data-choice-game="' + key + '"]')) controller?.reset();
				});
				renderMath(slide);
			});

			document.addEventListener('keydown', (event) => {
				const active = document.activeElement;
				if (active && ['INPUT', 'TEXTAREA', 'SELECT'].includes(active.tagName)) return;
				if (event.key === 'ArrowRight') updateSlide(currentSlide + 1);
				if (event.key === 'ArrowLeft') updateSlide(currentSlide - 1);
			});

			updateSlide(0);
			window.setTimeout(() => renderMath(root), 500);
		})();
	</script>
</Layout>
