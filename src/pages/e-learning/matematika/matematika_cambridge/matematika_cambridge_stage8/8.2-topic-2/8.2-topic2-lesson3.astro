---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 3: Unknowns on Both Sides — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics: solving equations with unknowns on both sides.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<style is:global>
		body:has(.topic2-lesson3) {
			margin: 0;
			overflow: hidden;
			background: #f7f3ed;
		}

		body:has(.topic2-lesson3) header:not(.lesson-topbar),
		body:has(.topic2-lesson3) footer:not(.deck-controls),
		body:has(.topic2-lesson3) .floating-whatsapp,
		body:has(.topic2-lesson3) .whatsapp-float,
		body:has(.topic2-lesson3) .site-header,
		body:has(.topic2-lesson3) .site-footer {
			display: none !important;
		}

		.topic2-lesson3 {
			--navy: #23304d;
			--navy-soft: #314466;
			--orange: #f2761e;
			--sky: #35b6ea;
			--cream: #fff8ee;
			--green: #2f9f65;
			--red: #d75b5b;
			--yellow: #f3bc34;
			--muted: #40506a;
			--line: rgba(35, 48, 77, 0.12);
			min-height: 100vh;
			height: 100vh;
			overflow: hidden;
			background:
				radial-gradient(circle at 12% 18%, rgba(53, 182, 234, 0.12), transparent 28%),
				radial-gradient(circle at 86% 86%, rgba(242, 118, 30, 0.12), transparent 26%),
				#f7f3ed;
			color: var(--navy);
			font-family: 'Figtree', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}

		.topic2-lesson3 * { box-sizing: border-box; }

		.topic2-lesson3 .lesson-shell {
			height: 100vh;
			padding: 10px 14px;
			display: grid;
			grid-template-rows: auto 10px minmax(0, 1fr) auto;
			gap: 8px;
		}

		.topic2-lesson3 .lesson-topbar,
		.topic2-lesson3 .deck-controls,
		.topic2-lesson3 .slide-nav,
		.topic2-lesson3 .slide-stage {
			background: rgba(255, 255, 255, 0.92);
			border: 1px solid var(--line);
			box-shadow: 0 12px 30px rgba(35, 48, 77, 0.06);
		}

		.topic2-lesson3 .lesson-topbar {
			border-radius: 22px;
			padding: 10px 18px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
		}

		.topic2-lesson3 .back-link {
			display: inline-flex;
			text-decoration: none;
			font-weight: 900;
			color: #26526d;
			font-size: 0.88rem;
			margin-bottom: 2px;
		}

		.topic2-lesson3 .eyebrow,
		.topic2-lesson3 .mini-kicker,
		.topic2-lesson3 .round-label {
			margin: 0;
			color: var(--orange);
			font-size: clamp(0.68rem, 0.85vw, 0.82rem);
			font-weight: 950;
			text-transform: uppercase;
			letter-spacing: 0.14em;
		}

		.topic2-lesson3 h1,
		.topic2-lesson3 h2,
		.topic2-lesson3 h3,
		.topic2-lesson3 p { margin-top: 0; }

		.topic2-lesson3 h1 {
			margin-bottom: 0;
			font-size: clamp(1.45rem, 2.5vw, 2.25rem);
			line-height: 0.98;
			font-weight: 950;
			letter-spacing: -0.05em;
		}

		.topic2-lesson3 .topbar-actions {
			display: flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
			justify-content: flex-end;
		}

		.topic2-lesson3 .objective-pill,
		.topic2-lesson3 .score-pill,
		.topic2-lesson3 .fullscreen-toggle,
		.topic2-lesson3 .primary-button,
		.topic2-lesson3 .secondary-button,
		.topic2-lesson3 .teacher-button {
			border: 0;
			border-radius: 999px;
			min-height: 46px;
			padding: 0 18px;
			font-weight: 950;
			font-size: clamp(0.86rem, 1vw, 1rem);
			font-family: inherit;
		}

		.topic2-lesson3 .objective-pill,
		.topic2-lesson3 .teacher-button {
			background: var(--navy);
			color: #ffffff;
		}

		.topic2-lesson3 .score-pill {
			background: #fff1e7;
			color: #c55210;
		}

		.topic2-lesson3 .fullscreen-toggle {
			background: #277fa8;
			color: #ffffff;
			cursor: pointer;
		}

		.topic2-lesson3 .primary-button {
			background: var(--orange);
			color: #ffffff;
			cursor: pointer;
		}

		.topic2-lesson3 .secondary-button {
			background: #eef4f8;
			color: var(--navy);
			cursor: pointer;
		}

		.topic2-lesson3 .primary-button:disabled,
		.topic2-lesson3 .secondary-button:disabled {
			opacity: 0.55;
			cursor: not-allowed;
		}

		.topic2-lesson3 button:focus-visible,
		.topic2-lesson3 a:focus-visible {
			outline: 3px solid var(--sky);
			outline-offset: 3px;
		}

		.topic2-lesson3 .progress-track {
			position: relative;
			border-radius: 999px;
			background: rgba(35, 48, 77, 0.10);
			overflow: hidden;
		}

		.topic2-lesson3 .progress-bar {
			display: block;
			height: 100%;
			width: 10%;
			border-radius: inherit;
			background: linear-gradient(90deg, var(--orange), var(--sky));
			transition: width 0.25s ease;
		}

		.topic2-lesson3 .lesson-main {
			display: grid;
			grid-template-columns: 150px minmax(0, 1fr);
			gap: 12px;
			min-height: 0;
		}

		.topic2-lesson3 .slide-nav {
			border-radius: 20px;
			padding: 14px 10px;
			display: grid;
			gap: 7px;
			align-content: start;
			overflow: hidden;
		}

		.topic2-lesson3 .slide-dot {
			display: grid;
			grid-template-columns: 34px minmax(0, 1fr);
			align-items: center;
			gap: 8px;
			border: 0;
			border-radius: 13px;
			background: transparent;
			color: var(--muted);
			padding: 8px 9px;
			text-align: left;
			font-weight: 950;
			font-family: inherit;
			font-size: 0.82rem;
			cursor: pointer;
		}

		.topic2-lesson3 .slide-dot span {
			display: grid;
			place-items: center;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background: #eef2f5;
			color: var(--navy);
		}

		.topic2-lesson3 .slide-dot.is-active {
			background: var(--navy);
			color: #ffffff;
		}

		.topic2-lesson3 .slide-dot.is-active span {
			background: #ffffff;
			color: var(--navy);
		}

		.topic2-lesson3 .slide-stage {
			border-radius: 26px;
			padding: clamp(18px, 2vw, 26px);
			overflow: hidden;
			min-height: 0;
		}

		.topic2-lesson3 .lesson-slide {
			display: none;
			height: 100%;
			min-height: 0;
			overflow: hidden;
			flex-direction: column;
		}

		.topic2-lesson3 .lesson-slide.is-active {
			display: flex;
		}

		.topic2-lesson3 .slide-label {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 8px;
			color: var(--muted);
			font-weight: 950;
		}

		.topic2-lesson3 .slide-label span {
			padding: 8px 14px;
			border-radius: 999px;
			background: #fff1e7;
			border: 1px solid rgba(242, 118, 30, 0.20);
			color: var(--orange);
		}

		.topic2-lesson3 h2 {
			margin: 8px 0 10px;
			font-size: clamp(2rem, 4.2vw, 4.8rem);
			line-height: 0.95;
			letter-spacing: -0.055em;
			font-weight: 950;
			color: var(--navy);
		}

		.topic2-lesson3 h3 {
			margin-bottom: 8px;
			font-weight: 950;
			color: var(--navy);
		}

		.topic2-lesson3 .slide-lede,
		.topic2-lesson3 .tight-lede {
			margin: 0 0 12px;
			font-size: clamp(1rem, 1.25vw, 1.28rem);
			line-height: 1.35;
			color: #53627a;
			font-weight: 700;
		}

		.topic2-lesson3 .deck-controls {
			border-radius: 20px;
			padding: 10px 12px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
		}

		.topic2-lesson3 .hero-grid,
		.topic2-lesson3 .two-column,
		.topic2-lesson3 .recap-grid,
		.topic2-lesson3 .exit-grid {
			display: grid;
			grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.75fr);
			gap: 16px;
			min-height: 0;
		}

		.topic2-lesson3 .mission-card,
		.topic2-lesson3 .time-card,
		.topic2-lesson3 .callout-card,
		.topic2-lesson3 .method-card,
		.topic2-lesson3 .game-card,
		.topic2-lesson3 .mini-panel,
		.topic2-lesson3 .sample-answer,
		.topic2-lesson3 .exit-item {
			border: 1px solid var(--line);
			border-radius: 24px;
			background: #ffffff;
			box-shadow: 0 12px 30px rgba(35, 48, 77, 0.06);
			padding: 18px;
		}

		.topic2-lesson3 .mission-card {
			background: linear-gradient(135deg, #ffffff, #f3fbff);
		}

		.topic2-lesson3 .mission-card ul {
			margin: 12px 0 0;
			padding-left: 22px;
			color: var(--muted);
			font-weight: 800;
			font-size: clamp(1rem, 1.2vw, 1.2rem);
			line-height: 1.5;
		}

		.topic2-lesson3 .time-card {
			display: grid;
			place-items: center;
			text-align: center;
			background: linear-gradient(145deg, var(--navy), #35507d);
			color: #ffffff;
		}

		.topic2-lesson3 .time-card span {
			font-size: clamp(4rem, 8vw, 7rem);
			line-height: 0.9;
			font-weight: 950;
		}

		.topic2-lesson3 .time-card strong,
		.topic2-lesson3 .time-card p { color: #ffffff; }

		.topic2-lesson3 .time-card p {
			margin: 12px 0 0;
			line-height: 1.4;
			font-weight: 700;
			opacity: 0.92;
		}

		/* Option cards are global because several cards are created by JavaScript. */
		.topic2-lesson3 .option-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
			margin-top: 10px;
		}

		.topic2-lesson3 .option-card {
			position: relative;
			min-height: 78px;
			padding: 0;
			border: 2px solid rgba(35,48,77,0.12);
			background: linear-gradient(180deg, #ffffff, #f8fbff);
			color: var(--navy);
			border-radius: 20px;
			overflow: hidden;
			font: inherit;
			cursor: pointer;
			text-align: left;
			display: grid;
			grid-template-columns: 58px minmax(0, 1fr);
			box-shadow: 0 8px 18px rgba(35, 48, 77, 0.06);
			transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
		}

		.topic2-lesson3 .option-card:hover,
		.topic2-lesson3 .option-card:focus-visible {
			transform: translateY(-2px);
			border-color: var(--sky);
			box-shadow: 0 12px 24px rgba(62, 182, 234, 0.18);
			outline: none;
		}

		.topic2-lesson3 .option-letter {
			display: grid;
			place-items: center;
			background: var(--navy);
			color: #ffffff;
			font-weight: 950;
			font-size: 1.05rem;
		}

		.topic2-lesson3 .option-content {
			display: grid;
			align-content: center;
			justify-items: center;
			padding: 12px 14px;
			min-width: 0;
			font-size: clamp(0.95rem, 1.2vw, 1.15rem);
			font-weight: 950;
			line-height: 1.22;
			text-align: center;
		}

		.topic2-lesson3 .option-card.math-option .option-content {
			font-size: clamp(1.1rem, 1.7vw, 1.75rem);
		}

		.topic2-lesson3 .option-card.is-correct {
			border-color: var(--green);
			background: #ecfdf3;
		}

		.topic2-lesson3 .option-card.is-correct .option-letter { background: var(--green); }

		.topic2-lesson3 .option-card.is-wrong {
			border-color: var(--red);
			background: #fff1f1;
		}

		.topic2-lesson3 .option-card.is-wrong .option-letter { background: var(--red); }

		.topic2-lesson3 .feedback-line,
		.topic2-lesson3 .status-line {
			margin: 10px 0 0;
			padding: 12px 14px;
			border-radius: 16px;
			background: #f7f8fb;
			color: var(--navy);
			font-weight: 900;
			line-height: 1.25;
		}

		.topic2-lesson3 .equation-banner {
			display: grid;
			place-items: center;
			min-height: 110px;
			border-radius: 24px;
			background: linear-gradient(145deg, #fff3e9, #eef9ff);
			border: 1px solid rgba(35,48,77,0.08);
			font-size: clamp(2.4rem, 5vw, 5.4rem);
			color: var(--navy);
			font-weight: 950;
		}

		/* Balance simulator */
		.topic2-lesson3 .balance-solver {
			display: grid;
			grid-template-rows: auto minmax(245px, 1fr) auto;
			gap: 10px;
			flex: 1 1 auto;
			min-height: 0;
		}

		.topic2-lesson3 .solver-top-row {
			display: grid;
			grid-template-columns: minmax(250px, 0.55fr) minmax(0, 1fr);
			gap: 10px;
			align-items: stretch;
		}

		.topic2-lesson3 .equation-strip,
		.topic2-lesson3 .solver-message,
		.topic2-lesson3 .solution-panel,
		.topic2-lesson3 .balance-buttons {
			border-radius: 18px;
			border: 1px solid rgba(35,48,77,0.12);
			background: #ffffff;
			box-shadow: 0 8px 18px rgba(35,48,77,0.05);
		}

		.topic2-lesson3 .equation-strip {
			padding: 11px 14px;
			display: grid;
			gap: 4px;
			align-content: center;
			background: linear-gradient(135deg, #fff8ee, #f3fbff);
		}

		.topic2-lesson3 .equation-strip span,
		.topic2-lesson3 .solution-panel span {
			color: var(--orange);
			font-size: 0.7rem;
			font-weight: 950;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.topic2-lesson3 .equation-strip strong {
			font-size: clamp(1.45rem, 2.6vw, 2.75rem);
			line-height: 1;
			color: var(--navy);
		}

		.topic2-lesson3 .solver-message {
			display: flex;
			align-items: center;
			padding: 12px 16px;
			color: #34445f;
			font-weight: 850;
			line-height: 1.28;
		}

		.topic2-lesson3 .solver-board {
			position: relative;
			display: grid;
			grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr);
			gap: 12px;
			align-items: end;
			min-height: 0;
			padding: 16px 18px 24px;
			border-radius: 24px;
			border: 1px solid rgba(35,48,77,0.12);
			background: linear-gradient(180deg, #f5f7f8, #ffffff);
			overflow: hidden;
			--tilt: 0deg;
			--left-shift: 0px;
			--right-shift: 0px;
		}

		.topic2-lesson3 .solver-board.is-left-heavy {
			--tilt: -4.2deg;
			--left-shift: 16px;
			--right-shift: -8px;
		}

		.topic2-lesson3 .solver-board.is-right-heavy {
			--tilt: 4.2deg;
			--left-shift: -8px;
			--right-shift: 16px;
		}

		.topic2-lesson3 .solver-side {
			position: relative;
			display: grid;
			grid-template-rows: auto minmax(0, 1fr);
			gap: 9px;
			min-width: 0;
			align-self: end;
			z-index: 2;
			transition: transform 0.36s ease;
		}

		.topic2-lesson3 .solver-side.side-left { transform: translateY(var(--left-shift)); }
		.topic2-lesson3 .solver-side.side-right { transform: translateY(var(--right-shift)); }

		.topic2-lesson3 .side-title {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
			padding: 7px 10px;
			border-radius: 14px;
			background: rgba(255,255,255,0.94);
			border: 1px solid rgba(35,48,77,0.10);
		}

		.topic2-lesson3 .side-title strong { font-size: 0.9rem; color: var(--navy); }

		.topic2-lesson3 .side-title small {
			padding: 5px 9px;
			border-radius: 999px;
			background: #eef4f8;
			color: var(--navy);
			font-weight: 950;
		}

		.topic2-lesson3 .solver-pan {
			position: relative;
			display: flex;
			align-items: end;
			justify-content: center;
			flex-wrap: wrap-reverse;
			gap: 8px;
			min-height: 178px;
			padding: 18px 16px 28px;
			margin-bottom: 48px;
			border-radius: 22px 22px 14px 14px;
			border-bottom: 16px solid #9a4f19;
			background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(244,248,250,0.94));
			box-shadow: inset 0 0 0 1px rgba(35,48,77,0.08), 0 10px 18px rgba(35,48,77,0.06);
			overflow: hidden;
		}

		.topic2-lesson3 .solver-pan::after {
			content: '';
			position: absolute;
			left: 8%;
			right: 8%;
			bottom: 11px;
			height: 9px;
			border-radius: 999px;
			background: #8b4518;
		}

		.topic2-lesson3 .solver-tile {
			display: grid;
			place-items: center;
			min-width: 58px;
			height: 44px;
			padding: 0 12px;
			border-radius: 11px 11px 8px 8px;
			border: 2px solid rgba(35,48,77,0.28);
			font-weight: 950;
			font-size: clamp(0.95rem, 1.2vw, 1.2rem);
			box-shadow: inset 0 -4px rgba(0,0,0,.08), 0 4px 0 rgba(35,48,77,0.10);
			animation: solver-pop 0.26s ease both;
			animation-delay: var(--delay, 0ms);
		}

		.topic2-lesson3 .solver-tile.x-tile { background: #5aa4ec; color: #ffffff; }
		.topic2-lesson3 .solver-tile.unit-tile { background: #ffd22e; color: #111827; }
		.topic2-lesson3 .solver-tile.negative-tile { background: #ef5b5b; color: #ffffff; }

		@keyframes solver-pop {
			0% { transform: translateY(-10px) scale(0.94); opacity: 0; }
			100% { transform: translateY(0) scale(1); opacity: 1; }
		}

		.topic2-lesson3 .solver-middle {
			position: absolute;
			inset: 0;
			display: grid;
			place-items: center;
			pointer-events: none;
		}

		.topic2-lesson3 .solver-equals {
			position: absolute;
			top: 16px;
			left: 50%;
			transform: translateX(-50%);
			z-index: 2;
			display: grid;
			place-items: center;
			width: 52px;
			height: 52px;
			border-radius: 50%;
			background: var(--navy);
			color: #ffffff;
			font-size: 1.8rem;
			font-weight: 950;
		}

		.topic2-lesson3 .solver-beam {
			position: absolute;
			left: 50%;
			bottom: 56px;
			width: calc(100% - 110px);
			height: 15px;
			border-radius: 999px;
			background: #9a4f19;
			transform: translateX(-50%) rotate(var(--tilt));
			transform-origin: 50% 50%;
			transition: transform 0.36s ease;
		}

		.topic2-lesson3 .solver-stand {
			position: absolute;
			bottom: 16px;
			left: 50%;
			transform: translateX(-50%);
			width: 0;
			height: 0;
			border-left: 32px solid transparent;
			border-right: 32px solid transparent;
			border-bottom: 80px solid #9a4f19;
		}

		.topic2-lesson3 .solver-bottom-row {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
			gap: 10px;
			align-items: stretch;
			min-height: 0;
		}

		.topic2-lesson3 .balance-buttons {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 8px;
			padding: 9px;
		}

		.topic2-lesson3 .balance-buttons .primary-button,
		.topic2-lesson3 .balance-buttons .secondary-button {
			min-height: 40px;
			padding: 8px 10px;
			border-radius: 14px;
			font-size: clamp(0.72rem, 0.9vw, 0.92rem);
		}

		.topic2-lesson3 .solution-panel {
			display: grid;
			gap: 5px;
			align-content: center;
			padding: 10px 12px;
			background: #fff8ee;
		}

		.topic2-lesson3 .solution-panel strong {
