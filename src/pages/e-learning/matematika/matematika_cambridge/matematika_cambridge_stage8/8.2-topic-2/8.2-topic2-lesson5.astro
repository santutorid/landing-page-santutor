---
import Layout from '../../../../../../layouts/Layout.astro';

const pageTitle = 'Lesson 5: Open and Closed Intervals — Cambridge Stage 8 Mathematics';
const pageDescription = 'Interactive IFP teaching deck for Cambridge Lower Secondary Stage 8 Mathematics: open and closed intervals on a number line.';
const pageTitleEn = pageTitle;
const pageDescriptionEn = pageDescription;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	titleEn={pageTitleEn}
	descriptionEn={pageDescriptionEn}
	ogTitle={pageTitle}
	ogDescription={pageDescription}
	ogTitleEn={pageTitleEn}
	ogDescriptionEn={pageDescriptionEn}
	currentPage="math"
>
	<script is:inline type="text/javascript">
		// @ts-nocheck
		window.MathJax = {
			startup: { typeset: false },
			chtml: { scale: 1.04, matchFontHeight: false }
		};
	</script>
	<script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

	<main id="top" class="ifp-lesson-page topic2-lesson5">
		<section class="lesson-shell" data-lesson-root>
			<header class="lesson-topbar">
				<div class="lesson-title-block">
					<a class="back-link" href="/e-learning/matematika/matematika_cambridge/matematika_cambridge_stage8/8.2-topic-2">← Back to Topic 2</a>
					<p class="eyebrow">Cambridge Stage 8 · Unit 8.2 Topic 2</p>
					<h1>Lesson 5: Open and Closed Intervals</h1>
				</div>
				<div class="topbar-actions">
					<span class="objective-pill">8Ae.07</span>
					<span class="score-pill">Score <strong data-total-score>0</strong></span>
					<button class="fullscreen-toggle" type="button" data-fullscreen-toggle>⛶ Present Full Screen</button>
				</div>
			</header>

			<div class="deck-layout">
				<nav class="slide-nav" aria-label="Lesson slides">
					<button type="button" class="slide-dot is-active" data-go-slide="0"><span>1</span>Goal</button>
					<button type="button" class="slide-dot" data-go-slide="1"><span>2</span>Theory</button>
					<button type="button" class="slide-dot" data-go-slide="2"><span>3</span>Explore</button>
					<button type="button" class="slide-dot" data-go-slide="3"><span>4</span>Builder</button>
					<button type="button" class="slide-dot" data-go-slide="4"><span>5</span>Convert</button>
					<button type="button" class="slide-dot" data-go-slide="5"><span>6</span>Dots</button>
					<button type="button" class="slide-dot" data-go-slide="6"><span>7</span>Sort</button>
					<button type="button" class="slide-dot" data-go-slide="7"><span>8</span>Integers</button>
					<button type="button" class="slide-dot" data-go-slide="8"><span>9</span>Board</button>
					<button type="button" class="slide-dot" data-go-slide="9"><span>10</span>Exit</button>
				</nav>

				<section class="slide-stage" aria-live="polite">
					<article class="lesson-slide is-active" data-slide data-slide-title="Goal">
						<div class="slide-label"><span>Slide 1</span><strong>Lesson Goal</strong></div>
						<p class="mini-kicker">Today’s mission</p>
						<div class="hero-grid">
							<div>
								<h2>Read intervals like a mathematician.</h2>
								<p class="slide-lede">Students connect inequality signs, open/closed endpoints, interval notation, and number-line shading.</p>
								<div class="success-box">
									<h3>By the end, students can:</h3>
									<ul>
										<li>explain the difference between open and closed endpoints</li>
										<li>write simple intervals using brackets and parentheses</li>
										<li>match interval notation to inequalities and number lines</li>
										<li>list integer solutions inside an interval</li>
									</ul>
								</div>
							</div>
							<div class="badge-card blue-card">
								<span>8Ae.07</span>
								<strong>open & closed intervals</strong>
								<p>Best taught visually: endpoints first, notation second, integer solutions last.</p>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Theory Foundation">
						<div class="slide-label"><span>Slide 2</span><strong>Theory Foundation</strong></div>
						<p class="mini-kicker">Core concepts before the activities</p>
						<h2>Intervals show a set of numbers.</h2>
						<div class="theory-grid interval-theory-grid">
							<div class="theory-card main-theory">
								<span class="card-tag">Big idea</span>
								<h3>An interval is a continuous part of the number line.</h3>
								<p>It may include one endpoint, both endpoints, or no endpoints. The endpoint rule depends on the symbol.</p>
								<div class="math-strip"><span class="mathjax" data-tex="-2 &lt; x ≤ 4"></span></div>
								<p class="teacher-cue">Ask: “Does −2 count? Does 4 count? How do you know?”</p>
							</div>
							<div class="symbol-board">
								<div><strong>(</strong><span>open left endpoint</span><small>not included</small></div>
								<div><strong>[</strong><span>closed left endpoint</span><small>included</small></div>
								<div><strong>)</strong><span>open right endpoint</span><small>not included</small></div>
								<div><strong>]</strong><span>closed right endpoint</span><small>included</small></div>
							</div>
						</div>
						<div class="concept-row">
							<div><strong><span class="mathjax" data-tex="x &gt; 3"></span></strong><p>Use open circle. Interval notation: <span class="mathjax" data-tex="(3,\infty)"></span></p></div>
							<div><strong><span class="mathjax" data-tex="x ≤ 5"></span></strong><p>Use closed circle. Interval notation: <span class="mathjax" data-tex="(-\infty,5]"></span></p></div>
							<div><strong><span class="mathjax" data-tex="-1 &lt; x ≤ 4"></span></strong><p>One open endpoint and one closed endpoint: <span class="mathjax" data-tex="(-1,4]"></span></p></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Interval Explorer">
						<div class="slide-label"><span>Slide 3</span><strong>Interactive Concept</strong></div>
						<p class="mini-kicker">Open and closed endpoints</p>
						<h2>Watch intervals appear on a number line.</h2>
						<div class="interval-lab" data-interval-lab>
							<div class="interval-top-grid">
								<section class="interval-select-card" aria-label="Choose an interval">
									<div class="lab-top compact-lab-top">
										<div>
											<span class="round-label">Selected interval</span>
											<strong data-interval-title><span class="mathjax" data-tex="(-2,4]"></span></strong>
										</div>
										<button type="button" class="primary-button" data-interval-random>Random</button>
									</div>
									<p class="interval-help">Select a card. The number line will show which endpoint is included and where the solution set is shaded.</p>
									<div class="interval-choice-grid" data-interval-choices></div>
								</section>
								<section class="interval-meaning-card" aria-label="Meaning of the selected interval">
									<span class="round-label">Meaning</span>
									<h3 data-interval-meaning-title>x is greater than −2 and less than or equal to 4.</h3>
									<p data-interval-meaning-text>−2 is not included, but 4 is included. The solution is the part between them.</p>
									<div class="endpoint-key">
										<span><i class="open-dot"></i> open: not included</span>
										<span><i class="closed-dot"></i> closed: included</span>
									</div>
								</section>
							</div>
							<div class="interval-numberline-card">
								<div class="interval-numberline" data-interval-track>
									<div class="line-axis"></div>
									<div class="line-fill" data-line-fill></div>
									<div class="left-endpoint" data-left-endpoint></div>
									<div class="right-endpoint" data-right-endpoint></div>
									<div class="left-arrow" data-left-arrow>←</div>
									<div class="right-arrow" data-right-arrow>→</div>
									<div class="test-line" data-test-line></div>
									<div class="test-dot" data-test-dot></div>
									<div class="test-label" data-test-label>x = 0</div>
									<div class="interval-ticks" data-interval-ticks></div>
								</div>
								<div class="probe-controls compact-probe-controls">
									<button type="button" class="secondary-button" data-test-left>← Move left</button>
									<label>Test value <input type="range" min="-6" max="6" step="1" value="0" data-test-slider /></label>
									<button type="button" class="secondary-button" data-test-right>Move right →</button>
								</div>
							</div>
							<div class="interval-feedback" data-interval-feedback>Move the test point to check if the number belongs to the interval.</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Interval Builder">
						<div class="slide-label"><span>Slide 4</span><strong>Builder</strong></div>
						<p class="mini-kicker">Build the notation yourself</p>
						<h2>Choose endpoints and brackets.</h2>
						<div class="builder-lab" data-builder-lab>
							<div class="builder-controls">
								<label>Left endpoint
									<select data-builder-left>
										<option value="-5">−5</option><option value="-4">−4</option><option value="-3">−3</option><option value="-2" selected>−2</option><option value="-1">−1</option><option value="0">0</option><option value="1">1</option><option value="2">2</option>
									</select>
								</label>
								<label>Left endpoint type
									<select data-builder-left-closed>
										<option value="open" selected>open: not included</option>
										<option value="closed">closed: included</option>
									</select>
								</label>
								<label>Right endpoint
									<select data-builder-right>
										<option value="-1">−1</option><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4" selected>4</option><option value="5">5</option><option value="6">6</option>
									</select>
								</label>
								<label>Right endpoint type
									<select data-builder-right-closed>
										<option value="open">open: not included</option>
										<option value="closed" selected>closed: included</option>
									</select>
								</label>
							</div>
							<div class="builder-output-grid">
								<div class="builder-output-card"><span class="round-label">Interval notation</span><strong data-builder-interval><span class="mathjax" data-tex="(-2,4]"></span></strong></div>
								<div class="builder-output-card"><span class="round-label">Inequality notation</span><strong data-builder-inequality><span class="mathjax" data-tex="-2 &lt; x ≤ 4"></span></strong></div>
								<div class="builder-output-card explanation-card"><span class="round-label">Endpoint meaning</span><p data-builder-message>−2 is open, so it is not included. 4 is closed, so it is included.</p></div>
							</div>
							<div class="mini-numberline" data-builder-line>
								<div class="line-axis"></div>
								<div class="line-fill" data-builder-fill></div>
								<div class="left-endpoint" data-builder-left-point></div>
								<div class="right-endpoint" data-builder-right-point></div>
								<div class="interval-ticks" data-builder-ticks></div>
							</div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Convert">
						<div class="slide-label"><span>Slide 5</span><strong>Game 1</strong></div>
						<p class="mini-kicker">Inequality to interval notation</p>
						<h2>Convert the statement.</h2>
						<div class="choice-game" data-convert-game>
							<div class="game-header">
								<div><span class="round-label" data-convert-round>Round 1 / 5</span><h3>Which interval notation matches this inequality?</h3></div>
								<div class="local-score"><span>Score</span><strong data-convert-score>0</strong></div>
							</div>
							<div class="big-expression"><span data-convert-prompt class="mathjax" data-tex="x ≥ -3"></span></div>
							<div class="option-grid compact-options" data-convert-options></div>
							<p class="feedback-line" data-convert-feedback>Look at whether the endpoint is included.</p>
							<div class="button-row"><button type="button" class="secondary-button" data-convert-next>Next round</button><button type="button" class="secondary-button" data-convert-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Dots">
						<div class="slide-label"><span>Slide 6</span><strong>Game 2</strong></div>
						<p class="mini-kicker">Open circle or closed circle?</p>
						<h2>Choose the correct endpoint.</h2>
						<div class="dot-game" data-dot-game>
							<div class="dot-question-card">
								<span class="round-label" data-dot-round>Round 1 / 6</span>
								<strong data-dot-prompt><span class="mathjax" data-tex="x &lt; 5"></span></strong>
								<p>At the boundary number, should the circle be open or closed?</p>
							</div>
							<div class="dot-choice-row">
								<button type="button" class="dot-choice" data-dot-answer="open"><i class="open-dot big-dot"></i><strong>Open circle</strong><span>endpoint not included</span></button>
								<button type="button" class="dot-choice" data-dot-answer="closed"><i class="closed-dot big-dot"></i><strong>Closed circle</strong><span>endpoint included</span></button>
							</div>
							<p class="feedback-line" data-dot-feedback>Read the symbol carefully.</p>
							<div class="button-row"><button type="button" class="secondary-button" data-dot-next>Next prompt</button><button type="button" class="secondary-button" data-dot-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Sort">
						<div class="slide-label"><span>Slide 7</span><strong>Game 3</strong></div>
						<p class="mini-kicker">Classify the interval</p>
						<h2>Sort each interval card.</h2>
						<div class="sort-game" data-sort-game>
							<div class="sort-card-display">
								<span class="round-label" data-sort-round>Card 1 / 6</span>
								<strong data-sort-card><span class="mathjax" data-tex="[-1,3)"></span></strong>
								<p>Look at both endpoints before choosing a category.</p>
							</div>
							<div class="sort-buttons">
								<button type="button" class="sort-button" data-sort-answer="open-open">open–open</button>
								<button type="button" class="sort-button" data-sort-answer="closed-closed">closed–closed</button>
								<button type="button" class="sort-button" data-sort-answer="open-closed">open–closed</button>
								<button type="button" class="sort-button" data-sort-answer="closed-open">closed–open</button>
							</div>
							<p class="feedback-line" data-sort-feedback>Parentheses are open; square brackets are closed.</p>
							<div class="button-row"><button type="button" class="secondary-button" data-sort-next>Next card</button><button type="button" class="secondary-button" data-sort-reset>Reset game</button></div>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Integer Solutions">
						<div class="slide-label"><span>Slide 8</span><strong>Integer Solutions</strong></div>
						<p class="mini-kicker">Which whole numbers are inside?</p>
						<h2>Tap the integer solutions.</h2>
						<div class="integer-game" data-integer-game>
							<div class="integer-prompt-card">
								<span class="round-label">Interval</span>
								<strong data-integer-prompt><span class="mathjax" data-tex="(-3,2]"></span></strong>
								<p data-integer-help>Choose all integers greater than −3 and up to 2.</p>
							</div>
							<div class="integer-buttons" data-integer-buttons></div>
							<div class="button-row">
								<button type="button" class="primary-button" data-integer-check>Check answers</button>
								<button type="button" class="secondary-button" data-integer-new>New interval</button>
								<button type="button" class="secondary-button" data-integer-reset>Clear</button>
							</div>
							<p class="feedback-line" data-integer-feedback>Tap the integers that are included in the interval.</p>
						</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Board Challenge">
						<div class="slide-label"><span>Slide 9</span><strong>Board Challenge</strong></div>
						<p class="mini-kicker">Pair or team task</p>
						<h2>Draw, write, explain.</h2>
						<div class="board-grid">
							<div class="board-card">
								<span class="round-label">Challenge A</span>
								<strong><span class="mathjax" data-tex="[-4,1)"></span></strong>
								<p>Draw the number line and list the integer solutions.</p>
							</div>
							<div class="board-card">
								<span class="round-label">Challenge B</span>
								<strong><span class="mathjax" data-tex="-2 ≤ x &lt; 5"></span></strong>
								<p>Write the interval notation and explain the endpoint types.</p>
							</div>
							<div class="board-card">
								<span class="round-label">Challenge C</span>
								<strong><span class="mathjax" data-tex="x &gt; 0"></span></strong>
								<p>Write interval notation, then give three values that work.</p>
							</div>
							<div class="board-card">
								<span class="round-label">Challenge D</span>
								<strong><span class="mathjax" data-tex="(-\infty,3]"></span></strong>
								<p>Write the inequality and describe the shaded direction.</p>
							</div>
						</div>
						<div class="teacher-cue large-cue">Teacher check: Students must mention both the endpoint symbol and whether the endpoint is included.</div>
					</article>

					<article class="lesson-slide" data-slide data-slide-title="Exit Ticket">
						<div class="slide-label"><span>Slide 10</span><strong>Exit Ticket</strong></div>
						<p class="mini-kicker">3-minute individual check</p>
						<h2>Can you read the interval correctly?</h2>
						<div class="exit-grid">
							<div class="exit-card"><strong>1</strong><p>Write the inequality for <span class="mathjax" data-tex="(1,6]"></span>.</p></div>
							<div class="exit-card"><strong>2</strong><p>Draw a number line for <span class="mathjax" data-tex="x ≤ -2"></span>.</p></div>
							<div class="exit-card"><strong>3</strong><p>List the integer solutions for <span class="mathjax" data-tex="[-3,2)"></span>.</p></div>
						</div>
						<div class="answer-card">
							<span class="round-label">Teacher quick answer</span>
							<p>1) <span class="mathjax" data-tex="1 &lt; x ≤ 6"></span> · 2) closed circle at −2, shade left · 3) −3, −2, −1, 0, 1.</p>
						</div>
					</article>
				</section>
			</div>

			<footer class="lesson-controls" aria-label="Lesson controls">
				<button type="button" class="nav-control" data-prev-slide>Back</button>
				<button type="button" class="teacher-notes-toggle" data-notes-toggle>Teacher Notes</button>
				<button type="button" class="nav-control" data-reset-slide>Reset Slide</button>
				<button type="button" class="next-control" data-next-slide>Next</button>
			</footer>

			<aside class="teacher-notes" data-teacher-notes aria-hidden="true">
				<div>
					<button type="button" class="notes-close" data-notes-close>×</button>
					<h2 data-notes-title>Teacher Notes</h2>
					<p data-notes-body>Use this slide to ask students to explain the endpoint first before writing the notation.</p>
				</div>
			</aside>
		</section>
	</main>

	<style is:global>
		.topic2-lesson5 {
			--navy: #202f50;
			--navy-2: #2d3d63;
			--orange: #f2761e;
			--blue: #3eb6ea;
			--sky: #eaf7fc;
			--cream: #fffaf2;
			--paper: #f7f5f0;
			--line: #d9e2ea;
			--soft: #f3f7fa;
			--green: #2fa36c;
			--red: #df5a5a;
			color: var(--navy);
			font-family: 'Nunito', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}

		.topic2-lesson5 * { box-sizing: border-box; }
		.topic2-lesson5 button,
		.topic2-lesson5 select,
		.topic2-lesson5 input { font: inherit; }
		.topic2-lesson5 button { cursor: pointer; }
		.topic2-lesson5 button:focus-visible,
		.topic2-lesson5 select:focus-visible,
		.topic2-lesson5 input:focus-visible { outline: 3px solid rgba(62, 182, 234, .8); outline-offset: 3px; }

		.topic2-lesson5 .lesson-shell {
			min-height: 100vh;
			padding: 12px;
			background: radial-gradient(circle at 12% 0%, rgba(62, 182, 234, .18), transparent 26rem), linear-gradient(135deg, #f8fafc 0%, #fff8ef 48%, #eef8fb 100%);
		}

		.topic2-lesson5 .lesson-topbar,
		.topic2-lesson5 .lesson-controls,
		.topic2-lesson5 .slide-nav,
		.topic2-lesson5 .slide-stage { border: 1px solid var(--line); box-shadow: 0 12px 28px rgba(32, 47, 80, .08); }

		.topic2-lesson5 .lesson-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
			min-height: 96px;
			padding: 14px 20px;
			border-radius: 26px;
			background: rgba(255,255,255,.92);
		}
		.topic2-lesson5 .back-link { color: #1c5c80; text-decoration: none; font-weight: 900; }
		.topic2-lesson5 .eyebrow,
		.topic2-lesson5 .mini-kicker { margin: 6px 0 0; color: var(--orange); font-size: 12px; font-weight: 1000; text-transform: uppercase; letter-spacing: .18em; }
		.topic2-lesson5 .lesson-title-block h1 { margin: 3px 0 0; color: var(--navy); font-size: clamp(23px, 2.2vw, 34px); line-height: .96; letter-spacing: -.04em; font-weight: 1000; }
		.topic2-lesson5 .topbar-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
		.topic2-lesson5 .objective-pill,
		.topic2-lesson5 .score-pill,
		.topic2-lesson5 .fullscreen-toggle { border: 0; border-radius: 999px; padding: 12px 18px; font-weight: 1000; white-space: nowrap; }
		.topic2-lesson5 .objective-pill { background: var(--sky); color: var(--navy); }
		.topic2-lesson5 .score-pill { background: #fff2e9; color: #c64d07; }
		.topic2-lesson5 .fullscreen-toggle { background: var(--orange); color: white; box-shadow: 0 6px 0 #bd550e; }

		.topic2-lesson5 .deck-layout { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 12px; margin-top: 12px; }
		.topic2-lesson5 .slide-nav { display: flex; flex-direction: column; gap: 8px; padding: 12px; border-radius: 24px; background: rgba(255,255,255,.92); }
		.topic2-lesson5 .slide-dot { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 45px; border: 0; border-radius: 18px; padding: 8px 10px; background: white; color: #4e5e77; font-size: 13px; font-weight: 1000; text-align: left; box-shadow: 0 5px 14px rgba(32,47,80,.05); }
		.topic2-lesson5 .slide-dot span { display: inline-flex; width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 50%; background: #edf4f8; color: var(--navy); flex: 0 0 auto; }
		.topic2-lesson5 .slide-dot.is-active { background: var(--navy); color: white; }
