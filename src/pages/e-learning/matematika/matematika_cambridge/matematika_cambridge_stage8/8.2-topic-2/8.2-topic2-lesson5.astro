				return String(text).replaceAll('-', '−');
			}

			function setMath(node, tex) {
				if (!node) return;
				node.dataset.tex = tex;
				node.textContent = '\\(' + tex + '\\)';
			}

			function prepareMath(scope) {
				(scope || document).querySelectorAll('.mathjax[data-tex]').forEach((node) => {
					const tex = node.dataset.tex || '';
					if (!node.textContent.trim() || !node.textContent.includes('\\(')) {
						node.textContent = '\\(' + tex + '\\)';
					}
				});
			}

			function renderMath(scope) {
				prepareMath(scope || root);
				if (window.MathJax && typeof window.MathJax.typesetPromise === 'function') {
					window.MathJax.typesetPromise(scope ? [scope] : undefined).catch(() => {});
				}
			}

			function updateScore(points) {
				score += points;
				if (score < 0) score = 0;
				if (totalScore) totalScore.textContent = String(score);
			}

			function showSlide(index) {
				currentSlide = Math.max(0, Math.min(slides.length - 1, index));
				slides.forEach((slide, i) => slide.classList.toggle('is-active', i === currentSlide));
				navButtons.forEach((button, i) => button.classList.toggle('is-active', i === currentSlide));
				const title = root.querySelector('[data-notes-title]');
				const body = root.querySelector('[data-notes-body]');
				if (title) title.textContent = 'Teacher Notes — Slide ' + (currentSlide + 1);
				if (body) body.textContent = notes[currentSlide] || 'Ask students to explain their reasoning.';
				renderMath(slides[currentSlide]);
			}

			navButtons.forEach((button, index) => button.addEventListener('click', () => showSlide(index)));
			root.querySelector('[data-next-slide]')?.addEventListener('click', () => showSlide(currentSlide + 1));
			root.querySelector('[data-prev-slide]')?.addEventListener('click', () => showSlide(currentSlide - 1));
			root.querySelector('[data-reset-slide]')?.addEventListener('click', () => {
				if (currentSlide === 2) intervalLab.render('midOC');
				if (currentSlide === 3) builderLab.render();
				if (currentSlide === 4) convertGame.reset();
				if (currentSlide === 5) dotGame.reset();
				if (currentSlide === 6) sortGame.reset();
				if (currentSlide === 7) integerGame.reset();
				renderMath(slides[currentSlide]);
			});

			const notesPanel = root.querySelector('[data-teacher-notes]');
			root.querySelector('[data-notes-toggle]')?.addEventListener('click', () => {
				notesPanel?.classList.add('is-open');
				notesPanel?.setAttribute('aria-hidden', 'false');
			});
			root.querySelector('[data-notes-close]')?.addEventListener('click', () => {
				notesPanel?.classList.remove('is-open');
				notesPanel?.setAttribute('aria-hidden', 'true');
			});
			root.querySelector('[data-fullscreen-toggle]')?.addEventListener('click', () => {
				if (document.fullscreenElement) document.exitFullscreen?.();
				else root.requestFullscreen?.();
			});

			function positionFor(value) {
				const min = -6;
				const max = 6;
				const pct = 5 + ((Number(value) - min) / (max - min)) * 90;
				return Math.max(5, Math.min(95, pct));
			}

			function notationText(item) {
				if (item.type === 'right') return (item.leftClosed ? '[' : '(') + formatNum(item.left) + ',∞)';
				if (item.type === 'left') return '(-∞,' + formatNum(item.right) + (item.rightClosed ? ']' : ')');
				return (item.leftClosed ? '[' : '(') + formatNum(item.left) + ',' + formatNum(item.right) + (item.rightClosed ? ']' : ')');
			}

			function inequalityText(item) {
				if (item.type === 'right') return 'x ' + (item.leftClosed ? '≥' : '>') + ' ' + formatNum(item.left);
				if (item.type === 'left') return 'x ' + (item.rightClosed ? '≤' : '<') + ' ' + formatNum(item.right);
				return formatNum(item.left) + ' ' + (item.leftClosed ? '≤' : '<') + ' x ' + (item.rightClosed ? '≤' : '<') + ' ' + formatNum(item.right);
			}

			function containsValue(item, value) {
				value = Number(value);
				if (item.type === 'right') return item.leftClosed ? value >= item.left : value > item.left;
				if (item.type === 'left') return item.rightClosed ? value <= item.right : value < item.right;
				const leftOk = item.leftClosed ? value >= item.left : value > item.left;
				const rightOk = item.rightClosed ? value <= item.right : value < item.right;
				return leftOk && rightOk;
			}

			function meaningTitle(item) {
				if (item.type === 'right') return 'x is ' + (item.leftClosed ? 'at least ' : 'greater than ') + formatNum(item.left) + '.';
				if (item.type === 'left') return 'x is ' + (item.rightClosed ? 'at most ' : 'less than ') + formatNum(item.right) + '.';
				return 'x is between ' + formatNum(item.left) + ' and ' + formatNum(item.right) + '.';
			}

			function meaningText(item) {
				if (item.type === 'right') return formatNum(item.left) + (item.leftClosed ? ' is included. ' : ' is not included. ') + 'The shading goes to the right.';
				if (item.type === 'left') return formatNum(item.right) + (item.rightClosed ? ' is included. ' : ' is not included. ') + 'The shading goes to the left.';
				return formatNum(item.left) + (item.leftClosed ? ' is included' : ' is not included') + ', and ' + formatNum(item.right) + (item.rightClosed ? ' is included.' : ' is not included.');
			}

			function drawTicks(container, asButtons, onClick) {
				if (!container) return;
				container.replaceChildren();
				for (let n = -6; n <= 6; n += 1) {
					const pct = positionFor(n);
					const tick = document.createElement('span');
					tick.className = 'tick';
					tick.style.left = pct + '%';
					container.appendChild(tick);
					const label = document.createElement(asButtons ? 'button' : 'span');
					label.className = 'tick-label';
					label.style.left = pct + '%';
					label.textContent = formatNum(n);
					if (asButtons) {
						label.type = 'button';
						label.dataset.tick = String(n);
						label.addEventListener('click', () => onClick?.(n));
					}
					container.appendChild(label);
				}
			}

			function renderLine(targets, item, testValue) {
				const fill = targets.fill;
				const leftPoint = targets.leftPoint;
				const rightPoint = targets.rightPoint;
				const leftArrow = targets.leftArrow;
				const rightArrow = targets.rightArrow;
				const testLine = targets.testLine;
				const testDot = targets.testDot;
				const testLabel = targets.testLabel;
				const minPct = 5;
				const maxPct = 95;
				const leftPct = item.type === 'left' ? minPct : positionFor(item.left);
				const rightPct = item.type === 'right' ? maxPct : positionFor(item.right);
				if (fill) {
					fill.style.left = leftPct + '%';
					fill.style.width = Math.max(0, rightPct - leftPct) + '%';
				}
				if (leftPoint) {
					leftPoint.style.left = leftPct + '%';
					leftPoint.style.display = item.type === 'left' ? 'none' : 'block';
					leftPoint.classList.toggle('closed', !!item.leftClosed);
					leftPoint.classList.remove('pulse');
					void leftPoint.offsetWidth;
					leftPoint.classList.add('pulse');
				}
				if (rightPoint) {
					rightPoint.style.left = rightPct + '%';
					rightPoint.style.display = item.type === 'right' ? 'none' : 'block';
					rightPoint.classList.toggle('closed', !!item.rightClosed);
					rightPoint.classList.remove('pulse');
					void rightPoint.offsetWidth;
					rightPoint.classList.add('pulse');
				}
				if (leftArrow) {
					leftArrow.style.left = '3.4%';
					leftArrow.style.opacity = item.type === 'left' ? '1' : '0';
				}
				if (rightArrow) {
					rightArrow.style.left = '94%';
					rightArrow.style.opacity = item.type === 'right' ? '1' : '0';
				}
				if (testLine && testDot && testLabel) {
					const testPct = positionFor(testValue);
					testLine.style.left = testPct + '%';
					testDot.style.left = testPct + '%';
					testLabel.style.left = testPct + '%';
					testLabel.textContent = 'x = ' + formatNum(testValue);
				}
			}

			const intervalData = [
				{ key: 'rightOpen', type: 'right', left: 2, leftClosed: false, label: 'greater than', value: 3 },
				{ key: 'rightClosed', type: 'right', left: -1, leftClosed: true, label: 'at least', value: -1 },
				{ key: 'leftOpen', type: 'left', right: 4, rightClosed: false, label: 'less than', value: 3 },
				{ key: 'leftClosed', type: 'left', right: 1, rightClosed: true, label: 'at most', value: 1 },
				{ key: 'midOO', type: 'middle', left: -3, right: 3, leftClosed: false, rightClosed: false, label: 'between, open ends', value: 0 },
				{ key: 'midOC', type: 'middle', left: -2, right: 4, leftClosed: false, rightClosed: true, label: 'open then closed', value: 0 },
				{ key: 'midCO', type: 'middle', left: -4, right: 2, leftClosed: true, rightClosed: false, label: 'closed then open', value: -2 },
				{ key: 'midCC', type: 'middle', left: 0, right: 5, leftClosed: true, rightClosed: true, label: 'closed ends', value: 5 }
			];

			const intervalLab = (function setupIntervalLab() {
				const lab = root.querySelector('[data-interval-lab]');
				if (!lab) return { render: function () {} };
				const title = lab.querySelector('[data-interval-title]');
				const choices = lab.querySelector('[data-interval-choices]');
				const meaningTitleNode = lab.querySelector('[data-interval-meaning-title]');
				const meaningTextNode = lab.querySelector('[data-interval-meaning-text]');
				const slider = lab.querySelector('[data-test-slider]');
				const feedback = lab.querySelector('[data-interval-feedback]');
				const tickBox = lab.querySelector('[data-interval-ticks]');
				const targets = {
					fill: lab.querySelector('[data-line-fill]'),
					leftPoint: lab.querySelector('[data-left-endpoint]'),
					rightPoint: lab.querySelector('[data-right-endpoint]'),
					leftArrow: lab.querySelector('[data-left-arrow]'),
					rightArrow: lab.querySelector('[data-right-arrow]'),
					testLine: lab.querySelector('[data-test-line]'),
					testDot: lab.querySelector('[data-test-dot]'),
					testLabel: lab.querySelector('[data-test-label]')
				};
				let activeKey = 'midOC';

				function findItem(key) {
					return intervalData.find((item) => item.key === key) || intervalData[0];
				}

				function updateProbe() {
					const item = findItem(activeKey);
					const value = Number(slider?.value || 0);
					renderLine(targets, item, value);
					const valid = containsValue(item, value);
					if (feedback) {
						feedback.textContent = formatNum(value) + (valid ? ' is inside the interval.' : ' is outside the interval.') + ' Check the shaded orange part and the endpoint rule.';
						feedback.classList.toggle('is-bad', !valid);
					}
					tickBox?.querySelectorAll('.tick-label').forEach((label) => label.classList.toggle('is-selected', Number(label.dataset.tick) === value));
				}

				function render(key) {
					activeKey = key;
					const item = findItem(key);
					if (title) setMath(title, notationText(item));
					if (meaningTitleNode) meaningTitleNode.textContent = meaningTitle(item);
					if (meaningTextNode) meaningTextNode.textContent = meaningText(item);
					if (slider) slider.value = String(item.value ?? 0);
					choices?.querySelectorAll('.interval-choice').forEach((button) => button.classList.toggle('is-selected', button.dataset.key === key));
					updateProbe();
					renderMath(lab);
				}

				intervalData.slice(0, 6).forEach((item) => {
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'interval-choice';
					button.dataset.key = item.key;
					const math = document.createElement('span');
					math.className = 'mathjax';
					setMath(math, notationText(item));
					const small = document.createElement('small');
					small.textContent = item.label;
					button.append(math, small);
					button.addEventListener('click', () => render(item.key));
					choices?.appendChild(button);
				});
				drawTicks(tickBox, true, (n) => {
					if (slider) slider.value = String(n);
					updateProbe();
				});
				slider?.addEventListener('input', updateProbe);
				lab.querySelector('[data-test-left]')?.addEventListener('click', () => {
					if (!slider) return;
					slider.value = String(Math.max(-6, Number(slider.value) - 1));
					updateProbe();
				});
				lab.querySelector('[data-test-right]')?.addEventListener('click', () => {
					if (!slider) return;
					slider.value = String(Math.min(6, Number(slider.value) + 1));
					updateProbe();
				});
				lab.querySelector('[data-interval-random]')?.addEventListener('click', () => {
					let next = activeKey;
					while (next === activeKey) next = intervalData[Math.floor(Math.random() * intervalData.length)].key;
					render(next);
				});
				render(activeKey);
				return { render };
			})();

			const builderLab = (function setupBuilderLab() {
				const lab = root.querySelector('[data-builder-lab]');
				if (!lab) return { render: function () {} };
				const leftSelect = lab.querySelector('[data-builder-left]');
				const rightSelect = lab.querySelector('[data-builder-right]');
				const leftClosedSelect = lab.querySelector('[data-builder-left-closed]');
				const rightClosedSelect = lab.querySelector('[data-builder-right-closed]');
				const intervalNode = lab.querySelector('[data-builder-interval]');
				const inequalityNode = lab.querySelector('[data-builder-inequality]');
				const message = lab.querySelector('[data-builder-message]');
				const ticks = lab.querySelector('[data-builder-ticks]');
				const targets = {
					fill: lab.querySelector('[data-builder-fill]'),
					leftPoint: lab.querySelector('[data-builder-left-point]'),
					rightPoint: lab.querySelector('[data-builder-right-point]')
				};
				drawTicks(ticks, false);
				function render() {
					let left = Number(leftSelect?.value || -2);
					let right = Number(rightSelect?.value || 4);
					if (left >= right) {
						right = left + 1;
						if (rightSelect) rightSelect.value = String(Math.min(6, right));
						if (right > 6 && leftSelect) {
							left = 5;
							leftSelect.value = '5';
							right = 6;
							rightSelect.value = '6';
						}
					}
					const item = { type: 'middle', left, right, leftClosed: leftClosedSelect?.value === 'closed', rightClosed: rightClosedSelect?.value === 'closed' };
					setMath(intervalNode, notationText(item));
					setMath(inequalityNode, inequalityText(item));
					if (message) message.textContent = formatNum(left) + (item.leftClosed ? ' is closed, so it is included. ' : ' is open, so it is not included. ') + formatNum(right) + (item.rightClosed ? ' is closed, so it is included.' : ' is open, so it is not included.');
					renderLine(targets, item, 0);
					renderMath(lab);
				}
				[leftSelect, rightSelect, leftClosedSelect, rightClosedSelect].forEach((select) => select?.addEventListener('change', render));
				render();
				return { render };
			})();

			function setupMcqGame(config) {
				let round = 0;
				let localScore = 0;
				let answered = false;
				function currentItem() { return config.items[round % config.items.length]; }
				function render() {
					answered = false;
					const item = currentItem();
					if (config.roundNode) config.roundNode.textContent = 'Round ' + (round + 1) + ' / ' + config.items.length;
					if (config.scoreNode) config.scoreNode.textContent = String(localScore);
					setMath(config.promptNode, item.prompt);
					config.optionBox.replaceChildren();
					item.options.forEach((option, index) => {
						const button = document.createElement('button');
						button.type = 'button';
						button.className = 'option-button';
						button.dataset.option = option;
						const letter = document.createElement('span');
						letter.className = 'letter';
						letter.textContent = String.fromCharCode(65 + index);
						const label = document.createElement('span');
						label.className = 'mathjax';
						setMath(label, option);
						button.append(letter, label);
						button.addEventListener('click', () => {
							if (answered) return;
							answered = true;
							const correct = option === item.answer;
							button.classList.add(correct ? 'is-correct' : 'is-wrong');
							if (correct) {
								localScore += 1;
								updateScore(1);
							} else {
								Array.from(config.optionBox.children).forEach((child) => {
									if (child.dataset.option === item.answer) child.classList.add('is-correct');
								});
							}
							if (config.scoreNode) config.scoreNode.textContent = String(localScore);
							if (config.feedbackNode) config.feedbackNode.textContent = correct ? 'Correct. Endpoint type and direction are both right.' : 'Not yet. Check whether the boundary is included and which way the interval goes.';
						});
						config.optionBox.appendChild(button);
					});
					if (config.feedbackNode) config.feedbackNode.textContent = 'Look at whether the endpoint is included.';
					renderMath(config.scope);
				}
				function next() { round = (round + 1) % config.items.length; render(); }
				function reset() { round = 0; localScore = 0; render(); }
				config.nextButton?.addEventListener('click', next);
				config.resetButton?.addEventListener('click', reset);
				render();
				return { reset, next };
			}

			const convertGame = setupMcqGame({
				scope: root.querySelector('[data-convert-game]'),
				items: [
					{ prompt: 'x ≥ -3', answer: '[-3,\\infty)', options: ['(-3,\\infty)', '[-3,\\infty)', '(-\\infty,-3]', '[-3,3]'] },
					{ prompt: 'x < 4', answer: '(-\\infty,4)', options: ['(-\\infty,4)', '(-\\infty,4]', '(4,\\infty)', '[4,\\infty)'] },
					{ prompt: '-2 < x ≤ 5', answer: '(-2,5]', options: ['[-2,5]', '(-2,5)', '(-2,5]', '[-2,5)'] },
					{ prompt: '0 ≤ x < 6', answer: '[0,6)', options: ['(0,6)', '[0,6)', '(0,6]', '[0,6]'] },
					{ prompt: 'x ≤ 1', answer: '(-\\infty,1]', options: ['(-\\infty,1)', '(-\\infty,1]', '(1,\\infty)', '[1,\\infty)'] }
				],
				roundNode: root.querySelector('[data-convert-round]'),
				scoreNode: root.querySelector('[data-convert-score]'),
				promptNode: root.querySelector('[data-convert-prompt]'),
				optionBox: root.querySelector('[data-convert-options]'),
				feedbackNode: root.querySelector('[data-convert-feedback]'),
				nextButton: root.querySelector('[data-convert-next]'),
				resetButton: root.querySelector('[data-convert-reset]')
			});

			const dotGame = (function setupDotGame() {
				const game = root.querySelector('[data-dot-game]');
				const prompts = [
					{ tex: 'x < 5', answer: 'open' },
					{ tex: 'x ≤ -2', answer: 'closed' },
					{ tex: 'x > 0', answer: 'open' },
					{ tex: 'x ≥ 3', answer: 'closed' },
					{ tex: '-1 < x < 4', answer: 'open' },
					{ tex: '-3 ≤ x ≤ 2', answer: 'closed' }
				];
				let round = 0;
				let answered = false;
				function render() {
					answered = false;
					const item = prompts[round % prompts.length];
					game?.querySelectorAll('.dot-choice').forEach((button) => button.classList.remove('is-correct', 'is-wrong'));
					const roundNode = game?.querySelector('[data-dot-round]');
					if (roundNode) roundNode.textContent = 'Round ' + (round + 1) + ' / ' + prompts.length;
					setMath(game?.querySelector('[data-dot-prompt]'), item.tex);
					const feedback = game?.querySelector('[data-dot-feedback]');
					if (feedback) feedback.textContent = 'Read the symbol carefully.';
					renderMath(game);
				}
				game?.querySelectorAll('[data-dot-answer]').forEach((button) => {
					button.addEventListener('click', () => {
						if (answered) return;
						answered = true;
						const item = prompts[round % prompts.length];
						const correct = button.dataset.dotAnswer === item.answer;
						button.classList.add(correct ? 'is-correct' : 'is-wrong');
						if (!correct) game?.querySelector('[data-dot-answer="' + item.answer + '"]')?.classList.add('is-correct');
						else updateScore(1);
						const feedback = game?.querySelector('[data-dot-feedback]');
						if (feedback) feedback.textContent = correct ? 'Correct. This endpoint rule matches the symbol.' : 'Check again: < and > are open; ≤ and ≥ are closed.';
					});
				});
				function next() { round = (round + 1) % prompts.length; render(); }
				function reset() { round = 0; render(); }
				game?.querySelector('[data-dot-next]')?.addEventListener('click', next);
				game?.querySelector('[data-dot-reset]')?.addEventListener('click', reset);
				render();
				return { reset };
			})();

			const sortGame = (function setupSortGame() {
				const game = root.querySelector('[data-sort-game]');
				const cards = [
					{ tex: '(-2,5)', answer: 'open-open' },
					{ tex: '[-1,3]', answer: 'closed-closed' },
					{ tex: '(-4,2]', answer: 'open-closed' },
					{ tex: '[0,6)', answer: 'closed-open' },
					{ tex: '(1,7]', answer: 'open-closed' },
					{ tex: '[-5,-2)', answer: 'closed-open' }
				];
				let round = 0;
				let answered = false;
				function render() {
					answered = false;
					const item = cards[round % cards.length];
					game?.querySelectorAll('.sort-button').forEach((button) => button.classList.remove('is-correct', 'is-wrong'));
					const roundNode = game?.querySelector('[data-sort-round]');
					if (roundNode) roundNode.textContent = 'Card ' + (round + 1) + ' / ' + cards.length;
					setMath(game?.querySelector('[data-sort-card]'), item.tex);
					const feedback = game?.querySelector('[data-sort-feedback]');
					if (feedback) feedback.textContent = 'Parentheses are open; square brackets are closed.';
					renderMath(game);
				}
				game?.querySelectorAll('[data-sort-answer]').forEach((button) => {
					button.addEventListener('click', () => {
						if (answered) return;
						answered = true;
						const item = cards[round % cards.length];
						const correct = button.dataset.sortAnswer === item.answer;
						button.classList.add(correct ? 'is-correct' : 'is-wrong');
						if (!correct) game?.querySelector('[data-sort-answer="' + item.answer + '"]')?.classList.add('is-correct');
						else updateScore(1);
						const feedback = game?.querySelector('[data-sort-feedback]');
						if (feedback) feedback.textContent = correct ? 'Correct category.' : 'Look at the left symbol and the right symbol separately.';
					});
				});
				function next() { round = (round + 1) % cards.length; render(); }
				function reset() { round = 0; render(); }
				game?.querySelector('[data-sort-next]')?.addEventListener('click', next);
				game?.querySelector('[data-sort-reset]')?.addEventListener('click', reset);
				render();
				return { reset };
			})();

			const integerGame = (function setupIntegerGame() {
				const game = root.querySelector('[data-integer-game]');
				const intervals = [
					{ type: 'middle', left: -3, right: 2, leftClosed: false, rightClosed: true, help: 'Choose all integers greater than −3 and up to 2.' },
					{ type: 'middle', left: -4, right: 1, leftClosed: true, rightClosed: false, help: 'Choose all integers from −4 up to, but not including, 1.' },
					{ type: 'middle', left: 0, right: 5, leftClosed: false, rightClosed: false, help: 'Choose all integers strictly between 0 and 5.' },
					{ type: 'middle', left: -2, right: 4, leftClosed: true, rightClosed: true, help: 'Choose all integers from −2 to 4 inclusive.' }
				];
				let activeIndex = 0;
				function activeItem() { return intervals[activeIndex % intervals.length]; }
				function renderButtons() {
					const box = game?.querySelector('[data-integer-buttons]');
					if (!box) return;
					box.replaceChildren();
					for (let n = -6; n <= 6; n += 1) {
						const button = document.createElement('button');
						button.type = 'button';
						button.className = 'integer-button';
						button.dataset.value = String(n);
						button.textContent = formatNum(n);
						button.addEventListener('click', () => button.classList.toggle('is-selected'));
						box.appendChild(button);
					}
				}
				function render() {
					const item = activeItem();
					setMath(game?.querySelector('[data-integer-prompt]'), notationText(item));
					const help = game?.querySelector('[data-integer-help]');
					if (help) help.textContent = item.help;
					renderButtons();
					const feedback = game?.querySelector('[data-integer-feedback]');
					if (feedback) feedback.textContent = 'Tap the integers that are included in the interval.';
					renderMath(game);
				}
				function check() {
					const item = activeItem();
					let correctCount = 0;
					let totalCorrect = 0;
					let wrongCount = 0;
					game?.querySelectorAll('.integer-button').forEach((button) => {
						button.classList.remove('is-correct', 'is-wrong', 'is-missed');
						const value = Number(button.dataset.value);
						const should = containsValue(item, value);
						const selected = button.classList.contains('is-selected');
						if (should) totalCorrect += 1;
						if (should && selected) { button.classList.add('is-correct'); correctCount += 1; }
						else if (should && !selected) button.classList.add('is-missed');
						else if (!should && selected) { button.classList.add('is-wrong'); wrongCount += 1; }
					});
					const feedback = game?.querySelector('[data-integer-feedback]');
					const allCorrect = correctCount === totalCorrect && wrongCount === 0;
					if (feedback) feedback.textContent = allCorrect ? 'Correct. You selected exactly the integers inside the interval.' : 'Review the highlighted buttons: green = correct, orange = missed, red = not in the interval.';
					if (allCorrect) updateScore(1);
				}
				function reset() {
					game?.querySelectorAll('.integer-button').forEach((button) => button.classList.remove('is-selected', 'is-correct', 'is-wrong', 'is-missed'));
					const feedback = game?.querySelector('[data-integer-feedback]');
					if (feedback) feedback.textContent = 'Tap the integers that are included in the interval.';
				}
				function next() { activeIndex = (activeIndex + 1) % intervals.length; render(); }
				game?.querySelector('[data-integer-check]')?.addEventListener('click', check);
				game?.querySelector('[data-integer-reset]')?.addEventListener('click', reset);
				game?.querySelector('[data-integer-new]')?.addEventListener('click', next);
				render();
				return { reset };
			})();

			prepareMath(root);
			renderMath(root);
			showSlide(0);
		})();
	</script>
</Layout>
