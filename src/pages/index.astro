---
// SAN TUTOR Learning Studio — Landing Page
// santutor.id
import logoSrc from '../assets/logo.svg';
import ilustrasiHero from '../assets/14739.jpg';
import ratihpp from '../assets/ratih.jpeg';
import bimopp from '../assets/bimo.jpeg';
---

<!DOCTYPE html>
<html lang="id">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>SAN TUTOR Learning Studio — Mitra Belajar Seumur Hidup Anak Anda</title>
	<meta name="description" content="SAN TUTOR menemani anak Anda dari TK hingga SMA dengan tutor tetap, kurikulum berjenjang, dan kelas kecil yang interaktif. Jadwalkan kelas percobaan gratis sekarang." />
	<link rel="icon" href={logoSrc.src} type="image/jpeg" />

	<meta property="og:type" content="website" />
	<meta property="og:title" content="SAN TUTOR Learning Studio — Mitra Belajar Seumur Hidup Anak Anda" />
	<meta property="og:description" content="Bimbingan belajar dari TK hingga SMA dengan tutor tetap, kelas kecil, dan kurikulum personal." />
	<meta property="og:image" content={logoSrc.src} />
	<meta name="twitter:card" content="summary" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="preconnect" href="https://images.pexels.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "EducationalOrganization",
		"name": "SAN TUTOR Learning Studio",
		"url": "https://santutor.id",
		"telephone": "+62-811-860-568",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "Jl. Melati Raya No. 45",
			"addressLocality": "Jakarta Selatan",
			"addressRegion": "DKI Jakarta",
			"postalCode": "12130",
			"addressCountry": "ID"
		},
		"description": "Bimbingan belajar berjenjang dari TK hingga SMA dengan tutor tetap dan kelas kecil."
	})}></script>
</head>
<body>

	<!-- ======================= HEADER ======================= -->
	<header class="site-header" id="siteHeader">
		<div class="wrap nav-inner">
			<a href="#top" class="logo" aria-label="SAN TUTOR Learning Studio — Beranda">
				<img
					src={logoSrc.src}
					style={{ height: '90px', width: 'auto' }}
					alt="Logo Santutor Learning Studio"
					class="logo-img"
				/>
			</a>

			<nav class="main-nav" id="mainNav" aria-label="Navigasi utama">
				<a href="#tentang">Tentang Kami</a>
				<a href="#tutor">Tutor</a>
				<a href="#jenjang">Jenjang</a>
				<a href="#program">Program</a>
				<a href="#testimoni">Testimoni</a>
			</nav>

			<div class="nav-actions">
				<a href="https://wa.me/62811860568" class="nav-phone">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
					<span>+62 811-860-568</span>
				</a>
				<a href="#pendaftaran" class="btn btn-primary btn-sm">Daftar Sekarang</a>
				<button class="nav-toggle" id="navToggle" aria-label="Buka menu" aria-expanded="false" aria-controls="mobileNav">
					<span></span><span></span><span></span>
				</button>
			</div>
		</div>

		<div class="mobile-nav" id="mobileNav">
			<a href="#tentang">Tentang Kami</a>
			<a href="#tutor">Tutor</a>
			<a href="#jenjang">Jenjang</a>
			<a href="#program">Program</a>
			<a href="#faq">FAQ</a>
			<a href="#testimoni">Testimoni</a>
			<a href="#pendaftaran" class="btn btn-primary">Daftar Sekarang</a>
		</div>
	</header>

	<main id="top">

		<!-- ======================= HERO ======================= -->
		<section class="hero">
			<div class="section-decor" aria-hidden="true">
				<span class="dot-grid dot-grid-hero"></span>
				<span class="blob blob-blue" style="top:-120px; left:-140px; width:340px; height:340px;"></span>
				<span class="blob blob-orange" style="bottom:-140px; left:38%; width:260px; height:260px;"></span>
				<svg class="doodle doodle-star" style="top:14%; left:6%;" width="26" height="26" viewBox="0 0 24 24" fill="var(--orange)"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2Z"/></svg>
				<svg class="doodle doodle-plus" style="top:66%; left:3%;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="3" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg>
			</div>
			<div class="wrap hero-inner">
				<div class="hero-content reveal">
					<p class="eyebrow">Sejak TK hingga SMA, satu atap yang sama</p>
					<h1>Satu Mitra Belajar, untuk Setiap Babak Tumbuh Kembang Anak Anda</h1>
					<p class="hero-lede">
						SAN TUTOR mendampingi anak Anda sejak langkah pertama di TK hingga garis akhir SMA — dengan tutor yang mengenal mereka luar-dalam, kurikulum yang ikut berkembang, dan kelas kecil yang membuat setiap anak benar-benar didengar.
					</p>
					<div class="hero-cta">
						<a href="#pendaftaran" class="btn btn-primary btn-lg">Daftar Kelas Percobaan Gratis</a>
						<a href="#jenjang" class="btn btn-ghost btn-lg">Lihat Jenjang Belajar</a>
					</div>
					<dl class="hero-stats">
						<div><dt>500+</dt><dd>Siswa terbimbing</dd></div>
						<div><dt>4 Jenjang</dt><dd>TK &middot; SD &middot; SMP &middot; SMA</dd></div>
						<div><dt>Maks. 5</dt><dd>Anak per kelas</dd></div>
					</dl>
				</div>

				<div class="hero-visual reveal">
					<div class="hero-blob" aria-hidden="true"></div>
					<img 
						src={ilustrasiHero.src} 
						width={ilustrasiHero.width} 
						height={ilustrasiHero.height} 
						alt="Ilustrasi tutor dan anak-anak belajar bersama di meja" 
						class="hero-illustration"
					/>
					<div class="hero-badge">
						<span class="hero-badge-dot"></span>
						Kelas kecil, maksimal 5 anak
					</div>
					<figure class="hero-photo-chip">
						<img
							src="https://images.pexels.com/photos/7156103/pexels-photo-7156103.jpeg?auto=compress&cs=tinysrgb&w=300&h=300&fit=crop"
							width="150"
							height="150"
							loading="lazy"
							alt="Tutor SAN TUTOR mendampingi anak-anak belajar dalam kelompok kecil"
						/>
					</figure>
				</div>
			</div>
		</section>

		<!-- ======================= WHY US ======================= -->
		<section class="why-section" id="tentang">
			<div class="section-decor" aria-hidden="true">
				<span class="blob blob-sage" style="top:-90px; right:-100px; width:300px; height:300px;"></span>
				<span class="blob blob-orange" style="bottom:-110px; left:-90px; width:260px; height:260px;"></span>
			</div>
			<div class="wrap">
				<div class="section-head reveal">
					<p class="eyebrow">Kenapa Orang Tua Memilih Kami</p>
					<h2>Belajar yang Ikut Tumbuh Bersama Anak Anda</h2>
					<p class="section-lede">Bukan sekadar bimbingan belajar musiman. SAN TUTOR dibangun agar satu tutor bisa benar-benar mengenal anak Anda, dari kebiasaan belajarnya sampai apa yang membuatnya semangat.</p>
				</div>

				<div class="why-columns">
					<div class="why-list reveal">
						<div class="why-list-item">
							<span class="why-list-icon" style="--icon-bg:#FDEDE0;--icon-fg:#F2761E">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6c4-2 8-2 8 0v14c0-2-4-2-8 0V6Z"/><path d="M20 6c-4-2-8-2-8 0v14c0-2 4-2 8 0V6Z"/></svg>
							</span>
							<div>
								<h3>Tutor untuk Semua Jenjang</h3>
								<p>Satu tutor dapat mendampingi anak Anda dari TK hingga SMA — kepercayaan dan pemahaman karakter anak terus terjaga, tidak mulai dari nol tiap tahun.</p>
							</div>
						</div>
						<div class="why-list-item">
							<span class="why-list-icon" style="--icon-bg:#E7F7FD;--icon-fg:#3EB6EA">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
							</span>
							<div>
								<h3>Kurikulum Berjenjang &amp; Personal</h3>
								<p>Materi disusun berbasis proyek dan disesuaikan gaya belajar tiap anak — bukan modul seragam untuk semua orang.</p>
							</div>
						</div>
						<div class="why-list-item">
							<span class="why-list-icon" style="--icon-bg:#F1EEE0;--icon-fg:#6E9B7D">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
							</span>
							<div>
								<h3>Kelas Kecil &amp; Interaktif</h3>
								<p>Maksimal 5 anak per kelas, agar setiap pertanyaan terjawab dan setiap anak punya ruang untuk aktif.</p>
							</div>
						</div>
						<div class="why-list-item">
							<span class="why-list-icon" style="--icon-bg:#FDEDE0;--icon-fg:#F2761E">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="M9 12l2 2 4-4"/></svg>
							</span>
							<div>
								<h3>Lingkungan Aman &amp; Menyenangkan</h3>
								<p>Ruang belajar yang nyaman dan pengajar terlatih membuat anak betah — dan orang tua tenang.</p>
							</div>
						</div>
					</div>

					<div class="why-collage reveal">
						<figure class="collage-item collage-lg">
							<img src="https://images.unsplash.com/photo-1636202339022-7d67f7447e3a?auto=format&fit=crop&w=800&q=80" alt="Sekelompok kecil anak belajar bersama di dalam kelas" loading="lazy" />
						</figure>
						<figure class="collage-item collage-sm" style="transform:rotate(-2deg)">
							<img src="https://plus.unsplash.com/premium_photo-1726750920964-c953324a3202?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTIxfHxraWRzJTIwYm9va3xlbnwwfHwwfHx8MA%3D%3D" alt="Siswa fokus belajar dengan buku di meja" loading="lazy" />
						</figure>
						<figure class="collage-item collage-sm" style="transform:rotate(2deg)">
							<img src="https://images.unsplash.com/photo-1588075592446-265fd1e6e76f?auto=format&fit=crop&w=500&q=80" alt="Anak-anak duduk bersama dalam suasana belajar yang santai" loading="lazy" />
						</figure>
					</div>
				</div>
			</div>
		</section>

		<!-- ======================= TUTOR KAMI ======================= -->
		<section class="tutor-section" id="tutor">
			<div class="wrap">
				<div class="section-head reveal">
					<p class="eyebrow" style="color:var(--blue)">Kenali Tim Pengajar</p>
					<h2>Tutor yang Akan Mendampingi Anak Anda</h2>
					<p class="section-lede">Bukan wajah asing yang berganti tiap semester. Ini tutor tetap kami — dipilih lewat seleksi ketat dan dilatih memahami cara belajar tiap anak.</p>
				</div>

				<div class="tutor-carousel reveal">
					<div class="tutor-track" id="tutorTrack">
						<article class="tutor-card" style="--accent:#F2761E">
							
								<img src="https://media.licdn.com/dms/image/v2/D5603AQHu96oAAK4rLw/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1714817054451?e=2147483647&v=beta&t=z6ld6QvJG7y-VoxfozxBPk3fULaaE4kSZTwh9xXOrWc" 
								style="width: 100px; height: 100px; border-radius: 50%; border: 1px solid #555555; object-fit: cover; display: block; margin: 0 auto;" 
								alt="Profile Picture">
							
							<h3>Ms. Sansan</h3>
							<p class="tutor-role">Tutor TK SD &amp;SMP</p>
							<p class="tutor-edu">Guru Sekolah Internasional Berpengalaman lebih dari 5 tahun Mengajar</p>
							<p class="tutor-quote">"Semua anak pasti bisa!"</p>
						</article>

						<article class="tutor-card" style="--accent:#3EB6EA">
							<img src="https://i1.rgstatic.net/ii/profile.image/955756656467970-1604881552637_Q512/Halley-Kuncoro.jpg" 
								style="width: 100px; height: 100px; border-radius: 50%; border: 1px solid #555555; object-fit: cover; display: block; margin: 0 auto;" 
								alt="Profile Picture">
							<h3>Mr. Rafael Halley</h3>
							<p class="tutor-role">Spesialis STEM</p>
							<p class="tutor-edu">Master pendidikan dan Pendidik Tersertifikasi, Pengalaman lebih dari 15 tahun mengajar</p>
							<p class="tutor-quote">"Kalau konsep dasarnya kuat, soal sesulit apa pun jadi terasa masuk akal."</p>
						</article>

						<article class="tutor-card" style="--accent:#6E9B7D">
							<img 
								src={ratihpp.src} alt="Foto Profil Ratih Puspitasari" 
								style="width: 100px; height: 100px; border-radius: 50%; border: 1px solid #555555; object-fit: cover; display: block; margin: 0 auto;" 
								/>
							<h3>Ms. Ratih Puspitasari</h3>
							<p class="tutor-role">Spesialis Bahasa &amp; Persiapan Ujian SMA</p>
							<p class="tutor-edu">S.Pd Pendidikan Bahasa Inggris, Universitas Padjadjaran</p>
							<p class="tutor-quote">"Persiapan ujian paling efektif kalau anak juga percaya diri, bukan cuma hafal rumus."</p>
						</article>

						<article class="tutor-card" style="--accent:#F2761E">
							<img 
								src={bimopp.src} alt="Foto Profil Ratih Puspitasari" 
								style="width: 100px; height: 100px; border-radius: 50%; border: 1px solid #555555; object-fit: cover; display: block; margin: 0 auto;" 
								/>
							<h3>Mr. Bimo Aditya</h3>
							<p class="tutor-role">Spesialis Sains SMP &amp; SMA</p>
							<p class="tutor-edu">S.Pd Pendidikan Fisika, Universitas Gadjah Mada</p>
							<p class="tutor-quote">"Sains itu paling seru kalau dikaitkan ke hal-hal yang anak lihat sehari-hari."</p>
						</article>
					</div>
					<div class="tutor-nav">
						<button type="button" id="tutorPrev" aria-label="Tutor sebelumnya">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
						</button>
						<button type="button" id="tutorNext" aria-label="Tutor berikutnya">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
						</button>
					</div>
				</div>
				
			</div>
		</section>

		<!-- ======================= JENJANG / JOURNEY ======================= -->
		<section class="journey-section" id="jenjang">
			<div class="section-decor" aria-hidden="true">
				<span class="blob blob-blue" style="top:-80px; left:42%; width:260px; height:260px;"></span>
			</div>
			<div class="wrap">
				<div class="section-head reveal">
					<p class="eyebrow">Perjalanan Belajar Bersama Kami</p>
					<h2>Satu Jalur, Empat Babak Pertumbuhan</h2>
					<p class="section-lede">Di mana pun posisi belajar anak Anda saat ini, SAN TUTOR siap menjadi mitra terbaiknya. Kami menyediakan program belajar adaptif untuk semua jenjang—mulai dari pondasi dasar di TK/SD, persiapan kelulusan SMP, hingga strategi sukses ujian di SMA.</p>
				</div>

				<div class="journey-track">
					<div class="journey-stop reveal" style="--offset:0px">
						<span class="journey-dot"></span>
						<div class="journey-card">
							<img class="journey-photo" src="https://images.pexels.com/photos/8363102/pexels-photo-8363102.jpeg?auto=compress&cs=tinysrgb&w=500&h=360&fit=crop" width="500" height="360" loading="lazy" alt="Anak-anak TK belajar sambil bermain bersama guru" />
							<div class="journey-card-body">
								<span class="journey-age">4–6 tahun</span>
								<h3>TK</h3>
								<p>Mengenal huruf, angka, dan kebiasaan belajar lewat permainan dan cerita.</p>
							</div>
						</div>
					</div>
					<div class="journey-stop reveal" style="--offset:-26px">
						<span class="journey-dot"></span>
						<div class="journey-card">
							<img class="journey-photo" src="https://images.pexels.com/photos/8617971/pexels-photo-8617971.jpeg?auto=compress&cs=tinysrgb&w=500&h=360&fit=crop" width="500" height="360" loading="lazy" alt="Siswa SD belajar aktif di kelas kecil" />
							<div class="journey-card-body">
								<span class="journey-age">7–12 tahun</span>
								<h3>SD</h3>
								<p>Menguatkan dasar Matematika, Bahasa, dan Sains sambil menumbuhkan rasa percaya diri.</p>
							</div>
						</div>
					</div>
					<div class="journey-stop reveal" style="--offset:0px">
						<span class="journey-dot"></span>
						<div class="journey-card">
							<img class="journey-photo" src="https://images.pexels.com/photos/7694945/pexels-photo-7694945.jpeg?auto=compress&cs=tinysrgb&w=500&h=360&fit=crop" width="500" height="360" loading="lazy" alt="Siswa SMP belajar mandiri di rumah" />
							<div class="journey-card-body">
								<span class="journey-age">13–15 tahun</span>
								<h3>SMP</h3>
								<p>Memperdalam pemahaman konsep dan melatih kebiasaan belajar yang lebih mandiri.</p>
							</div>
						</div>
					</div>
					<div class="journey-stop reveal" style="--offset:-26px">
						<span class="journey-dot journey-dot-end"></span>
						<div class="journey-card">
							<img class="journey-photo" src="https://images.pexels.com/photos/7516544/pexels-photo-7516544.jpeg?auto=compress&cs=tinysrgb&w=500&h=360&fit=crop" width="500" height="360" loading="lazy" alt="Siswa SMA fokus mempersiapkan ujian besar" />
							<div class="journey-card-body">
								<span class="journey-age">16–18 tahun</span>
								<h3>SMA</h3>
								<p>Fokus pada pendalaman materi, strategi ujian, dan persiapan menuju jenjang berikutnya.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ======================= PROGRAM ======================= -->
		<section class="program-section" id="program">
			<div class="section-decor" aria-hidden="true">
				<span class="dot-grid dot-grid-light"></span>
			</div>
			<div class="wrap program-inner">
				<div class="reveal">
					<p class="eyebrow eyebrow-light">Program Kami</p>
					<h2 class="light-title">Dirancang Sesuai Kebutuhan, Bukan Sekadar Jadwal</h2>
					<p class="program-lede">Dari pendampingan reguler mingguan hingga kelas intensif menjelang ujian, setiap program disusun bersama orang tua agar benar-benar menjawab kebutuhan anak. Biaya bervariasi tergantung jenjang dan frekuensi — tim kami akan bantu hitungkan paket yang paling pas saat konsultasi.</p>
				</div>
				<ul class="program-list reveal">
					<li>
						<span class="program-num">01</span>
						<span class="program-text">
							<strong>Bimbingan Reguler Mingguan</strong>
							<small class="packet-list">
								• 1× seminggu (60 menit/sesi)<br>
								• 2× seminggu (90 menit/sesi)<br>
								• 3× seminggu (90 menit/sesi)
							</small>
						</span>
					</li>
					<li>
						<span class="program-num">02</span>
						<span class="program-text"><strong>Kelas Intensif Persiapan Ujian</strong><small>Jadwal padat menjelang UTS/UAS/ujian masuk</small></span>
					</li>
					<li>
						<span class="program-num">03</span>
						<span class="program-text"><strong>Pendampingan Tugas &amp; PR</strong><small>Fleksibel, disesuaikan jadwal sekolah anak</small></span>
