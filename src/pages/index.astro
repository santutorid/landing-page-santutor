		.tutor-nav button:hover { background: var(--orange-light); border-color: var(--orange); color: var(--orange); }
		.tutor-note { text-align: center; font-size: 0.78rem; color: var(--ink-soft); margin-top: 24px; opacity: 0.8; }

		/* ---------- Journey ---------- */
		.journey-section { padding: 90px 0 110px; background: var(--white); position: relative; }
		.journey-track {
			display: flex; justify-content: space-between; gap: 20px;
