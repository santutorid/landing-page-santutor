		.journey-card h3 { font-size: 1.3rem; margin: 4px 0 8px; }
		.journey-card p { font-size: 0.86rem; }

		/* ---------- Program ---------- */
		.program-section { background: var(--navy); padding: 84px 0; position: relative; overflow: hidden; }
		.dot-grid-light {
			background-image: radial-gradient(circle, rgba(255,255,255,0.14) 1.6px, transparent 1.6px);
			background-size: 26px 26px;
			-webkit-mask-image: radial-gradient(ellipse 60% 70% at 85% 20%, #000 30%, transparent 80%);
			mask-image: radial-gradient(ellipse 60% 70% at 85% 20%, #000 30%, transparent 80%);
		}
		.program-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; }
		.light-title { color: var(--white); font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 10px 0 16px; }
		.program-lede { color: rgba(255,255,255,0.72); max-width: 48ch; }
		.program-list { display: flex; flex-direction: column; gap: 0; }
		.program-list li {
			display: flex; align-items: flex-start; gap: 18px;
			padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.14);
		}
		.program-list li:last-child { border-bottom: none; }
		.program-num {
			font-family: var(--font-display); font-weight: 600; color: var(--blue); font-size: 0.9rem; padding-top: 2px;
		}
		.program-text { display: flex; flex-direction: column; gap: 4px; }
		.program-text strong { color: var(--white); font-size: 1.02rem; font-weight: 700; }
		.program-text small { color: rgba(255,255,255,0.6); font-size: 0.82rem; }

		/* ---------- FAQ ---------- */
		.faq-section { padding: 90px 0; background: var(--cream); position: relative; overflow: hidden; }
		.faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
		.faq-item {
			background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md);
			padding: 6px 24px;
		}
		.faq-item summary {
			cursor: pointer; list-style: none; padding: 18px 0;
			font-weight: 700; font-size: 1rem; color: var(--navy);
			display: flex; justify-content: space-between; align-items: center; gap: 16px;
		}
		.faq-item summary::-webkit-details-marker { display: none; }
		.faq-item summary::after {
			content: "+"; font-family: var(--font-display); font-size: 1.4rem; color: var(--orange);
			flex-shrink: 0; transition: transform 0.2s ease;
		}
		.faq-item[open] summary::after { transform: rotate(45deg); }
		.faq-item p { padding-bottom: 20px; font-size: 0.94rem; }

		/* ---------- Testimonials ---------- */
		.testimonials-section { padding: 90px 0; background: var(--white); position: relative; overflow: hidden; }
		.testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
		.testi-card {
			background: var(--cream); border: 1px solid var(--border); border-radius: var(--radius-md);
			padding: 30px 26px; margin: 0; display: flex; flex-direction: column; gap: 16px;
		}
		.testi-stars { color: var(--orange); letter-spacing: 2px; font-size: 0.95rem; }
		.testi-card blockquote { margin: 0; font-size: 0.98rem; color: var(--navy); line-height: 1.6; }
		.testi-card figcaption { display: flex; align-items: center; gap: 12px; font-size: 0.86rem; color: var(--ink-soft); }
		.testi-avatar {
			width: 38px; height: 38px; border-radius: 50%; background: var(--blue-light); color: var(--blue);
			display: flex; align-items: center; justify-content: center; font-weight: 800; flex-shrink: 0;
			font-family: var(--font-display);
		}
		.testi-badge {
			display: inline-flex; align-items: center; gap: 4px; margin-top: 7px;
			padding: 3px 10px; border-radius: 100px; background: var(--badge-bg); color: var(--badge-fg);
			font-size: 0.72rem; font-weight: 700; white-space: nowrap;
		}
		.testi-note { text-align: center; font-size: 0.78rem; color: var(--ink-soft); margin-top: 28px; opacity: 0.8; }

		/* ---------- Pendaftaran ---------- */
		.daftar-section { padding: 90px 0 100px; background: var(--cream); position: relative; overflow: hidden; }
		.daftar-inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; }
		.daftar-lede { margin: 4px 0 28px; max-width: 44ch; }
		.daftar-steps { display: flex; flex-direction: column; gap: 16px; }
		.daftar-steps li { display: flex; align-items: center; gap: 14px; font-weight: 700; color: var(--navy); font-size: 0.98rem; }
		.daftar-steps span {
			width: 30px; height: 30px; border-radius: 50%; background: var(--orange-light); color: var(--orange);
			display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 600;
			flex-shrink: 0; font-size: 0.92rem;
		}

		.daftar-form {
			background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg);
			padding: 34px; box-shadow: var(--shadow-soft); display: flex; flex-direction: column; gap: 18px;
		}
		.form-row { display: flex; flex-direction: column; gap: 7px; }
		.form-row-split { flex-direction: row; gap: 16px; }
		.form-row-split > div { flex: 1; display: flex; flex-direction: column; gap: 7px; }
		label { font-weight: 700; font-size: 0.86rem; color: var(--navy); }
		input, select, textarea {
			font-family: var(--font-body); font-size: 0.96rem; color: var(--navy);
			border: 1.5px solid var(--border); border-radius: 12px; padding: 12px 14px;
			background: var(--cream); transition: border-color 0.18s ease;
		}
		input:focus, select:focus, textarea:focus { border-color: var(--blue); outline: none; }
		textarea { resize: vertical; font-family: var(--font-body); }
		.form-hint { font-size: 0.8rem; text-align: center; color: var(--ink-soft); }

		/* ---------- Floating WhatsApp ---------- */
		.wa-float {
			position: fixed; bottom: 24px; right: 24px; z-index: 200;
			width: 58px; height: 58px; border-radius: 50%; background: var(--whatsapp); color: var(--white);
			display: flex; align-items: center; justify-content: center;
			box-shadow: 0 14px 28px -10px rgba(37, 211, 102, 0.6);
			transition: transform 0.2s ease;
		}
		.wa-float:hover { transform: scale(1.08); }
		.wa-float::before {
			content: ""; position: absolute; inset: 0; border-radius: 50%;
			border: 2px solid var(--whatsapp); animation: wa-pulse 2.2s ease-out infinite;
		}
		@keyframes wa-pulse {
			0% { transform: scale(1); opacity: 0.7; }
			100% { transform: scale(1.6); opacity: 0; }
		}
		@media (prefers-reduced-motion: reduce) {
			.wa-float::before { animation: none; display: none; }
		}

		/* ---------- Footer ---------- */
		.site-footer { background: var(--navy); padding: 70px 0 0; }
		.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 50px; border-bottom: 1px solid rgba(255,255,255,0.12); }
		.logo-chip {
			display: inline-flex; background: var(--white); border-radius: 14px; padding: 8px 14px; margin-bottom: 4px;
		}
		.footer-brand .logo-img { height: 52px; }
		.footer-brand p { color: rgba(255,255,255,0.65); margin-top: 14px; font-size: 0.92rem; max-width: 30ch; }
		.footer-col h4 { color: var(--white); font-family: var(--font-label); font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 16px; }
		.footer-col p { color: rgba(255,255,255,0.68); font-size: 0.92rem; margin-bottom: 8px; }
		.footer-col a:hover { color: var(--blue); }
		.footer-map-link { color: var(--blue); font-weight: 700; font-size: 0.86rem; display: inline-block; margin-top: 6px; }
		.footer-bottom { display: flex; justify-content: space-between; align-items: center; padding: 22px 24px; }
		.footer-bottom p, .footer-bottom a { color: rgba(255,255,255,0.55); font-size: 0.82rem; }
		.footer-bottom a:hover { color: var(--white); }

		/* ---------- Reveal on scroll ---------- */
		.reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
		.reveal.in-view { opacity: 1; transform: translateY(0); }
		@media (prefers-reduced-motion: reduce) {
			.reveal { opacity: 1; transform: none; transition: none; }
			html { scroll-behavior: auto; }
		}

		/* ---------- Responsive ---------- */
		@media (max-width: 980px) {
			.why-columns { grid-template-columns: 1fr; gap: 32px; }
			.why-collage { height: 320px; }
			.testi-grid { grid-template-columns: 1fr; }
			.program-inner { grid-template-columns: 1fr; }
			.daftar-inner { grid-template-columns: 1fr; }
		}
		@media (max-width: 860px) {
			.main-nav { display: none; }
			.nav-toggle { display: flex; }
			.hero-inner { grid-template-columns: 1fr; }
			.hero-visual { order: -1; max-width: 420px; margin: 0 auto; }
			.hero-cta { justify-content: center; }
			.hero-content { text-align: center; }
			.hero-stats { justify-content: center; }
			.hero-lede { margin-inline: auto; }
			.journey-track { flex-direction: column; gap: 34px; }
			.journey-track::before { top: 4%; bottom: 4%; left: 24px; right: auto; width: 0; border-top: none; border-left: 2.5px dashed var(--border); height: auto; }
			.journey-stop { flex-direction: row; text-align: left; transform: none !important; align-items: flex-start; }
			.journey-dot { margin: 4px 20px 0 8px; flex-shrink: 0; }
			.footer-grid { grid-template-columns: 1fr 1fr; }
			.form-row-split { flex-direction: column; }
			.tutor-card { flex-basis: 220px; }
		}
		@media (max-width: 560px) {
			.why-collage { grid-template-columns: 1fr; grid-template-rows: repeat(3, 130px); height: auto; }
			.collage-lg { grid-row: auto; }
			.hero-stats { flex-direction: column; gap: 14px; }
			.hero-cta { flex-direction: column; }
			.hero-cta .btn { width: 100%; }
			.footer-grid { grid-template-columns: 1fr; }
			.footer-bottom { flex-direction: column; gap: 10px; text-align: center; }
			.daftar-form { padding: 24px; }
			.wa-float { bottom: 16px; right: 16px; width: 52px; height: 52px; }
			.tutor-card { flex-basis: 82vw; }
		}
	</style>

	<script>
		const header = document.getElementById('siteHeader');
		const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		const toggle = document.getElementById('navToggle');
		const mobileNav = document.getElementById('mobileNav');
		toggle?.addEventListener('click', () => {
			const open = mobileNav?.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(!!open));
		});
		mobileNav?.querySelectorAll('a').forEach((a) =>
			a.addEventListener('click', () => {
				mobileNav.classList.remove('open');
				toggle?.setAttribute('aria-expanded', 'false');
			})
		);

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!prefersReduced && 'IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('in-view');
							io.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15 }
			);
			document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		} else {
			document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
		}

		const tutorTrack = document.getElementById('tutorTrack');
		const scrollTutor = (dir: number) => {
			if (!tutorTrack) return;
			const card = tutorTrack.querySelector('.tutor-card');
			const step = card ? card.getBoundingClientRect().width + 20 : 270;
			tutorTrack.scrollBy({ left: dir * step, behavior: 'smooth' });
		};
		document.getElementById('tutorPrev')?.addEventListener('click', () => scrollTutor(-1));
		document.getElementById('tutorNext')?.addEventListener('click', () => scrollTutor(1));

		const daftarForm = document.getElementById('daftarForm');
		daftarForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!(daftarForm instanceof HTMLFormElement) || !daftarForm.reportValidity()) return;
			const data = new FormData(daftarForm);
			const pesan = `Halo SAN TUTOR, saya ingin mendaftarkan anak saya.

Nama Orang Tua: ${data.get('nama_ortu')}
Nama Anak: ${data.get('nama_anak')}
Jenjang: ${data.get('jenjang')}
Program: ${data.get('program') || '-'}
No. WhatsApp: ${data.get('whatsapp')}
Catatan: ${data.get('catatan') || '-'}`;
			const url = `https://wa.me/62811860568?text=${encodeURIComponent(pesan)}`;
			window.open(url, '_blank', 'noopener');
		});
	</script>

</body>
</html>