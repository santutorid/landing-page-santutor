		.mobile-nav a { padding: 12px 4px; font-weight: 700; border-bottom: 1px solid var(--border); }
		.mobile-nav .btn { margin-top: 12px; width: 100%; }
		.mobile-nav.open { display: flex; }

		@media (min-width: 1140px) {
			.nav-phone { display: flex; }
