		.tutor-nav { display: flex; justify-content: center; gap: 12px; margin-top: 18px; }
		.tutor-nav button {
			width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid var(--border); background: var(--white);
			display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--navy);
