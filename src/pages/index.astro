			position: absolute; z-index: 2; bottom: -18px; left: 24px;
			background: var(--white); border-radius: 100px; padding: 10px 18px;
			display: flex; align-items: center; gap: 9px;
			font-weight: 700; font-size: 0.84rem; box-shadow: var(--shadow-soft);
