---
import logoSrc from '../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />
  <title>Santutor Portal</title>
</head>

<body>

  <main class="login-page">

    <section class="login-card">

      <div class="brand">
        <img
          src={logoSrc.src}
          alt="Santutor Learning Studio"
        />
        <p>Private Portal</p>
      </div>


      <div id="loginView">

        <div class="heading">
          <p class="eyebrow">WELCOME BACK</p>
          <h1>Sign in to Santutor</h1>
          <p>
            Access your Santutor portal securely.
          </p>
        </div>


        <form id="loginForm">

          <label>
            Email
            <input
              id="emailInput"
              type="email"
              autocomplete="email"
              placeholder="name@example.com"
              required
            />
          </label>


          <label>
            Password
            <input
              id="passwordInput"
              type="password"
              autocomplete="current-password"
              placeholder="Enter your password"
              required
            />
          </label>


          <div class="password-actions">
            <button
              id="forgotButton"
              class="link-button"
              type="button"
            >
              Forgot password?
            </button>
          </div>


          <button
            id="loginButton"
            class="primary-button"
            type="submit"
          >
            Sign In
          </button>


          <div
            id="loginMessage"
            class="message"
            hidden
          ></div>

        </form>

      </div>


      <div
        id="forgotView"
        hidden
      >

        <button
          id="backToLogin"
          class="back-button"
          type="button"
        >
          ← Back to sign in
        </button>


        <div class="heading">
          <p class="eyebrow">PASSWORD RESET</p>
          <h1>Forgot your password?</h1>
          <p>
            Enter your login email and we will send
            you a secure password reset link.
          </p>
        </div>


        <form id="forgotForm">

          <label>
            Email
            <input
              id="resetEmailInput"
              type="email"
              autocomplete="email"
              placeholder="name@example.com"
              required
            />
          </label>


          <button
            id="sendResetButton"
            class="primary-button"
            type="submit"
          >
            Send Reset Link
          </button>


          <div
            id="forgotMessage"
            class="message"
            hidden
          ></div>

        </form>

      </div>

    </section>

  </main>


  <script>

    import {
      supabase
    } from '../../lib/supabase';


    function getEl<T extends Element>(
      selector: string
    ): T {

      const element =
        document.querySelector<T>(
          selector
        );


      if (!element) {
        throw new Error(
          `Element not found: ${selector}`
        );
      }


      return element;

    }


    function showMessage(
      selector: string,
      message: string,
      type:
        'success' |
        'error'
    ): void {

      const element =
        getEl<HTMLElement>(
          selector
        );


      element.hidden =
        false;


      element.textContent =
        message;


      element.className =
        `message ${type}`;

    }


    function hideMessage(
      selector: string
    ): void {

      const element =
        getEl<HTMLElement>(
          selector
        );


      element.hidden =
        true;

      element.textContent =
        '';

      element.className =
        'message';

    }


    async function routeUser():
      Promise<void> {

      const {
        data: {
          user
        }
      } =
        await supabase.auth
          .getUser();


      if (!user) {
        return;
      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select(
            'role, active'
          )
          .eq(
            'id',
            user.id
          )
          .single();


      if (
        error ||
        !profile ||
        profile.active !== true
      ) {

        await supabase.auth
          .signOut();


        showMessage(
          '#loginMessage',
          'This account is not active. Please contact Santutor.',
          'error'
        );

        return;

      }


      if (
        profile.role ===
        'admin'
      ) {

        window.location.href =
          '/portal/admin/';

        return;

      }


      if (
        profile.role ===
        'parent'
      ) {

        window.location.href =
          '/portal/parent/';

        return;

      }


      if (
        profile.role ===
        'tutor'
      ) {

        window.location.href =
          '/portal/tutor/';

        return;

      }


      await supabase.auth
        .signOut();


      showMessage(
        '#loginMessage',
        'No portal role is assigned to this account.',
        'error'
      );

    }


    getEl<HTMLFormElement>(
      '#loginForm'
    )
      .addEventListener(
        'submit',
        async event => {

          event.preventDefault();

          hideMessage(
            '#loginMessage'
          );


          const email =
            getEl<HTMLInputElement>(
              '#emailInput'
            )
              .value
              .trim();


          const password =
            getEl<HTMLInputElement>(
              '#passwordInput'
            )
              .value;


          const button =
            getEl<HTMLButtonElement>(
              '#loginButton'
            );


          button.disabled =
            true;

          button.textContent =
            'Signing in...';


          try {

            const {
              error
            } =
              await supabase.auth
                .signInWithPassword({
                  email,
                  password
                });


            if (error) {
              throw error;
            }


            await routeUser();

          } catch (error) {

            showMessage(
              '#loginMessage',
              error instanceof Error
                ? error.message
                : 'Unable to sign in.',
              'error'
            );

          } finally {

            button.disabled =
              false;

            button.textContent =
              'Sign In';

          }

        }
      );


    getEl<HTMLButtonElement>(
      '#forgotButton'
    )
      .addEventListener(
        'click',
        () => {

          const email =
            getEl<HTMLInputElement>(
              '#emailInput'
            )
              .value
              .trim();


          getEl<HTMLInputElement>(
            '#resetEmailInput'
          ).value =
            email;


          getEl<HTMLElement>(
            '#loginView'
          ).hidden =
            true;


          getEl<HTMLElement>(
            '#forgotView'
          ).hidden =
            false;


          hideMessage(
            '#forgotMessage'
          );

        }
      );


    getEl<HTMLButtonElement>(
      '#backToLogin'
    )
      .addEventListener(
        'click',
        () => {

          getEl<HTMLElement>(
            '#forgotView'
          ).hidden =
            true;


          getEl<HTMLElement>(
            '#loginView'
          ).hidden =
            false;

        }
      );


    getEl<HTMLFormElement>(
      '#forgotForm'
    )
      .addEventListener(
        'submit',
        async event => {

          event.preventDefault();

          hideMessage(
            '#forgotMessage'
          );


          const email =
            getEl<HTMLInputElement>(
              '#resetEmailInput'
            )
              .value
              .trim();


          const button =
            getEl<HTMLButtonElement>(
              '#sendResetButton'
            );


          button.disabled =
            true;

          button.textContent =
            'Sending...';


          try {

            const redirectTo =
              `${window.location.origin}/portal/reset-password/`;


            const {
              error
            } =
              await supabase.auth
                .resetPasswordForEmail(
                  email,
                  {
                    redirectTo
                  }
                );


            if (error) {
              throw error;
            }


            showMessage(
              '#forgotMessage',
              'Reset link sent. Please check your email inbox.',
              'success'
            );

          } catch (error) {

            showMessage(
              '#forgotMessage',
              error instanceof Error
                ? error.message
                : 'Unable to send reset email.',
              'error'
            );

          } finally {

            button.disabled =
              false;

            button.textContent =
              'Send Reset Link';

          }

        }
      );


    void routeUser();

  </script>


  <style is:global>

    * {
      box-sizing: border-box;
    }


    body {
      margin: 0;

      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        #f5f7fb;

      color: #20324b;
    }


    .login-page {
      min-height: 100vh;

      padding: 24px;

      display: flex;
      align-items: center;
      justify-content: center;

      background:
        radial-gradient(
          circle at top right,
          rgba(
            242,
            139,
            45,
            .08
          ),
          transparent 30%
        ),
        #f5f7fb;
    }


    .login-card {
      width:
        min(
          100%,
          430px
        );

      padding:
        34px;

      border:
        1px solid #e1e7ee;

      border-radius: 20px;

      background: white;

      box-shadow:
        0 16px 50px
        rgba(
          23,
          55,
          94,
          .08
        );
    }


    .brand {
      margin-bottom: 30px;
    }


    .brand img {
      width: 180px;
      display: block;
    }


    .brand p {
      margin:
        8px 0 0;

      color: #8b97a8;

      font-size: 10px;
      font-weight: 800;

      letter-spacing: .14em;

      text-transform: uppercase;
    }


    .heading {
      margin-bottom: 23px;
    }


    .eyebrow {
      margin:
        0 0 6px;

      color: #f28b2d;

      font-size: 10px;
      font-weight: 850;

      letter-spacing: .14em;
    }


    h1 {
      margin: 0;

      color: #17375e;

      font-size: 27px;
      line-height: 1.15;
    }


    .heading > p:last-child {
      margin:
        8px 0 0;

      color: #8794a6;

      font-size: 13px;
      line-height: 1.55;
    }


    form {
      display: grid;
      gap: 16px;
    }


    label {
      color: #56677d;

      font-size: 11px;
      font-weight: 700;
    }


    input {
      width: 100%;
      min-height: 46px;

      margin-top: 7px;

      padding:
        0 13px;

      border:
        1px solid #d9e1ea;

      border-radius: 10px;

      outline: none;

      background: white;

      color: #20324b;

      font: inherit;
      font-size: 13px;
    }


    input:focus {
      border-color: #8aa5c4;

      box-shadow:
        0 0 0 3px
        rgba(
          23,
          55,
          94,
          .07
        );
    }


    .password-actions {
      margin-top: -6px;

      display: flex;
      justify-content: flex-end;
    }


    .link-button,
    .back-button {
      border: none;
      background: transparent;

      color: #17375e;

      font: inherit;
      font-size: 11px;
      font-weight: 750;

      cursor: pointer;

      padding: 0;
    }


    .link-button:hover,
    .back-button:hover {
      color: #f28b2d;
    }


    .back-button {
      margin-bottom: 22px;
    }


    .primary-button {
      min-height: 48px;

      border: none;

      border-radius: 11px;

      background: #17375e;

      color: white;

      font: inherit;
      font-size: 13px;
      font-weight: 800;

      cursor: pointer;
    }


    .primary-button:hover {
      background: #102a4b;
    }


    .primary-button:disabled {
      opacity: .65;
      cursor: not-allowed;
    }


    .message {
      padding:
        11px 12px;

      border-radius: 9px;

      font-size: 11px;
      line-height: 1.5;
    }


    .message.error {
      border:
        1px solid #efc0c0;

      background: #fff1f1;

      color: #a43f3f;
    }


    .message.success {
      border:
        1px solid #bde1cc;

      background: #edf9f2;

      color: #28754d;
    }


    [hidden] {
      display: none !important;
    }


    @media
    (max-width: 520px) {

      .login-page {
        padding: 14px;
      }


      .login-card {
        padding:
          27px 21px;

        border-radius: 16px;
      }


      .brand img {
        width: 160px;
      }


      h1 {
        font-size: 24px;
      }

    }

  </style>

</body>
</html>
