---
import logoSrc from '../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />
  <title>Parent Dashboard | Santutor</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading your Santutor dashboard...</p>
  </div>


  <div id="app" class="app" hidden>

    <!-- MOBILE HEADER -->

    <header class="mobile-topbar">

      <a
        class="mobile-brand"
        href="/portal/parent/"
      >
        <img
          src={logoSrc.src}
          alt="Santutor Learning Studio"
        />
      </a>

      <button
        id="mobileMenuButton"
        class="mobile-menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

    </header>


    <div
      id="mobileBackdrop"
      class="mobile-backdrop"
      hidden
    ></div>


    <aside
      id="mobileDrawer"
      class="mobile-drawer"
      aria-hidden="true"
    >

      <div class="mobile-drawer-header">

        <div class="drawer-logo">
          <img
            src={logoSrc.src}
            alt="Santutor Learning Studio"
          />
        </div>

        <button
          id="mobileCloseButton"
          class="mobile-close-button"
          type="button"
          aria-label="Close menu"
        >
          ×
        </button>

      </div>


      <nav class="mobile-nav">

        <a
          class="mobile-nav-item active"
          href="#overview"
        >
          <span>⌂</span>
          Overview
        </a>

        <a
          class="mobile-nav-item"
          href="#schedule"
        >
          <span>📅</span>
          Schedule
        </a>

        <a
          class="mobile-nav-item"
          href="#attendance"
        >
          <span>✓</span>
          Attendance
        </a>

        <a
          class="mobile-nav-item"
          href="#reports"
        >
          <span>📚</span>
          Learning Reports
        </a>

        <a
          class="mobile-nav-item"
          href="#package"
        >
          <span>🎟</span>
          Package & Payment
        </a>

        <a
          class="mobile-nav-item"
          href="#account"
        >
          <span>⚙</span>
          Account
        </a>

      </nav>


      <div class="mobile-drawer-footer">

        <button
          id="mobileLogoutButton"
          class="mobile-logout-button"
          type="button"
        >
          ↪
          <span>Sign Out</span>
        </button>

      </div>

    </aside>


    <!-- DESKTOP SIDEBAR -->

    <aside class="sidebar">

      <div class="brand">

        <a href="/portal/parent/">

          <div class="logo-box">
            <img
              src={logoSrc.src}
              alt="Santutor Learning Studio"
            />
          </div>

        </a>

        <span class="portal-label">
          PARENT PORTAL
        </span>

      </div>


      <nav>

        <a
          class="nav-item active"
          href="#overview"
        >
          <span class="nav-icon">⌂</span>
          <span>Overview</span>
        </a>

        <a
          class="nav-item"
          href="#schedule"
        >
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a
          class="nav-item"
          href="#attendance"
        >
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a
          class="nav-item"
          href="#reports"
        >
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a
          class="nav-item"
          href="#package"
        >
          <span class="nav-icon">🎟</span>
          <span>Package & Payment</span>
        </a>

        <a
          class="nav-item"
          href="#account"
        >
          <span class="nav-icon">⚙</span>
          <span>Account</span>
        </a>

      </nav>


      <div class="sidebar-bottom">

        <button
          id="logoutButton"
          class="logout-button"
          type="button"
        >
          ↪
          <span>Sign Out</span>
        </button>

      </div>

    </aside>


    <!-- MAIN -->

    <main class="main">

      <section id="overview">

        <header class="page-header">

          <div>

            <p class="eyebrow">
              SANTUTOR PARENT PORTAL
            </p>

            <h1>
              Hello,
              <span id="parentName">
                Parent
              </span>
            </h1>

            <p class="subtitle">
              Your child's learning overview at Santutor.
            </p>

          </div>


          <div
            id="childSelectorWrap"
            class="child-selector-wrap"
          >

            <label for="childSelector">
              Viewing
            </label>

            <select id="childSelector"></select>

          </div>

        </header>


        <section
          id="studentHero"
          class="student-hero"
        >

          <div class="student-avatar" id="studentAvatar">
            S
          </div>

          <div class="student-main">

            <div class="student-title-row">

              <div>

                <h2 id="studentName">
                  Student
                </h2>

                <p id="studentMeta">
                  —
                </p>

              </div>

              <span
                id="studentCode"
                class="student-code"
              >
                —
              </span>

            </div>

          </div>

        </section>


        <section class="stats-grid">

          <article class="stat-card">

            <div class="stat-icon package-icon">
              🎟
            </div>

            <div>

              <span class="stat-label">
                Sessions Remaining
              </span>

              <strong id="remainingSessions">
                —
              </strong>

              <span
                id="packageName"
                class="stat-note"
              >
                No active package
              </span>

            </div>

          </article>


          <article class="stat-card">

            <div class="stat-icon next-icon">
              📅
            </div>

            <div>

              <span class="stat-label">
                Next Class
              </span>

              <strong
                id="nextClassDate"
                class="small-stat"
              >
                —
              </strong>

              <span
                id="nextClassDetail"
                class="stat-note"
              >
                No upcoming class
              </span>

            </div>

          </article>


          <article class="stat-card">

            <div class="stat-icon attendance-icon">
              ✓
            </div>

            <div>

              <span class="stat-label">
                Attendance Rate
              </span>

              <strong id="attendanceRate">
                —
              </strong>

              <span
                id="attendanceCount"
                class="stat-note"
              >
                No attendance yet
              </span>

            </div>

          </article>


          <article class="stat-card">

            <div class="stat-icon payment-icon">
              💳
            </div>

            <div>

              <span class="stat-label">
                Payment Status
              </span>

              <strong
                id="paymentStatus"
                class="small-stat"
              >
                —
              </strong>

              <span
                id="paymentAmount"
                class="stat-note"
              >
                No package
              </span>

            </div>

          </article>

        </section>

      </section>


      <!-- SCHEDULE -->

      <section
        id="schedule"
        class="dashboard-panel"
      >

        <div class="panel-top">

          <div>

            <p class="section-label">
              WEEKLY SCHEDULE
            </p>

            <h2>
              Regular Classes
            </h2>

            <p class="panel-description">
              Your child's current weekly Santutor schedule.
            </p>

          </div>

        </div>


        <div
          id="scheduleList"
          class="schedule-list"
        ></div>

      </section>


      <!-- ATTENDANCE -->

      <section
        id="attendance"
        class="dashboard-panel"
      >

        <div class="panel-top">

          <div>

            <p class="section-label">
              ATTENDANCE
            </p>

            <h2>
              Recent Classes
            </h2>

            <p class="panel-description">
              Latest attendance records for this student.
            </p>

          </div>

        </div>


        <div
          id="attendanceList"
          class="attendance-list"
        ></div>

      </section>


      <!-- REPORTS -->

      <section
        id="reports"
        class="dashboard-panel"
      >

        <div class="panel-top">

          <div>

            <p class="section-label">
              LEARNING PROGRESS
            </p>

            <h2>
              Learning Reports
            </h2>

            <p class="panel-description">
              Reports published by your child's tutor.
            </p>

          </div>

        </div>


        <div
          id="reportList"
          class="report-list"
        ></div>

      </section>


      <!-- PACKAGE -->

      <section
        id="package"
        class="dashboard-panel"
      >

        <div class="panel-top">

          <div>

            <p class="section-label">
              PACKAGE & PAYMENT
            </p>

            <h2>
              Package Details
            </h2>

            <p class="panel-description">
              Session balance and recorded payments.
            </p>

          </div>

        </div>


        <div class="package-grid">

          <div
            id="packageDetail"
            class="package-detail"
          ></div>

          <div>

            <h3 class="subheading">
              Recent Payments
            </h3>

            <div
              id="paymentList"
              class="payment-list"
            ></div>

          </div>

        </div>

      </section>




      <!-- ACCOUNT -->

      <section
        id="account"
        class="dashboard-panel"
      >

        <div class="panel-top">

          <div>

            <p class="section-label">
              ACCOUNT
            </p>

            <h2>
              Account & Password
            </h2>

            <p class="panel-description">
              Update the password used to sign in to Santutor.
            </p>

          </div>

        </div>


        <div class="account-layout">

          <div class="account-info">

            <span class="account-label">
              Login Email
            </span>

            <strong id="accountEmail">
              —
            </strong>

            <p>
              This email is used to access the Parent Portal.
            </p>

          </div>


          <form
            id="changePasswordForm"
            class="password-form"
          >

            <label>
              New Password

              <input
                id="accountNewPassword"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
              />
            </label>


            <label>
              Confirm New Password

              <input
                id="accountConfirmPassword"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
              />
            </label>


            <button
              id="changePasswordButton"
              class="account-save-button"
              type="submit"
            >
              Change Password
            </button>


            <div
              id="accountMessage"
              class="account-message"
              hidden
            ></div>

          </form>

        </div>

      </section>


      <section
        id="errorPanel"
        class="error-panel"
        hidden
      >
        <strong>
          We couldn't load this parent dashboard.
        </strong>

        <p id="errorText"></p>
      </section>

    </main>

  </div>


  <script>

    import {
      supabase
    } from '../../../lib/supabase';


    type ParentInfo = {
      id: string;
      parent_code: string | null;
      name: string;
      email: string | null;
      phone: string | null;
    };


    type ScheduleItem = {
      id: string;
      schedule_code: string | null;
      subject: string | null;
      day_of_week: string;
      start_time: string;
      end_time: string;
      class_mode: string;
      location: string | null;
      tutor_name: string | null;
    };


    type AttendanceItem = {
      id: string;
      attendance_code: string | null;
      class_date: string;
      start_time: string | null;
      end_time: string | null;
      attendance_status: string;
      is_makeup: boolean;
      rescheduled_from_date: string | null;
      subject: string | null;
      class_mode: string | null;
      tutor_name: string | null;
    };


    type PackageItem = {
      id: string;
      package_code: string | null;
      package_name: string;
      total_sessions: number;
      remaining_sessions: number;
      price: number | string | null;
      payment_status: string;
      purchase_date: string | null;
      start_date: string | null;
      expiry_date: string | null;
      status: string;
      created_at: string;
    };


    type PaymentItem = {
      id: string;
      payment_code: string | null;
      package_id: string;
      amount: number | string;
      payment_date: string;
      payment_method: string;
      status: string;
    };


    type ReportItem = {
      id: string;
      report_code: string | null;
      report_date: string;
      subject: string | null;
      topic: string | null;
      summary: string | null;
      strengths: string | null;
      areas_for_improvement: string | null;
      homework: string | null;
      next_focus: string | null;
      engagement_rating: number | null;
      understanding_rating: number | null;
      tutor_name: string | null;
    };


    type Child = {
      id: string;
      student_code: string | null;
      name: string;
      nickname: string | null;
      school: string | null;
      grade: string | null;
      curriculum: string | null;
      status: string;
      relationship: string | null;
      is_primary: boolean;
      schedules: ScheduleItem[];
      attendance: AttendanceItem[];
      packages: PackageItem[];
      payments: PaymentItem[];
      reports: ReportItem[];
    };


    type ParentDashboard = {
      parent: ParentInfo;
      children: Child[];
    };


    let dashboard:
      ParentDashboard | null =
      null;


    let selectedChildId:
      string | null =
      null;


    function getEl<T extends Element>(
      selector: string
    ): T {

      const element =
        document.querySelector<T>(
          selector
        );


      if (!element) {
        throw new Error(
          `Element not found: ${selector}`
        );
      }


      return element;

    }


    function setText(
      selector: string,
      value: string | number
    ): void {

      getEl<HTMLElement>(
        selector
      ).textContent =
        String(value);

    }


    function escapeHtml(
      value:
        string |
        number |
        null |
        undefined
    ): string {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value === null ||
        value === undefined
          ? ''
          : String(value);


      return div.innerHTML;

    }


    function formatTime(
      value: string | null
    ): string {

      if (!value) return '—';

      return value.slice(0, 5);

    }


    function formatDate(
      value: string | null
    ): string {

      if (!value) return '—';


      const date =
        new Date(
          `${value}T00:00:00`
        );


      return new Intl
        .DateTimeFormat(
          'en-GB',
          {
            day: 'numeric',
            month: 'short',
            year: 'numeric'
          }
        )
        .format(date);

    }


    function formatShortDate(
      date: Date
    ): string {

      return new Intl
        .DateTimeFormat(
          'en-GB',
          {
            weekday: 'short',
            day: 'numeric',
            month: 'short'
          }
        )
        .format(date);

    }


    function formatCurrency(
      value:
        number |
        string |
        null |
        undefined
    ): string {

      const amount =
        Number(value || 0);


      return new Intl
        .NumberFormat(
          'id-ID',
          {
            style: 'currency',
            currency: 'IDR',
            maximumFractionDigits: 0
          }
        )
        .format(amount);

    }


    function titleCase(
      value: string
    ): string {

      return value
        .replaceAll('_', ' ')
        .replace(
          /\b\w/g,
          char =>
            char.toUpperCase()
        );

    }


    function initials(
      name: string
    ): string {

      return name
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map(part =>
          part.charAt(0)
        )
        .join('')
        .toUpperCase();

    }


    function currentChild():
      Child | null {

      if (
        !dashboard ||
        !selectedChildId
      ) {
        return null;
      }


      return (
        dashboard.children.find(
          child =>
            child.id ===
            selectedChildId
        ) || null
      );

    }


    function activePackage(
      child: Child
    ): PackageItem | null {

      return (
        child.packages.find(
          item =>
            item.status === 'active'
        ) ||
        child.packages[0] ||
        null
      );

    }


    function jakartaToday():
      Date {

      const parts =
        new Intl.DateTimeFormat(
          'en-CA',
          {
            timeZone: 'Asia/Jakarta',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }
        )
        .formatToParts(
          new Date()
        );


      const map =
        Object.fromEntries(
          parts.map(
            part => [
              part.type,
              part.value
            ]
          )
        );


      return new Date(
        Number(map.year),
        Number(map.month) - 1,
        Number(map.day),
        0,
        0,
        0,
        0
      );

    }


    function weekdayIndex(
      day: string
    ): number {

      const map:
        Record<string, number> = {
          Sunday: 0,
          Monday: 1,
          Tuesday: 2,
          Wednesday: 3,
          Thursday: 4,
          Friday: 5,
          Saturday: 6
        };


      return map[day] ?? 7;

    }


    function nextRegularClass(
      child: Child
    ): {
      date: Date;
      schedule: ScheduleItem;
    } | null {

      if (
        child.schedules.length === 0
      ) {
        return null;
      }


      const today =
        jakartaToday();


      const nowParts =
        new Intl.DateTimeFormat(
          'en-GB',
          {
            timeZone: 'Asia/Jakarta',
            hour: '2-digit',
            minute: '2-digit',
            hourCycle: 'h23'
          }
        )
        .formatToParts(
          new Date()
        );


      const nowMap =
        Object.fromEntries(
          nowParts.map(
            part => [
              part.type,
              part.value
            ]
          )
        );


      const nowMinutes =
        (
          Number(
            nowMap.hour || 0
          ) * 60
        ) +
        Number(
          nowMap.minute || 0
        );


      const candidates =
        child.schedules.map(
          schedule => {

            const target =
              weekdayIndex(
                schedule.day_of_week
              );


            let diff =
              (
                target -
                today.getDay() +
                7
              ) % 7;


            if (
              diff === 0
            ) {

              const [
                hour,
                minute
              ] =
                schedule.start_time
                  .slice(0, 5)
                  .split(':')
                  .map(Number);


              const classMinutes =
                (
                  (hour || 0) *
                  60
                ) +
                (minute || 0);


              if (
                classMinutes <
                nowMinutes
              ) {
                diff = 7;
              }

            }


            const candidate =
              new Date(today);


            candidate.setDate(
              candidate.getDate() +
              diff
            );


            return {
              date: candidate,
              schedule
            };

          }
        );


      candidates.sort(
        (
          a,
          b
        ) => {

          const dateDiff =
            a.date.getTime() -
            b.date.getTime();


          if (
            dateDiff !== 0
          ) {
            return dateDiff;
          }


          return (
            a.schedule.start_time
              .localeCompare(
                b.schedule.start_time
              )
          );

        }
      );


      return candidates[0] || null;

    }


    function nextMakeupClass(
      child: Child
    ): AttendanceItem | null {

      const today =
        jakartaToday();


      return (
        child.attendance
          .filter(
            item => {

              if (
                !item.is_makeup ||
                item.attendance_status !==
                  'pending'
              ) {
                return false;
              }


              const date =
                new Date(
                  `${item.class_date}T00:00:00`
                );


              return (
                date.getTime() >=
                today.getTime()
              );

            }
          )
          .sort(
            (
              a,
              b
            ) => {

              const dateDiff =
                a.class_date
                  .localeCompare(
                    b.class_date
                  );


              if (
                dateDiff !== 0
              ) {
                return dateDiff;
              }


              return (
                (a.start_time || '')
                  .localeCompare(
                    b.start_time || ''
                  )
              );

            }
          )[0] ||
        null
      );

    }


    async function requireParent():
      Promise<void> {

      const {
        data: {
          user
        }
      } =
        await supabase.auth
          .getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        throw new Error(
          'Not authenticated'
        );

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select(
            'role, active'
          )
          .eq(
            'id',
            user.id
          )
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'parent' ||
        profile.active !== true
      ) {

        await supabase.auth
          .signOut();


        window.location.href =
          '/portal/';


        throw new Error(
          'Parent access required'
        );

      }

    }


    async function loadDashboard():
      Promise<void> {

      const {
        data,
        error
      } =
        await supabase.rpc(
          'get_parent_portal_dashboard'
        );


      if (error) {
        throw error;
      }


      dashboard =
        data as ParentDashboard;


      if (
        !dashboard ||
        !dashboard.parent
      ) {
        throw new Error(
          'Parent profile could not be loaded.'
        );
      }


      setText(
        '#parentName',
        dashboard.parent.name
      );


      setText(
        '#accountEmail',
        dashboard.parent.email ||
        'No email recorded'
      );


      if (
        dashboard.children.length === 0
      ) {

        renderNoLinkedStudents();

        return;

      }


      selectedChildId =
        dashboard.children[0].id;


      renderChildSelector();

      renderSelectedChild();

    }


    function renderNoLinkedStudents():
      void {

      getEl<HTMLElement>(
        '#studentHero'
      ).innerHTML = `
        <div class="empty-state large">
          <strong>
            No student linked yet
          </strong>
          <p>
            Please contact Santutor admin to connect
            your child to this parent account.
          </p>
        </div>
      `;


      setText(
        '#remainingSessions',
        '—'
      );


      setText(
        '#nextClassDate',
        '—'
      );


      setText(
        '#attendanceRate',
        '—'
      );


      setText(
        '#paymentStatus',
        '—'
      );


      getEl<HTMLElement>(
        '#scheduleList'
      ).innerHTML =
        emptyHtml(
          'No schedule available.'
        );


      getEl<HTMLElement>(
        '#attendanceList'
      ).innerHTML =
        emptyHtml(
          'No attendance available.'
        );


      getEl<HTMLElement>(
        '#reportList'
      ).innerHTML =
        emptyHtml(
          'No reports available.'
        );


      getEl<HTMLElement>(
        '#packageDetail'
      ).innerHTML =
        emptyHtml(
          'No package available.'
        );


      getEl<HTMLElement>(
        '#paymentList'
      ).innerHTML =
        emptyHtml(
          'No payment history available.'
        );

    }


    function renderChildSelector():
      void {

      if (!dashboard) return;


      const wrap =
        getEl<HTMLElement>(
          '#childSelectorWrap'
        );


      const selector =
        getEl<HTMLSelectElement>(
          '#childSelector'
        );


      selector.innerHTML =
        dashboard.children
          .map(
            child => `
              <option
                value="${escapeHtml(child.id)}"
              >
                ${escapeHtml(child.name)}
              </option>
            `
          )
          .join('');


      selector.value =
        selectedChildId || '';


      wrap.hidden =
        dashboard.children.length <= 1;

    }


    function renderSelectedChild():
      void {

      const child =
        currentChild();


      if (!child) return;


      setText(
        '#studentAvatar',
        initials(child.name)
      );


      setText(
        '#studentName',
        child.name
      );


      const meta =
        [
          child.grade,
          child.school,
          child.curriculum
        ]
          .filter(Boolean)
          .join(' · ');


      setText(
        '#studentMeta',
        meta || 'Santutor student'
      );


      setText(
        '#studentCode',
        child.student_code || '—'
      );


      renderStats(child);

      renderSchedule(child);

      renderAttendance(child);

      renderReports(child);

      renderPackage(child);

      renderPayments(child);

    }


    function renderStats(
      child: Child
    ): void {

      const pkg =
        activePackage(child);


      setText(
        '#remainingSessions',
        pkg
          ? pkg.remaining_sessions
          : '—'
      );


      setText(
        '#packageName',
        pkg
          ? pkg.package_name
          : 'No active package'
      );


      const completed =
        child.attendance.filter(
          item =>
            item.attendance_status ===
              'present' ||
            item.attendance_status ===
              'absent'
        );


      const present =
        completed.filter(
          item =>
            item.attendance_status ===
            'present'
        ).length;


      const rate =
        completed.length > 0
          ? Math.round(
              (
                present /
                completed.length
              ) * 100
            )
          : null;


      setText(
        '#attendanceRate',
        rate === null
          ? '—'
          : `${rate}%`
      );


      setText(
        '#attendanceCount',
        completed.length > 0
          ? `${present} present of ${completed.length} recorded classes`
          : 'No completed attendance yet'
      );


      setText(
        '#paymentStatus',
        pkg
          ? titleCase(
              pkg.payment_status
            )
          : '—'
      );


      setText(
        '#paymentAmount',
        pkg && pkg.price !== null
          ? formatCurrency(
              pkg.price
            )
          : 'No active package'
      );


      const makeup =
        nextMakeupClass(child);


      if (makeup) {

        setText(
          '#nextClassDate',
          formatDate(
            makeup.class_date
          )
        );


        setText(
          '#nextClassDetail',
          `${formatTime(makeup.start_time)} · ${makeup.subject || 'Make-up class'}`
        );


        return;

      }


      const next =
        nextRegularClass(child);


      if (!next) {

        setText(
          '#nextClassDate',
          '—'
        );


        setText(
          '#nextClassDetail',
          'No upcoming class'
        );


        return;

      }


      setText(
        '#nextClassDate',
        formatShortDate(
          next.date
        )
      );


      setText(
        '#nextClassDetail',
        `${formatTime(next.schedule.start_time)} · ${next.schedule.subject || 'Class'}`
      );

    }


    function renderSchedule(
      child: Child
    ): void {

      const container =
        getEl<HTMLElement>(
          '#scheduleList'
        );


      if (
        child.schedules.length === 0
      ) {

        container.innerHTML =
          emptyHtml(
            'No active weekly schedule.'
          );

        return;

      }


      container.innerHTML =
        child.schedules
          .map(
            item => `
              <article class="schedule-row">

                <div class="day-badge">
                  ${escapeHtml(
                    item.day_of_week
                      .slice(0, 3)
                      .toUpperCase()
                  )}
                </div>

                <div class="row-main">

                  <strong>
                    ${escapeHtml(
                      item.subject ||
                      'Class'
                    )}
                  </strong>

                  <span>
                    ${escapeHtml(
                      item.tutor_name ||
                      'Santutor Tutor'
                    )}
                    ·
                    ${escapeHtml(
                      titleCase(
                        item.class_mode
                      )
                    )}
                  </span>

                </div>

                <div class="row-time">

                  <strong>
                    ${escapeHtml(
                      formatTime(
                        item.start_time
                      )
                    )}
                  </strong>

                  <span>
                    ${escapeHtml(
                      formatTime(
                        item.end_time
                      )
                    )}
                  </span>

                </div>

              </article>
            `
          )
          .join('');

    }


    function attendanceBadge(
      status: string
    ): string {

      return `
        <span
          class="status-badge ${escapeHtml(status)}"
        >
          ${escapeHtml(
            titleCase(status)
          )}
        </span>
      `;

    }


    function renderAttendance(
      child: Child
    ): void {

      const container =
        getEl<HTMLElement>(
          '#attendanceList'
        );


      const recent =
        child.attendance
          .filter(
            item =>
              item.attendance_status !==
              'pending'
          )
          .slice(0, 8);


      if (
        recent.length === 0
      ) {

        container.innerHTML =
          emptyHtml(
            'No attendance records yet.'
          );

        return;

      }


      container.innerHTML =
        recent
          .map(
            item => `
              <article class="attendance-row">

                <div class="date-box">

                  <strong>
                    ${escapeHtml(
                      formatDate(
                        item.class_date
                      )
                    )}
                  </strong>

                  <span>
                    ${escapeHtml(
                      formatTime(
                        item.start_time
                      )
                    )}
                  </span>

                </div>

                <div class="row-main">

                  <strong>
                    ${escapeHtml(
                      item.subject ||
                      'Class'
                    )}

                    ${
                      item.is_makeup
                        ? '<span class="makeup-tag">MAKE-UP</span>'
                        : ''
                    }
                  </strong>

                  <span>
                    ${escapeHtml(
                      item.tutor_name ||
                      'Santutor Tutor'
                    )}
                  </span>

                </div>

                <div>
                  ${attendanceBadge(
                    item.attendance_status
                  )}
                </div>

              </article>
            `
          )
          .join('');

    }


    function renderStars(
      rating: number | null
    ): string {

      if (
        rating === null ||
        rating < 1
      ) {
        return '—';
      }


      return (
        '★'.repeat(
          Math.min(
            rating,
            5
          )
        ) +
        '☆'.repeat(
          Math.max(
            0,
            5 - rating
          )
        )
      );

    }


    function renderReports(
      child: Child
    ): void {

      const container =
        getEl<HTMLElement>(
          '#reportList'
        );


      if (
        child.reports.length === 0
      ) {

        container.innerHTML =
          emptyHtml(
            'No published learning reports yet.'
          );

        return;

      }


      container.innerHTML =
        child.reports
          .slice(0, 5)
          .map(
            report => `
              <article class="report-card">

                <div class="report-head">

                  <div>

                    <span class="report-date">
                      ${escapeHtml(
                        formatDate(
                          report.report_date
                        )
                      )}
                    </span>

                    <h3>
                      ${escapeHtml(
                        report.topic ||
                        report.subject ||
                        'Learning Report'
                      )}
                    </h3>

                    <p>
                      ${escapeHtml(
                        report.subject ||
                        'General Learning'
                      )}
                      ·
                      ${escapeHtml(
                        report.tutor_name ||
                        'Santutor Tutor'
                      )}
                    </p>

                  </div>

                  <div class="ratings">

                    <span>
                      Engagement
                      <b>
                        ${escapeHtml(
                          renderStars(
                            report.engagement_rating
                          )
                        )}
                      </b>
                    </span>

                    <span>
                      Understanding
                      <b>
                        ${escapeHtml(
                          renderStars(
                            report.understanding_rating
                          )
                        )}
                      </b>
                    </span>

                  </div>

                </div>


                ${
                  report.summary
                    ? `
                      <div class="report-summary">
                        ${escapeHtml(
                          report.summary
                        )}
                      </div>
                    `
                    : ''
                }


                <div class="report-detail-grid">

                  ${
                    report.strengths
                      ? detailBlock(
                          'Strengths',
                          report.strengths
                        )
                      : ''
                  }

                  ${
                    report.areas_for_improvement
                      ? detailBlock(
                          'Areas to Improve',
                          report.areas_for_improvement
                        )
                      : ''
                  }

                  ${
                    report.homework
                      ? detailBlock(
                          'Homework',
                          report.homework
                        )
                      : ''
                  }

                  ${
                    report.next_focus
                      ? detailBlock(
                          'Next Focus',
                          report.next_focus
                        )
                      : ''
                  }

                </div>

              </article>
            `
          )
          .join('');

    }


    function detailBlock(
      title: string,
      body: string
    ): string {

      return `
        <div class="report-detail">
          <span>
            ${escapeHtml(title)}
          </span>
          <p>
            ${escapeHtml(body)}
          </p>
        </div>
      `;

    }


    function renderPackage(
      child: Child
    ): void {

      const container =
        getEl<HTMLElement>(
          '#packageDetail'
        );


      const pkg =
        activePackage(child);


      if (!pkg) {

        container.innerHTML =
          emptyHtml(
            'No package information available.'
          );

        return;

      }


      const used =
        Math.max(
          0,
          pkg.total_sessions -
          pkg.remaining_sessions
        );


      const percent =
        pkg.total_sessions > 0
          ? Math.min(
              100,
              Math.round(
                (
                  used /
                  pkg.total_sessions
                ) * 100
              )
            )
          : 0;


      container.innerHTML = `
        <div class="package-card">

          <div class="package-head">

            <div>

              <span class="package-code">
                ${escapeHtml(
                  pkg.package_code ||
                  'PACKAGE'
                )}
              </span>

              <h3>
                ${escapeHtml(
                  pkg.package_name
                )}
              </h3>

            </div>

            <span
              class="package-status ${escapeHtml(pkg.status)}"
            >
              ${escapeHtml(
                titleCase(
                  pkg.status
                )
              )}
            </span>

          </div>


          <div class="session-balance">

            <strong>
              ${escapeHtml(
                pkg.remaining_sessions
              )}
            </strong>

            <span>
              of
              ${escapeHtml(
                pkg.total_sessions
              )}
              sessions remaining
            </span>

          </div>


          <div class="progress-track">
            <div
              class="progress-bar"
              style="width:${percent}%"
            ></div>
          </div>


          <div class="package-info-grid">

            <div>
              <span>Payment</span>
              <strong>
                ${escapeHtml(
                  titleCase(
                    pkg.payment_status
                  )
                )}
              </strong>
            </div>

            <div>
              <span>Package Price</span>
              <strong>
                ${escapeHtml(
                  pkg.price !== null
                    ? formatCurrency(
                        pkg.price
                      )
                    : '—'
                )}
              </strong>
            </div>

            <div>
              <span>Start Date</span>
              <strong>
                ${escapeHtml(
                  formatDate(
                    pkg.start_date
                  )
                )}
              </strong>
            </div>

            <div>
              <span>Expiry</span>
              <strong>
                ${escapeHtml(
                  formatDate(
                    pkg.expiry_date
                  )
                )}
              </strong>
            </div>

          </div>

        </div>
      `;

    }


    function renderPayments(
      child: Child
    ): void {

      const container =
        getEl<HTMLElement>(
          '#paymentList'
        );


      const items =
        child.payments.slice(0, 6);


      if (
        items.length === 0
      ) {

        container.innerHTML =
          emptyHtml(
            'No recorded payments yet.'
          );

        return;

      }


      container.innerHTML =
        items
          .map(
            item => `
              <article class="payment-row">

                <div>

                  <strong>
                    ${escapeHtml(
                      formatCurrency(
                        item.amount
                      )
                    )}
                  </strong>

                  <span>
                    ${escapeHtml(
                      formatDate(
                        item.payment_date
                      )
                    )}
                    ·
                    ${escapeHtml(
                      titleCase(
                        item.payment_method
                      )
                    )}
                  </span>

                </div>

                <span
                  class="payment-badge ${escapeHtml(item.status)}"
                >
                  ${escapeHtml(
                    titleCase(
                      item.status
                    )
                  )}
                </span>

              </article>
            `
          )
          .join('');

    }


    function emptyHtml(
      message: string
    ): string {

      return `
        <div class="empty-state">
          <strong>
            Nothing to show yet
          </strong>
          <p>
            ${escapeHtml(message)}
          </p>
        </div>
      `;

    }


    function showError(
      message: string
    ): void {

      const panel =
        getEl<HTMLElement>(
          '#errorPanel'
        );


      panel.hidden =
        false;


      setText(
        '#errorText',
        message
      );

    }


    async function signOut():
      Promise<void> {

      await supabase.auth
        .signOut();


      window.location.href =
        '/portal/';

    }


    function setupMobileMenu():
      void {

      const drawer =
        getEl<HTMLElement>(
          '#mobileDrawer'
        );


      const backdrop =
        getEl<HTMLElement>(
          '#mobileBackdrop'
        );


      const button =
        getEl<HTMLButtonElement>(
          '#mobileMenuButton'
        );


      function close():
        void {

        drawer.classList
          .remove('open');


        drawer.setAttribute(
          'aria-hidden',
          'true'
        );


        backdrop.classList
          .remove('visible');


        backdrop.hidden =
          true;


        button.setAttribute(
          'aria-expanded',
          'false'
        );


        document.body
          .classList
          .remove(
            'mobile-menu-open'
          );

      }


      function open():
        void {

        backdrop.hidden =
          false;


        drawer.classList
          .add('open');


        drawer.setAttribute(
          'aria-hidden',
          'false'
        );


        requestAnimationFrame(
          () =>
            backdrop.classList
              .add('visible')
        );


        button.setAttribute(
          'aria-expanded',
          'true'
        );


        document.body
          .classList
          .add(
            'mobile-menu-open'
          );

      }


      button.addEventListener(
        'click',
        open
      );


      getEl<HTMLButtonElement>(
        '#mobileCloseButton'
      )
        .addEventListener(
          'click',
          close
        );


      backdrop.addEventListener(
        'click',
        close
      );


      document
        .querySelectorAll<HTMLAnchorElement>(
          '.mobile-nav-item'
        )
        .forEach(
          link => {
            link.addEventListener(
              'click',
              close
            );
          }
        );

    }


    async function initPage():
      Promise<void> {

      try {

        await requireParent();

        await loadDashboard();

        getEl<HTMLElement>(
          '#loadingScreen'
        )
          .setAttribute(
            'style',
            'display:none'
          );


        getEl<HTMLElement>(
          '#app'
        )
          .removeAttribute(
            'hidden'
          );

      } catch (error) {

        console.error(error);


        getEl<HTMLElement>(
          '#loadingScreen'
        )
          .setAttribute(
            'style',
            'display:none'
          );


        getEl<HTMLElement>(
          '#app'
        )
          .removeAttribute(
            'hidden'
          );


        showError(
          error instanceof Error
            ? error.message
            : 'Unknown parent portal error.'
        );

      }

    }


    getEl<HTMLSelectElement>(
      '#childSelector'
    )
      .addEventListener(
        'change',
        event => {

          const target =
            event.currentTarget as
              HTMLSelectElement;


          selectedChildId =
            target.value;


          renderSelectedChild();

        }
      );


    getEl<HTMLButtonElement>(
      '#logoutButton'
    )
      .addEventListener(
        'click',
        () => {
          void signOut();
        }
      );


    getEl<HTMLButtonElement>(
      '#mobileLogoutButton'
    )
      .addEventListener(
        'click',
        () => {
          void signOut();
        }
      );




    getEl<HTMLFormElement>(
      '#changePasswordForm'
    )
      .addEventListener(
        'submit',
        async event => {

          event.preventDefault();


          const message =
            getEl<HTMLElement>(
              '#accountMessage'
            );


          message.hidden =
            true;


          const password =
            getEl<HTMLInputElement>(
              '#accountNewPassword'
            )
              .value;


          const confirmPassword =
            getEl<HTMLInputElement>(
              '#accountConfirmPassword'
            )
              .value;


          if (
            password.length <
            8
          ) {

            message.hidden =
              false;

            message.className =
              'account-message error';

            message.textContent =
              'Password must be at least 8 characters.';

            return;

          }


          if (
            password !==
            confirmPassword
          ) {

            message.hidden =
              false;

            message.className =
              'account-message error';

            message.textContent =
              'The two passwords do not match.';

            return;

          }


          const button =
            getEl<HTMLButtonElement>(
              '#changePasswordButton'
            );


          button.disabled =
            true;

          button.textContent =
            'Updating...';


          try {

            const {
              error
            } =
              await supabase.auth
                .updateUser({
                  password
                });


            if (error) {
              throw error;
            }


            getEl<HTMLFormElement>(
              '#changePasswordForm'
            )
              .reset();


            message.hidden =
              false;

            message.className =
              'account-message success';

            message.textContent =
              'Password changed successfully.';

          } catch (error) {

            message.hidden =
              false;

            message.className =
              'account-message error';

            message.textContent =
              error instanceof Error
                ? error.message
                : 'Unable to change password.';

          } finally {

            button.disabled =
              false;

            button.textContent =
              'Change Password';

          }

        }
      );

    setupMobileMenu();

    void initPage();

  </script>


  <style is:global>

