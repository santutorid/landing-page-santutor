    }


    .child-selector-wrap label {
      color: #7e8b9d;

      font-size: 10px;
      font-weight: 750;

      text-transform: uppercase;

      letter-spacing: .07em;
    }


    .child-selector-wrap select {
      min-height: 44px;

      padding:
        0 38px 0 13px;

      border:
        1px solid #dce3eb;

      border-radius: 10px;

      background: white;

      color: var(--navy);

      font: inherit;
      font-size: 13px;
      font-weight: 700;
    }


    /* STUDENT HERO */

    .student-hero {
      min-height: 112px;

      padding:
        20px 22px;

      border:
        1px solid var(--line);

      border-radius: 17px;

      background:
        linear-gradient(
          120deg,
          #ffffff 0%,
          #f8fbff 100%
        );

      display: flex;
      align-items: center;

      gap: 17px;

      box-shadow:
        0 4px 16px
        rgba(
          23,
          55,
          94,
          .035
        );

      margin-bottom: 17px;
    }


    .student-avatar {
      width: 64px;
      height: 64px;

      border:
        1px solid #d5e1ee;

      border-radius: 18px;

      background: #eef5fc;

      color: var(--navy);

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      font-size: 21px;
      font-weight: 850;
    }


    .student-main {
      flex: 1;
      min-width: 0;
    }


    .student-title-row {
      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }


    .student-title-row h2 {
      font-size: 24px;
    }


    .student-title-row p {
      margin:
        4px 0 0;

      color: #8794a6;

      font-size: 12px;
    }


    .student-code {
      padding:
        6px 9px;

      border-radius: 8px;

      background: #f0f4f8;

      color: #748398;

      font-size: 10px;
      font-weight: 750;
    }


    /* STATS */

    .stats-grid {
      display: grid;

      grid-template-columns:
        repeat(
          4,
          minmax(0,1fr)
        );

      gap: 15px;

      margin-bottom: 20px;
    }


    .stat-card {
      min-height: 116px;

      padding: 17px;

      border:
        1px solid var(--line);

      border-radius: 15px;

      background: white;

      display: flex;
      align-items: center;

      gap: 14px;
    }


    .stat-icon {
      width: 45px;
      height: 45px;

      border-radius: 12px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      font-size: 17px;
    }


    .package-icon {
      background: #fff2e6;
    }


    .next-icon {
      background: #eef4fb;
    }


    .attendance-icon {
      background: #eaf8f0;
      color: var(--green);
    }


    .payment-icon {
      background: #f3effb;
    }


    .stat-label {
      display: block;

      color: #7e8b9d;

      font-size: 10px;
      font-weight: 750;
    }


    .stat-card strong {
      display: block;

      margin:
        5px 0;

      color: var(--navy);

      font-size: 25px;
      line-height: 1.05;
    }


    .stat-card strong.small-stat {
      font-size: 16px;
    }


    .stat-note {
      display: block;

      color: #a0a8b4;

      font-size: 9px;
      line-height: 1.4;
    }


    /* PANELS */

    .dashboard-panel {
      margin-bottom: 20px;

      padding:
        24px 26px;

      border:
        1px solid var(--line);

      border-radius: 18px;

      background: white;

      scroll-margin-top: 20px;
    }


    .panel-top {
      margin-bottom: 18px;
    }


    /* ROWS */

    .schedule-list,
    .attendance-list,
    .payment-list {
      display: flex;
      flex-direction: column;
    }


    .schedule-row,
    .attendance-row {
      min-height: 68px;

      padding:
        11px 0;

      border-bottom:
        1px solid #edf1f5;

      display: grid;

      align-items: center;

      gap: 13px;
    }


    .schedule-row {
      grid-template-columns:
        52px minmax(0,1fr) auto;
    }


    .attendance-row {
      grid-template-columns:
        118px minmax(0,1fr) auto;
    }


    .schedule-row:last-child,
    .attendance-row:last-child {
      border-bottom: none;
    }


    .day-badge {
      width: 44px;
      height: 44px;

      border-radius: 11px;

      background: #eef4fb;

      color: var(--navy);

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 10px;
      font-weight: 850;
    }


    .date-box {
      min-width: 0;
    }


    .date-box strong {
      display: block;

      color: var(--text);

      font-size: 12px;
      line-height: 1.25;

      white-space: nowrap;
    }


    .row-main {
      min-width: 0;
    }


    .row-main strong {
      display: block;

      color: var(--text);

      font-size: 12px;
      line-height: 1.35;
    }


    .date-box span,
    .row-main span,
    .row-time span {
      display: block;

      margin-top: 3px;

      color: #929eae;

      font-size: 9px;
    }


    .row-time {
      text-align: right;
    }


    .row-time strong {
      color: var(--navy);

      font-size: 12px;
    }


    .status-badge,
    .payment-badge,
    .package-status {
      display: inline-flex;

      padding:
        5px 8px;

      border-radius: 999px;

      font-size: 9px;
      font-weight: 800;

      text-transform: capitalize;
    }


    .status-badge.present,
    .payment-badge.received,
    .package-status.active {
      background: #eaf8ef;
      color: #267c4e;
    }


    .status-badge.absent,
    .payment-badge.refunded {
      background: #fdeaea;
      color: #b34545;
    }


    .status-badge.cancelled,
    .payment-badge.cancelled,
    .package-status.cancelled {
      background: #eff1f4;
      color: #737e8c;
    }


    .status-badge.rescheduled {
      background: #eaf0fa;
      color: #416ea6;
    }


    .makeup-tag {
      margin-left: 5px;

      padding:
        2px 5px;

      border-radius: 999px;

      background: #fff0df;

      color: #d66d00;

      font-size: 7px;
      font-weight: 900;

      vertical-align: middle;
    }


    /* REPORTS */

    .report-list {
      display: grid;
      gap: 13px;
    }


    .report-card {
      padding: 18px;

      border:
        1px solid #e7ebf0;

      border-radius: 13px;

      background: #fbfcfe;
    }


    .report-head {
      display: flex;

      align-items: flex-start;
      justify-content: space-between;

      gap: 18px;
    }


    .report-date {
      color: var(--orange);

      font-size: 9px;
      font-weight: 850;

      letter-spacing: .04em;
    }


    .report-card h3 {
      margin:
        4px 0 0;

      color: var(--navy);

      font-size: 15px;
    }


    .report-card h3 + p {
      margin:
        4px 0 0;

      color: #8995a6;

      font-size: 10px;
    }


    .ratings {
      min-width: 175px;

      display: grid;

      gap: 5px;
    }


    .ratings span {
      display: flex;

      justify-content: space-between;

      gap: 10px;

      color: #8692a3;

      font-size: 9px;
    }


    .ratings b {
      color: #f2a53c;
      letter-spacing: .04em;
    }


    .report-summary {
      margin-top: 14px;

      padding:
        11px 13px;

      border-left:
        3px solid var(--orange);

      background: white;

      color: #53647a;

      font-size: 11px;
      line-height: 1.55;
    }


    .report-detail-grid {
      margin-top: 13px;

      display: grid;

      grid-template-columns:
        repeat(
          2,
          minmax(0,1fr)
        );

      gap: 9px;
    }


    .report-detail {
      padding:
        10px 11px;

      border:
        1px solid #edf0f4;

      border-radius: 9px;

      background: white;
    }


    .report-detail span {
      color: #7e8a9b;

      font-size: 8px;
      font-weight: 850;

      text-transform: uppercase;

      letter-spacing: .06em;
    }


    .report-detail p {
      margin:
        5px 0 0;

      color: #59697f;

      font-size: 10px;
      line-height: 1.5;
    }


    /* PACKAGE */

    .package-grid {
      display: grid;

      grid-template-columns:
        minmax(0,1.15fr)
        minmax(280px,.85fr);

      gap: 22px;
    }


    .package-card {
      padding: 18px;

      border:
        1px solid #e5eaf0;

      border-radius: 14px;

      background: #fbfcfe;
    }


    .package-head {
      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 15px;
    }


    .package-code {
      color: var(--orange);

      font-size: 8px;
      font-weight: 850;
    }


    .package-head h3 {
      margin:
        4px 0 0;

      color: var(--navy);

      font-size: 16px;
    }


    .session-balance {
      margin-top: 20px;

      display: flex;
      align-items: baseline;

      gap: 7px;
    }


    .session-balance strong {
      color: var(--navy);

      font-size: 34px;
      line-height: 1;
    }


    .session-balance span {
      color: #8491a3;

      font-size: 10px;
    }


    .progress-track {
      height: 7px;

      margin-top: 11px;

      border-radius: 999px;

      overflow: hidden;

      background: #e8edf2;
    }


    .progress-bar {
      height: 100%;

      border-radius: inherit;

      background: var(--orange);
    }


    .package-info-grid {
      margin-top: 18px;

      display: grid;

      grid-template-columns:
        repeat(
          2,
          minmax(0,1fr)
        );

      gap: 11px;
    }


    .package-info-grid div {
      padding:
        10px;

      border:
        1px solid #edf0f4;

      border-radius: 9px;

      background: white;
    }


    .package-info-grid span {
      display: block;

      color: #929cab;

      font-size: 8px;

      text-transform: uppercase;

      letter-spacing: .05em;
    }


    .package-info-grid strong {
      display: block;

      margin-top: 4px;

      color: #42546b;

      font-size: 10px;
    }


    .subheading {
      margin:
        0 0 8px;

      color: var(--navy);

      font-size: 13px;
    }


    .payment-row {
      min-height: 54px;

      padding:
        10px 0;

      border-bottom:
        1px solid #edf0f4;

      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 12px;
    }


    .payment-row:last-child {
      border-bottom: none;
    }


    .payment-row strong {
      display: block;

      color: var(--text);

      font-size: 11px;
    }


    .payment-row span:not(
      .payment-badge
    ) {
      display: block;

      margin-top: 3px;

      color: #929eae;

      font-size: 9px;
    }




    /* ACCOUNT */

    .account-layout {
      display: grid;

      grid-template-columns:
        minmax(220px,.8fr)
        minmax(320px,1.2fr);

      gap: 26px;

      align-items: start;
    }


    .account-info {
      padding: 17px;

      border:
        1px solid #e6eaf0;

      border-radius: 13px;

      background: #f9fbfd;
    }


    .account-label {
      display: block;

      color: #8d99a9;

      font-size: 8px;
      font-weight: 850;

      letter-spacing: .07em;

      text-transform: uppercase;
    }


    .account-info strong {
      display: block;

      margin-top: 6px;

      color: #17375e;

      font-size: 13px;
    }


    .account-info p {
      margin:
        6px 0 0;

      color: #8c98a8;

      font-size: 10px;
      line-height: 1.5;
    }


    .password-form {
      display: grid;
      gap: 13px;
    }


    .password-form label {
      color: #56677d;

      font-size: 10px;
      font-weight: 750;
    }


    .password-form input {
      width: 100%;
      min-height: 43px;

      margin-top: 6px;

      padding:
        0 12px;

      border:
        1px solid #dce3eb;

      border-radius: 9px;

      outline: none;

      font: inherit;
      font-size: 12px;

      background: white;
    }


    .password-form input:focus {
      border-color: #8aa5c4;

      box-shadow:
        0 0 0 3px
        rgba(
          23,
          55,
          94,
          .06
        );
    }


    .account-save-button {
      min-height: 43px;

      border: none;

      border-radius: 9px;

      background: #17375e;

      color: white;

      font: inherit;
      font-size: 11px;
      font-weight: 800;

      cursor: pointer;
    }


    .account-save-button:disabled {
      opacity: .65;
      cursor: not-allowed;
    }


    .account-message {
      padding:
        9px 11px;

      border-radius: 8px;

      font-size: 10px;
      line-height: 1.5;
    }


    .account-message.success {
      border:
        1px solid #bde1cc;

      background: #edf9f2;

      color: #28754d;
    }


    .account-message.error {
      border:
        1px solid #efc0c0;

      background: #fff1f1;

      color: #a43f3f;
    }



    .empty-state {
      width: 100%;

      padding:
        28px 15px;

      text-align: center;

      color: #929eae;
    }


    .empty-state.large {
      padding:
        12px;
    }


    .empty-state strong {
      display: block;

      color: #58687d;

      font-size: 12px;
    }


    .empty-state p {
      margin:
        5px 0 0;

      font-size: 10px;
      line-height: 1.5;
    }


    .error-panel {
      padding:
        13px 15px;

      border:
        1px solid #edb8b8;

      border-radius: 11px;

      background: #fff2f2;

      color: #a03b3b;

      font-size: 11px;
    }


    .error-panel p {
      margin:
        5px 0 0;
    }


    /* MOBILE MENU */

    .mobile-topbar,
    .mobile-drawer,
    .mobile-backdrop {
      display: none;
    }


    @media
    (max-width: 1050px) {

      .stats-grid {
        grid-template-columns:
          repeat(
            2,
            minmax(0,1fr)
          );
      }


      .package-grid {
        grid-template-columns: 1fr;
      }

    }


    @media
    (max-width: 760px) {

      body.mobile-menu-open {
        overflow: hidden;
      }


      .app {
        display: block;
      }


      .sidebar {
        display: none;
      }


      .mobile-topbar {
        height: 64px;

        padding:
          8px 16px;

        border-bottom:
          1px solid #1f2937;

        background: white;

        display: flex;
        align-items: center;
        justify-content: space-between;

        position: sticky;
        top: 0;

        z-index: 60;
      }


      .mobile-brand {
        width: 142px;

        display: flex;
        align-items: center;
      }


      .mobile-brand img {
        width: 100%;
        display: block;
      }


      .mobile-menu-button {
        width: 42px;
        height: 42px;

        border: none;

        border-radius: 8px;

        background: transparent;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        gap: 5px;

        cursor: pointer;

        touch-action: manipulation;
      }


      .mobile-menu-button span {
        width: 22px;
        height: 2px;

        border-radius: 99px;

        background: #111827;
      }


      .mobile-backdrop {
        position: fixed;
        inset: 0;

        z-index: 70;

        background:
          rgba(
            9,
            24,
            42,
            .52
          );

        opacity: 0;

        pointer-events: none;
      }


      .mobile-backdrop.visible {
        display: block;

        opacity: 1;

        pointer-events: auto;
      }


      .mobile-backdrop[hidden] {
        display: none !important;
      }


      .mobile-drawer {
        width:
          min(
            84vw,
            320px
          );

        height: 100dvh;

        position: fixed;

        top: 0;
        left: 0;

        z-index: 80;

        transform:
          translateX(-102%);

        transition:
          transform .2s ease;

        background:
          linear-gradient(
            180deg,
            var(--navy) 0%,
            var(--navy-dark) 100%
          );

        color: white;

        flex-direction: column;

        pointer-events: none;
      }


      .mobile-drawer.open {
        display: flex;

        transform:
          translateX(0);

        pointer-events: auto;

        box-shadow:
          18px 0 44px
          rgba(
            8,
            29,
            51,
            .28
          );
      }


      .mobile-drawer-header {
        min-height: 78px;

        padding:
          14px 16px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom:
          1px solid
          rgba(
            255,
            255,
            255,
            .08
          );
      }


      .drawer-logo {
        width: 148px;

        padding:
          6px 9px;

        border-radius: 9px;

        background: white;
      }


      .drawer-logo img {
        width: 100%;
        display: block;
      }


      .mobile-close-button {
        width: 40px;
        height: 40px;

        border: none;

        border-radius: 9px;

        background:
          rgba(
            255,
            255,
            255,
            .08
          );

        color: white;

        font-size: 26px;

        cursor: pointer;
      }


      .mobile-nav {
        padding:
          14px 12px;

        display: flex;
        flex-direction: column;

        gap: 4px;
      }


      .mobile-nav-item {
        min-height: 46px;

        padding:
          10px 12px;

        border-radius: 10px;

        display: flex;
        align-items: center;

        gap: 12px;

        color:
          rgba(
            255,
            255,
            255,
            .78
          );

        text-decoration: none;

        font-size: 14px;
      }


      .mobile-nav-item span {
        width: 24px;
        text-align: center;
      }


      .mobile-nav-item.active {
        color: white;

        background:
          rgba(
            255,
            255,
            255,
            .14
          );

        font-weight: 800;

        box-shadow:
          inset 3px 0
          var(--orange);
      }


      .mobile-drawer-footer {
        margin-top: auto;

        padding:
          14px 12px 20px;
      }


      .main {
        padding:
          25px 15px 45px;
      }


      .page-header {
        align-items: stretch;
        flex-direction: column;

        gap: 15px;
      }


      h1 {
        font-size: 29px;
      }


      .child-selector-wrap {
        width: 100%;
      }


      .student-hero {
        padding: 16px;

        align-items: flex-start;
      }


      .student-avatar {
        width: 52px;
        height: 52px;

        border-radius: 14px;

        font-size: 17px;
      }


      .student-title-row {
        align-items: flex-start;
      }


      .student-title-row h2 {
        font-size: 19px;
      }


      .stats-grid {
        grid-template-columns: 1fr;

        gap: 9px;
      }


      .stat-card {
        min-height: 94px;

        padding: 14px;
      }


      .dashboard-panel {
        padding:
          20px 16px;

        scroll-margin-top:
          78px;
      }


      .schedule-row {
        grid-template-columns:
          46px minmax(0,1fr);

        gap: 10px;
      }


      .attendance-row {
        grid-template-columns:
          104px minmax(0,1fr);

        gap: 10px;
        align-items: start;
      }


      .row-time {
        grid-column: 2;
        text-align: left;
      }


      .attendance-row > div:last-child {
        grid-column: 2;
        text-align: left;
        margin-top: 2px;
      }


      .date-box {
        min-width: 0;
      }


      .date-box strong {
        white-space: normal;
        font-size: 11px;
      }


      .report-head {
        flex-direction: column;
      }


      .ratings {
        width: 100%;
        min-width: 0;
      }


      .report-detail-grid {
        grid-template-columns: 1fr;
      }


      .package-info-grid {
        grid-template-columns: 1fr 1fr;
      }


      .account-layout {
        grid-template-columns: 1fr;
        gap: 14px;
      }

    }

  </style>

</body>
</html>
