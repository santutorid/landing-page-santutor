    }


    .nav-icon {
      width: 22px;
      text-align: center;
    }


    .sidebar-bottom {
      margin-top: auto;
    }


    .logout-button,
    .mobile-logout-button {
      width: 100%;

      min-height: 44px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          .14
        );

      border-radius: 10px;

      background:
        rgba(
          255,
          255,
          255,
          .07
        );

      color: white;

      font: inherit;
      font-weight: 700;

      cursor: pointer;

      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;
    }


    /* MAIN */

    .main {
      width: 100%;
      max-width: 1450px;

      margin: 0 auto;

      padding:
        38px 40px 64px;
    }


    .page-header {
