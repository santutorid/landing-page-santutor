      background: #e28a3c;
    }

    .period-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      color: #7d8998;
      font-size: 10px;
    }

    .payment-cell {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }

    .payment-cell small {
      color: #8b96a6;
      font-size: 9px;
    }

    .payment-badge,
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 800;
    }

    .payment-badge.paid {
      background: #eaf8ef;
      color: #26844f;
    }

    .payment-badge.partial {
      background: #fff5e8;
      color: #b96b22;
    }

    .payment-badge.unpaid {
      background: #fff0f0;
      color: #b94141;
    }

    .status-badge.active {
      background: #eaf8ef;
      color: #26844f;
    }

    .status-badge.completed {
      background: #eef4fb;
      color: #3b6eaa;
    }

    .status-badge.expired {
      background: #f3f3f5;
      color: #737c88;
    }

    .status-badge.cancelled {
      background: #fff0f0;
      color: #b94141;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .action-heading,
    .action-cell {
      text-align: right;
    }

    .edit-button {
      border: 1px solid #dce4ed;
      background: white;
      color: #42536b;
      border-radius: 8px;
      padding: 7px 11px;
      cursor: pointer;
      font-size: 11px;
      font-weight: 750;
    }

    .edit-button:hover {
      background: #f7f9fc;
      color: #17375e;
    }

    .empty-row {
      padding: 60px 20px;
      text-align: center;
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #8f9aa9;
    }

    .empty-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #f4f6f9;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }

    .empty-state strong {
      color: #536178;
    }

    .empty-state p {
      margin: 5px 0 0;
      font-size: 12px;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background:
        rgba(15, 29, 47, .52);
      backdrop-filter:
        blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop[hidden] {
      display: none;
    }

    .modal {
      width: 100%;
      max-width: 760px;
      max-height: 92vh;
      overflow-y: auto;
      background: white;
      border-radius: 19px;
      box-shadow:
        0 25px 70px
        rgba(12, 27, 45, .28);
    }

    .modal-header {
      padding: 24px 25px 19px;
      display: flex;
      justify-content:
        space-between;
      gap: 20px;
      border-bottom:
        1px solid #edf0f4;
    }

    .modal-header p:last-child {
      color: #8c97a7;
      font-size: 12px;
      margin: 5px 0 0;
    }

    .modal-close {
      width: 34px;
      height: 34px;
      flex-shrink: 0;
      border-radius: 50%;
      border: none;
      background: #f3f5f7;
      color: #667389;
      cursor: pointer;
      font-size: 20px;
    }

    form {
      padding: 22px 25px 25px;
    }

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(2, 1fr);
      gap: 16px;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    label span {
      display: block;
      color: #536178;
      font-size: 11px;
      font-weight: 750;
      margin-bottom: 6px;
    }

    label input,
    label select,
    label textarea {
      width: 100%;
      border: 1px solid #dce3eb;
      border-radius: 9px;
      background: white;
      padding: 10px 11px;
      color: #27364b;
      outline: none;
      font-size: 13px;
    }

    label input,
    label select {
      height: 42px;
    }

    label textarea {
      resize: vertical;
      min-height: 96px;
    }

    label input:focus,
    label select:focus,
    label textarea:focus {
      border-color: #769dcc;
      box-shadow:
        0 0 0 3px
        rgba(73, 126, 188, .1);
    }

    .form-message {
      margin-top: 15px;
      min-height: 18px;
      font-size: 12px;
    }

    .form-message.error {
      color: #c44242;
    }

    .form-actions {
      margin-top: 18px;
      padding-top: 18px;
      border-top:
        1px solid #edf0f4;
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .form-spacer {
      flex: 1;
    }

    .cancel-button,
    .save-button,
    .danger-button {
      border-radius: 9px;
      padding: 10px 15px;
      font-weight: 750;
      cursor: pointer;
    }

    .cancel-button {
      border: 1px solid #dce3eb;
      background: white;
      color: #536178;
    }

    .save-button {
      border: none;
      background: #17375e;
      color: white;
    }

    .danger-button {
      border: 1px solid #f0caca;
      background: #fff6f6;
      color: #bf3d3d;
    }

    .save-button:disabled,
    .danger-button:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    .error-text {
      color: #c44242;
    }

    @media (max-width: 1150px) {

      .stats-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .panel-top {
        align-items: stretch;
        flex-direction: column;
      }

    }

    @media (max-width: 1000px) {

      .app {
        grid-template-columns:
          80px minmax(0, 1fr);
      }

      .sidebar {
        width: 80px;
      }

      .logo-box {
        width: 50px;
        padding: 6px;
      }

      .portal-label {
        display: none;
      }

      .nav-item {
        justify-content: center;
      }

      .nav-item span:not(.nav-icon) {
        display: none;
      }

      .logout-button span {
        display: none;
      }

      .main {
        padding: 28px 22px 50px;
      }

    }

    @media (max-width: 720px) {

      .app {
        display: block;
      }

      .sidebar {
        display: none;
      }

      .main {
        padding: 24px 15px 45px;
      }

      .page-header {
        align-items: stretch;
        flex-direction: column;
      }

      .add-button {
        width: 100%;
        justify-content: center;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .search-box,
      .toolbar select {
        width: 100%;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .full-width {
        grid-column: auto;
      }

      .form-actions {
        flex-wrap: wrap;
      }

      .form-spacer {
        display: none;
      }

      .danger-button {
        width: 100%;
      }

      .cancel-button,
      .save-button {
        flex: 1;
      }

    }

  </style>

</body>
</html>
