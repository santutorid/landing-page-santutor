---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>Packages | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>

  <div id="app" class="app" hidden>

    <aside class="sidebar">

      <div class="brand">
        <a href="/portal/admin/">
          <div class="logo-box">
            <img src={logoSrc.src} alt="Santutor Learning Studio" />
          </div>
        </a>
        <span class="portal-label">ADMIN PORTAL</span>
      </div>

      <nav>
        <a class="nav-item" href="/portal/admin/">
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

        <a class="nav-item" href="/portal/admin/students/">
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>

        <a class="nav-item" href="/portal/admin/schedule/">
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a class="nav-item" href="/portal/admin/attendance/">
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a class="nav-item" href="#">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a class="nav-item active" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>

        <a class="nav-item" href="#">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>

        <a class="nav-item" href="/portal/admin/parents/">
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>

        <a class="nav-item" href="/portal/admin/tutors/">
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <button id="logoutButton" class="logout-button" type="button">
          ↪ <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <main class="main">

      <header class="page-header">

        <div>
          <a class="back-link" href="/portal/admin/">
            ← Back to Dashboard
          </a>

          <p class="eyebrow">SESSION MANAGEMENT</p>
          <h1>Packages</h1>
          <p class="subtitle">
            Manage student session credits, renewal alerts, expiry dates, and payment status.
          </p>
        </div>

        <button id="showFormButton" class="add-button" type="button">
          <span class="plus">+</span>
          Add Package
        </button>

      </header>

      <section class="stats-grid">

        <article class="stat-card">
          <div class="stat-icon total-icon">🎟</div>
          <div>
            <span class="stat-label">Active Packages</span>
            <strong id="activePackages">—</strong>
            <span class="stat-note">Currently usable</span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon credit-icon">◉</div>
          <div>
            <span class="stat-label">Remaining Sessions</span>
            <strong id="remainingSessions">—</strong>
            <span class="stat-note">Across active packages</span>
          </div>
        </article>

        <article class="stat-card warning-stat">
          <div class="stat-icon warning-icon">!</div>
          <div>
            <span class="stat-label">Renewal Needed</span>
            <strong id="renewalNeeded">—</strong>
            <span class="stat-note">1 session or less</span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon payment-icon">💳</div>
          <div>
            <span class="stat-label">Payment Pending</span>
            <strong id="paymentPending">—</strong>
            <span class="stat-note">Unpaid or partial</span>
          </div>
        </article>

      </section>

      <section class="package-panel">

        <div class="panel-top">

          <div>
            <p class="section-label">STUDENT PACKAGES</p>
            <h2>All Packages</h2>
            <p class="panel-description">
              Packages with 1 session remaining are highlighted automatically.
            </p>
          </div>

          <div class="toolbar">

            <div class="search-box">
              <span class="search-icon">⌕</span>
              <input
                id="searchInput"
                type="search"
                placeholder="Search student or package..."
              />
            </div>

            <select id="statusFilter">
              <option value="all">All Status</option>
              <option value="active">Active</option>
              <option value="completed">Completed</option>
              <option value="expired">Expired</option>
              <option value="cancelled">Cancelled</option>
            </select>

            <select id="paymentFilter">
              <option value="all">All Payments</option>
              <option value="paid">Paid</option>
              <option value="partial">Partial</option>
              <option value="unpaid">Unpaid</option>
            </select>

            <select
              id="sortFilter"
              aria-label="Sort packages"
              title="Sort packages"
            >
              <option value="name-asc">
                Name A–Z
              </option>
              <option value="name-desc">
                Name Z–A
              </option>
              <option value="remaining-asc">
                Remaining: Low → High
              </option>
              <option value="remaining-desc">
                Remaining: High → Low
              </option>
              <option value="newest">
                Newest Package
              </option>
            </select>

          </div>

        </div>

        <div class="table-wrapper">
          <table>

            <thead>
              <tr>
                <th>Student</th>
                <th>Package</th>
                <th>Sessions</th>
                <th>Validity</th>
                <th>Payment</th>
                <th>Status</th>
                <th class="action-heading">Action</th>
              </tr>
            </thead>

            <tbody id="packageTableBody">
              <tr>
                <td colspan="7" class="empty-row">
                  Loading packages...
                </td>
              </tr>
            </tbody>

          </table>
        </div>

      </section>

    </main>

  </div>

  <div id="packageModal" class="modal-backdrop" hidden>

    <div
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <div class="modal-header">

        <div>
          <p id="modalEyebrow" class="section-label">NEW PACKAGE</p>
          <h2 id="modalTitle">Add Package</h2>
          <p id="modalDescription">
            Assign a session package to a student.
          </p>
        </div>

        <button
          id="closeFormButton"
          class="modal-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>

      </div>

      <form id="packageForm">

        <div class="form-grid">

          <label class="full-width">
            <span>Student *</span>
            <select id="studentId" required>
              <option value="">Select student</option>
            </select>
          </label>

          <label>
            <span>Package Code</span>
            <input
              id="packageCode"
              type="text"
              autocomplete="off"
              placeholder="e.g. PKG001"
            />
          </label>

          <label>
            <span>Package Name *</span>
            <input
              id="packageName"
              type="text"
              autocomplete="off"
              required
              placeholder="e.g. Mathematics 8 Sessions"
            />
          </label>

          <label>
            <span>Total Sessions *</span>
            <input
              id="totalSessions"
              type="number"
              min="1"
              step="1"
              required
              placeholder="8"
            />
          </label>

          <label>
            <span>Remaining Sessions *</span>
            <input
              id="remainingInput"
              type="number"
              min="0"
              step="1"
              required
              placeholder="8"
            />
          </label>

          <label>
            <span>Price (IDR)</span>
            <input
              id="price"
              type="number"
              min="0"
              step="1000"
              placeholder="0"
            />
          </label>

          <label>
            <span>Payment Status</span>
            <select id="paymentStatus">
              <option value="unpaid">Unpaid</option>
              <option value="partial">Partial</option>
              <option value="paid">Paid</option>
            </select>
          </label>

          <label>
            <span>Purchase Date</span>
            <input id="purchaseDate" type="date" />
          </label>

          <label>
            <span>Start Date</span>
            <input id="startDate" type="date" />
          </label>

          <label>
            <span>Expiry Date</span>
            <input id="expiryDate" type="date" />
          </label>

          <label>
            <span>Status</span>
            <select id="packageStatus">
              <option value="active">Active</option>
              <option value="completed">Completed</option>
              <option value="expired">Expired</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </label>

          <label class="full-width">
            <span>Notes</span>
            <textarea
              id="notes"
              rows="4"
              placeholder="Optional notes..."
            ></textarea>
          </label>

        </div>

        <div id="formMessage" class="form-message"></div>

        <div class="form-actions">

          <button
            id="cancelPackageButton"
            type="button"
            class="danger-button"
            hidden
          >
            Cancel Package
          </button>

          <div class="form-spacer"></div>

          <button id="cancelButton" type="button" class="cancel-button">
            Close
          </button>

          <button id="saveButton" type="submit" class="save-button">
            Add Package
          </button>

        </div>

      </form>

    </div>

  </div>

  <script>

    import { supabase }
      from '../../../../lib/supabase';


    type StudentStatus =
      'active' |
      'inactive';


    type PackageStatus =
      'active' |
      'completed' |
      'expired' |
      'cancelled';


    type PaymentStatus =
      'unpaid' |
      'partial' |
      'paid';


    type Student = {
      id: string;
      student_code: string | null;
      name: string;
      status: StudentStatus;
    };


    type StudentPackage = {
      id: string;
      package_code: string | null;
      student_id: string;
      package_name: string;
      total_sessions: number;
      remaining_sessions: number;
      price: number | null;
      payment_status: PaymentStatus;
      purchase_date: string | null;
      start_date: string | null;
      expiry_date: string | null;
      status: PackageStatus;
      notes: string | null;
      created_at: string;
      updated_at: string | null;
    };


    let students: Student[] = [];
    let packages: StudentPackage[] = [];
    let editingPackageId: string | null = null;


    function getEl<T extends Element>(
      selector: string
    ): T {

      const element =
        document.querySelector<T>(
          selector
        );


      if (!element) {

        throw new Error(
          `Element not found: ${selector}`
        );

      }


      return element;

    }


    const loadingScreen =
      getEl<HTMLDivElement>(
        '#loadingScreen'
      );


    const app =
      getEl<HTMLDivElement>(
        '#app'
      );


    const packageTableBody =
      getEl<HTMLTableSectionElement>(
        '#packageTableBody'
      );


    const searchInput =
      getEl<HTMLInputElement>(
        '#searchInput'
      );


    const statusFilter =
      getEl<HTMLSelectElement>(
        '#statusFilter'
      );


    const paymentFilter =
      getEl<HTMLSelectElement>(
        '#paymentFilter'
      );


    const sortFilter =
      getEl<HTMLSelectElement>(
        '#sortFilter'
      );


    const packageModal =
      getEl<HTMLDivElement>(
        '#packageModal'
      );


    const packageForm =
      getEl<HTMLFormElement>(
        '#packageForm'
      );


    const studentIdInput =
      getEl<HTMLSelectElement>(
        '#studentId'
      );


    const packageCodeInput =
      getEl<HTMLInputElement>(
        '#packageCode'
      );


    const packageNameInput =
      getEl<HTMLInputElement>(
        '#packageName'
      );


    const totalSessionsInput =
      getEl<HTMLInputElement>(
        '#totalSessions'
      );


    const remainingInput =
      getEl<HTMLInputElement>(
        '#remainingInput'
      );


    const priceInput =
      getEl<HTMLInputElement>(
        '#price'
      );


    const paymentStatusInput =
      getEl<HTMLSelectElement>(
        '#paymentStatus'
      );


    const purchaseDateInput =
      getEl<HTMLInputElement>(
        '#purchaseDate'
      );


    const startDateInput =
      getEl<HTMLInputElement>(
        '#startDate'
      );


    const expiryDateInput =
      getEl<HTMLInputElement>(
        '#expiryDate'
      );


    const packageStatusInput =
      getEl<HTMLSelectElement>(
        '#packageStatus'
      );


    const notesInput =
      getEl<HTMLTextAreaElement>(
        '#notes'
      );


    const formMessage =
      getEl<HTMLDivElement>(
        '#formMessage'
      );


    const saveButton =
      getEl<HTMLButtonElement>(
        '#saveButton'
      );


    const cancelPackageButton =
      getEl<HTMLButtonElement>(
        '#cancelPackageButton'
      );


    async function initPage() {

      const {
        data: { user }
      } =
        await supabase.auth.getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        return;

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select('role, active')
          .eq('id', user.id)
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {

        await supabase.auth.signOut();

        window.location.href =
          '/portal/';

        return;

      }


      loadingScreen.style.display =
        'none';


      app.hidden =
        false;


      await loadAllData();

    }


    async function loadAllData() {

      const [
        studentsResult,
        packagesResult
      ] =
        await Promise.all([

          supabase
            .from('students')
            .select(`
              id,
              student_code,
              name,
              status
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('student_packages')
            .select(`
              id,
              package_code,
              student_id,
              package_name,
              total_sessions,
              remaining_sessions,
              price,
              payment_status,
              purchase_date,
              start_date,
              expiry_date,
              status,
              notes,
              created_at,
              updated_at
            `)
            .order(
              'created_at',
              {
                ascending: false
              }
            )

        ]);


      if (
        studentsResult.error
      ) {

        throw new Error(
          studentsResult.error.message
        );

      }


      if (
        packagesResult.error
      ) {

        throw new Error(
          packagesResult.error.message
        );

      }


      students =
        (studentsResult.data || []) as Student[];


      packages =
        (packagesResult.data || []) as StudentPackage[];


      populateStudentDropdown();

      applyFilters();

      updateStats();

    }


    function populateStudentDropdown() {

      const currentValue =
        studentIdInput.value;


      const options =
        students
          .filter(
            student =>
              student.status ===
                'active' ||
              student.id ===
                currentValue
          )
          .map(
            student => `
              <option value="${escapeHtml(student.id)}">
                ${escapeHtml(student.name)}
                ${
                  student.student_code
                    ? `(${escapeHtml(student.student_code)})`
                    : ''
                }
              </option>
            `
          )
          .join('');


      studentIdInput.innerHTML = `
        <option value="">Select student</option>
        ${options}
      `;


      studentIdInput.value =
        currentValue;

    }


    function getEffectiveStatus(
      item: StudentPackage
    ): PackageStatus {

      if (
        item.status ===
        'cancelled'
      ) {

        return 'cancelled';

      }


      if (
        item.remaining_sessions <=
        0
      ) {

        return 'completed';

      }


      const today =
        getLocalDateString(
          new Date()
        );


      if (
        item.expiry_date &&
        item.expiry_date < today
      ) {

        return 'expired';

      }


      return item.status;

    }


    function applyFilters() {

      const search =
        searchInput.value
          .toLowerCase()
          .trim();


      const status =
        statusFilter.value;


      const payment =
        paymentFilter.value;


      const filtered =
        packages.filter(
          item => {

            const student =
              getStudent(
                item.student_id
              );


            const effectiveStatus =
              getEffectiveStatus(
                item
              );


            const combined = `
              ${student?.name || ''}
              ${student?.student_code || ''}
              ${item.package_code || ''}
              ${item.package_name || ''}
              ${item.notes || ''}
            `
              .toLowerCase();


            const matchesSearch =
              combined.includes(
                search
              );


            const matchesStatus =
              status === 'all' ||
              effectiveStatus ===
                status;


            const matchesPayment =
              payment === 'all' ||
              item.payment_status ===
                payment;


            return (
              matchesSearch &&
              matchesStatus &&
              matchesPayment
            );

          }
        );


      const sorted =
        [...filtered]
          .sort(
            (
              a: StudentPackage,
              b: StudentPackage
            ) => {

              const sort =
                sortFilter.value;


              const studentA =
                getStudent(
                  a.student_id
                );


              const studentB =
                getStudent(
                  b.student_id
                );


              const nameA =
                (
                  studentA?.name ||
                  ''
                )
                  .toLocaleLowerCase();


              const nameB =
                (
                  studentB?.name ||
                  ''
                )
                  .toLocaleLowerCase();


              if (
                sort ===
                'name-desc'
              ) {

                return (
                  nameB.localeCompare(
                    nameA
                  )
                );

              }


              if (
                sort ===
                'remaining-asc'
              ) {

                const remainingDifference =
                  a.remaining_sessions -
                  b.remaining_sessions;


                if (
                  remainingDifference !==
                  0
                ) {

                  return (
                    remainingDifference
                  );

                }


                return (
                  nameA.localeCompare(
                    nameB
                  )
                );

              }


              if (
                sort ===
                'remaining-desc'
              ) {

                const remainingDifference =
                  b.remaining_sessions -
                  a.remaining_sessions;


                if (
                  remainingDifference !==
                  0
                ) {

                  return (
                    remainingDifference
                  );

                }


                return (
                  nameA.localeCompare(
                    nameB
                  )
                );

              }


              if (
                sort ===
                'newest'
              ) {

                return (
                  new Date(
                    b.created_at
                  ).getTime() -
                  new Date(
                    a.created_at
                  ).getTime()
                );

              }


              return (
                nameA.localeCompare(
                  nameB
                )
              );

            }
          );


      renderPackages(
        sorted
      );

    }


    function renderPackages(
      list: StudentPackage[]
    ) {

      if (
        list.length === 0
      ) {

        packageTableBody.innerHTML = `
          <tr>
            <td colspan="7" class="empty-row">

              <div class="empty-state">
                <div class="empty-icon">🎟</div>

                <strong>
                  No packages found
                </strong>

                <p>
                  Add a package or change your filters.
                </p>
              </div>

            </td>
          </tr>
        `;

        return;

      }


      packageTableBody.innerHTML =
        list
          .map(
            item =>
              renderPackageRow(
                item
              )
          )
          .join('');

    }


    function renderPackageRow(
      item: StudentPackage
    ): string {

      const student =
        getStudent(
          item.student_id
        );


      const effectiveStatus =
        getEffectiveStatus(
          item
        );


      const lowCredit =
        effectiveStatus ===
          'active' &&
        item.remaining_sessions <=
          1;


      const percent =
        item.total_sessions > 0
          ? Math.max(
              0,
              Math.min(
                100,
                Math.round(
                  (
                    item.remaining_sessions /
                    item.total_sessions
                  ) *
                  100
                )
              )
            )
          : 0;


      return `
        <tr class="${lowCredit ? 'low-credit-row' : ''}">

          <td>
            <div class="student-cell">

              <div class="avatar">
                ${escapeHtml(
                  getInitials(
                    student?.name ||
                    '?'
                  )
                )}
              </div>

              <div>
                <div class="student-name">
                  ${escapeHtml(
                    student?.name ||
                    'Unknown student'
                  )}
                </div>

                <div class="student-code">
                  ${escapeHtml(
                    student?.student_code ||
                    'No student code'
                  )}
                </div>
              </div>

            </div>
          </td>

          <td>
            <div class="package-name">
              ${escapeHtml(item.package_name)}
            </div>

            <div class="package-code">
              ${escapeHtml(
                item.package_code ||
                'No package code'
              )}
            </div>
          </td>

          <td>
            <div class="credit-line">

              <strong class="${lowCredit ? 'credit-warning' : ''}">
                ${item.remaining_sessions}
              </strong>

              <span>
                / ${item.total_sessions}
              </span>

              ${
                lowCredit
                  ? `
                    <span class="renewal-badge">
                      RENEW SOON
                    </span>
                  `
                  : ''
              }

            </div>

            <div class="progress-track">
              <div
                class="progress-fill ${lowCredit ? 'warning' : ''}"
                style="width:${percent}%"
              ></div>
            </div>
          </td>

          <td>
            <div class="period-text">

              <span>
                Start:
                ${
                  item.start_date
                    ? escapeHtml(
                        formatDate(
                          item.start_date
                        )
                      )
                    : '—'
                }
              </span>

              <span>
                Exp:
                ${
                  item.expiry_date
                    ? escapeHtml(
                        formatDate(
                          item.expiry_date
                        )
                      )
                    : '—'
                }
              </span>

            </div>
          </td>

          <td>
            <div class="payment-cell">

              <span
                class="
                  payment-badge
                  ${item.payment_status}
                "
              >
                ${capitalize(item.payment_status)}
              </span>

              ${
                item.price !== null
                  ? `
                    <small>
                      ${escapeHtml(
                        formatCurrency(
                          item.price
                        )
                      )}
                    </small>
                  `
                  : ''
              }

            </div>
          </td>

          <td>
            <span
              class="
                status-badge
                ${effectiveStatus}
              "
            >
              <span class="status-dot"></span>
              ${capitalize(effectiveStatus)}
            </span>
          </td>

          <td class="action-cell">
            <button
              class="edit-button edit-package-button"
              data-id="${escapeHtml(item.id)}"
              type="button"
            >
              Edit
            </button>
          </td>

        </tr>
      `;

    }


    function updateStats() {

      const active =
        packages.filter(
          item =>
            getEffectiveStatus(item) ===
            'active'
        );


      const remaining =
        active.reduce(
          (
            total,
            item
          ) =>
            total +
            item.remaining_sessions,
          0
        );


      const renewal =
        active.filter(
          item =>
            item.remaining_sessions <=
            1
        ).length;


      const pending =
        packages.filter(
          item =>
            item.payment_status ===
              'unpaid' ||
            item.payment_status ===
              'partial'
        ).length;


      setText(
        '#activePackages',
        active.length
      );


      setText(
        '#remainingSessions',
        remaining
      );


      setText(
        '#renewalNeeded',
        renewal
      );


      setText(
        '#paymentPending',
        pending
      );

    }


    function showModal() {

      editingPackageId =
        null;


      packageForm.reset();


      clearFormMessage();


      populateStudentDropdown();


      const today =
        getLocalDateString(
          new Date()
        );


      purchaseDateInput.value =
        today;


      startDateInput.value =
        today;


      paymentStatusInput.value =
        'unpaid';


      packageStatusInput.value =
        'active';


      setText(
        '#modalEyebrow',
        'NEW PACKAGE'
      );


      setText(
        '#modalTitle',
        'Add Package'
      );


      setText(
        '#modalDescription',
        'Assign a session package to a student.'
      );


      saveButton.textContent =
        'Add Package';


      cancelPackageButton.hidden =
        true;


      packageModal.hidden =
        false;


      document.body.classList.add(
        'modal-open'
      );


      setTimeout(
        () =>
          studentIdInput.focus(),
        0
      );

    }


    function openEditModal(
      packageId: string
    ) {

      const item =
        packages.find(
          record =>
            record.id ===
            packageId
        );


      if (!item) return;


      editingPackageId =
        item.id;


      clearFormMessage();


      studentIdInput.value =
        item.student_id;


      populateStudentDropdown();


      studentIdInput.value =
        item.student_id;


      packageCodeInput.value =
        item.package_code || '';


      packageNameInput.value =
        item.package_name;


      totalSessionsInput.value =
        String(
          item.total_sessions
        );


      remainingInput.value =
        String(
          item.remaining_sessions
        );


      priceInput.value =
        item.price !== null
          ? String(item.price)
          : '';


      paymentStatusInput.value =
        item.payment_status;


      purchaseDateInput.value =
        item.purchase_date || '';


      startDateInput.value =
        item.start_date || '';


      expiryDateInput.value =
        item.expiry_date || '';


      packageStatusInput.value =
        getEffectiveStatus(
          item
        );


      notesInput.value =
        item.notes || '';


      setText(
        '#modalEyebrow',
        'PACKAGE DETAILS'
      );


      setText(
        '#modalTitle',
        'Edit Package'
      );


      setText(
        '#modalDescription',
        'Update this package and remaining session balance.'
      );


      saveButton.textContent =
        'Save Changes';


      cancelPackageButton.hidden =
        item.status ===
        'cancelled';


      packageModal.hidden =
        false;


      document.body.classList.add(
        'modal-open'
      );

    }


    function hideModal() {

      packageModal.hidden =
        true;


      document.body.classList.remove(
        'modal-open'
      );


      clearFormMessage();

    }


    function clearFormMessage() {

      formMessage.textContent =
        '';


      formMessage.className =
        'form-message';

    }


    function showFormError(
      message: string
    ) {

      formMessage.textContent =
        message;


      formMessage.className =
        'form-message error';

    }


    packageForm
      .addEventListener(
        'submit',
        async event => {

          event.preventDefault();


          const studentId =
            studentIdInput.value;


          const packageName =
            packageNameInput.value
              .trim();


          const totalSessions =
            Number(
              totalSessionsInput.value
            );


          const remainingSessions =
            Number(
              remainingInput.value
            );


          const paymentStatus =
            paymentStatusInput.value as PaymentStatus;


          let packageStatus =
            packageStatusInput.value as PackageStatus;


          if (
            !studentId ||
            !packageName
          ) {

            showFormError(
              'Student and package name are required.'
            );

            return;

          }


          if (
            !Number.isInteger(
              totalSessions
            ) ||
            totalSessions < 1
          ) {

            showFormError(
              'Total sessions must be at least 1.'
            );

            return;

          }


          if (
            !Number.isInteger(
              remainingSessions
            ) ||
            remainingSessions < 0 ||
            remainingSessions >
              totalSessions
          ) {

            showFormError(
              'Remaining sessions must be between 0 and total sessions.'
            );

            return;

          }


          if (
            remainingSessions === 0 &&
            packageStatus ===
              'active'
          ) {

            packageStatus =
              'completed';

          }


          if (
            expiryDateInput.value &&
            startDateInput.value &&
            expiryDateInput.value <
              startDateInput.value
          ) {

            showFormError(
              'Expiry date cannot be earlier than start date.'
            );

            return;

          }


          const rawPrice =
            priceInput.value
              .trim();


          const price =
            rawPrice
              ? Number(rawPrice)
              : null;


          if (
            price !== null &&
            (
              !Number.isFinite(price) ||
              price < 0
            )
          ) {

            showFormError(
              'Price must be zero or greater.'
            );

            return;

          }


          const packageData = {

            student_id:
              studentId,

            package_code:
              packageCodeInput.value
                .trim() ||
              null,

            package_name:
              packageName,

            total_sessions:
              totalSessions,

            remaining_sessions:
              remainingSessions,

            price,

            payment_status:
              paymentStatus,

            purchase_date:
              purchaseDateInput.value ||
              null,

            start_date:
              startDateInput.value ||
              null,

            expiry_date:
              expiryDateInput.value ||
              null,

            status:
              packageStatus,

            notes:
              notesInput.value
                .trim() ||
              null,

            updated_at:
              new Date()
                .toISOString()

          };


          saveButton.disabled =
            true;


          saveButton.textContent =
            editingPackageId
              ? 'Saving Changes...'
              : 'Saving...';


          let errorMessage:
            string | null = null;


          if (
            editingPackageId
          ) {

            const {
              error
            } =
              await supabase
                .from(
                  'student_packages'
                )
                .update(
                  packageData
                )
                .eq(
                  'id',
                  editingPackageId
                );


            errorMessage =
              error?.message ||
              null;

          } else {

            const {
              error
            } =
              await supabase
                .from(
                  'student_packages'
                )
                .insert(
                  packageData
                );


            errorMessage =
              error?.message ||
              null;

          }


          if (
            errorMessage
          ) {

            console.error(
              'Save package error:',
              errorMessage
            );


            showFormError(
              errorMessage
            );


            saveButton.disabled =
              false;


            saveButton.textContent =
              editingPackageId
                ? 'Save Changes'
                : 'Add Package';


            return;

          }


          await loadAllData();


          hideModal();


          saveButton.disabled =
            false;


          saveButton.textContent =
            'Add Package';


          editingPackageId =
            null;

        }
      );


    cancelPackageButton
      .addEventListener(
        'click',
        async () => {

          if (
            !editingPackageId
          ) {

            return;

          }


          const item =
            packages.find(
              record =>
                record.id ===
                editingPackageId
            );


          if (!item) return;


          const confirmed =
            window.confirm(
              `Cancel package "${item.package_name}"?`
            );


          if (!confirmed) return;


          cancelPackageButton.disabled =
            true;


          cancelPackageButton.textContent =
            'Cancelling...';


          const {
            error
          } =
            await supabase
              .from(
                'student_packages'
              )
              .update({

                status:
                  'cancelled',

                updated_at:
                  new Date()
                    .toISOString()

              })
              .eq(
                'id',
                editingPackageId
              );


          if (error) {

            window.alert(
              error.message
            );


            cancelPackageButton.disabled =
              false;


            cancelPackageButton.textContent =
              'Cancel Package';


            return;

          }


          await loadAllData();


          cancelPackageButton.disabled =
            false;


          cancelPackageButton.textContent =
            'Cancel Package';


          hideModal();


          editingPackageId =
            null;

        }
      );


    totalSessionsInput
      .addEventListener(
        'input',
        () => {

          if (
            editingPackageId
          ) {

            return;

          }


          remainingInput.value =
            totalSessionsInput.value;

        }
      );


    searchInput
      .addEventListener(
        'input',
        applyFilters
      );


    statusFilter
      .addEventListener(
        'change',
        applyFilters
      );


    paymentFilter
      .addEventListener(
        'change',
        applyFilters
      );


    sortFilter
      .addEventListener(
        'change',
        applyFilters
      );


    getEl<HTMLButtonElement>(
      '#showFormButton'
    )
      .addEventListener(
        'click',
        showModal
      );


    getEl<HTMLButtonElement>(
      '#closeFormButton'
    )
      .addEventListener(
        'click',
        hideModal
      );


    getEl<HTMLButtonElement>(
      '#cancelButton'
    )
      .addEventListener(
        'click',
        hideModal
      );


    packageTableBody
      .addEventListener(
        'click',
        event => {

          const target =
            event.target;


          if (
            !(target instanceof Element)
          ) {

            return;

          }


          const button =
            target.closest<HTMLButtonElement>(
              '.edit-package-button'
            );


          if (!button) return;


          const packageId =
            button.dataset.id;


          if (packageId) {

            openEditModal(
              packageId
            );

          }

        }
      );


    packageModal
      .addEventListener(
        'click',
        event => {

          if (
            event.target ===
            packageModal
          ) {

            hideModal();

          }

        }
      );


    document
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key ===
              'Escape' &&
            !packageModal.hidden
          ) {

            hideModal();

          }

        }
      );


    getEl<HTMLButtonElement>(
      '#logoutButton'
    )
      .addEventListener(
        'click',
        async () => {

          await supabase.auth
            .signOut();


          window.location.href =
            '/portal/';

        }
      );


    function getStudent(
      studentId: string
    ): Student | undefined {

      return students.find(
        student =>
          student.id ===
          studentId
      );

    }


    function setText(
      selector: string,
      value: string | number
    ) {

      getEl<HTMLElement>(
        selector
      ).textContent =
        String(value);

    }


    function getInitials(
      name: string
    ): string {

      return (
        name || '?'
      )
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(
          part =>
            part
              .charAt(0)
              .toUpperCase()
        )
        .join('');

    }


    function capitalize(
      value: string
    ): string {

      if (!value) return '';


      return (
        value.charAt(0)
          .toUpperCase() +
        value.slice(1)
      );

    }


    function formatCurrency(
      value: number
    ): string {

      return new Intl
        .NumberFormat(
          'id-ID',
          {
            style:
              'currency',
            currency:
              'IDR',
            maximumFractionDigits:
              0
          }
        )
        .format(value);

    }


    function formatDate(
      value: string
    ): string {

      const [
        year,
        month,
        day
      ] =
        value
          .split('-')
          .map(Number);


      const date =
        new Date(
          year,
          month - 1,
          day
        );


      return new Intl
        .DateTimeFormat(
          'en-GB',
          {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
          }
        )
        .format(date);

    }


    function getLocalDateString(
      date: Date
    ): string {

      const year =
        date.getFullYear();


      const month =
        String(
          date.getMonth() + 1
        )
          .padStart(
            2,
            '0'
          );


      const day =
        String(
          date.getDate()
        )
          .padStart(
            2,
            '0'
          );


      return `${year}-${month}-${day}`;

    }


    function escapeHtml(
      value: string
    ): string {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value ?? '';


      return div.innerHTML;

    }


    initPage()
      .catch(
        error => {

          console.error(
            'Packages page error:',
            error
          );


          loadingScreen.innerHTML = `
            <p class="error-text">
              Unable to load Packages.
            </p>
          `;

        }
      );

