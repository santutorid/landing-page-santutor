---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />

  <title>Students | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>


  <div id="app" class="app" hidden>

    <!-- ============================= -->
    <!-- SIDEBAR -->
    <!-- ============================= -->

    <aside class="sidebar">

      <div class="brand">

        <a href="/portal/admin/">
          <div class="logo-box">
            <img
              src={logoSrc.src}
              alt="Santutor Learning Studio"
            />
          </div>
        </a>

        <span class="portal-label">
          ADMIN PORTAL
        </span>

      </div>


      <nav>

        <a
          class="nav-item"
          href="/portal/admin/"
        >
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>


        <a
          class="nav-item active"
          href="/portal/admin/students/"
        >
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>


        <a class="nav-item" href="/portal/admin/schedule/">
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>


        <a class="nav-item" href="/portal/admin/attendance/">
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>


        <a class="nav-item" href="/portal/admin/reports/">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>


        <a class="nav-item" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>


        <a class="nav-item" href="/portal/admin/payments/">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>


        <a class="nav-item" href="/portal/admin/parents/">
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>


        <a class="nav-item" href="/portal/admin/tutors/">
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>

      </nav>


      <div class="sidebar-bottom">

        <button
          id="logoutButton"
          class="logout-button"
        >
          ↪
          <span>Sign Out</span>
        </button>

      </div>

    </aside>



    <!-- ============================= -->
    <!-- MAIN CONTENT -->
    <!-- ============================= -->

    <main class="main">

      <!-- HEADER -->

      <header class="page-header">

        <div>

          <a
            class="back-link"
            href="/portal/admin/"
          >
            ← Back to Dashboard
          </a>

          <div class="title-row">

            <div>

              <p class="eyebrow">
                STUDENT MANAGEMENT
              </p>

              <h1>Students</h1>

              <p class="subtitle">
                Manage student information and enrolment.
              </p>

            </div>

          </div>

        </div>


        <button
          id="showFormButton"
          class="add-button"
        >
          <span class="plus">
            +
          </span>

          Add Student
        </button>

      </header>



      <!-- STATS -->

      <section class="stats-grid">

        <article class="stat-card">

          <div class="stat-icon total-icon">
            👨‍🎓
          </div>

          <div>

            <span class="stat-label">
              Total Students
            </span>

            <strong id="totalStudents">
              —
            </strong>

            <span class="stat-note">
              Registered students
            </span>

          </div>

        </article>


        <article class="stat-card">

          <div class="stat-icon active-icon">
            ✓
          </div>

          <div>

            <span class="stat-label">
              Active Students
            </span>

            <strong id="activeStudents">
              —
            </strong>

            <span class="stat-note">
              Currently learning
            </span>

          </div>

        </article>


        <article class="stat-card">

          <div class="stat-icon inactive-icon">
            ⏸
          </div>

          <div>

            <span class="stat-label">
              Inactive
            </span>

            <strong id="inactiveStudents">
              —
            </strong>

            <span class="stat-note">
              Not currently active
            </span>

          </div>

        </article>

      </section>



      <!-- STUDENT LIST -->

      <section class="student-panel">


        <div class="panel-top">

          <div>

            <p class="section-label">
              STUDENT DATABASE
            </p>

            <h2>All Students</h2>

            <p class="panel-description">
              Student profiles registered in Santutor.
            </p>

          </div>


          <div class="toolbar">

            <div class="search-box">

              <span>
                ⌕
              </span>

              <input
                id="searchInput"
                type="search"
                placeholder="Search students..."
              />

            </div>


            <select id="statusFilter">

              <option value="all">
                All Status
              </option>

              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>

            </select>

          </div>

        </div>



        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>
                  Student
                </th>

                <th>
                  School
                </th>

                <th>
                  Grade
                </th>

                <th>
                  Curriculum
                </th>

                <th>
                  Status
                </th>

                <th></th>

              </tr>

            </thead>


            <tbody id="studentTableBody">

              <tr>

                <td
                  colspan="6"
                  class="empty-row"
                >
                  Loading students...
                </td>

              </tr>

            </tbody>

          </table>

        </div>

      </section>

    </main>

  </div>



  <!-- ============================= -->
  <!-- ADD STUDENT MODAL -->
  <!-- ============================= -->

  <div
    id="studentModal"
    class="modal-backdrop"
    hidden
  >

    <div class="modal">

      <div class="modal-header">

        <div>

          <p class="section-label">
            NEW STUDENT
          </p>

          <h2 id="modalTitle">
            Add Student
            </h2>

            <p id="modalDescription">
            Add a new student to Santutor.
            </p>

        </div>


        <button
          id="closeFormButton"
          class="modal-close"
          type="button"
        >
          ×
        </button>

      </div>



      <form id="studentForm">

        <div class="form-grid">


          <label class="full-width">

            <span>
              Student Name *
            </span>

            <input
              id="name"
              type="text"
              required
              placeholder="Full student name"
            />

          </label>



          <label>

            <span>
              Nickname
            </span>

            <input
              id="nickname"
              type="text"
              placeholder="Preferred name"
            />

          </label>



          <label>

            <span>
              Student Code
            </span>

            <input
              id="studentCode"
              type="text"
              placeholder="e.g. ST002"
            />

          </label>



          <label class="full-width">

            <span>
              School
            </span>

            <input
              id="school"
              type="text"
              placeholder="Student's school"
            />

          </label>



          <label>

            <span>
              Grade / Level
            </span>

            <input
              id="grade"
              type="text"
              placeholder="e.g. Grade 5"
            />

          </label>



          <label>

            <span>
              Curriculum
            </span>

            <select id="curriculum">

              <option value="">
                Select curriculum
              </option>

              <option value="Cambridge">
                Cambridge
              </option>

              <option value="IB">
                IB
              </option>

              <option value="National">
                National
              </option>

              <option value="International">
                International
              </option>

              <option value="Other">
                Other
              </option>

            </select>

          </label>



          <label>

            <span>
              Start Date
            </span>

            <input
              id="startDate"
              type="date"
            />

          </label>



          <label>

            <span>
              Status
            </span>

            <select id="status">

              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>

            </select>

          </label>

        </div>



        <div
          id="formMessage"
          class="form-message"
        >
        </div>



        <div class="form-actions">

            <button
                id="deactivateButton"
                type="button"
                class="danger-button"
                hidden
            >
                Deactivate
            </button>

            <div class="form-spacer"></div>

            <button
                id="cancelButton"
                type="button"
                class="cancel-button"
            >
                Cancel
            </button>

            <button
                id="saveButton"
                type="submit"
                class="save-button"
            >
                Add Student
            </button>

        </div>

      </form>

    </div>

  </div>



  <script>

    import { supabase }
      from '../../../../lib/supabase';


    type Student = {
      id: string;
      student_code: string | null;
      name: string;
      nickname: string | null;
      school: string | null;
      grade: string | null;
      curriculum: string | null;
      start_date: string | null;
      status: 'active' | 'inactive';
      created_at: string;
      updated_at?: string | null;
    };


    let students: Student[] = [];

    let editingStudentId: string | null = null;


    // ==============================
    // AUTH
    // ==============================

    async function initPage() {

      const {
        data: { user }
      } =
        await supabase.auth.getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        return;

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select(
            'role, active'
          )
          .eq(
            'id',
            user.id
          )
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {

        await supabase.auth.signOut();

        window.location.href =
          '/portal/';

        return;

      }


      document
        .querySelector(
          '#loadingScreen'
        )
        ?.setAttribute(
          'style',
          'display:none'
        );


      document
        .querySelector('#app')
        ?.removeAttribute('hidden');


      await loadStudents();

    }



    // ==============================
    // LOAD STUDENTS
    // ==============================

    async function loadStudents() {

      const {
        data,
        error
      } =
        await supabase
          .from('students')
          .select(`
            id,
            student_code,
            name,
            nickname,
            school,
            grade,
            curriculum,
            start_date,
            status,
            created_at
          `)
          .order(
            'name',
            {
              ascending: true
            }
          );


      if (error) {

        console.error(
          'Load students error:',
          error
        );

        return;

      }


      students =
        (data || []) as Student[];


      applyFilters();

      updateStats();

    }



    // ==============================
    // TABLE
    // ==============================

    function renderStudents(
      list: Student[]
    ) {

      const tbody =
        document.querySelector(
          '#studentTableBody'
        );


      if (!tbody) return;


      if (
        list.length === 0
      ) {

        tbody.innerHTML = `

          <tr>

            <td
              colspan="6"
              class="empty-row"
            >

              <div class="empty-state">

                <div class="empty-icon">
                  👨‍🎓
                </div>

                <strong>
                  No students found
                </strong>

                <p>
                  Add your first student or
                  change your search filters.
                </p>

              </div>

            </td>

          </tr>

        `;

        return;

      }


      tbody.innerHTML =
        list
          .map(student => {

            const initials =
              getInitials(
                student.name
              );


            return `

              <tr>

                <td>

                  <div class="student-cell">

                    <div class="avatar">

                      ${escapeHtml(
                        initials
                      )}

                    </div>


                    <div>

                      <div class="student-name">

                        ${escapeHtml(
                          student.name
                        )}

                      </div>


                      <div class="student-code">

                        ${
                          escapeHtml(
                            student.student_code ||
                            student.nickname ||
                            'No student code'
                          )
                        }

                      </div>

                    </div>

                  </div>

                </td>


                <td>

                  ${
                    escapeHtml(
                      student.school ||
                      '—'
                    )
                  }

                </td>


                <td>

                  ${
                    escapeHtml(
                      student.grade ||
                      '—'
                    )
                  }

                </td>


                <td>

                  ${
                    escapeHtml(
                      student.curriculum ||
                      '—'
                    )
                  }

                </td>


                <td>

                  <span
                    class="
                      status-badge
                      ${
                        student.status
                        === 'active'
                          ? 'active'
                          : 'inactive'
                      }
                    "
                  >

                    <span
                      class="status-dot"
                    ></span>

                    ${
                      student.status
                      === 'active'
                        ? 'Active'
                        : 'Inactive'
                    }

                  </span>

                </td>


                <td>

                  <button
                    class="more-button edit-student-button"
                    data-id="${student.id}"
                    title="Edit student"
                    >
                    •••
                    </button>

                </td>

              </tr>

            `;

          })
          .join('');

    }



    // ==============================
    // STATS
    // ==============================

    function updateStats() {

      const active =
        students.filter(
          student =>
            student.status ===
            'active'
        ).length;


      const inactive =
        students.filter(
          student =>
            student.status ===
            'inactive'
        ).length;


      setText(
        '#totalStudents',
        students.length
      );


      setText(
        '#activeStudents',
        active
      );


      setText(
        '#inactiveStudents',
        inactive
      );

    }



    function setText(
      selector: string,
      value: string | number
    ) {

      const element =
        document.querySelector(
          selector
        );


      if (element) {

        element.textContent =
          String(value);

      }

    }



    // ==============================
    // FILTERS
    // ==============================

    function applyFilters() {

      const search =
        (
          document.querySelector(
            '#searchInput'
          ) as HTMLInputElement
        )?.value
          .toLowerCase()
          .trim() || '';


      const status =
        (
          document.querySelector(
            '#statusFilter'
          ) as HTMLSelectElement
        )?.value || 'all';


      const filtered =
        students.filter(
          student => {

            const combined = `
              ${student.name || ''}
              ${student.nickname || ''}
              ${student.student_code || ''}
              ${student.school || ''}
              ${student.grade || ''}
              ${student.curriculum || ''}
            `
              .toLowerCase();


            const matchesSearch =
              combined.includes(
                search
              );


            const matchesStatus =
              status === 'all' ||
              student.status === status;


            return (
              matchesSearch &&
              matchesStatus
            );

          }
        );


      renderStudents(
        filtered
      );

    }



    document
      .querySelector(
        '#searchInput'
      )
      ?.addEventListener(
        'input',
        applyFilters
      );


    document
      .querySelector(
        '#statusFilter'
      )
      ?.addEventListener(
        'change',
        applyFilters
      );



    // ==============================
    // ADD / EDIT STUDENT
    // ==============================

    document
      .querySelector(
        '#studentForm'
      )
      ?.addEventListener(
        'submit',
        async event => {

          event.preventDefault();


          const nameInput =
            document.querySelector(
              '#name'
            ) as HTMLInputElement;


          const nicknameInput =
            document.querySelector(
              '#nickname'
            ) as HTMLInputElement;


          const codeInput =
            document.querySelector(
              '#studentCode'
            ) as HTMLInputElement;


          const schoolInput =
            document.querySelector(
              '#school'
            ) as HTMLInputElement;


          const gradeInput =
            document.querySelector(
              '#grade'
            ) as HTMLInputElement;


          const curriculumInput =
            document.querySelector(
              '#curriculum'
            ) as HTMLSelectElement;


          const dateInput =
            document.querySelector(
              '#startDate'
            ) as HTMLInputElement;


          const statusInput =
            document.querySelector(
              '#status'
            ) as HTMLSelectElement;


          const saveButton =
            document.querySelector(
              '#saveButton'
            ) as HTMLButtonElement;


          const message =
            document.querySelector(
              '#formMessage'
            );


          const studentName =
            nameInput.value.trim();


          if (!studentName) {

            if (message) {

              message.textContent =
                'Student name is required.';

              message.className =
                'form-message error';

            }

            return;

          }


          saveButton.disabled =
            true;


          saveButton.textContent =
            editingStudentId
              ? 'Saving Changes...'
              : 'Saving...';


          if (message) {

            message.textContent =
              '';

            message.className =
              'form-message';

          }


          const studentData = {

            name:
              studentName,

            nickname:
              nicknameInput.value
                .trim() ||
              null,

            student_code:
              codeInput.value
                .trim() ||
              null,

            school:
              schoolInput.value
                .trim() ||
              null,

            grade:
              gradeInput.value
                .trim() ||
              null,

            curriculum:
              curriculumInput.value ||
              null,

            start_date:
              dateInput.value ||
              null,

            status:
              statusInput.value,

            updated_at:
              new Date()
                .toISOString()

          };


          let operationError = null;


          if (editingStudentId) {

            const {
              error
            } =
              await supabase
                .from('students')
                .update(
                  studentData
                )
                .eq(
                  'id',
                  editingStudentId
                );


            operationError =
              error;

          } else {

            const {
              error
            } =
              await supabase
                .from('students')
                .insert(
                  studentData
                );


            operationError =
              error;

          }


          if (operationError) {

            console.error(
              'Save student error:',
              operationError
            );


            if (message) {

              message.textContent =
                operationError.message;

              message.className =
                'form-message error';

            }


            saveButton.disabled =
              false;


            saveButton.textContent =
              editingStudentId
                ? 'Save Changes'
                : 'Add Student';


            return;

          }


          (
            document.querySelector(
              '#studentForm'
            ) as HTMLFormElement
          ).reset();


          await loadStudents();


          hideModal();


          saveButton.disabled =
            false;


          saveButton.textContent =
            'Add Student';

        }
      );



    // ==============================
    // MODAL
    // ==============================

    function showModal() {

        editingStudentId = null;

        const form =
            document.querySelector(
            '#studentForm'
            ) as HTMLFormElement;

        form?.reset();


        setText(
            '#modalTitle',
            'Add Student'
        );

        setText(
            '#modalDescription',
            'Add a new student to Santutor.'
        );

        setText(
            '#saveButton',
            'Add Student'
        );


        const deactivateButton =
            document.querySelector(
            '#deactivateButton'
            ) as HTMLButtonElement;


        if (deactivateButton) {
            deactivateButton.hidden = true;
        }


        document
            .querySelector('#studentModal')
            ?.removeAttribute('hidden');


        document.body.classList.add(
            'modal-open'
        );

    }

    
    function openEditModal(
        studentId: string
        ) {

        const student =
            students.find(
            item =>
                item.id === studentId
            );


        if (!student) return;


        editingStudentId =
            student.id;


        (
            document.querySelector(
            '#name'
            ) as HTMLInputElement
        ).value =
            student.name || '';


        (
            document.querySelector(
            '#nickname'
            ) as HTMLInputElement
        ).value =
            student.nickname || '';


        (
            document.querySelector(
            '#studentCode'
            ) as HTMLInputElement
        ).value =
            student.student_code || '';


        (
            document.querySelector(
            '#school'
            ) as HTMLInputElement
        ).value =
            student.school || '';


        (
            document.querySelector(
            '#grade'
            ) as HTMLInputElement
        ).value =
            student.grade || '';


        (
            document.querySelector(
            '#curriculum'
            ) as HTMLSelectElement
        ).value =
            student.curriculum || '';


        (
            document.querySelector(
            '#startDate'
            ) as HTMLInputElement
        ).value =
            student.start_date || '';


        (
            document.querySelector(
            '#status'
            ) as HTMLSelectElement
        ).value =
            student.status;


        setText(
            '#modalTitle',
            'Edit Student'
        );


        setText(
            '#modalDescription',
            `Update ${student.name}'s student information.`
        );


        setText(
            '#saveButton',
            'Save Changes'
        );


        const deactivateButton =
            document.querySelector(
            '#deactivateButton'
            ) as HTMLButtonElement;


        if (deactivateButton) {

            deactivateButton.hidden =
            false;

            deactivateButton.textContent =
            student.status === 'active'
                ? 'Deactivate'
                : 'Reactivate';

        }


        document
            .querySelector(
            '#studentModal'
            )
            ?.removeAttribute(
            'hidden'
            );


        document.body.classList.add(
            'modal-open'
        );

        }

    function hideModal() {

      document
        .querySelector(
          '#studentModal'
        )
        ?.setAttribute(
          'hidden',
          ''
        );


      document.body
        .classList
        .remove(
          'modal-open'
        );


      editingStudentId =
        null;


      const message =
        document.querySelector(
          '#formMessage'
        );


      if (message) {

        message.textContent =
          '';

        message.className =
          'form-message';

      }

    }



    document
      .querySelector(
        '#showFormButton'
      )
      ?.addEventListener(
        'click',
        showModal
      );


    document
      .querySelector(
        '#closeFormButton'
      )
      ?.addEventListener(
        'click',
        hideModal
      );


    document
      .querySelector(
        '#cancelButton'
      )
      ?.addEventListener(
        'click',
        hideModal
      );



    document
      .querySelector(
        '#studentModal'
      )
      ?.addEventListener(
        'click',
        event => {

          if (
            event.target ===
            event.currentTarget
          ) {

            hideModal();

          }

        }
      );


    document
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key ===
            'Escape'
          ) {

            hideModal();

          }

        }
      );



    // ==============================
    // EDIT STUDENT BUTTON
    // ==============================

    document
      .querySelector(
        '#studentTableBody'
      )
      ?.addEventListener(
        'click',
        event => {

          const target =
            event.target as HTMLElement;


          const button =
            target.closest(
              '.edit-student-button'
            ) as HTMLButtonElement | null;


          if (!button) return;


          const studentId =
            button.dataset.id;


          if (studentId) {

            openEditModal(
              studentId
            );

          }

        }
      );



    // ==============================
    // DEACTIVATE / REACTIVATE
    // ==============================

    document
      .querySelector(
        '#deactivateButton'
      )
      ?.addEventListener(
        'click',
        async () => {

          if (!editingStudentId) {
            return;
          }


          const student =
            students.find(
              item =>
                item.id ===
                editingStudentId
            );


          if (!student) return;


          const newStatus =
            student.status === 'active'
              ? 'inactive'
              : 'active';


          const actionText =
            newStatus === 'inactive'
              ? 'deactivate'
              : 'reactivate';


          const confirmed =
            window.confirm(
              `Are you sure you want to ${actionText} ${student.name}?`
            );


          if (!confirmed) {
            return;
          }


          const button =
            document.querySelector(
              '#deactivateButton'
            ) as HTMLButtonElement;


          button.disabled =
            true;


          button.textContent =
            newStatus === 'inactive'
              ? 'Deactivating...'
              : 'Reactivating...';


          const {
            error
          } =
            await supabase
              .from('students')
              .update({

                status:
                  newStatus,

                updated_at:
                  new Date()
                    .toISOString()

              })
              .eq(
                'id',
                editingStudentId
              );


          if (error) {

            console.error(
              'Update status error:',
              error
            );


            window.alert(
              error.message
            );


            button.disabled =
              false;


            button.textContent =
              student.status === 'active'
                ? 'Deactivate'
                : 'Reactivate';


            return;

          }


          await loadStudents();


          button.disabled =
            false;


          hideModal();

        }
      );



    // ==============================
    // LOGOUT
    // ==============================

    document
      .querySelector(
        '#logoutButton'
      )
      ?.addEventListener(
        'click',
        async () => {

          await supabase.auth
            .signOut();


          window.location.href =
            '/portal/';

        }
      );



    // ==============================
    // HELPERS
    // ==============================

    function getInitials(
      name: string
    ) {

      return (
        name || '?'
      )
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(
          part =>
            part.charAt(0)
              .toUpperCase()
        )
        .join('');

    }



    function escapeHtml(
      value: string
    ) {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value ?? '';


      return div.innerHTML;

    }



    initPage();

  </script>



