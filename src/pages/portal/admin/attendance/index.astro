---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />
  <title>Attendance | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>

  <div id="app" class="app" hidden>

    <!-- SIDEBAR -->
    <aside class="sidebar">

      <div class="brand">
        <a href="/portal/admin/">
          <div class="logo-box">
            <img
              src={logoSrc.src}
              alt="Santutor Learning Studio"
            />
          </div>
        </a>

        <span class="portal-label">
          ADMIN PORTAL
        </span>
      </div>

      <nav>

        <a
          class="nav-item"
          href="/portal/admin/"
        >
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/students/"
        >
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/schedule/"
        >
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a
          class="nav-item active"
          href="/portal/admin/attendance/"
        >
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a class="nav-item" href="/portal/admin/reports/">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a class="nav-item" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>

        <a class="nav-item" href="/portal/admin/payments/">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/parents/"
        >
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/tutors/"
        >
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>

      </nav>

      <div class="sidebar-bottom">
        <button
          id="logoutButton"
          class="logout-button"
          type="button"
        >
          ↪
          <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

      <header class="page-header">

        <div>
          <a
            class="back-link"
            href="/portal/admin/"
          >
            ← Back to Dashboard
          </a>

          <p class="eyebrow">
            CLASS ATTENDANCE
          </p>

          <h1>Attendance</h1>

          <p class="subtitle">
            Mark attendance for scheduled Santutor classes.
          </p>
        </div>

        <button
          id="todayButton"
          class="today-button"
          type="button"
        >
          Today
        </button>

      </header>

      <!-- DATE CONTROLS -->
      <section class="date-panel">

        <button
          id="previousDateButton"
          class="date-arrow"
          type="button"
          aria-label="Previous day"
        >
          ←
        </button>

        <div class="date-main">

          <span class="date-label">
            SELECTED DATE
          </span>

          <strong id="selectedDateLabel">
            —
          </strong>

          <span id="selectedDayLabel">
            —
          </span>

        </div>

        <input
          id="attendanceDate"
          type="date"
        />

        <button
          id="nextDateButton"
          class="date-arrow"
          type="button"
          aria-label="Next day"
        >
          →
        </button>

      </section>

      <!-- STATS -->
      <section class="stats-grid">

        <article class="stat-card">
          <div class="stat-icon scheduled-icon">
            📅
          </div>

          <div>
            <span class="stat-label">
              Scheduled
            </span>

            <strong id="scheduledCount">
              —
            </strong>

            <span class="stat-note">
              Classes for this day
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon present-icon">
            ✓
          </div>

          <div>
            <span class="stat-label">
              Present
            </span>

            <strong id="presentCount">
              —
            </strong>

            <span class="stat-note">
              Completed classes
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon absent-icon">
            ✕
          </div>

          <div>
            <span class="stat-label">
              Absent
            </span>

            <strong id="absentCount">
              —
            </strong>

            <span class="stat-note">
              Student absent
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon pending-icon">
            •
          </div>

          <div>
            <span class="stat-label">
              Not Marked
            </span>

            <strong id="pendingCount">
              —
            </strong>

            <span class="stat-note">
              Waiting for attendance
            </span>
          </div>
        </article>

      </section>

      <!-- ATTENDANCE LIST -->
      <section class="attendance-panel">

        <div class="panel-top">

          <div>
            <p class="section-label">
              DAILY CLASSES
            </p>

            <h2 id="dailyHeading">
              Attendance List
            </h2>

            <p class="panel-description">
              Mark attendance or reschedule a class to a one-off date.
            </p>
          </div>

          <div class="toolbar">

            <div class="search-box">
              <span class="search-icon">⌕</span>

              <input
                id="searchInput"
                type="search"
                placeholder="Search student, tutor..."
              />
            </div>

            <select id="modeFilter">
              <option value="all">
                All Modes
              </option>

              <option value="onsite">
                Onsite
              </option>

              <option value="online">
                Online
              </option>
            </select>

          </div>

        </div>

        <div
          id="attendanceList"
          class="attendance-list"
        >
          <div class="list-loading">
            Loading classes...
          </div>
        </div>

      </section>

    </main>

  </div>

  <!-- RESCHEDULE MODAL -->
  <div
    id="rescheduleModal"
    class="reschedule-backdrop"
    hidden
  >
    <div
      class="reschedule-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="rescheduleTitle"
    >
      <div class="reschedule-dialog-header">
        <div>
          <p class="section-label">ONE-OFF CLASS</p>
          <h2 id="rescheduleTitle">Reschedule Class</h2>
        </div>

        <button
          id="closeRescheduleButton"
          class="reschedule-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>
      </div>

      <p
        id="rescheduleSummary"
        class="reschedule-summary"
      >
        —
      </p>

      <label class="reschedule-field">
        <span>New class date</span>
        <input
          id="rescheduleDate"
          type="date"
        />
      </label>

      <div class="reschedule-time-grid">
        <label class="reschedule-field">
          <span>Start time</span>
          <input
            id="rescheduleStartTime"
            type="time"
          />
        </label>

        <label class="reschedule-field">
          <span>End time</span>
          <input
            id="rescheduleEndTime"
            type="time"
          />
        </label>
      </div>

      <div class="credit-rule-box">
        <strong>Credit rule</strong>
        <span>
          The original date uses 0 credit. The make-up class uses 1 credit only after it is marked Present.
        </span>
      </div>

      <p
        id="rescheduleMessage"
        class="reschedule-message"
      ></p>

      <div class="reschedule-dialog-actions">
        <button
          id="cancelRescheduleButton"
          class="secondary-button"
          type="button"
        >
          Cancel
        </button>

        <button
          id="confirmRescheduleButton"
          class="primary-button"
          type="button"
        >
          Confirm Reschedule
        </button>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../../../lib/supabase';

    type RecordStatus = 'active' | 'inactive';
    type ClassMode = 'onsite' | 'online';
    type DayOfWeek =
      'Monday' |
      'Tuesday' |
      'Wednesday' |
      'Thursday' |
      'Friday' |
      'Saturday' |
      'Sunday';

    type AttendanceStatus =
      'pending' |
      'present' |
      'absent' |
      'cancelled' |
      'rescheduled';

    type Student = {
      id: string;
      student_code: string | null;
      name: string;
      status: RecordStatus;
    };

    type Tutor = {
      id: string;
      tutor_code: string | null;
      name: string;
      status: RecordStatus;
    };

    type Schedule = {
      id: string;
      student_id: string;
      tutor_id: string;
      subject: string | null;
      day_of_week: DayOfWeek;
      start_time: string;
      end_time: string;
      class_mode: ClassMode;
      location: string | null;
      notes: string | null;
      status: RecordStatus;
    };

    type AttendanceRecord = {
      id: string;
      schedule_id: string;
      student_id: string;
      tutor_id: string;
      class_date: string;
      start_time: string | null;
      end_time: string | null;
      attendance_status: AttendanceStatus;
      notes: string | null;
      rescheduled_to_date: string | null;
      rescheduled_to_start_time: string | null;
      rescheduled_to_end_time: string | null;
      rescheduled_from_attendance_id: string | null;
      rescheduled_from_date: string | null;
      legacy_attendance_id: string | null;
      created_at: string;
      updated_at: string | null;
    };

    type InstanceKind =
      'regular' |
      'makeup' |
      'history';

    type ClassInstance = {
      key: string;
      kind: InstanceKind;
      schedule: Schedule;
      attendance: AttendanceRecord | null;
    };

    type RescheduleContext = {
      instanceKey: string;
      scheduleId: string;
      sourceAttendanceId: string | null;
      originalDate: string;
      note: string | null;
    };

    const DAY_NAMES: DayOfWeek[] = [
      'Sunday',
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday'
    ];

    let students: Student[] = [];
    let tutors: Tutor[] = [];
    let schedules: Schedule[] = [];
    let attendanceRecords: AttendanceRecord[] = [];
    let rescheduleContext: RescheduleContext | null = null;

    function getEl<T extends Element>(selector: string): T {
      const element = document.querySelector<T>(selector);
      if (!element) {
        throw new Error(`Element not found: ${selector}`);
      }
      return element;
    }

    const loadingScreen = getEl<HTMLDivElement>('#loadingScreen');
    const app = getEl<HTMLDivElement>('#app');
    const attendanceDate = getEl<HTMLInputElement>('#attendanceDate');
    const attendanceList = getEl<HTMLDivElement>('#attendanceList');
    const searchInput = getEl<HTMLInputElement>('#searchInput');
    const modeFilter = getEl<HTMLSelectElement>('#modeFilter');
    const rescheduleModal = getEl<HTMLDivElement>('#rescheduleModal');
    const rescheduleDate = getEl<HTMLInputElement>('#rescheduleDate');
    const rescheduleStartTime = getEl<HTMLInputElement>('#rescheduleStartTime');
    const rescheduleEndTime = getEl<HTMLInputElement>('#rescheduleEndTime');
    const rescheduleSummary = getEl<HTMLParagraphElement>('#rescheduleSummary');
    const rescheduleMessage = getEl<HTMLParagraphElement>('#rescheduleMessage');
    const confirmRescheduleButton = getEl<HTMLButtonElement>('#confirmRescheduleButton');

    async function initPage(): Promise<void> {
      const { data: { user } } = await supabase.auth.getUser();

      if (!user) {
        window.location.href = '/portal/';
        return;
      }

      const { data: profile, error } = await supabase
        .from('profiles')
        .select('role, active')
        .eq('id', user.id)
        .single();

      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {
        await supabase.auth.signOut();
        window.location.href = '/portal/';
        return;
      }

      attendanceDate.value = getLocalDateString(new Date());
      await loadMasterData();

      loadingScreen.style.display = 'none';
      app.hidden = false;

      await loadAttendanceForDate();
    }

    async function loadMasterData(): Promise<void> {
      const [studentsResult, tutorsResult, schedulesResult] = await Promise.all([
        supabase
          .from('students')
          .select('id, student_code, name, status'),
        supabase
          .from('tutors')
          .select('id, tutor_code, name, status'),
        supabase
          .from('schedules')
          .select(`
            id,
            student_id,
            tutor_id,
            subject,
            day_of_week,
            start_time,
            end_time,
            class_mode,
            location,
            notes,
            status
          `)
      ]);

      if (studentsResult.error) throw new Error(studentsResult.error.message);
      if (tutorsResult.error) throw new Error(tutorsResult.error.message);
      if (schedulesResult.error) throw new Error(schedulesResult.error.message);

      students = (studentsResult.data || []) as Student[];
      tutors = (tutorsResult.data || []) as Tutor[];
      schedules = (schedulesResult.data || []) as Schedule[];
    }

    async function loadAttendanceForDate(): Promise<void> {
      const selectedDate = attendanceDate.value;
      if (!selectedDate) return;

      attendanceList.innerHTML = `
        <div class="list-loading">Loading classes...</div>
      `;

      const { data, error } = await supabase
        .from('attendance')
        .select(`
          id,
          schedule_id,
          student_id,
          tutor_id,
          class_date,
          start_time,
          end_time,
          attendance_status,
          notes,
          rescheduled_to_date,
          rescheduled_to_start_time,
          rescheduled_to_end_time,
          rescheduled_from_attendance_id,
          rescheduled_from_date,
          legacy_attendance_id,
          created_at,
          updated_at
        `)
        .eq('class_date', selectedDate);

      if (error) {
        console.error('Load attendance error:', error);
        attendanceList.innerHTML = `
          <div class="list-loading error-text">
            Unable to load attendance.
          </div>
        `;
        return;
      }

      attendanceRecords = (data || []) as AttendanceRecord[];
      updateDateLabels();
      applyFilters();
      updateStats();
    }

    function getSelectedDay(): DayOfWeek {
      const date = parseLocalDate(attendanceDate.value);
      return DAY_NAMES[date.getDay()];
    }

    function updateDateLabels(): void {
      const date = parseLocalDate(attendanceDate.value);
      const day = getSelectedDay();

      setText(
        '#selectedDateLabel',
        new Intl.DateTimeFormat('en-US', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        }).format(date)
      );

      setText('#selectedDayLabel', day);
      setText('#dailyHeading', `${day} Classes`);
    }

    function changeDate(offsetDays: number): void {
      const date = parseLocalDate(attendanceDate.value);
      date.setDate(date.getDate() + offsetDays);
      attendanceDate.value = getLocalDateString(date);
      void loadAttendanceForDate();
    }

    function getRegularSchedulesForSelectedDay(): Schedule[] {
      const selectedDay = getSelectedDay();

      return schedules
        .filter(
          schedule =>
            schedule.status === 'active' &&
            schedule.day_of_week === selectedDay
        )
        .sort((first, second) =>
          first.start_time.localeCompare(second.start_time)
        );
    }

    function getClassInstances(): ClassInstance[] {
      const regularSchedules = getRegularSchedulesForSelectedDay();
      const regularScheduleIds = new Set(
        regularSchedules.map(schedule => schedule.id)
      );

      const instances: ClassInstance[] = regularSchedules.map(schedule => {
        const attendance = attendanceRecords.find(
          record =>
            record.schedule_id === schedule.id &&
            record.rescheduled_from_attendance_id === null
        ) || null;

        return {
          key: `regular_${schedule.id}`,
          kind: 'regular',
          schedule,
          attendance
        };
      });

      for (const record of attendanceRecords) {
        const schedule = schedules.find(item => item.id === record.schedule_id);
        if (!schedule) continue;

        if (record.rescheduled_from_attendance_id) {
          instances.push({
            key: `makeup_${record.id}`,
            kind: 'makeup',
            schedule,
            attendance: record
          });
          continue;
        }

        if (!regularScheduleIds.has(record.schedule_id)) {
          instances.push({
            key: `history_${record.id}`,
            kind: 'history',
            schedule,
            attendance: record
          });
        }
      }

      return instances.sort((first, second) => {
        const firstTime =
          first.attendance?.start_time || first.schedule.start_time;
        const secondTime =
          second.attendance?.start_time || second.schedule.start_time;

        const timeCompare = firstTime.localeCompare(secondTime);
        if (timeCompare !== 0) return timeCompare;

        const firstName = getStudent(first.schedule.student_id)?.name || '';
        const secondName = getStudent(second.schedule.student_id)?.name || '';
        return firstName.localeCompare(secondName);
      });
    }

    function getInstance(instanceKey: string): ClassInstance | undefined {
      return getClassInstances().find(instance => instance.key === instanceKey);
    }

    function applyFilters(): void {
      const search = searchInput.value.toLowerCase().trim();
      const mode = modeFilter.value;

      const filtered = getClassInstances().filter(instance => {
        const student = getStudent(instance.schedule.student_id);
        const tutor = getTutor(instance.schedule.tutor_id);

        const combined = `
          ${student?.name || ''}
          ${student?.student_code || ''}
          ${tutor?.name || ''}
          ${tutor?.tutor_code || ''}
          ${instance.schedule.subject || ''}
          ${instance.schedule.location || ''}
          ${instance.kind}
        `.toLowerCase();

        const matchesSearch = combined.includes(search);
        const matchesMode =
          mode === 'all' || instance.schedule.class_mode === mode;

        return matchesSearch && matchesMode;
      });

      renderAttendanceList(filtered);
    }

    function renderAttendanceList(list: ClassInstance[]): void {
      if (list.length === 0) {
        attendanceList.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">📅</div>
            <strong>No classes</strong>
            <p>There are no recurring or one-off classes for this date.</p>
          </div>
        `;
        return;
      }

      attendanceList.innerHTML = list
        .map(instance => renderAttendanceCard(instance))
        .join('');
    }

    function renderAttendanceCard(instance: ClassInstance): string {
      const { schedule, attendance, kind } = instance;
      const student = getStudent(schedule.student_id);
      const tutor = getTutor(schedule.tutor_id);
      const currentStatus = attendance?.attendance_status || null;
      const note = attendance?.notes || '';
      const isLegacy = Boolean(attendance?.legacy_attendance_id);
      const startTime = attendance?.start_time || schedule.start_time;
      const endTime = attendance?.end_time || schedule.end_time;

      const instanceBanner =
        kind === 'makeup'
          ? `
            <div class="instance-banner makeup-banner">
              ↪ One-off rescheduled class
              ${
                attendance?.rescheduled_from_date
                  ? `• from ${escapeHtml(formatDateShort(attendance.rescheduled_from_date))}`
                  : ''
              }
            </div>
          `
          : kind === 'history' || isLegacy
            ? `
              <div class="instance-banner history-banner">
                Historical attendance record
              </div>
            `
            : '';

      const movedTarget =
        currentStatus === 'rescheduled' && attendance?.rescheduled_to_date
          ? `
            <div class="reschedule-target">
              Moved to <strong>${escapeHtml(formatDateShort(attendance.rescheduled_to_date))}</strong>
              ${
                attendance.rescheduled_to_start_time && attendance.rescheduled_to_end_time
                  ? `at <strong>${escapeHtml(formatTime(attendance.rescheduled_to_start_time))}–${escapeHtml(formatTime(attendance.rescheduled_to_end_time))}</strong>`
                  : ''
              }.
              The recurring schedule is unchanged.
            </div>
          `
          : '';

      return `
        <article
          class="attendance-card ${kind === 'makeup' ? 'makeup-card' : ''}"
          data-instance-key="${escapeHtml(instance.key)}"
        >
          ${instanceBanner}

          <div class="class-info">
            <div class="time-box">
              <strong>${escapeHtml(formatTime(startTime))}</strong>
              <span>${escapeHtml(formatTime(endTime))}</span>
            </div>

            <div class="student-box">
              <div class="avatar">
                ${escapeHtml(getInitials(student?.name || '?'))}
              </div>

              <div>
                <strong>${escapeHtml(student?.name || 'Unknown student')}</strong>
                <span>
                  ${schedule.subject ? escapeHtml(schedule.subject) : 'General Class'}
                </span>
              </div>
            </div>

            <div class="meta-box">
              <span>👩‍🏫 ${escapeHtml(tutor?.name || 'Unknown tutor')}</span>
              <span>
                ${schedule.class_mode === 'online' ? '💻 Online' : '🏠 Onsite'}
              </span>
              ${
                schedule.location
                  ? `<span>📍 ${escapeHtml(schedule.location)}</span>`
                  : ''
              }
            </div>
          </div>

          <div class="attendance-actions">
            ${movedTarget}

            <div class="status-buttons">
              ${renderStatusButton(instance, 'present', 'Present', currentStatus, isLegacy)}
              ${renderStatusButton(instance, 'absent', 'Absent', currentStatus, isLegacy)}
              ${renderStatusButton(instance, 'cancelled', 'Cancelled', currentStatus, isLegacy)}
              ${renderStatusButton(instance, 'rescheduled', 'Reschedule', currentStatus, isLegacy)}
            </div>

            <div class="note-row">
              <input
                class="attendance-note"
                data-instance-key="${escapeHtml(instance.key)}"
                type="text"
                value="${escapeHtml(note)}"
                placeholder="Optional note..."
                ${isLegacy ? 'disabled' : ''}
              />

              <button
                class="save-note-button"
                data-instance-key="${escapeHtml(instance.key)}"
                type="button"
                ${attendance && !isLegacy ? '' : 'disabled'}
              >
                Save Note
              </button>
            </div>

            <div class="saved-state">
              ${renderSavedState(attendance)}
            </div>
          </div>
        </article>
      `;
    }

    function renderStatusButton(
      instance: ClassInstance,
      status: Exclude<AttendanceStatus, 'pending'>,
      label: string,
      currentStatus: AttendanceStatus | null,
      disabled: boolean
    ): string {
      const activeClass = currentStatus === status ? 'active' : '';

      return `
        <button
          class="status-button ${status} ${activeClass}"
          data-instance-key="${escapeHtml(instance.key)}"
          data-status="${status}"
          type="button"
          ${disabled ? 'disabled' : ''}
        >
          ${escapeHtml(label)}
        </button>
      `;
    }

    function renderSavedState(attendance: AttendanceRecord | null): string {
      if (!attendance) {
        return `<span class="not-marked">Not marked</span>`;
      }

      if (attendance.legacy_attendance_id) {
        return `<span class="history-state">Imported history • credit locked</span>`;
      }

      if (attendance.attendance_status === 'pending') {
        return `<span class="pending-makeup-state">One-off class • awaiting attendance</span>`;
      }

      if (attendance.attendance_status === 'rescheduled') {
        return `<span class="rescheduled-state">Rescheduled • no credit used</span>`;
      }

      if (attendance.attendance_status === 'present') {
        return `<span class="saved-badge">Saved • 1 credit used</span>`;
      }

      return `<span class="saved-badge neutral-saved">Saved • no credit used</span>`;
    }

    async function saveAttendanceStatus(
      instance: ClassInstance,
      status: 'present' | 'absent' | 'cancelled'
    ): Promise<void> {
      if (instance.attendance?.legacy_attendance_id) return;

      const noteInput = attendanceList.querySelector<HTMLInputElement>(
        `.attendance-note[data-instance-key="${CSS.escape(instance.key)}"]`
      );

      const note = noteInput?.value.trim() || null;
      const classDate = instance.attendance?.class_date || attendanceDate.value;

      const { error } = await supabase.rpc('mark_attendance', {
        p_schedule_id: instance.schedule.id,
        p_class_date: classDate,
        p_status: status,
        p_attendance_id: instance.attendance?.id || null,
        p_notes: note
      });

      if (error) {
        console.error('Save attendance error:', error);
        window.alert(error.message);
        return;
      }

      await loadAttendanceForDate();
    }

    async function saveAttendanceNote(instance: ClassInstance): Promise<void> {
      const attendance = instance.attendance;

      if (!attendance) {
        window.alert('Please mark attendance first.');
        return;
      }

      if (attendance.legacy_attendance_id) {
        window.alert('Imported historical attendance is read-only.');
        return;
      }

      const noteInput = attendanceList.querySelector<HTMLInputElement>(
        `.attendance-note[data-instance-key="${CSS.escape(instance.key)}"]`
      );

      const note = noteInput?.value.trim() || null;

      const { error } = await supabase
        .from('attendance')
        .update({
          notes: note,
          updated_at: new Date().toISOString()
        })
        .eq('id', attendance.id);

      if (error) {
        window.alert(error.message);
        return;
      }

      await loadAttendanceForDate();
    }

    function openRescheduleModal(instance: ClassInstance): void {
      if (instance.attendance?.legacy_attendance_id) {
        window.alert('Imported historical attendance is read-only.');
        return;
      }

      const student = getStudent(instance.schedule.student_id);
      const originalDate = instance.attendance?.class_date || attendanceDate.value;
      const noteInput = attendanceList.querySelector<HTMLInputElement>(
        `.attendance-note[data-instance-key="${CSS.escape(instance.key)}"]`
      );

      rescheduleContext = {
        instanceKey: instance.key,
        scheduleId: instance.schedule.id,
        sourceAttendanceId: instance.attendance?.id || null,
        originalDate,
        note: noteInput?.value.trim() || null
      };

      const isCurrentlyRescheduled =
        instance.attendance?.attendance_status === 'rescheduled';

      const currentTarget =
        isCurrentlyRescheduled
          ? instance.attendance?.rescheduled_to_date
          : null;

      const currentStart =
        isCurrentlyRescheduled
          ? instance.attendance?.rescheduled_to_start_time
          : null;

      const currentEnd =
        isCurrentlyRescheduled
          ? instance.attendance?.rescheduled_to_end_time
          : null;

      const originalStart =
        instance.attendance?.start_time || instance.schedule.start_time;

      const originalEnd =
        instance.attendance?.end_time || instance.schedule.end_time;

      rescheduleDate.value =
        currentTarget || addDaysToDateString(originalDate, 1);

      rescheduleStartTime.value =
        toTimeInputValue(currentStart || originalStart);

      rescheduleEndTime.value =
        toTimeInputValue(currentEnd || originalEnd);

      rescheduleSummary.textContent =
        `${student?.name || 'Student'} • ${instance.schedule.subject || 'General Class'} • ` +
        `${formatDateShort(originalDate)} ${formatTime(originalStart)}–${formatTime(originalEnd)} ` +
        `→ choose the one-off replacement date and time.`;

      rescheduleMessage.textContent = '';
      confirmRescheduleButton.disabled = false;
      rescheduleModal.hidden = false;
      document.body.classList.add('modal-open');
      rescheduleDate.focus();
    }

    function closeRescheduleModal(): void {
      rescheduleContext = null;
      rescheduleModal.hidden = true;
      rescheduleMessage.textContent = '';
      document.body.classList.remove('modal-open');
    }

    async function confirmReschedule(): Promise<void> {
      if (!rescheduleContext) return;

      const targetDate = rescheduleDate.value;
      const targetStartTime = rescheduleStartTime.value;
      const targetEndTime = rescheduleEndTime.value;

      if (!targetDate) {
        rescheduleMessage.textContent = 'Please choose the new class date.';
        return;
      }

      if (!targetStartTime || !targetEndTime) {
        rescheduleMessage.textContent = 'Please choose the start and end time.';
        return;
      }

      if (targetEndTime <= targetStartTime) {
        rescheduleMessage.textContent = 'End time must be later than start time.';
        return;
      }

      if (targetDate === rescheduleContext.originalDate) {
        rescheduleMessage.textContent = 'Please choose a different date.';
        return;
      }

      confirmRescheduleButton.disabled = true;
      confirmRescheduleButton.textContent = 'Saving...';
      rescheduleMessage.textContent = '';

      const { error } = await supabase.rpc('reschedule_class', {
        p_schedule_id: rescheduleContext.scheduleId,
        p_original_date: rescheduleContext.originalDate,
        p_target_date: targetDate,
        p_target_start_time: targetStartTime,
        p_target_end_time: targetEndTime,
        p_source_attendance_id: rescheduleContext.sourceAttendanceId,
        p_notes: rescheduleContext.note
      });

      confirmRescheduleButton.disabled = false;
      confirmRescheduleButton.textContent = 'Confirm Reschedule';

      if (error) {
        console.error('Reschedule error:', error);
        rescheduleMessage.textContent = error.message;
        return;
      }

      closeRescheduleModal();
      await loadAttendanceForDate();
    }

    function updateStats(): void {
      const instances = getClassInstances();
      const present = instances.filter(
        instance => instance.attendance?.attendance_status === 'present'
      ).length;
      const absent = instances.filter(
        instance => instance.attendance?.attendance_status === 'absent'
      ).length;
      const pending = instances.filter(instance => {
        const status = instance.attendance?.attendance_status;
        return !status || status === 'pending';
      }).length;

      setText('#scheduledCount', instances.length);
      setText('#presentCount', present);
      setText('#absentCount', absent);
      setText('#pendingCount', pending);
    }

    attendanceDate.addEventListener('change', () => {
      void loadAttendanceForDate();
    });

    searchInput.addEventListener('input', applyFilters);
    modeFilter.addEventListener('change', applyFilters);

    getEl<HTMLButtonElement>('#todayButton').addEventListener('click', () => {
      attendanceDate.value = getLocalDateString(new Date());
      void loadAttendanceForDate();
    });

    getEl<HTMLButtonElement>('#previousDateButton').addEventListener('click', () => {
      changeDate(-1);
    });

    getEl<HTMLButtonElement>('#nextDateButton').addEventListener('click', () => {
      changeDate(1);
    });

    attendanceList.addEventListener('click', event => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const statusButton = target.closest<HTMLButtonElement>('.status-button');
      if (statusButton) {
        const instanceKey = statusButton.dataset.instanceKey;
        const status = statusButton.dataset.status as
          | 'present'
          | 'absent'
          | 'cancelled'
          | 'rescheduled'
          | undefined;

        if (!instanceKey || !status) return;

        const instance = getInstance(instanceKey);
        if (!instance) return;

        if (status === 'rescheduled') {
          openRescheduleModal(instance);
        } else {
          void saveAttendanceStatus(instance, status);
        }
        return;
      }

      const noteButton = target.closest<HTMLButtonElement>('.save-note-button');
      if (noteButton) {
        const instanceKey = noteButton.dataset.instanceKey;
        if (!instanceKey) return;

        const instance = getInstance(instanceKey);
        if (instance) void saveAttendanceNote(instance);
      }
    });

    getEl<HTMLButtonElement>('#closeRescheduleButton').addEventListener(
      'click',
      closeRescheduleModal
    );

    getEl<HTMLButtonElement>('#cancelRescheduleButton').addEventListener(
      'click',
      closeRescheduleModal
    );

    confirmRescheduleButton.addEventListener('click', () => {
      void confirmReschedule();
    });

    rescheduleModal.addEventListener('click', event => {
      if (event.target === rescheduleModal) closeRescheduleModal();
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !rescheduleModal.hidden) {
        closeRescheduleModal();
      }
    });

    getEl<HTMLButtonElement>('#logoutButton').addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/portal/';
    });

    function getStudent(studentId: string): Student | undefined {
      return students.find(student => student.id === studentId);
    }

    function getTutor(tutorId: string): Tutor | undefined {
      return tutors.find(tutor => tutor.id === tutorId);
    }

    function setText(selector: string, value: string | number): void {
      getEl<HTMLElement>(selector).textContent = String(value);
    }

    function formatTime(value: string): string {
      return value ? value.slice(0, 5) : '';
    }

    function formatDateShort(value: string): string {
      const date = parseLocalDate(value);
      return new Intl.DateTimeFormat('en-GB', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
      }).format(date);
    }

    function parseLocalDate(value: string): Date {
      const [year, month, day] = value.split('-').map(Number);
      return new Date(year, month - 1, day);
    }

    function getLocalDateString(date: Date): string {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function toTimeInputValue(value: string | null | undefined): string {
      if (!value) return '';
      return value.slice(0, 5);
    }

    function addDaysToDateString(value: string, days: number): string {
      const date = parseLocalDate(value);
      date.setDate(date.getDate() + days);
      return getLocalDateString(date);
    }

    function getInitials(value: string): string {
      return value
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map(part => part.charAt(0).toUpperCase())
        .join('');
    }

    function escapeHtml(value: string): string {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    void initPage().catch(error => {
      console.error(error);
      loadingScreen.innerHTML = `
        <p class="error-text">${escapeHtml(
          error instanceof Error ? error.message : 'Unable to load attendance.'
        )}</p>
      `;
    });
  </script>

