      background: #f1f2f4;
      color: #646d79;
    }

    .status-button.rescheduled.active {
      border-color: #efd1ae;
      background: #fff5e8;
      color: #bc6a1e;
    }

    .note-row {
      display: grid;
      grid-template-columns:
        1fr auto;
      gap: 8px;
    }

    .attendance-note {
      min-width: 0;
      height: 36px;
      border: 1px solid #dde4eb;
      border-radius: 8px;
      padding: 0 10px;
      outline: none;
      color: #46566b;
      background: white;
      font-size: 11px;
    }

    .attendance-note:focus {
      border-color: #769dcc;
      box-shadow:
        0 0 0 3px
        rgba(73, 126, 188, .08);
    }

    .save-note-button {
      min-width: 90px;
      border: 1px solid #dce3ea;
      background: #f8fafc;
      color: #4e5d72;
      border-radius: 8px;
      padding: 0 12px;
      cursor: pointer;
      font-size: 10px;
      font-weight: 750;
    }

    .save-note-button:hover:not(:disabled) {
      background: #eef3f8;
      color: #17375e;
    }

    .save-note-button:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    .saved-state {
      min-height: 15px;
      display: flex;
      justify-content: flex-end;
    }

    .saved-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #27814f;
      font-size: 9px;
      font-weight: 750;
    }

    .saved-badge::before {
      content: "✓";
    }

    .not-marked {
      color: #9aa4b1;
      font-size: 9px;
      font-weight: 700;
    }

    .list-loading,
    .empty-state {
      min-height: 300px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #929dab;
      text-align: center;
      padding: 30px;
    }

    .empty-icon {
      width: 50px;
      height: 50px;
      margin-bottom: 12px;
      border-radius: 50%;
      background: #f2f5f8;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .empty-state p {
      margin: 5px 0 0;
      font-size: 12px;
    }

    .error-text {
      color: #c44242;
    }

    /* RESPONSIVE */

    @media (max-width: 1180px) {

      .stats-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .attendance-card {
        grid-template-columns: 1fr;
      }

    }

    @media (max-width: 1000px) {

      .app {
        grid-template-columns:
          80px minmax(0, 1fr);
      }

      .sidebar {
        width: 80px;
      }

      .logo-box {
        width: 50px;
        padding: 6px;
      }

      .portal-label {
        display: none;
      }

      .nav-item {
        justify-content: center;
      }

      .nav-item span:not(.nav-icon) {
        display: none;
      }

      .logout-button span {
        display: none;
      }

      .main {
        padding: 28px 22px 50px;
      }

      .panel-top {
        align-items: stretch;
        flex-direction: column;
      }

    }

    @media (max-width: 720px) {

      .app {
        display: block;
      }

      .sidebar {
        display: none;
      }

      .main {
        padding: 24px 15px 45px;
      }

      .page-header {
        align-items: stretch;
        flex-direction: column;
      }

      .today-button {
        width: 100%;
      }

      .date-panel {
        grid-template-columns:
          auto 1fr auto;
        gap: 9px;
      }

      #attendanceDate {
        grid-column: 1 / -1;
        width: 100%;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .search-box,
      #modeFilter {
        width: 100%;
      }

      .attendance-card {
        padding: 16px;
      }

      .class-info {
        grid-template-columns:
          70px 1fr;
      }

      .meta-box {
        grid-column: 1 / -1;
        padding-top: 10px;
        border-top: 1px solid #edf0f4;
      }

      .status-buttons {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .note-row {
        grid-template-columns: 1fr;
      }

      .save-note-button {
        height: 36px;
      }

    }

    /* RESCHEDULE / ONE-OFF */

    body.modal-open {
      overflow: hidden;
    }

    .instance-banner {
      grid-column: 1 / -1;
      margin: -2px 0 10px;
      padding: 8px 10px;
      border-radius: 8px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .02em;
    }

    .makeup-banner {
      color: #9a571a;
      background: #fff4e5;
      border: 1px solid #f1d4ad;
    }

    .history-banner {
      color: #687483;
      background: #f5f7f9;
      border: 1px solid #e2e6eb;
    }

    .makeup-card {
      border-color: #efd1ae;
      box-shadow: 0 8px 22px rgba(188, 106, 30, .06);
    }

    .reschedule-target {
      border: 1px solid #efd1ae;
      background: #fff8ef;
      color: #9a571a;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 10px;
      line-height: 1.45;
    }

    .status-button:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    .pending-makeup-state,
    .rescheduled-state,
    .history-state {
      font-size: 9px;
      font-weight: 750;
    }

    .pending-makeup-state,
    .rescheduled-state {
      color: #bc6a1e;
    }

    .history-state {
      color: #7a8491;
    }

    .neutral-saved {
      color: #687483;
    }

    .reschedule-backdrop {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(13, 32, 55, .48);
      backdrop-filter: blur(3px);
    }

    .reschedule-backdrop[hidden] {
      display: none;
    }

    .reschedule-dialog {
      width: min(480px, 100%);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 24px 70px rgba(13, 32, 55, .24);
      padding: 22px;
    }

    .reschedule-dialog-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    .reschedule-dialog-header h2 {
      margin: 3px 0 0;
      color: #17375e;
      font-size: 22px;
    }

    .reschedule-close {
      width: 34px;
      height: 34px;
      border: 0;
      border-radius: 8px;
      background: #f2f5f8;
      color: #607086;
      font-size: 22px;
      cursor: pointer;
    }

    .reschedule-summary {
      margin: 16px 0;
      color: #5c697b;
      font-size: 12px;
      line-height: 1.55;
    }

    .reschedule-field {
      display: grid;
      gap: 7px;
      color: #3f4f64;
      font-size: 11px;
      font-weight: 750;
    }

    .reschedule-field input {
      width: 100%;
      height: 42px;
      border: 1px solid #d9e1e8;
      border-radius: 9px;
      padding: 0 11px;
      outline: none;
      color: #17375e;
      background: white;
      font: inherit;
    }

    .reschedule-field input:focus {
      border-color: #769dcc;
      box-shadow: 0 0 0 3px rgba(73, 126, 188, .08);
    }

    .reschedule-time-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .credit-rule-box {
      display: grid;
      gap: 4px;
      margin-top: 14px;
      padding: 12px;
      border: 1px solid #cfe2d6;
      border-radius: 9px;
      background: #f2faf5;
      color: #42624d;
      font-size: 10px;
      line-height: 1.5;
    }

    .credit-rule-box strong {
      color: #277148;
    }

    .reschedule-message {
      min-height: 18px;
      margin: 10px 0 0;
      color: #b74242;
      font-size: 10px;
      font-weight: 700;
    }

    .reschedule-dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 9px;
      margin-top: 10px;
    }

    .secondary-button,
    .primary-button {
      min-height: 38px;
      border-radius: 9px;
      padding: 0 14px;
      cursor: pointer;
      font-size: 10px;
      font-weight: 800;
    }

    .secondary-button {
      border: 1px solid #d9e1e8;
      background: white;
      color: #536276;
    }

    .primary-button {
      border: 1px solid #17375e;
      background: #17375e;
      color: white;
    }

    .primary-button:disabled {
      opacity: .55;
      cursor: wait;
    }

    @media (max-width: 520px) {
      .reschedule-time-grid {
        grid-template-columns: 1fr;
      }

      .reschedule-dialog-actions {
        flex-direction: column-reverse;
      }

      .secondary-button,
      .primary-button {
        width: 100%;
      }
    }

  </style>

</body>
</html>
