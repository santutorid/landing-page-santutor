---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />
  <title>Tutors | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>

  <div id="app" class="app" hidden>

    <!-- SIDEBAR -->
    <aside class="sidebar">

      <div class="brand">
        <a href="/portal/admin/">
          <div class="logo-box">
            <img
              src={logoSrc.src}
              alt="Santutor Learning Studio"
            />
          </div>
        </a>

        <span class="portal-label">
          ADMIN PORTAL
        </span>
      </div>

      <nav>

        <a
          class="nav-item"
          href="/portal/admin/"
        >
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/students/"
        >
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>

        <a class="nav-item" href="/portal/admin/schedule/">
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a class="nav-item" href="/portal/admin/attendance/">
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a class="nav-item" href="/portal/admin/reports/">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a class="nav-item" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>

        <a class="nav-item" href="/portal/admin/payments/">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/parents/"
        >
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>

        <a
          class="nav-item active"
          href="/portal/admin/tutors/"
        >
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>

      </nav>

      <div class="sidebar-bottom">
        <button
          id="logoutButton"
          class="logout-button"
          type="button"
        >
          ↪
          <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

      <header class="page-header">

        <div>
          <a
            class="back-link"
            href="/portal/admin/"
          >
            ← Back to Dashboard
          </a>

          <p class="eyebrow">
            TUTOR MANAGEMENT
          </p>

          <h1>Tutors</h1>

          <p class="subtitle">
            Manage tutor profiles, subjects, and contact information.
          </p>
        </div>

        <button
          id="showFormButton"
          class="add-button"
          type="button"
        >
          <span class="plus">+</span>
          Add Tutor
        </button>

      </header>

      <!-- STATS -->
      <section class="stats-grid">

        <article class="stat-card">
          <div class="stat-icon total-icon">
            👩‍🏫
          </div>

          <div>
            <span class="stat-label">
              Total Tutors
            </span>

            <strong id="totalTutors">
              —
            </strong>

            <span class="stat-note">
              Registered tutors
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon active-icon">
            ✓
          </div>

          <div>
            <span class="stat-label">
              Active Tutors
            </span>

            <strong id="activeTutors">
              —
            </strong>

            <span class="stat-note">
              Currently teaching
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon inactive-icon">
            ⏸
          </div>

          <div>
            <span class="stat-label">
              Inactive
            </span>

            <strong id="inactiveTutors">
              —
            </strong>

            <span class="stat-note">
              Not currently active
            </span>
          </div>
        </article>

      </section>

      <!-- TUTOR LIST -->
      <section class="tutor-panel">

        <div class="panel-top">

          <div>
            <p class="section-label">
              TUTOR DATABASE
            </p>

            <h2>All Tutors</h2>

            <p class="panel-description">
              Tutor profiles registered in Santutor.
            </p>
          </div>

          <div class="toolbar">

            <div class="search-box">
              <span class="search-icon">⌕</span>

              <input
                id="searchInput"
                type="search"
                placeholder="Search tutors..."
              />
            </div>

            <select id="statusFilter">
              <option value="all">
                All Status
              </option>

              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>
            </select>

          </div>

        </div>

        <div class="table-wrapper">

          <table>

            <thead>
              <tr>
                <th>Tutor</th>
                <th>Contact</th>
                <th>Subjects</th>
                <th>Notes</th>
                <th>Status</th>
                <th class="action-heading">
                  Action
                </th>
              </tr>
            </thead>

            <tbody id="tutorTableBody">
              <tr>
                <td
                  colspan="6"
                  class="empty-row"
                >
                  Loading tutors...
                </td>
              </tr>
            </tbody>

          </table>

        </div>

      </section>

    </main>

  </div>

  <!-- ADD / EDIT TUTOR MODAL -->
  <div
    id="tutorModal"
    class="modal-backdrop"
    hidden
  >

    <div
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <div class="modal-header">

        <div>
          <p
            id="modalEyebrow"
            class="section-label"
          >
            NEW TUTOR
          </p>

          <h2 id="modalTitle">
            Add Tutor
          </h2>

          <p id="modalDescription">
            Add a new tutor to Santutor.
          </p>
        </div>

        <button
          id="closeFormButton"
          class="modal-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>

      </div>

      <form id="tutorForm">

        <div class="form-grid">

          <label class="full-width">
            <span>Tutor Name *</span>

            <input
              id="name"
              type="text"
              required
              autocomplete="off"
              placeholder="Full tutor name"
            />
          </label>

          <label>
            <span>Tutor Code</span>

            <input
              id="tutorCode"
              type="text"
              autocomplete="off"
              placeholder="e.g. TU001"
            />
          </label>

          <label>
            <span>Status</span>

            <select id="status">
              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>
            </select>
          </label>

          <label>
            <span>WhatsApp / Phone</span>

            <input
              id="phone"
              type="tel"
              autocomplete="off"
              placeholder="e.g. 0812..."
            />
          </label>

          <label>
            <span>Email</span>

            <input
              id="email"
              type="email"
              autocomplete="off"
              placeholder="tutor@email.com"
            />
          </label>

          <label class="full-width">
            <span>Subjects</span>

            <input
              id="subjects"
              type="text"
              autocomplete="off"
              placeholder="e.g. Mathematics, ICT, Computer Science"
            />
          </label>

          <label class="full-width">
            <span>Notes</span>

            <textarea
              id="notes"
              rows="4"
              placeholder="Optional notes about this tutor..."
            ></textarea>
          </label>

        </div>

        <div
          id="formMessage"
          class="form-message"
        ></div>

        <div class="form-actions">

          <button
            id="deactivateButton"
            type="button"
            class="danger-button"
            hidden
          >
            Deactivate
          </button>

          <div class="form-spacer"></div>

          <button
            id="cancelButton"
            type="button"
            class="cancel-button"
          >
            Cancel
          </button>

          <button
            id="saveButton"
            type="submit"
            class="save-button"
          >
            Add Tutor
          </button>

        </div>

      </form>

    </div>

  </div>

  <script>

    import { supabase }
      from '../../../../lib/supabase';


    type TutorStatus =
      'active' | 'inactive';


    type Tutor = {
      id: string;
      tutor_code: string | null;
      name: string;
      phone: string | null;
      email: string | null;
      subjects: string | null;
      notes: string | null;
      status: TutorStatus;
      created_at: string;
      updated_at: string | null;
    };


    let tutors: Tutor[] = [];

    let editingTutorId: string | null =
      null;


    function getEl<T extends Element>(
      selector: string
    ): T {

      const element =
        document.querySelector<T>(
          selector
        );


      if (!element) {

        throw new Error(
          `Element not found: ${selector}`
        );

      }


      return element;

    }


    // ==============================
    // AUTH
    // ==============================

    async function initPage(): Promise<void> {

      const {
        data: { user }
      } =
        await supabase.auth.getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        return;

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select(
            'role, active'
          )
          .eq(
            'id',
            user.id
          )
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {

        await supabase.auth.signOut();

        window.location.href =
          '/portal/';

        return;

      }


      getEl<HTMLElement>(
        '#loadingScreen'
      ).style.display =
        'none';


      getEl<HTMLElement>(
        '#app'
      ).removeAttribute(
        'hidden'
      );


      await loadTutors();

    }


    // ==============================
    // LOAD TUTORS
    // ==============================

    async function loadTutors(): Promise<void> {

      const {
        data,
        error
      } =
        await supabase
          .from('tutors')
          .select(`
            id,
            tutor_code,
            name,
            phone,
            email,
            subjects,
            notes,
            status,
            created_at,
            updated_at
          `)
          .order(
            'name',
            {
              ascending: true
            }
          );


      if (error) {

        console.error(
          'Load tutors error:',
          error
        );


        showTableError(
          'Unable to load tutors.'
        );

        return;

      }


      tutors =
        (data ?? []) as Tutor[];


      applyFilters();

      updateStats();

    }


    function showTableError(
      message: string
    ): void {

      const tbody =
        getEl<HTMLTableSectionElement>(
          '#tutorTableBody'
        );


      tbody.innerHTML = `
        <tr>
          <td
            colspan="6"
            class="empty-row"
          >
            ${escapeHtml(message)}
          </td>
        </tr>
      `;

    }


    // ==============================
    // RENDER TABLE
    // ==============================

    function renderTutors(
      list: Tutor[]
    ): void {

      const tbody =
        getEl<HTMLTableSectionElement>(
          '#tutorTableBody'
        );


      if (
        list.length === 0
      ) {

        tbody.innerHTML = `
          <tr>
            <td
              colspan="6"
              class="empty-row"
            >
              <div class="empty-state">

                <div class="empty-icon">
                  👩‍🏫
                </div>

                <strong>
                  No tutors found
                </strong>

                <p>
                  Add your first tutor or
                  change your search filters.
                </p>

              </div>
            </td>
          </tr>
        `;

        return;

      }


      tbody.innerHTML =
        list
          .map((tutor: Tutor) => {

            const initials =
              getInitials(
                tutor.name
              );


            const contact =
              [
                tutor.phone,
                tutor.email
              ]
                .filter(
                  (value): value is string =>
                    Boolean(value)
                )
                .map(
                  value =>
                    escapeHtml(
                      value
                    )
                )
                .join(
                  '<br>'
                ) ||
              '—';


            const subjects =
              tutor.subjects
                ? escapeHtml(
                    tutor.subjects
                  )
                : '—';


            const notes =
              tutor.notes
                ? escapeHtml(
                    truncate(
                      tutor.notes,
                      60
                    )
                  )
                : '—';


            return `
              <tr>

                <td>
                  <div class="tutor-cell">

                    <div class="avatar">
                      ${escapeHtml(initials)}
                    </div>

                    <div>
                      <div class="tutor-name">
                        ${escapeHtml(tutor.name)}
                      </div>

                      <div class="tutor-code">
                        ${
                          escapeHtml(
                            tutor.tutor_code ||
                            'No tutor code'
                          )
                        }
                      </div>
                    </div>

                  </div>
                </td>

                <td class="contact-cell">
                  ${contact}
                </td>

                <td>
                  ${subjects}
                </td>

                <td class="notes-cell">
                  ${notes}
                </td>

                <td>
                  <span
                    class="
                      status-badge
                      ${
                        tutor.status ===
                        'active'
                          ? 'active'
                          : 'inactive'
                      }
                    "
                  >
                    <span
                      class="status-dot"
                    ></span>

                    ${
                      tutor.status ===
                      'active'
                        ? 'Active'
                        : 'Inactive'
                    }
                  </span>
                </td>

                <td class="action-cell">
                  <button
                    class="edit-button edit-tutor-button"
                    data-id="${escapeHtml(tutor.id)}"
                    type="button"
                  >
                    Edit
                  </button>
                </td>

              </tr>
            `;

          })
          .join('');

    }


    // ==============================
    // STATS
    // ==============================

    function updateStats(): void {

      const active =
        tutors.filter(
          (tutor: Tutor) =>
            tutor.status ===
            'active'
        ).length;


      const inactive =
        tutors.filter(
          (tutor: Tutor) =>
            tutor.status ===
            'inactive'
        ).length;


      setText(
        '#totalTutors',
        tutors.length
      );


      setText(
        '#activeTutors',
        active
      );


      setText(
        '#inactiveTutors',
        inactive
      );

    }


    function setText(
      selector: string,
      value: string | number
    ): void {

      getEl<HTMLElement>(
        selector
      ).textContent =
        String(value);

    }


    // ==============================
    // FILTERS
    // ==============================

    function applyFilters(): void {

      const searchInput =
        getEl<HTMLInputElement>(
          '#searchInput'
        );


      const statusFilter =
        getEl<HTMLSelectElement>(
          '#statusFilter'
        );


      const search =
        searchInput.value
          .toLowerCase()
          .trim();


      const status =
        statusFilter.value;


      const filtered =
        tutors.filter(
          (tutor: Tutor) => {

            const combined = `
              ${tutor.name || ''}
              ${tutor.tutor_code || ''}
              ${tutor.phone || ''}
              ${tutor.email || ''}
              ${tutor.subjects || ''}
              ${tutor.notes || ''}
            `
              .toLowerCase();


            const matchesSearch =
              combined.includes(
                search
              );


            const matchesStatus =
              status === 'all' ||
              tutor.status === status;


            return (
              matchesSearch &&
              matchesStatus
            );

          }
        );


      renderTutors(
        filtered
      );

    }


    getEl<HTMLInputElement>(
      '#searchInput'
    ).addEventListener(
      'input',
      applyFilters
    );


    getEl<HTMLSelectElement>(
      '#statusFilter'
    ).addEventListener(
      'change',
      applyFilters
    );


    // ==============================
    // MODAL
    // ==============================

    function clearFormMessage(): void {

      const message =
        getEl<HTMLElement>(
          '#formMessage'
        );


      message.textContent =
        '';


      message.className =
        'form-message';

    }


    function showModal(): void {

      editingTutorId =
        null;


      getEl<HTMLFormElement>(
        '#tutorForm'
      ).reset();


      clearFormMessage();


      setText(
        '#modalEyebrow',
        'NEW TUTOR'
      );


      setText(
        '#modalTitle',
        'Add Tutor'
      );


      setText(
        '#modalDescription',
        'Add a new tutor to Santutor.'
      );


      setText(
        '#saveButton',
        'Add Tutor'
      );


      const deactivateButton =
        getEl<HTMLButtonElement>(
          '#deactivateButton'
        );


      deactivateButton.hidden =
        true;


      deactivateButton.classList
        .remove(
          'reactivate'
        );


      getEl<HTMLElement>(
        '#tutorModal'
      ).removeAttribute(
        'hidden'
      );


      document.body.classList.add(
        'modal-open'
      );


      setTimeout(() => {

        getEl<HTMLInputElement>(
          '#name'
        ).focus();

      }, 0);

    }


    function openEditModal(
      tutorId: string
    ): void {

      const tutor =
        tutors.find(
          (item: Tutor) =>
            item.id === tutorId
        );


      if (!tutor) return;


      editingTutorId =
        tutor.id;


      clearFormMessage();


      getEl<HTMLInputElement>(
        '#name'
      ).value =
        tutor.name || '';


      getEl<HTMLInputElement>(
        '#tutorCode'
      ).value =
        tutor.tutor_code || '';


      getEl<HTMLInputElement>(
        '#phone'
      ).value =
        tutor.phone || '';


      getEl<HTMLInputElement>(
        '#email'
      ).value =
        tutor.email || '';


      getEl<HTMLInputElement>(
        '#subjects'
      ).value =
        tutor.subjects || '';


      getEl<HTMLTextAreaElement>(
        '#notes'
      ).value =
        tutor.notes || '';


      getEl<HTMLSelectElement>(
        '#status'
      ).value =
        tutor.status;


      setText(
        '#modalEyebrow',
        'TUTOR PROFILE'
      );


      setText(
        '#modalTitle',
        'Edit Tutor'
      );


      setText(
        '#modalDescription',
        `Update ${tutor.name}'s tutor information.`
      );


      setText(
        '#saveButton',
        'Save Changes'
      );


      const deactivateButton =
        getEl<HTMLButtonElement>(
          '#deactivateButton'
        );


      deactivateButton.hidden =
        false;


      deactivateButton.textContent =
        tutor.status ===
        'active'
          ? 'Deactivate'
          : 'Reactivate';


      deactivateButton.classList.toggle(
        'reactivate',
        tutor.status ===
          'inactive'
      );


      getEl<HTMLElement>(
        '#tutorModal'
      ).removeAttribute(
        'hidden'
      );


      document.body.classList.add(
        'modal-open'
      );

    }


    function hideModal(): void {

      getEl<HTMLElement>(
        '#tutorModal'
      ).setAttribute(
        'hidden',
        ''
      );


      document.body.classList.remove(
        'modal-open'
      );


      clearFormMessage();

    }


    // ==============================
    // SAVE ADD / EDIT
    // ==============================

    getEl<HTMLFormElement>(
      '#tutorForm'
    ).addEventListener(
      'submit',
      async (
        event: SubmitEvent
      ) => {

        event.preventDefault();


        const nameInput =
          getEl<HTMLInputElement>(
            '#name'
          );


        const codeInput =
          getEl<HTMLInputElement>(
            '#tutorCode'
          );


        const phoneInput =
          getEl<HTMLInputElement>(
            '#phone'
          );


        const emailInput =
          getEl<HTMLInputElement>(
            '#email'
          );


        const subjectsInput =
          getEl<HTMLInputElement>(
            '#subjects'
          );


        const notesInput =
          getEl<HTMLTextAreaElement>(
            '#notes'
          );


        const statusInput =
          getEl<HTMLSelectElement>(
            '#status'
          );


        const saveButton =
          getEl<HTMLButtonElement>(
            '#saveButton'
          );


        const message =
          getEl<HTMLElement>(
            '#formMessage'
          );


        const name =
          nameInput.value.trim();


        if (!name) {

          message.textContent =
            'Tutor name is required.';


          message.className =
            'form-message error';

          return;

        }


        saveButton.disabled =
          true;


        saveButton.textContent =
          editingTutorId
            ? 'Saving Changes...'
            : 'Saving...';


        clearFormMessage();


        const tutorData = {

          name,

          tutor_code:
            codeInput.value
              .trim() ||
            null,

          phone:
            phoneInput.value
              .trim() ||
            null,

          email:
            emailInput.value
              .trim() ||
            null,

          subjects:
            subjectsInput.value
              .trim() ||
            null,

          notes:
            notesInput.value
              .trim() ||
            null,

          status:
            statusInput.value,

          updated_at:
            new Date()
              .toISOString()

        };


        let operationError:
          { message: string } | null =
            null;


        if (editingTutorId) {

          const {
            error
          } =
            await supabase
              .from('tutors')
              .update(
                tutorData
              )
              .eq(
                'id',
                editingTutorId
              );


          operationError =
            error;

        } else {

          const {
            error
          } =
            await supabase
              .from('tutors')
              .insert(
                tutorData
              );


          operationError =
            error;

        }


        if (operationError) {

          console.error(
            'Save tutor error:',
            operationError
          );


          message.textContent =
            operationError.message;


          message.className =
            'form-message error';


          saveButton.disabled =
            false;


          saveButton.textContent =
            editingTutorId
              ? 'Save Changes'
              : 'Add Tutor';


          return;

        }


        await loadTutors();


        hideModal();


        saveButton.disabled =
          false;


        saveButton.textContent =
          'Add Tutor';


        editingTutorId =
          null;

      }
    );


    // ==============================
    // EDIT BUTTON
    // ==============================

    getEl<HTMLTableSectionElement>(
      '#tutorTableBody'
    ).addEventListener(
      'click',
      (
        event: MouseEvent
      ) => {

        const target =
          event.target;


        if (!(
          target instanceof Element
        )) {
          return;
        }


        const button =
          target.closest<HTMLButtonElement>(
            '.edit-tutor-button'
          );


        if (!button) return;


        const tutorId =
          button.dataset.id;


        if (tutorId) {

          openEditModal(
            tutorId
          );

        }

      }
    );


    // ==============================
    // DEACTIVATE / REACTIVATE
    // ==============================

    getEl<HTMLButtonElement>(
      '#deactivateButton'
    ).addEventListener(
      'click',
      async () => {

        if (!editingTutorId) {
          return;
        }


        const tutor =
          tutors.find(
            (item: Tutor) =>
              item.id ===
              editingTutorId
          );


        if (!tutor) return;


        const newStatus:
          TutorStatus =
            tutor.status ===
            'active'
              ? 'inactive'
              : 'active';


        const actionLabel =
          newStatus ===
          'inactive'
            ? 'deactivate'
            : 'reactivate';


        const confirmed =
          window.confirm(
            `Are you sure you want to ${actionLabel} ${tutor.name}?`
          );


        if (!confirmed) {
          return;
        }


        const button =
          getEl<HTMLButtonElement>(
            '#deactivateButton'
          );


        button.disabled =
          true;


        button.textContent =
          newStatus ===
          'inactive'
            ? 'Deactivating...'
            : 'Reactivating...';


        const {
          error
        } =
          await supabase
            .from('tutors')
            .update({

              status:
                newStatus,

              updated_at:
                new Date()
                  .toISOString()

            })
            .eq(
              'id',
              editingTutorId
            );


        if (error) {

          console.error(
            'Tutor status update error:',
            error
          );


          window.alert(
            error.message
          );


          button.disabled =
            false;


          button.textContent =
            tutor.status ===
            'active'
              ? 'Deactivate'
              : 'Reactivate';


          return;

        }


        await loadTutors();


        button.disabled =
          false;


        hideModal();


        editingTutorId =
          null;

      }
    );


    // ==============================
    // MODAL EVENTS
    // ==============================

    getEl<HTMLButtonElement>(
      '#showFormButton'
    ).addEventListener(
      'click',
      showModal
    );


    getEl<HTMLButtonElement>(
      '#closeFormButton'
    ).addEventListener(
      'click',
      hideModal
    );


    getEl<HTMLButtonElement>(
      '#cancelButton'
    ).addEventListener(
      'click',
      hideModal
    );


    getEl<HTMLElement>(
      '#tutorModal'
    ).addEventListener(
      'click',
      (
        event: MouseEvent
      ) => {

        if (
          event.target ===
          event.currentTarget
        ) {

          hideModal();

        }

      }
    );


    document.addEventListener(
      'keydown',
      (
        event: KeyboardEvent
      ) => {

        if (
          event.key ===
          'Escape'
        ) {

          hideModal();

        }

      }
    );


    // ==============================
    // LOGOUT
    // ==============================

    getEl<HTMLButtonElement>(
      '#logoutButton'
    ).addEventListener(
      'click',
      async () => {

        await supabase.auth
          .signOut();


        window.location.href =
          '/portal/';

      }
    );


    // ==============================
    // HELPERS
    // ==============================

    function getInitials(
      name: string
    ): string {

      return (
        name || '?'
      )
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(
          (part: string) =>
            part
              .charAt(0)
              .toUpperCase()
        )
        .join('');

    }


    function truncate(
      value: string,
      maxLength: number
    ): string {

      if (!value) {
        return '';
      }


      if (
        value.length <=
        maxLength
      ) {

        return value;

      }


      return (
        value.slice(
          0,
          maxLength
        ) +
        '…'
      );

    }


    function escapeHtml(
      value:
        string |
        number |
        null |
        undefined
    ): string {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value == null
          ? ''
          : String(value);


      return div.innerHTML;

    }


    void initPage();

  </script>



