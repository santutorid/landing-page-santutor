    }

    .modal-header {
      padding:
        24px 25px 19px;

      display: flex;

      justify-content:
        space-between;

      gap: 20px;

      border-bottom:
        1px solid #edf0f4;
    }

    .modal-header p:last-child {
      color: #8c97a7;

      font-size: 12px;

      margin:
        5px 0 0;
    }

    .modal-close {
      width: 34px;
      height: 34px;

      flex-shrink: 0;

      border-radius: 50%;

      border: none;

      background: #f3f5f7;

      color: #667389;

      cursor: pointer;

      font-size: 20px;
    }

    form {
      padding:
        22px 25px 25px;
    }

    .form-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 16px;
    }

    .full-width {
      grid-column:
        1 / -1;
    }

    label span,
    .field-title {
      display: block;

      color: #536178;

      font-size: 11px;
      font-weight: 750;

      margin-bottom: 6px;
    }

    label input,
    label select,
    .student-picker-toolbar input {
      width: 100%;
      height: 42px;

      border:
        1px solid #dce3eb;

      border-radius: 9px;

      background: #fff;

      padding:
        0 11px;

      color: #27364b;

      outline: none;

      font-size: 13px;
    }

    label input:focus,
    label select:focus,
    .student-picker-toolbar input:focus {
      border-color: #769dcc;

      box-shadow:
        0 0 0 3px
        rgba(
          73,
          126,
          188,
          .1
        );
    }

    /* STUDENT LINK SECTION */

    .student-link-section {
      margin-top: 22px;

      padding-top: 20px;

      border-top:
        1px solid #edf0f4;
    }

    .student-link-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 15px;

      margin-bottom: 15px;
    }

    .student-link-heading p {
      margin:
        2px 0 0;

      color: #909aaa;

      font-size: 11px;
    }

    .selection-count {
      background: #eef4fb;

      color: #17375e;

      border-radius: 999px;

      padding:
        5px 9px;

      font-size: 10px;
      font-weight: 750;

      white-space: nowrap;
    }

    .relationship-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      align-items: end;

      gap: 16px;

      margin-bottom: 14px;
    }

    .primary-check {
      min-height: 42px;

      border:
        1px solid #e1e7ee;

      border-radius: 9px;

      padding:
        9px 11px;

      display: flex;
      align-items: center;

      gap: 9px;

      cursor: pointer;
    }

    .primary-check input {
      width: 16px;
      height: 16px;

      margin: 0;
    }

    .primary-check span {
      margin: 0;

      font-weight: 650;
    }

    .student-picker-toolbar {
      margin-bottom: 10px;
    }

    .student-picker {
      max-height: 230px;

      overflow-y: auto;

      border:
        1px solid #e1e7ee;

      border-radius: 11px;

      background: #fafbfd;
    }

    .student-option {
      display: flex;
      align-items: center;

      gap: 11px;

      padding:
        11px 12px;

      border-bottom:
        1px solid #e9edf2;

      cursor: pointer;
    }

    .student-option:last-child {
      border-bottom: none;
    }

    .student-option:hover {
      background: white;
    }

    .student-option > input {
      width: 16px;
      height: 16px;

      margin: 0;

      flex-shrink: 0;
    }

    .student-option-avatar {
      width: 34px;
      height: 34px;

      border-radius: 10px;

      background: #edf4fb;

      color: #17375e;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 10px;
      font-weight: 850;

      flex-shrink: 0;
    }

    .student-option-info {
      min-width: 0;
    }

    .student-option-info strong {
      display: block;

      color: #2d3c51;

      font-size: 12px;
    }

    .student-option-info small {
      display: block;

      margin-top: 2px;

      color: #98a2b0;

      font-size: 10px;
    }

    .student-picker-empty {
      padding: 28px 15px;

      text-align: center;

      color: #98a2b0;

      font-size: 12px;
    }

    /* FORM ACTIONS */

    .form-message {
      margin-top: 15px;

      min-height: 18px;

      font-size: 12px;
    }

    .form-message.error {
      color: #c44242;
    }

    .form-actions {
      margin-top: 18px;

      padding-top: 18px;

      border-top:
        1px solid #edf0f4;

      display: flex;
      align-items: center;

      gap: 9px;
    }

    .form-spacer {
      flex: 1;
    }

    .cancel-button,
    .save-button,
    .danger-button {
      border-radius: 9px;

      padding:
        10px 15px;

      font-weight: 750;

      cursor: pointer;
    }

    .cancel-button {
      border:
        1px solid #dce3eb;

      background: white;

      color: #536178;
    }

    .save-button {
      border: none;

      background: #17375e;

      color: white;
    }

    .save-button:disabled,
    .danger-button:disabled {
      opacity: .55;

      cursor: not-allowed;
    }

    .danger-button {
      border:
        1px solid #f0caca;

      background: #fff6f6;

      color: #bf3d3d;
    }

    .danger-button.reactivate {
      border-color: #cce8d6;

      background: #f1fbf5;

      color: #238455;
    }

    /* RESPONSIVE */

    @media
    (max-width: 1000px) {

      .app {
        grid-template-columns:
          80px minmax(0, 1fr);
      }

      .sidebar {
        width: 80px;
      }

      .logo-box {
        width: 50px;

        padding: 6px;
      }

      .portal-label {
        display: none;
      }

      .nav-item {
        justify-content: center;
      }

      .nav-item span:not(
        .nav-icon
      ) {
        display: none;
      }

      .nav-icon {
        font-size: 18px;
      }

      .logout-button span {
        display: none;
      }

      .main {
        padding:
          28px 22px 50px;
      }

    }

    @media
    (max-width: 720px) {

      .app {
        display: block;
      }

      .sidebar {
        display: none;
      }

      .main {
        padding:
          24px 15px 45px;
      }

      .page-header {
        align-items: stretch;

        flex-direction: column;
      }

      .add-button {
        justify-content: center;

        width: 100%;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .panel-top {
        align-items: stretch;

        flex-direction: column;
      }

      .toolbar {
        width: 100%;

        flex-direction: column;
      }

      .search-box,
      #statusFilter {
        width: 100%;
      }

      .form-grid,
      .relationship-grid {
        grid-template-columns: 1fr;
      }

      .full-width {
        grid-column: auto;
      }

      .form-actions {
        flex-wrap: wrap;
      }

      .form-spacer {
        display: none;
      }

      .danger-button {
        width: 100%;
      }

      .cancel-button,
      .save-button {
        flex: 1;
      }

    }

  </style>

</body>
</html>
