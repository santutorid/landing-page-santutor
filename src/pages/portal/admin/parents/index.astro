---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />
  <title>Parents | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>

  <div id="app" class="app" hidden>

    <!-- SIDEBAR -->
    <aside class="sidebar">

      <div class="brand">
        <a href="/portal/admin/">
          <div class="logo-box">
            <img
              src={logoSrc.src}
              alt="Santutor Learning Studio"
            />
          </div>
        </a>

        <span class="portal-label">
          ADMIN PORTAL
        </span>
      </div>

      <nav>

        <a
          class="nav-item"
          href="/portal/admin/"
        >
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/students/"
        >
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>

        <a class="nav-item" href="/portal/admin/schedule/">
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a class="nav-item" href="/portal/admin/attendance/">
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a class="nav-item" href="/portal/admin/reports/">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a class="nav-item" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>

        <a class="nav-item" href="/portal/admin/payments/">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>

        <a
          class="nav-item active"
          href="/portal/admin/parents/"
        >
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>

        <a class="nav-item" href="/portal/admin/tutors/">
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>

      </nav>

      <div class="sidebar-bottom">
        <button
          id="logoutButton"
          class="logout-button"
          type="button"
        >
          ↪
          <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

      <header class="page-header">

        <div>
          <a
            class="back-link"
            href="/portal/admin/"
          >
            ← Back to Dashboard
          </a>

          <p class="eyebrow">
            PARENT MANAGEMENT
          </p>

          <h1>Parents</h1>

          <p class="subtitle">
            Manage parent contacts and link them to Santutor students.
          </p>
        </div>

        <button
          id="showFormButton"
          class="add-button"
          type="button"
        >
          <span class="plus">+</span>
          Add Parent
        </button>

      </header>

      <!-- STATS -->
      <section class="stats-grid">

        <article class="stat-card">
          <div class="stat-icon total-icon">
            👪
          </div>

          <div>
            <span class="stat-label">
              Total Parents
            </span>

            <strong id="totalParents">
              —
            </strong>

            <span class="stat-note">
              Registered contacts
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon active-icon">
            ✓
          </div>

          <div>
            <span class="stat-label">
              Active Parents
            </span>

            <strong id="activeParents">
              —
            </strong>

            <span class="stat-note">
              Currently active
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon linked-icon">
            ↔
          </div>

          <div>
            <span class="stat-label">
              Linked Students
            </span>

            <strong id="linkedStudents">
              —
            </strong>

            <span class="stat-note">
              Students with parent links
            </span>
          </div>
        </article>

      </section>

      <!-- PARENT LIST -->
      <section class="parent-panel">

        <div class="panel-top">

          <div>
            <p class="section-label">
              PARENT DATABASE
            </p>

            <h2>All Parents</h2>

            <p class="panel-description">
              Parent and guardian contacts registered in Santutor.
            </p>
          </div>

          <div class="toolbar">

            <div class="search-box">
              <span class="search-icon">⌕</span>

              <input
                id="searchInput"
                type="search"
                placeholder="Search parents..."
              />
            </div>

            <select id="statusFilter">
              <option value="all">
                All Status
              </option>

              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>
            </select>

          </div>

        </div>

        <div class="table-wrapper">

          <table>

            <thead>
              <tr>
                <th>Parent</th>
                <th>Contact</th>
                <th>Student(s)</th>
                <th>Relationship</th>
                <th>Status</th>
                <th class="action-heading">
                  Action
                </th>
              </tr>
            </thead>

            <tbody id="parentTableBody">
              <tr>
                <td
                  colspan="6"
                  class="empty-row"
                >
                  Loading parents...
                </td>
              </tr>
            </tbody>

          </table>

        </div>

      </section>

    </main>

  </div>

  <!-- ADD / EDIT PARENT MODAL -->
  <div
    id="parentModal"
    class="modal-backdrop"
    hidden
  >

    <div
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <div class="modal-header">

        <div>
          <p
            id="modalEyebrow"
            class="section-label"
          >
            NEW PARENT
          </p>

          <h2 id="modalTitle">
            Add Parent
          </h2>

          <p id="modalDescription">
            Add a new parent or guardian to Santutor.
          </p>
        </div>

        <button
          id="closeFormButton"
          class="modal-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>

      </div>

      <form id="parentForm">

        <div class="form-grid">

          <label class="full-width">
            <span>Parent / Guardian Name *</span>

            <input
              id="name"
              type="text"
              required
              autocomplete="off"
              placeholder="Full parent or guardian name"
            />
          </label>

          <label>
            <span>Parent Code</span>

            <input
              id="parentCode"
              type="text"
              autocomplete="off"
              placeholder="e.g. PR001"
            />
          </label>

          <label>
            <span>Status</span>

            <select id="status">
              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>
            </select>
          </label>

          <label>
            <span>WhatsApp / Phone</span>

            <input
              id="phone"
              type="tel"
              autocomplete="off"
              placeholder="e.g. 0812..."
            />
          </label>

          <label>
            <span>Email</span>

            <input
              id="email"
              type="email"
              autocomplete="off"
              placeholder="parent@email.com"
            />
          </label>

        </div>

        <div class="student-link-section">

          <div class="student-link-heading">
            <div>
              <span class="field-title">
                Link Student(s)
              </span>

              <p>
                Choose one or more students connected to this parent.
              </p>
            </div>

            <span
              id="selectedStudentCount"
              class="selection-count"
            >
              0 selected
            </span>
          </div>

          <div class="relationship-grid">

            <label>
              <span>Relationship</span>

              <select id="relationship">
                <option value="">
                  Select relationship
                </option>

                <option value="Mother">
                  Mother
                </option>

                <option value="Father">
                  Father
                </option>

                <option value="Guardian">
                  Guardian
                </option>

                <option value="Grandparent">
                  Grandparent
                </option>

                <option value="Other">
                  Other
                </option>
              </select>
            </label>

            <label class="primary-check">
              <input
                id="isPrimary"
                type="checkbox"
              />

              <span>
                Primary contact for selected student(s)
              </span>
            </label>

          </div>

          <div class="student-picker-toolbar">

            <input
              id="studentSearch"
              type="search"
              placeholder="Search students to link..."
            />

          </div>

          <div
            id="studentPicker"
            class="student-picker"
          >
            <div class="student-picker-empty">
              Loading students...
            </div>
          </div>

        </div>

        <div
          id="formMessage"
          class="form-message"
        ></div>

        <div class="form-actions">

          <button
            id="deactivateButton"
            type="button"
            class="danger-button"
            hidden
          >
            Deactivate
          </button>

          <div class="form-spacer"></div>

          <button
            id="cancelButton"
            type="button"
            class="cancel-button"
          >
            Cancel
          </button>

          <button
            id="saveButton"
            type="submit"
            class="save-button"
          >
            Add Parent
          </button>

        </div>

      </form>

    </div>

  </div>

  <script>

    import { supabase }
      from '../../../../lib/supabase';


    type Parent = {
      id: string;
      parent_code: string | null;
      name: string;
      phone: string | null;
      email: string | null;
      status: 'active' | 'inactive';
      created_at: string;
      updated_at?: string | null;
    };


    type Student = {
      id: string;
      student_code: string | null;
      name: string;
      status: 'active' | 'inactive';
    };


    type StudentParent = {
      id: string;
      student_id: string;
      parent_id: string;
      relationship: string | null;
      is_primary: boolean;
    };


    let parents: Parent[] = [];

    let students: Student[] = [];

    let links: StudentParent[] = [];

    let editingParentId: string | null =
      null;


    // ==============================
    // AUTH
    // ==============================

    async function initPage() {

      const {
        data: { user }
      } =
        await supabase.auth.getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        return;

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select(
            'role, active'
          )
          .eq(
            'id',
            user.id
          )
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {

        await supabase.auth.signOut();

        window.location.href =
          '/portal/';

        return;

      }


      document
        .querySelector(
          '#loadingScreen'
        )
        ?.setAttribute(
          'style',
          'display:none'
        );


      document
        .querySelector(
          '#app'
        )
        ?.removeAttribute(
          'hidden'
        );


      await loadAllData();

    }


    // ==============================
    // LOAD DATA
    // ==============================

    async function loadAllData() {

      const [
        parentsResult,
        studentsResult,
        linksResult
      ] =
        await Promise.all([

          supabase
            .from('parents')
            .select(`
              id,
              parent_code,
              name,
              phone,
              email,
              status,
              created_at,
              updated_at
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('students')
            .select(`
              id,
              student_code,
              name,
              status
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('student_parents')
            .select(`
              id,
              student_id,
              parent_id,
              relationship,
              is_primary
            `)

        ]);


      if (parentsResult.error) {

        console.error(
          'Load parents error:',
          parentsResult.error
        );

      }


      if (studentsResult.error) {

        console.error(
          'Load students error:',
          studentsResult.error
        );

      }


      if (linksResult.error) {

        console.error(
          'Load parent links error:',
          linksResult.error
        );

      }


      parents =
        (parentsResult.data || []) as Parent[];


      students =
        (studentsResult.data || []) as Student[];


      links =
        (linksResult.data || []) as StudentParent[];


      applyFilters();

      updateStats();

      renderStudentPicker();

    }


    // ==============================
    // TABLE
    // ==============================

    function renderParents(
      list: Parent[]
    ) {

      const tbody =
        document.querySelector(
          '#parentTableBody'
        );


      if (!tbody) return;


      if (
        list.length === 0
      ) {

        tbody.innerHTML = `
          <tr>
            <td
              colspan="6"
              class="empty-row"
            >
              <div class="empty-state">

                <div class="empty-icon">
                  👪
                </div>

                <strong>
                  No parents found
                </strong>

                <p>
                  Add your first parent or
                  change your search filters.
                </p>

              </div>
            </td>
          </tr>
        `;

        return;

      }


      tbody.innerHTML =
        list
          .map(parent => {

            const initials =
              getInitials(
                parent.name
              );


            const parentLinks =
              links.filter(
                link =>
                  link.parent_id ===
                  parent.id
              );


            const linkedNames =
              parentLinks
                .map(link => {

                  const student =
                    students.find(
                      item =>
                        item.id ===
                        link.student_id
                    );


                  return student
                    ? student.name
                    : null;

                })
                .filter(Boolean)
                .join(', ');


            const relationships =
              Array.from(
                new Set(
                  parentLinks
                    .map(
                      link =>
                        link.relationship
                    )
                    .filter(Boolean)
                )
              )
                .join(', ');


            const contact =
              [
                parent.phone,
                parent.email
              ]
                .filter(Boolean)
                .map(
                  value =>
                    escapeHtml(
                      value as string
                    )
                )
                .join(
                  '<br>'
                ) ||
              '—';


            return `
              <tr>

                <td>
                  <div class="parent-cell">

                    <div class="avatar">
                      ${escapeHtml(initials)}
                    </div>

                    <div>
                      <div class="parent-name">
                        ${escapeHtml(parent.name)}
                      </div>

                      <div class="parent-code">
                        ${
                          escapeHtml(
                            parent.parent_code ||
                            'No parent code'
                          )
                        }
                      </div>
                    </div>

                  </div>
                </td>

                <td class="contact-cell">
                  ${contact}
                </td>

                <td>
                  ${
                    linkedNames
                      ? escapeHtml(
                          linkedNames
                        )
                      : '<span class="muted">Not linked</span>'
                  }
                </td>

                <td>
                  ${
                    relationships
                      ? escapeHtml(
                          relationships
                        )
                      : '—'
                  }
                </td>

                <td>
                  <span
                    class="
                      status-badge
                      ${
                        parent.status ===
                        'active'
                          ? 'active'
                          : 'inactive'
                      }
                    "
                  >
                    <span
                      class="status-dot"
                    ></span>

                    ${
                      parent.status ===
                      'active'
                        ? 'Active'
                        : 'Inactive'
                    }
                  </span>
                </td>

                <td class="action-cell">
                  <button
                    class="edit-button edit-parent-button"
                    data-id="${escapeHtml(parent.id)}"
                    type="button"
                  >
                    Edit
                  </button>
                </td>

              </tr>
            `;

          })
          .join('');

    }


    // ==============================
    // STATS
    // ==============================

    function updateStats() {

      const active =
        parents.filter(
          parent =>
            parent.status ===
            'active'
        ).length;


      const linkedStudents =
        new Set(
          links.map(
            link =>
              link.student_id
          )
        ).size;


      setText(
        '#totalParents',
        parents.length
      );


      setText(
        '#activeParents',
        active
      );


      setText(
        '#linkedStudents',
        linkedStudents
      );

    }


    function setText(
      selector: string,
      value: string | number
    ) {

      const element =
        document.querySelector(
          selector
        );


      if (element) {

        element.textContent =
          String(value);

      }

    }


    // ==============================
    // FILTERS
    // ==============================

    function applyFilters() {

      const search =
        (
          document.querySelector(
            '#searchInput'
          ) as HTMLInputElement
        )?.value
          .toLowerCase()
          .trim() || '';


      const status =
        (
          document.querySelector(
            '#statusFilter'
          ) as HTMLSelectElement
        )?.value || 'all';


      const filtered =
        parents.filter(
          parent => {

            const parentLinks =
              links.filter(
                link =>
                  link.parent_id ===
                  parent.id
              );


            const studentNames =
              parentLinks
                .map(link => {

                  const student =
                    students.find(
                      item =>
                        item.id ===
                        link.student_id
                    );


                  return student?.name ||
                    '';

                })
                .join(' ');


            const combined = `
              ${parent.name || ''}
              ${parent.parent_code || ''}
              ${parent.phone || ''}
              ${parent.email || ''}
              ${studentNames}
            `
              .toLowerCase();


            const matchesSearch =
              combined.includes(
                search
              );


            const matchesStatus =
              status === 'all' ||
              parent.status === status;


            return (
              matchesSearch &&
              matchesStatus
            );

          }
        );


      renderParents(
        filtered
      );

    }


    document
      .querySelector(
        '#searchInput'
      )
      ?.addEventListener(
        'input',
        applyFilters
      );


    document
      .querySelector(
        '#statusFilter'
      )
      ?.addEventListener(
        'change',
        applyFilters
      );


    // ==============================
    // STUDENT PICKER
    // ==============================

    function getSelectedStudentIds() {

      return Array.from(
        document.querySelectorAll(
          '.student-checkbox:checked'
        )
      )
        .map(
          checkbox =>
            (
              checkbox as
              HTMLInputElement
            ).value
        );

    }


    function updateSelectedCount() {

      const count =
        getSelectedStudentIds()
          .length;


      setText(
        '#selectedStudentCount',
        `${count} selected`
      );

    }


    function renderStudentPicker(
      selectedIds:
        string[] = []
    ) {

      const picker =
        document.querySelector(
          '#studentPicker'
        );


      if (!picker) return;


      const search =
        (
          document.querySelector(
            '#studentSearch'
          ) as HTMLInputElement
        )?.value
          .toLowerCase()
          .trim() || '';


      const visibleStudents =
        students.filter(
          student => {

            const combined = `
              ${student.name || ''}
              ${student.student_code || ''}
            `
              .toLowerCase();


            return (
              combined.includes(
                search
              )
            );

          }
        );


      if (
        visibleStudents.length === 0
      ) {

        picker.innerHTML = `
          <div class="student-picker-empty">
            No students found.
          </div>
        `;

        updateSelectedCount();

        return;

      }


      picker.innerHTML =
        visibleStudents
          .map(student => {

            const checked =
              selectedIds.includes(
                student.id
              );


            return `
              <label class="student-option">

                <input
                  class="student-checkbox"
                  type="checkbox"
                  value="${escapeHtml(student.id)}"
                  ${checked ? 'checked' : ''}
                />

                <span class="student-option-avatar">
                  ${escapeHtml(
                    getInitials(
                      student.name
                    )
                  )}
                </span>

                <span class="student-option-info">

                  <strong>
                    ${escapeHtml(student.name)}
                  </strong>

                  <small>
                    ${
                      escapeHtml(
                        student.student_code ||
                        'No student code'
                      )
                    }
                    ·
                    ${
                      student.status ===
                      'active'
                        ? 'Active'
                        : 'Inactive'
                    }
                  </small>

                </span>

              </label>
            `;

          })
          .join('');


      picker
        .querySelectorAll(
          '.student-checkbox'
        )
        .forEach(
          checkbox => {

            checkbox.addEventListener(
              'change',
              updateSelectedCount
            );

          }
        );


      updateSelectedCount();

    }


    document
      .querySelector(
        '#studentSearch'
      )
      ?.addEventListener(
        'input',
        () => {

          const selectedIds =
            getSelectedStudentIds();


          renderStudentPicker(
            selectedIds
          );

        }
      );


    // ==============================
    // MODAL
    // ==============================

    function clearFormMessage() {

      const message =
        document.querySelector(
          '#formMessage'
        );


      if (!message) return;


      message.textContent =
        '';


      message.className =
        'form-message';

    }


    function resetStudentSearch() {

      const search =
        document.querySelector(
          '#studentSearch'
        ) as HTMLInputElement;


      if (search) {

        search.value =
          '';

      }

    }


    function showModal() {

      editingParentId =
        null;


      const form =
        document.querySelector(
          '#parentForm'
        ) as HTMLFormElement;


      form?.reset();


      clearFormMessage();

      resetStudentSearch();


      setText(
        '#modalEyebrow',
        'NEW PARENT'
      );


      setText(
        '#modalTitle',
        'Add Parent'
      );


      setText(
        '#modalDescription',
        'Add a new parent or guardian to Santutor.'
      );


      setText(
        '#saveButton',
        'Add Parent'
      );


      const deactivateButton =
        document.querySelector(
          '#deactivateButton'
        ) as HTMLButtonElement;


      if (deactivateButton) {

        deactivateButton.hidden =
          true;

      }


      renderStudentPicker(
        []
      );


      document
        .querySelector(
          '#parentModal'
        )
        ?.removeAttribute(
          'hidden'
        );


      document.body.classList.add(
        'modal-open'
      );


      setTimeout(() => {

        (
          document.querySelector(
            '#name'
          ) as HTMLInputElement
        )?.focus();

      }, 0);

    }


    function openEditModal(
      parentId: string
    ) {

      const parent =
        parents.find(
          item =>
            item.id === parentId
        );


      if (!parent) return;


      editingParentId =
        parent.id;


      clearFormMessage();

      resetStudentSearch();


      (
        document.querySelector(
          '#name'
        ) as HTMLInputElement
      ).value =
        parent.name ||
        '';


      (
        document.querySelector(
          '#parentCode'
        ) as HTMLInputElement
      ).value =
        parent.parent_code ||
        '';


      (
        document.querySelector(
          '#phone'
        ) as HTMLInputElement
      ).value =
        parent.phone ||
        '';


      (
        document.querySelector(
          '#email'
        ) as HTMLInputElement
      ).value =
        parent.email ||
        '';


      (
        document.querySelector(
          '#status'
        ) as HTMLSelectElement
      ).value =
        parent.status;


      const parentLinks =
        links.filter(
          link =>
            link.parent_id ===
            parent.id
        );


      const selectedIds =
        parentLinks.map(
          link =>
            link.student_id
        );


      const firstRelationship =
        parentLinks
          .find(
            link =>
              Boolean(
                link.relationship
              )
          )
          ?.relationship ||
        '';


      const anyPrimary =
        parentLinks.some(
          link =>
            link.is_primary
        );


      (
        document.querySelector(
          '#relationship'
        ) as HTMLSelectElement
      ).value =
        firstRelationship;


      (
        document.querySelector(
          '#isPrimary'
        ) as HTMLInputElement
      ).checked =
        anyPrimary;


      renderStudentPicker(
        selectedIds
      );


      setText(
        '#modalEyebrow',
        'PARENT PROFILE'
      );


      setText(
        '#modalTitle',
        'Edit Parent'
      );


      setText(
        '#modalDescription',
        `Update ${parent.name}'s contact and student links.`
      );


      setText(
        '#saveButton',
        'Save Changes'
      );


      const deactivateButton =
        document.querySelector(
          '#deactivateButton'
        ) as HTMLButtonElement;


      if (deactivateButton) {

        deactivateButton.hidden =
          false;


        deactivateButton.textContent =
          parent.status ===
          'active'
            ? 'Deactivate'
            : 'Reactivate';


        deactivateButton
          .classList
          .toggle(
            'reactivate',
            parent.status ===
              'inactive'
          );

      }


      document
        .querySelector(
          '#parentModal'
        )
        ?.removeAttribute(
          'hidden'
        );


      document.body.classList.add(
        'modal-open'
      );

    }


    function hideModal() {

      document
        .querySelector(
          '#parentModal'
        )
        ?.setAttribute(
          'hidden',
          ''
        );


      document.body.classList.remove(
        'modal-open'
      );


      clearFormMessage();

    }


    // ==============================
    // SAVE PARENT + RELATIONSHIPS
    // ==============================

    document
      .querySelector(
        '#parentForm'
      )
      ?.addEventListener(
        'submit',
        async event => {

          event.preventDefault();


          const nameInput =
            document.querySelector(
              '#name'
            ) as HTMLInputElement;


          const codeInput =
            document.querySelector(
              '#parentCode'
            ) as HTMLInputElement;


          const phoneInput =
            document.querySelector(
              '#phone'
            ) as HTMLInputElement;


          const emailInput =
            document.querySelector(
              '#email'
            ) as HTMLInputElement;


          const statusInput =
            document.querySelector(
              '#status'
            ) as HTMLSelectElement;


          const relationshipInput =
            document.querySelector(
              '#relationship'
            ) as HTMLSelectElement;


          const primaryInput =
            document.querySelector(
              '#isPrimary'
            ) as HTMLInputElement;


          const saveButton =
            document.querySelector(
              '#saveButton'
            ) as HTMLButtonElement;


          const message =
            document.querySelector(
              '#formMessage'
            );


          const name =
            nameInput.value
              .trim();


          if (!name) {

            if (message) {

              message.textContent =
                'Parent name is required.';


              message.className =
                'form-message error';

            }

            return;

          }


          saveButton.disabled =
            true;


          saveButton.textContent =
            editingParentId
              ? 'Saving Changes...'
              : 'Saving...';


          clearFormMessage();


          const parentData = {

            name,

            parent_code:
              codeInput.value
                .trim() ||
              null,

            phone:
              phoneInput.value
                .trim() ||
              null,

            email:
              emailInput.value
                .trim() ||
              null,

            status:
              statusInput.value,

            updated_at:
              new Date()
                .toISOString()

          };


          let parentId =
            editingParentId;


          if (
            editingParentId
          ) {

            const {
              error
            } =
              await supabase
                .from('parents')
                .update(
                  parentData
                )
                .eq(
                  'id',
                  editingParentId
                );


            if (error) {

              handleSaveError(
                error.message
              );

              return;

            }

          } else {

            const {
              data,
              error
            } =
              await supabase
                .from('parents')
                .insert(
                  parentData
                )
                .select(
                  'id'
                )
                .single();


            if (
              error ||
              !data
            ) {

              handleSaveError(
                error?.message ||
                'Unable to create parent.'
              );

              return;

            }


            parentId =
              data.id;

          }


          if (!parentId) {

            handleSaveError(
              'Parent ID is missing.'
            );

            return;

          }


          const {
            error: deleteError
          } =
            await supabase
              .from(
                'student_parents'
              )
              .delete()
              .eq(
                'parent_id',
                parentId
              );


          if (deleteError) {

            handleSaveError(
              deleteError.message
            );

            return;

          }


          const selectedIds =
            getSelectedStudentIds();


          if (
            selectedIds.length >
            0
          ) {

            const relationship =
              relationshipInput.value ||
              null;


            const newLinks =
              selectedIds.map(
                studentId => ({

                  student_id:
                    studentId,

                  parent_id:
                    parentId,

                  relationship,

                  is_primary:
                    primaryInput.checked

                })
              );


            const {
              error: linkError
            } =
              await supabase
                .from(
                  'student_parents'
                )
                .insert(
                  newLinks
                );


            if (linkError) {

              handleSaveError(
                linkError.message
              );

              return;

            }

          }


          await loadAllData();


          hideModal();


          saveButton.disabled =
            false;


          saveButton.textContent =
            'Add Parent';


          editingParentId =
            null;

        }
      );


    function handleSaveError(
      errorMessage: string
    ) {

      console.error(
        'Save parent error:',
        errorMessage
      );


      const message =
        document.querySelector(
          '#formMessage'
        );


      const saveButton =
        document.querySelector(
          '#saveButton'
        ) as HTMLButtonElement;


      if (message) {

        message.textContent =
          errorMessage;


        message.className =
          'form-message error';

      }


      if (saveButton) {

        saveButton.disabled =
          false;


        saveButton.textContent =
          editingParentId
            ? 'Save Changes'
            : 'Add Parent';

      }

    }


    // ==============================
    // EDIT BUTTON
    // ==============================

    document
      .querySelector(
        '#parentTableBody'
      )
      ?.addEventListener(
        'click',
        event => {

          const target =
            event.target as HTMLElement;


          const button =
            target.closest(
              '.edit-parent-button'
            ) as HTMLButtonElement |
              null;


          if (!button) return;


          const parentId =
            button.dataset.id;


          if (parentId) {

            openEditModal(
              parentId
            );

          }

        }
      );


    // ==============================
    // DEACTIVATE / REACTIVATE
    // ==============================

    document
      .querySelector(
        '#deactivateButton'
      )
      ?.addEventListener(
        'click',
        async () => {

          if (!editingParentId) {
            return;
          }


          const parent =
            parents.find(
              item =>
                item.id ===
                editingParentId
            );


          if (!parent) return;


          const newStatus:
            'active' |
            'inactive' =
              parent.status ===
              'active'
                ? 'inactive'
                : 'active';


          const actionLabel =
            newStatus ===
            'inactive'
              ? 'deactivate'
              : 'reactivate';


          const confirmed =
            window.confirm(
              `Are you sure you want to ${actionLabel} ${parent.name}?`
            );


          if (!confirmed) {
            return;
          }


          const button =
            document.querySelector(
              '#deactivateButton'
            ) as HTMLButtonElement;


          button.disabled =
            true;


          button.textContent =
            newStatus ===
            'inactive'
              ? 'Deactivating...'
              : 'Reactivating...';


          const {
            error
          } =
            await supabase
              .from('parents')
              .update({

                status:
                  newStatus,

                updated_at:
                  new Date()
                    .toISOString()

              })
              .eq(
                'id',
                editingParentId
              );


          if (error) {

            window.alert(
              error.message
            );


            button.disabled =
              false;


            button.textContent =
              parent.status ===
              'active'
                ? 'Deactivate'
                : 'Reactivate';


            return;

          }


          await loadAllData();


          button.disabled =
            false;


          hideModal();


          editingParentId =
            null;

        }
      );


    // ==============================
    // MODAL EVENTS
    // ==============================

    document
      .querySelector(
        '#showFormButton'
      )
      ?.addEventListener(
        'click',
        showModal
      );


    document
      .querySelector(
        '#closeFormButton'
      )
      ?.addEventListener(
        'click',
        hideModal
      );


    document
      .querySelector(
        '#cancelButton'
      )
      ?.addEventListener(
        'click',
        hideModal
      );


    document
      .querySelector(
        '#parentModal'
      )
      ?.addEventListener(
        'click',
        event => {

          if (
            event.target ===
            event.currentTarget
          ) {

            hideModal();

          }

        }
      );


    document
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key ===
            'Escape'
          ) {

            hideModal();

          }

        }
      );


    // ==============================
    // LOGOUT
    // ==============================

    document
      .querySelector(
        '#logoutButton'
      )
      ?.addEventListener(
        'click',
        async () => {

          await supabase.auth
            .signOut();


          window.location.href =
            '/portal/';

        }
      );


    // ==============================
    // HELPERS
    // ==============================

    function getInitials(
      name: string
    ) {

      return (
        name || '?'
      )
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(
          part =>
            part
              .charAt(0)
              .toUpperCase()
        )
        .join('');

    }


    function escapeHtml(
      value: string
    ) {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value ?? '';


      return div.innerHTML;

    }


    initPage();

  </script>


