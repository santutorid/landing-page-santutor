---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />
  <meta
    name="robots"
    content="noindex,nofollow,noarchive"
  />
  <title>Schedule | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>

  <div id="app" class="app" hidden>

    <!-- SIDEBAR -->
    <aside class="sidebar">

      <div class="brand">
        <a href="/portal/admin/">
          <div class="logo-box">
            <img
              src={logoSrc.src}
              alt="Santutor Learning Studio"
            />
          </div>
        </a>

        <span class="portal-label">
          ADMIN PORTAL
        </span>
      </div>

      <nav>

        <a
          class="nav-item"
          href="/portal/admin/"
        >
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/students/"
        >
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>

        <a
          class="nav-item active"
          href="/portal/admin/schedule/"
        >
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a class="nav-item" href="/portal/admin/attendance/">
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a class="nav-item" href="/portal/admin/reports/">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a class="nav-item" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>

        <a class="nav-item" href="/portal/admin/payments/">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/parents/"
        >
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>

        <a
          class="nav-item"
          href="/portal/admin/tutors/"
        >
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>

      </nav>

      <div class="sidebar-bottom">
        <button
          id="logoutButton"
          class="logout-button"
          type="button"
        >
          ↪
          <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

      <header class="page-header">

        <div>
          <a
            class="back-link"
            href="/portal/admin/"
          >
            ← Back to Dashboard
          </a>

          <p class="eyebrow">
            CLASS MANAGEMENT
          </p>

          <h1>Schedule</h1>

          <p class="subtitle">
            Manage Santutor's recurring weekly classes.
          </p>
        </div>

        <button
          id="showFormButton"
          class="add-button"
          type="button"
        >
          <span class="plus">+</span>
          Add Schedule
        </button>

      </header>

      <!-- STATS -->
      <section class="stats-grid">

        <article class="stat-card">
          <div class="stat-icon total-icon">
            📅
          </div>

          <div>
            <span class="stat-label">
              Active Classes
            </span>

            <strong id="activeClasses">
              —
            </strong>

            <span class="stat-note">
              Weekly recurring classes
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon onsite-icon">
            🏠
          </div>

          <div>
            <span class="stat-label">
              Onsite
            </span>

            <strong id="onsiteClasses">
              —
            </strong>

            <span class="stat-note">
              In-person classes
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon online-icon">
            💻
          </div>

          <div>
            <span class="stat-label">
              Online
            </span>

            <strong id="onlineClasses">
              —
            </strong>

            <span class="stat-note">
              Remote classes
            </span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon tutor-icon">
            👩‍🏫
          </div>

          <div>
            <span class="stat-label">
              Tutors Scheduled
            </span>

            <strong id="scheduledTutors">
              —
            </strong>

            <span class="stat-note">
              Tutors with active classes
            </span>
          </div>
        </article>

      </section>

      <!-- TOOLBAR -->
      <section class="schedule-panel">

        <div class="panel-top">

          <div>
            <p class="section-label">
              WEEKLY TIMETABLE
            </p>

            <h2>Monday – Sunday</h2>

            <p class="panel-description">
              Classes are sorted automatically by start time.
            </p>
          </div>

          <div class="toolbar">

            <div class="search-box">
              <span class="search-icon">⌕</span>

              <input
                id="searchInput"
                type="search"
                placeholder="Search student, tutor..."
              />
            </div>

            <select id="modeFilter">
              <option value="all">
                All Modes
              </option>

              <option value="onsite">
                Onsite
              </option>

              <option value="online">
                Online
              </option>
            </select>

            <select id="statusFilter">
              <option value="active">
                Active Only
              </option>

              <option value="all">
                All Status
              </option>

              <option value="inactive">
                Inactive
              </option>
            </select>

          </div>

        </div>

        <div
          id="weeklySchedule"
          class="weekly-grid"
        >
          <div class="schedule-loading">
            Loading schedule...
          </div>
        </div>

      </section>

    </main>

  </div>

  <!-- ADD / EDIT MODAL -->
  <div
    id="scheduleModal"
    class="modal-backdrop"
    hidden
  >

    <div
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <div class="modal-header">

        <div>
          <p
            id="modalEyebrow"
            class="section-label"
          >
            NEW CLASS
          </p>

          <h2 id="modalTitle">
            Add Schedule
          </h2>

          <p id="modalDescription">
            Create a recurring weekly class.
          </p>
        </div>

        <button
          id="closeFormButton"
          class="modal-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>

      </div>

      <form id="scheduleForm">

        <div class="form-grid">

          <label>
            <span>Student *</span>

            <select
              id="studentId"
              required
            >
              <option value="">
                Select student
              </option>
            </select>
          </label>

          <label>
            <span>Tutor *</span>

            <select
              id="tutorId"
              required
            >
              <option value="">
                Select tutor
              </option>
            </select>
          </label>

          <label class="full-width">
            <span>Subject</span>

            <input
              id="subject"
              type="text"
              autocomplete="off"
              placeholder="e.g. Mathematics"
            />
          </label>

          <label>
            <span>Day *</span>

            <select
              id="dayOfWeek"
              required
            >
              <option value="">
                Select day
              </option>

              <option value="Monday">
                Monday
              </option>

              <option value="Tuesday">
                Tuesday
              </option>

              <option value="Wednesday">
                Wednesday
              </option>

              <option value="Thursday">
                Thursday
              </option>

              <option value="Friday">
                Friday
              </option>

              <option value="Saturday">
                Saturday
              </option>

              <option value="Sunday">
                Sunday
              </option>
            </select>
          </label>

          <label>
            <span>Mode *</span>

            <select
              id="classMode"
              required
            >
              <option value="onsite">
                Onsite
              </option>

              <option value="online">
                Online
              </option>
            </select>
          </label>

          <label>
            <span>Start Time *</span>

            <input
              id="startTime"
              type="time"
              required
            />
          </label>

          <label>
            <span>End Time *</span>

            <input
              id="endTime"
              type="time"
              required
            />
          </label>

          <label>
            <span>Status</span>

            <select id="status">
              <option value="active">
                Active
              </option>

              <option value="inactive">
                Inactive
              </option>
            </select>
          </label>

          <label>
            <span>Location</span>

            <input
              id="location"
              type="text"
              autocomplete="off"
              placeholder="e.g. Santutor Studio"
            />
          </label>

          <label class="full-width">
            <span>Notes</span>

            <textarea
              id="notes"
              rows="4"
              placeholder="Optional notes..."
            ></textarea>
          </label>

        </div>

        <div
          id="formMessage"
          class="form-message"
        ></div>

        <div class="form-actions">

          <button
            id="deactivateButton"
            type="button"
            class="danger-button"
            hidden
          >
            Deactivate
          </button>

          <div class="form-spacer"></div>

          <button
            id="cancelButton"
            type="button"
            class="cancel-button"
          >
            Cancel
          </button>

          <button
            id="saveButton"
            type="submit"
            class="save-button"
          >
            Add Schedule
          </button>

        </div>

      </form>

    </div>

  </div>

  <script>

    import { supabase }
      from '../../../../lib/supabase';


    type ScheduleStatus =
      'active' |
      'inactive';


    type ClassMode =
      'onsite' |
      'online';


    type DayOfWeek =
      'Monday' |
      'Tuesday' |
      'Wednesday' |
      'Thursday' |
      'Friday' |
      'Saturday' |
      'Sunday';


    type Student = {
      id: string;
      student_code: string | null;
      name: string;
      status: ScheduleStatus;
    };


    type Tutor = {
      id: string;
      tutor_code: string | null;
      name: string;
      status: ScheduleStatus;
    };


    type Schedule = {
      id: string;
      student_id: string;
      tutor_id: string;
      subject: string | null;
      day_of_week: DayOfWeek;
      start_time: string;
      end_time: string;
      class_mode: ClassMode;
      location: string | null;
      notes: string | null;
      status: ScheduleStatus;
      created_at: string;
      updated_at: string | null;
    };


    const DAYS: DayOfWeek[] = [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday'
    ];


    let schedules: Schedule[] = [];

    let students: Student[] = [];

    let tutors: Tutor[] = [];

    let editingScheduleId:
      string | null = null;


    function getEl<T extends Element>(
      selector: string
    ): T {

      const element =
        document.querySelector<T>(
          selector
        );


      if (!element) {

        throw new Error(
          `Element not found: ${selector}`
        );

      }


      return element;

    }


    const loadingScreen =
      getEl<HTMLDivElement>(
        '#loadingScreen'
      );


    const app =
      getEl<HTMLDivElement>(
        '#app'
      );


    const weeklySchedule =
      getEl<HTMLDivElement>(
        '#weeklySchedule'
      );


    const searchInput =
      getEl<HTMLInputElement>(
        '#searchInput'
      );


    const modeFilter =
      getEl<HTMLSelectElement>(
        '#modeFilter'
      );


    const statusFilter =
      getEl<HTMLSelectElement>(
        '#statusFilter'
      );


    const scheduleModal =
      getEl<HTMLDivElement>(
        '#scheduleModal'
      );


    const scheduleForm =
      getEl<HTMLFormElement>(
        '#scheduleForm'
      );


    const studentIdInput =
      getEl<HTMLSelectElement>(
        '#studentId'
      );


    const tutorIdInput =
      getEl<HTMLSelectElement>(
        '#tutorId'
      );


    const subjectInput =
      getEl<HTMLInputElement>(
        '#subject'
      );


    const dayOfWeekInput =
      getEl<HTMLSelectElement>(
        '#dayOfWeek'
      );


    const classModeInput =
      getEl<HTMLSelectElement>(
        '#classMode'
      );


    const startTimeInput =
      getEl<HTMLInputElement>(
        '#startTime'
      );


    const endTimeInput =
      getEl<HTMLInputElement>(
        '#endTime'
      );


    const statusInput =
      getEl<HTMLSelectElement>(
        '#status'
      );


    const locationInput =
      getEl<HTMLInputElement>(
        '#location'
      );


    const notesInput =
      getEl<HTMLTextAreaElement>(
        '#notes'
      );


    const formMessage =
      getEl<HTMLDivElement>(
        '#formMessage'
      );


    const saveButton =
      getEl<HTMLButtonElement>(
        '#saveButton'
      );


    const deactivateButton =
      getEl<HTMLButtonElement>(
        '#deactivateButton'
      );


    // ==============================
    // AUTH
    // ==============================

    async function initPage() {

      const {
        data: { user }
      } =
        await supabase.auth.getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        return;

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select(
            'role, active'
          )
          .eq(
            'id',
            user.id
          )
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {

        await supabase.auth.signOut();

        window.location.href =
          '/portal/';

        return;

      }


      loadingScreen.style.display =
        'none';


      app.hidden =
        false;


      await loadAllData();

    }


    // ==============================
    // LOAD DATA
    // ==============================

    async function loadAllData() {

      const [
        studentsResult,
        tutorsResult,
        schedulesResult
      ] =
        await Promise.all([

          supabase
            .from('students')
            .select(`
              id,
              student_code,
              name,
              status
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('tutors')
            .select(`
              id,
              tutor_code,
              name,
              status
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('schedules')
            .select(`
              id,
              student_id,
              tutor_id,
              subject,
              day_of_week,
              start_time,
              end_time,
              class_mode,
              location,
              notes,
              status,
              created_at,
              updated_at
            `)

        ]);


      if (
        studentsResult.error
      ) {

        console.error(
          'Load students error:',
          studentsResult.error
        );

      }


      if (
        tutorsResult.error
      ) {

        console.error(
          'Load tutors error:',
          tutorsResult.error
        );

      }


      if (
        schedulesResult.error
      ) {

        console.error(
          'Load schedules error:',
          schedulesResult.error
        );


        weeklySchedule.innerHTML = `
          <div class="schedule-loading error-text">
            Unable to load schedule.
          </div>
        `;

        return;

      }


      students =
        (studentsResult.data || []) as Student[];


      tutors =
        (tutorsResult.data || []) as Tutor[];


      schedules =
        (schedulesResult.data || []) as Schedule[];


      populateDropdowns();

      applyFilters();

      updateStats();

    }


    // ==============================
    // DROPDOWNS
    // ==============================

    function populateDropdowns() {

      const currentStudent =
        studentIdInput.value;


      const currentTutor =
        tutorIdInput.value;


      const studentOptions =
        students
          .filter(
            student =>
              student.status ===
              'active' ||
              student.id ===
              currentStudent
          )
          .map(
            student => `
              <option
                value="${escapeHtml(student.id)}"
              >
                ${escapeHtml(student.name)}
                ${
                  student.student_code
                    ? `(${escapeHtml(student.student_code)})`
                    : ''
                }
              </option>
            `
          )
          .join('');


      const tutorOptions =
        tutors
          .filter(
            tutor =>
              tutor.status ===
              'active' ||
              tutor.id ===
              currentTutor
          )
          .map(
            tutor => `
              <option
                value="${escapeHtml(tutor.id)}"
              >
                ${escapeHtml(tutor.name)}
                ${
                  tutor.tutor_code
                    ? `(${escapeHtml(tutor.tutor_code)})`
                    : ''
                }
              </option>
            `
          )
          .join('');


      studentIdInput.innerHTML = `
        <option value="">
          Select student
        </option>
        ${studentOptions}
      `;


      tutorIdInput.innerHTML = `
        <option value="">
          Select tutor
        </option>
        ${tutorOptions}
      `;


      studentIdInput.value =
        currentStudent;


      tutorIdInput.value =
        currentTutor;

    }


    // ==============================
    // FILTER + RENDER
    // ==============================

    function applyFilters() {

      const search =
        searchInput.value
          .toLowerCase()
          .trim();


      const mode =
        modeFilter.value;


      const status =
        statusFilter.value;


      const filtered =
        schedules.filter(
          schedule => {

            const student =
              getStudent(
                schedule.student_id
              );


            const tutor =
              getTutor(
                schedule.tutor_id
              );


            const combined = `
              ${student?.name || ''}
              ${student?.student_code || ''}
              ${tutor?.name || ''}
              ${tutor?.tutor_code || ''}
              ${schedule.subject || ''}
              ${schedule.day_of_week || ''}
              ${schedule.location || ''}
              ${schedule.notes || ''}
            `
              .toLowerCase();


            const matchesSearch =
              combined.includes(
                search
              );


            const matchesMode =
              mode === 'all' ||
              schedule.class_mode ===
              mode;


            const matchesStatus =
              status === 'all' ||
              schedule.status ===
              status;


            return (
              matchesSearch &&
              matchesMode &&
              matchesStatus
            );

          }
        );


      renderSchedule(
        filtered
      );

    }


    function renderSchedule(
      list: Schedule[]
    ) {

      if (
        list.length === 0
      ) {

        weeklySchedule.innerHTML = `
          <div class="empty-schedule">
            <div class="empty-icon">
              📅
            </div>

            <strong>
              No classes found
            </strong>

            <p>
              Add a schedule or change the filters.
            </p>
          </div>
        `;

        return;

      }


      weeklySchedule.innerHTML =
        DAYS
          .map(day => {

            const daySchedules =
              list
                .filter(
                  schedule =>
                    schedule.day_of_week ===
                    day
                )
                .sort(
                  (
                    first,
                    second
                  ) =>
                    first.start_time
                      .localeCompare(
                        second.start_time
                      )
                );


            return `
              <section class="day-column">

                <div class="day-heading">

                  <div>
                    <span class="day-label">
                      ${escapeHtml(day)}
                    </span>

                    <small>
                      ${daySchedules.length}
                      ${
                        daySchedules.length === 1
                          ? 'class'
                          : 'classes'
                      }
                    </small>
                  </div>

                </div>

                <div class="day-list">

                  ${
                    daySchedules.length
                      ? daySchedules
                          .map(
                            schedule =>
                              renderScheduleCard(
                                schedule
                              )
                          )
                          .join('')
                      : `
                        <div class="no-class">
                          No class
                        </div>
                      `
                  }

                </div>

              </section>
            `;

          })
          .join('');

    }


    function renderScheduleCard(
      schedule: Schedule
    ): string {

      const student =
        getStudent(
          schedule.student_id
        );


      const tutor =
        getTutor(
          schedule.tutor_id
        );


      const studentName =
        student?.name ||
        'Unknown student';


      const tutorName =
        tutor?.name ||
        'Unknown tutor';


      const modeLabel =
        schedule.class_mode ===
        'online'
          ? 'Online'
          : 'Onsite';


      const statusClass =
        schedule.status ===
        'active'
          ? ''
          : 'inactive-card';


      return `
        <article
          class="schedule-card ${statusClass}"
        >

          <div class="card-top">

            <div class="time-block">
              ${escapeHtml(
                formatTime(
                  schedule.start_time
                )
              )}
              <span>–</span>
              ${escapeHtml(
                formatTime(
                  schedule.end_time
                )
              )}
            </div>

            <span
              class="
                mode-badge
                ${schedule.class_mode}
              "
            >
              ${modeLabel}
            </span>

          </div>

          <div class="student-name">
            ${escapeHtml(studentName)}
          </div>

          <div class="subject-name">
            ${
              schedule.subject
                ? escapeHtml(
                    schedule.subject
                  )
                : 'General Class'
            }
          </div>

          <div class="schedule-meta">

            <span>
              👩‍🏫
              ${escapeHtml(tutorName)}
            </span>

            ${
              schedule.location
                ? `
                  <span>
                    📍
                    ${escapeHtml(
                      schedule.location
                    )}
                  </span>
                `
                : ''
            }

          </div>

          <div class="card-bottom">

            <span
              class="
                status-badge
                ${
                  schedule.status ===
                  'active'
                    ? 'active'
                    : 'inactive'
                }
              "
            >
              <span class="status-dot"></span>

              ${
                schedule.status ===
                'active'
                  ? 'Active'
                  : 'Inactive'
              }
            </span>

            <button
              class="edit-button edit-schedule-button"
              data-id="${escapeHtml(schedule.id)}"
              type="button"
            >
              Edit
            </button>

          </div>

        </article>
      `;

    }


    // ==============================
    // STATS
    // ==============================

    function updateStats() {

      const active =
        schedules.filter(
          schedule =>
            schedule.status ===
            'active'
        );


      const onsite =
        active.filter(
          schedule =>
            schedule.class_mode ===
            'onsite'
        ).length;


      const online =
        active.filter(
          schedule =>
            schedule.class_mode ===
            'online'
        ).length;


      const tutorCount =
        new Set(
          active.map(
            schedule =>
              schedule.tutor_id
          )
        ).size;


      setText(
        '#activeClasses',
        active.length
      );


      setText(
        '#onsiteClasses',
        onsite
      );


      setText(
        '#onlineClasses',
        online
      );


      setText(
        '#scheduledTutors',
        tutorCount
      );

    }


    function setText(
      selector: string,
      value: string | number
    ) {

      getEl<HTMLElement>(
        selector
      ).textContent =
        String(value);

    }


    // ==============================
    // MODAL
    // ==============================

    function showModal() {

      editingScheduleId =
        null;


      scheduleForm.reset();


      clearFormMessage();


      populateDropdowns();


      setText(
        '#modalEyebrow',
        'NEW CLASS'
      );


      setText(
        '#modalTitle',
        'Add Schedule'
      );


      setText(
        '#modalDescription',
        'Create a recurring weekly class.'
      );


      saveButton.textContent =
        'Add Schedule';


      deactivateButton.hidden =
        true;


      deactivateButton.classList
        .remove(
          'reactivate'
        );


      classModeInput.value =
        'onsite';


      statusInput.value =
        'active';


      scheduleModal.hidden =
        false;


      document.body.classList.add(
        'modal-open'
      );


      setTimeout(
        () =>
          studentIdInput.focus(),
        0
      );

    }


    function openEditModal(
      scheduleId: string
    ) {

      const schedule =
        schedules.find(
          item =>
            item.id ===
            scheduleId
        );


      if (!schedule) return;


      editingScheduleId =
        schedule.id;


      clearFormMessage();


      studentIdInput.value =
        schedule.student_id;


      tutorIdInput.value =
        schedule.tutor_id;


      subjectInput.value =
        schedule.subject || '';


      dayOfWeekInput.value =
        schedule.day_of_week;


      classModeInput.value =
        schedule.class_mode;


      startTimeInput.value =
        normalizeTimeForInput(
          schedule.start_time
        );


      endTimeInput.value =
        normalizeTimeForInput(
          schedule.end_time
        );


      statusInput.value =
        schedule.status;


      locationInput.value =
        schedule.location || '';


      notesInput.value =
        schedule.notes || '';


      populateDropdowns();


      studentIdInput.value =
        schedule.student_id;


      tutorIdInput.value =
        schedule.tutor_id;


      setText(
        '#modalEyebrow',
        'CLASS DETAILS'
      );


      setText(
        '#modalTitle',
        'Edit Schedule'
      );


      setText(
        '#modalDescription',
        'Update this recurring weekly class.'
      );


      saveButton.textContent =
        'Save Changes';


      deactivateButton.hidden =
        false;


      deactivateButton.textContent =
        schedule.status ===
        'active'
          ? 'Deactivate'
          : 'Reactivate';


      deactivateButton.classList
        .toggle(
          'reactivate',
          schedule.status ===
            'inactive'
        );


      scheduleModal.hidden =
        false;


      document.body.classList.add(
        'modal-open'
      );

    }


    function hideModal() {

      scheduleModal.hidden =
        true;


      document.body.classList.remove(
        'modal-open'
      );


      clearFormMessage();

    }


    function clearFormMessage() {

      formMessage.textContent =
        '';


      formMessage.className =
        'form-message';

    }


    function showFormError(
      message: string
    ) {

      formMessage.textContent =
        message;


      formMessage.className =
        'form-message error';

    }


    // ==============================
    // SAVE
    // ==============================

    scheduleForm
      .addEventListener(
        'submit',
        async event => {

          event.preventDefault();


          const studentId =
            studentIdInput.value;


          const tutorId =
            tutorIdInput.value;


          const day =
            dayOfWeekInput.value as DayOfWeek;


          const mode =
            classModeInput.value as ClassMode;


          const status =
            statusInput.value as ScheduleStatus;


          const startTime =
            startTimeInput.value;


          const endTime =
            endTimeInput.value;


          if (
            !studentId ||
            !tutorId ||
            !day ||
            !startTime ||
            !endTime
          ) {

            showFormError(
              'Please complete all required fields.'
            );

            return;

          }


          if (
            endTime <= startTime
          ) {

            showFormError(
              'End time must be later than start time.'
            );

            return;

          }


          const scheduleData = {

            student_id:
              studentId,

            tutor_id:
              tutorId,

            subject:
              subjectInput.value
                .trim() ||
              null,

            day_of_week:
              day,

            start_time:
              startTime,

            end_time:
              endTime,

            class_mode:
              mode,

            location:
              locationInput.value
                .trim() ||
              null,

            notes:
              notesInput.value
                .trim() ||
              null,

            status,

            updated_at:
              new Date()
                .toISOString()

          };


          saveButton.disabled =
            true;


          saveButton.textContent =
            editingScheduleId
              ? 'Saving Changes...'
              : 'Saving...';


          let errorMessage:
            string | null = null;


          if (
            editingScheduleId
          ) {

            const {
              error
            } =
              await supabase
                .from('schedules')
                .update(
                  scheduleData
                )
                .eq(
                  'id',
                  editingScheduleId
                );


            errorMessage =
              error?.message ||
              null;

          } else {

            const {
              error
            } =
              await supabase
                .from('schedules')
                .insert(
                  scheduleData
                );


            errorMessage =
              error?.message ||
              null;

          }


          if (
            errorMessage
          ) {

            console.error(
              'Save schedule error:',
              errorMessage
            );


            showFormError(
              errorMessage
            );


            saveButton.disabled =
              false;


            saveButton.textContent =
              editingScheduleId
                ? 'Save Changes'
                : 'Add Schedule';


            return;

          }


          await loadAllData();


          hideModal();


          saveButton.disabled =
            false;


          saveButton.textContent =
            'Add Schedule';


          editingScheduleId =
            null;

        }
      );


    // ==============================
    // DEACTIVATE / REACTIVATE
    // ==============================

    deactivateButton
      .addEventListener(
        'click',
        async () => {

          if (
            !editingScheduleId
          ) {

            return;

          }


          const schedule =
            schedules.find(
              item =>
                item.id ===
                editingScheduleId
            );


          if (!schedule) return;


          const newStatus:
            ScheduleStatus =
              schedule.status ===
              'active'
                ? 'inactive'
                : 'active';


          const actionLabel =
            newStatus ===
            'inactive'
              ? 'deactivate'
              : 'reactivate';


          const confirmed =
            window.confirm(
              `Are you sure you want to ${actionLabel} this class?`
            );


          if (!confirmed) return;


          deactivateButton.disabled =
            true;


          deactivateButton.textContent =
            newStatus ===
            'inactive'
              ? 'Deactivating...'
              : 'Reactivating...';


          const {
            error
          } =
            await supabase
              .from('schedules')
              .update({

                status:
                  newStatus,

                updated_at:
                  new Date()
                    .toISOString()

              })
              .eq(
                'id',
                editingScheduleId
              );


          if (error) {

            window.alert(
              error.message
            );


            deactivateButton.disabled =
              false;


            deactivateButton.textContent =
              schedule.status ===
              'active'
                ? 'Deactivate'
                : 'Reactivate';


            return;

          }


          await loadAllData();


          deactivateButton.disabled =
            false;


          hideModal();


          editingScheduleId =
            null;

        }
      );


    // ==============================
    // EVENTS
    // ==============================

    searchInput
      .addEventListener(
        'input',
        applyFilters
      );


    modeFilter
      .addEventListener(
        'change',
        applyFilters
      );


    statusFilter
      .addEventListener(
        'change',
        applyFilters
      );


    getEl<HTMLButtonElement>(
      '#showFormButton'
    )
      .addEventListener(
        'click',
        showModal
      );


    getEl<HTMLButtonElement>(
      '#closeFormButton'
    )
      .addEventListener(
        'click',
        hideModal
      );


    getEl<HTMLButtonElement>(
      '#cancelButton'
    )
      .addEventListener(
        'click',
        hideModal
      );


    weeklySchedule
      .addEventListener(
        'click',
        event => {

          const target =
            event.target;


          if (
            !(target instanceof Element)
          ) {

            return;

          }


          const button =
            target.closest<HTMLButtonElement>(
              '.edit-schedule-button'
            );


          if (!button) return;


          const scheduleId =
            button.dataset.id;


          if (scheduleId) {

            openEditModal(
              scheduleId
            );

          }

        }
      );


    scheduleModal
      .addEventListener(
        'click',
        event => {

          if (
            event.target ===
            scheduleModal
          ) {

            hideModal();

          }

        }
      );


    document
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key ===
            'Escape' &&
            !scheduleModal.hidden
          ) {

            hideModal();

          }

        }
      );


    getEl<HTMLButtonElement>(
      '#logoutButton'
    )
      .addEventListener(
        'click',
        async () => {

          await supabase.auth
            .signOut();


          window.location.href =
            '/portal/';

        }
      );


    // ==============================
    // HELPERS
    // ==============================

    function getStudent(
      studentId: string
    ): Student | undefined {

      return students.find(
        student =>
          student.id ===
          studentId
      );

    }


    function getTutor(
      tutorId: string
    ): Tutor | undefined {

      return tutors.find(
        tutor =>
          tutor.id ===
          tutorId
      );

    }


    function formatTime(
      time: string
    ): string {

      if (!time) return '';


      return time.slice(
        0,
        5
      );

    }


    function normalizeTimeForInput(
      time: string
    ): string {

      if (!time) return '';


      return time.slice(
        0,
        5
      );

    }


    function escapeHtml(
      value: string
    ): string {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value ?? '';


      return div.innerHTML;

    }


    initPage();

  </script>


