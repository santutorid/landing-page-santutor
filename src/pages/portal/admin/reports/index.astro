      padding: 10px 11px;
      color: #27364b;
      outline: none;
      font-size: 13px;
    }

    label input,
    label select {
      height: 42px;
    }

    label textarea {
      resize: vertical;
      min-height: 84px;
    }

    label input:focus,
    label select:focus,
    label textarea:focus {
      border-color: #769dcc;
      box-shadow:
        0 0 0 3px
        rgba(73, 126, 188, .1);
    }

    .visibility-toggle {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 12px 13px;
      background: #f8fafc;
      border: 1px solid #e4e9ef;
      border-radius: 10px;
      cursor: pointer;
    }

    .visibility-toggle input {
      width: 16px;
      height: 16px;
      margin: 0;
    }

    .visibility-toggle span {
      margin: 0;
    }

    .form-message {
      margin-top: 15px;
      min-height: 18px;
      font-size: 12px;
    }

    .form-message.error {
      color: #c44242;
    }

    .form-actions {
      margin-top: 18px;
      padding-top: 18px;
      border-top:
        1px solid #edf0f4;
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .form-spacer {
      flex: 1;
    }

    .cancel-button,
    .save-button,
    .danger-button {
      border-radius: 9px;
      padding: 10px 15px;
      font-weight: 750;
      cursor: pointer;
    }

    .cancel-button {
      border: 1px solid #dce3eb;
      background: white;
      color: #536178;
    }

    .save-button {
      border: none;
      background: #17375e;
      color: white;
    }

    .danger-button {
      border: 1px solid #f0caca;
      background: #fff6f6;
      color: #bf3d3d;
    }

    .save-button:disabled,
    .danger-button:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    .error-text {
      color: #c44242;
    }

    @media (max-width: 1150px) {

      .stats-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .panel-top {
        align-items: stretch;
        flex-direction: column;
      }

    }

    @media (max-width: 1000px) {

      .app {
        grid-template-columns:
          80px minmax(0, 1fr);
      }

      .sidebar {
        width: 80px;
      }

      .logo-box {
        width: 50px;
        padding: 6px;
      }

      .portal-label {
        display: none;
      }

      .nav-item {
        justify-content: center;
      }

      .nav-item span:not(.nav-icon) {
        display: none;
      }

      .logout-button span {
        display: none;
      }

      .main {
        padding: 28px 22px 50px;
      }

    }

    @media (max-width: 720px) {

      .app {
        display: block;
      }

      .sidebar {
        display: none;
      }

      .main {
        padding: 24px 15px 45px;
      }

      .page-header {
        align-items: stretch;
        flex-direction: column;
      }

      .add-button {
        width: 100%;
        justify-content: center;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .search-box,
      .toolbar select {
        width: 100%;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .full-width {
        grid-column: auto;
      }

      .form-actions {
        flex-wrap: wrap;
      }

      .form-spacer {
        display: none;
      }

      .danger-button {
        width: 100%;
      }

      .cancel-button,
      .save-button {
        flex: 1;
      }

    }

  </style>

