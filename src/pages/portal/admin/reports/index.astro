---
import logoSrc from '../../../../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>Learning Reports | Santutor Admin</title>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loader"></div>
    <p>Loading Santutor...</p>
  </div>

  <div id="app" class="app" hidden>

    <aside class="sidebar">

      <div class="brand">
        <a href="/portal/admin/">
          <div class="logo-box">
            <img src={logoSrc.src} alt="Santutor Learning Studio" />
          </div>
        </a>
        <span class="portal-label">ADMIN PORTAL</span>
      </div>

      <nav>
        <a class="nav-item" href="/portal/admin/">
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

        <a class="nav-item" href="/portal/admin/students/">
          <span class="nav-icon">👨‍🎓</span>
          <span>Students</span>
        </a>

        <a class="nav-item" href="/portal/admin/schedule/">
          <span class="nav-icon">📅</span>
          <span>Schedule</span>
        </a>

        <a class="nav-item" href="/portal/admin/attendance/">
          <span class="nav-icon">✓</span>
          <span>Attendance</span>
        </a>

        <a class="nav-item active" href="/portal/admin/reports/">
          <span class="nav-icon">📚</span>
          <span>Learning Reports</span>
        </a>

        <a class="nav-item" href="/portal/admin/packages/">
          <span class="nav-icon">🎟</span>
          <span>Packages</span>
        </a>

        <a class="nav-item" href="/portal/admin/payments/">
          <span class="nav-icon">💳</span>
          <span>Payments</span>
        </a>

        <a class="nav-item" href="/portal/admin/parents/">
          <span class="nav-icon">👪</span>
          <span>Parents</span>
        </a>

        <a class="nav-item" href="/portal/admin/tutors/">
          <span class="nav-icon">👩‍🏫</span>
          <span>Tutors</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <button id="logoutButton" class="logout-button" type="button">
          ↪ <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <main class="main">

      <header class="page-header">

        <div>
          <a class="back-link" href="/portal/admin/">
            ← Back to Dashboard
          </a>

          <p class="eyebrow">STUDENT PROGRESS</p>
          <h1>Learning Reports</h1>
          <p class="subtitle">
            Record learning progress, tutor feedback, homework, and next focus.
          </p>
        </div>

        <button id="showFormButton" class="add-button" type="button">
          <span class="plus">+</span>
          Add Report
        </button>

      </header>

      <section class="stats-grid">

        <article class="stat-card">
          <div class="stat-icon total-icon">📚</div>
          <div>
            <span class="stat-label">Total Reports</span>
            <strong id="totalReports">—</strong>
            <span class="stat-note">All learning reports</span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon published-icon">✓</div>
          <div>
            <span class="stat-label">Published</span>
            <strong id="publishedReports">—</strong>
            <span class="stat-note">Ready for parents</span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon draft-icon">✎</div>
          <div>
            <span class="stat-label">Draft</span>
            <strong id="draftReports">—</strong>
            <span class="stat-note">Still being prepared</span>
          </div>
        </article>

        <article class="stat-card">
          <div class="stat-icon visible-icon">👪</div>
          <div>
            <span class="stat-label">Parent Visible</span>
            <strong id="parentVisibleReports">—</strong>
            <span class="stat-note">Visible in parent portal</span>
          </div>
        </article>

      </section>

      <section class="report-panel">

        <div class="panel-top">

          <div>
            <p class="section-label">REPORT DATABASE</p>
            <h2>All Learning Reports</h2>
            <p class="panel-description">
              Drafts stay internal until you publish and allow parent visibility.
            </p>
          </div>

          <div class="toolbar">

            <div class="search-box">
              <span class="search-icon">⌕</span>
              <input
                id="searchInput"
                type="search"
                placeholder="Search student, tutor, topic..."
              />
            </div>

            <select id="statusFilter">
              <option value="all">All Status</option>
              <option value="published">Published</option>
              <option value="draft">Draft</option>
            </select>

            <select id="visibilityFilter">
              <option value="all">All Visibility</option>
              <option value="visible">Parent Visible</option>
              <option value="hidden">Hidden</option>
            </select>

          </div>

        </div>

        <div class="table-wrapper">
          <table>

            <thead>
              <tr>
                <th>Date</th>
                <th>Student</th>
                <th>Tutor</th>
                <th>Subject / Topic</th>
                <th>Ratings</th>
                <th>Visibility</th>
                <th>Status</th>
                <th class="action-heading">Action</th>
              </tr>
            </thead>

            <tbody id="reportTableBody">
              <tr>
                <td colspan="8" class="empty-row">
                  Loading reports...
                </td>
              </tr>
            </tbody>

          </table>
        </div>

      </section>

    </main>

  </div>

  <div id="reportModal" class="modal-backdrop" hidden>

    <div
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <div class="modal-header">

        <div>
          <p id="modalEyebrow" class="section-label">NEW REPORT</p>
          <h2 id="modalTitle">Add Learning Report</h2>
          <p id="modalDescription">
            Record the student's learning progress.
          </p>
        </div>

        <button
          id="closeFormButton"
          class="modal-close"
          type="button"
          aria-label="Close"
        >
          ×
        </button>

      </div>

      <form id="reportForm">

        <div class="form-grid">

          <label>
            <span>Student *</span>
            <select id="studentId" required>
              <option value="">Select student</option>
            </select>
          </label>

          <label>
            <span>Tutor *</span>
            <select id="tutorId" required>
              <option value="">Select tutor</option>
            </select>
          </label>

          <label>
            <span>Report Date *</span>
            <input id="reportDate" type="date" required />
          </label>

          <label>
            <span>Status</span>
            <select id="reportStatus">
              <option value="draft">Draft</option>
              <option value="published">Published</option>
            </select>
          </label>

          <label>
            <span>Subject</span>
            <input
              id="subject"
              type="text"
              autocomplete="off"
              placeholder="e.g. Mathematics"
            />
          </label>

          <label>
            <span>Topic</span>
            <input
              id="topic"
              type="text"
              autocomplete="off"
              placeholder="e.g. Linear Equations"
            />
          </label>

          <label>
            <span>Engagement Rating</span>
            <select id="engagementRating">
              <option value="">Not rated</option>
              <option value="1">1 - Needs Support</option>
              <option value="2">2 - Developing</option>
              <option value="3">3 - Good</option>
              <option value="4">4 - Very Good</option>
              <option value="5">5 - Excellent</option>
            </select>
          </label>

          <label>
            <span>Understanding Rating</span>
            <select id="understandingRating">
              <option value="">Not rated</option>
              <option value="1">1 - Needs Support</option>
              <option value="2">2 - Developing</option>
              <option value="3">3 - Good</option>
              <option value="4">4 - Very Good</option>
              <option value="5">5 - Excellent</option>
            </select>
          </label>

          <label class="full-width">
            <span>Session Summary</span>
            <textarea
              id="summary"
              rows="4"
              placeholder="What was covered during the session?"
            ></textarea>
          </label>

          <label class="full-width">
            <span>Strengths</span>
            <textarea
              id="strengths"
              rows="3"
              placeholder="What did the student do well?"
            ></textarea>
          </label>

          <label class="full-width">
            <span>Areas for Improvement</span>
            <textarea
              id="areasForImprovement"
              rows="3"
              placeholder="What should the student improve?"
            ></textarea>
          </label>

          <label class="full-width">
            <span>Homework</span>
            <textarea
              id="homework"
              rows="3"
              placeholder="Homework or practice assigned..."
            ></textarea>
          </label>

          <label class="full-width">
            <span>Next Focus</span>
            <textarea
              id="nextFocus"
              rows="3"
              placeholder="Focus for the next lesson..."
            ></textarea>
          </label>

          <label class="visibility-toggle full-width">
            <input id="parentVisible" type="checkbox" />
            <span>
              Visible to parent when published
            </span>
          </label>

        </div>

        <div id="formMessage" class="form-message"></div>

        <div class="form-actions">

          <button
            id="deleteReportButton"
            type="button"
            class="danger-button"
            hidden
          >
            Delete Report
          </button>

          <div class="form-spacer"></div>

          <button id="cancelButton" type="button" class="cancel-button">
            Close
          </button>

          <button id="saveButton" type="submit" class="save-button">
            Add Report
          </button>

        </div>

      </form>

    </div>

  </div>

  <script>

    import { supabase }
      from '../../../../lib/supabase';


    type ActiveStatus =
      'active' |
      'inactive';


    type ReportStatus =
      'draft' |
      'published';


    type Student = {
      id: string;
      student_code: string | null;
      name: string;
      status: ActiveStatus;
    };


    type Tutor = {
      id: string;
      tutor_code: string | null;
      name: string;
      status: ActiveStatus;
    };


    type LearningReport = {
      id: string;
      student_id: string;
      tutor_id: string;
      attendance_id: string | null;
      report_date: string;
      subject: string | null;
      topic: string | null;
      summary: string | null;
      strengths: string | null;
      areas_for_improvement: string | null;
      homework: string | null;
      next_focus: string | null;
      engagement_rating: number | null;
      understanding_rating: number | null;
      status: ReportStatus;
      parent_visible: boolean;
      created_at: string;
      updated_at: string | null;
    };


    let students: Student[] = [];
    let tutors: Tutor[] = [];
    let reports: LearningReport[] = [];
    let editingReportId: string | null = null;


    function getEl<T extends Element>(
      selector: string
    ): T {

      const element =
        document.querySelector<T>(
          selector
        );


      if (!element) {

        throw new Error(
          `Element not found: ${selector}`
        );

      }


      return element;

    }


    const loadingScreen =
      getEl<HTMLDivElement>(
        '#loadingScreen'
      );


    const app =
      getEl<HTMLDivElement>(
        '#app'
      );


    const reportTableBody =
      getEl<HTMLTableSectionElement>(
        '#reportTableBody'
      );


    const searchInput =
      getEl<HTMLInputElement>(
        '#searchInput'
      );


    const statusFilter =
      getEl<HTMLSelectElement>(
        '#statusFilter'
      );


    const visibilityFilter =
      getEl<HTMLSelectElement>(
        '#visibilityFilter'
      );


    const reportModal =
      getEl<HTMLDivElement>(
        '#reportModal'
      );


    const reportForm =
      getEl<HTMLFormElement>(
        '#reportForm'
      );


    const studentIdInput =
      getEl<HTMLSelectElement>(
        '#studentId'
      );


    const tutorIdInput =
      getEl<HTMLSelectElement>(
        '#tutorId'
      );


    const reportDateInput =
      getEl<HTMLInputElement>(
        '#reportDate'
      );


    const reportStatusInput =
      getEl<HTMLSelectElement>(
        '#reportStatus'
      );


    const subjectInput =
      getEl<HTMLInputElement>(
        '#subject'
      );


    const topicInput =
      getEl<HTMLInputElement>(
        '#topic'
      );


    const engagementRatingInput =
      getEl<HTMLSelectElement>(
        '#engagementRating'
      );


    const understandingRatingInput =
      getEl<HTMLSelectElement>(
        '#understandingRating'
      );


    const summaryInput =
      getEl<HTMLTextAreaElement>(
        '#summary'
      );


    const strengthsInput =
      getEl<HTMLTextAreaElement>(
        '#strengths'
      );


    const areasForImprovementInput =
      getEl<HTMLTextAreaElement>(
        '#areasForImprovement'
      );


    const homeworkInput =
      getEl<HTMLTextAreaElement>(
        '#homework'
      );


    const nextFocusInput =
      getEl<HTMLTextAreaElement>(
        '#nextFocus'
      );


    const parentVisibleInput =
      getEl<HTMLInputElement>(
        '#parentVisible'
      );


    const formMessage =
      getEl<HTMLDivElement>(
        '#formMessage'
      );


    const saveButton =
      getEl<HTMLButtonElement>(
        '#saveButton'
      );


    const deleteReportButton =
      getEl<HTMLButtonElement>(
        '#deleteReportButton'
      );


    async function initPage() {

      const {
        data: { user }
      } =
        await supabase.auth.getUser();


      if (!user) {

        window.location.href =
          '/portal/';

        return;

      }


      const {
        data: profile,
        error
      } =
        await supabase
          .from('profiles')
          .select('role, active')
          .eq('id', user.id)
          .single();


      if (
        error ||
        !profile ||
        profile.role !== 'admin' ||
        profile.active !== true
      ) {

        await supabase.auth.signOut();

        window.location.href =
          '/portal/';

        return;

      }


      loadingScreen.style.display =
        'none';


      app.hidden =
        false;


      await loadAllData();

    }


    async function loadAllData() {

      const [
        studentsResult,
        tutorsResult,
        reportsResult
      ] =
        await Promise.all([

          supabase
            .from('students')
            .select(`
              id,
              student_code,
              name,
              status
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('tutors')
            .select(`
              id,
              tutor_code,
              name,
              status
            `)
            .order(
              'name',
              {
                ascending: true
              }
            ),

          supabase
            .from('learning_reports')
            .select(`
              id,
              student_id,
              tutor_id,
              attendance_id,
              report_date,
              subject,
              topic,
              summary,
              strengths,
              areas_for_improvement,
              homework,
              next_focus,
              engagement_rating,
              understanding_rating,
              status,
              parent_visible,
              created_at,
              updated_at
            `)
            .order(
              'report_date',
              {
                ascending: false
              }
            )
            .order(
              'created_at',
              {
                ascending: false
              }
            )

        ]);


      if (
        studentsResult.error
      ) {

        throw new Error(
          studentsResult.error.message
        );

      }


      if (
        tutorsResult.error
      ) {

        throw new Error(
          tutorsResult.error.message
        );

      }


      if (
        reportsResult.error
      ) {

        throw new Error(
          reportsResult.error.message
        );

      }


      students =
        (studentsResult.data || []) as Student[];


      tutors =
        (tutorsResult.data || []) as Tutor[];


      reports =
        (reportsResult.data || []) as LearningReport[];


      populateDropdowns();

      applyFilters();

      updateStats();

    }


    function populateDropdowns() {

      const currentStudent =
        studentIdInput.value;


      const currentTutor =
        tutorIdInput.value;


      studentIdInput.innerHTML = `
        <option value="">Select student</option>
        ${
          students
            .filter(
              student =>
                student.status ===
                  'active' ||
                student.id ===
                  currentStudent
            )
            .map(
              student => `
                <option value="${escapeHtml(student.id)}">
                  ${escapeHtml(student.name)}
                  ${
                    student.student_code
                      ? `(${escapeHtml(student.student_code)})`
                      : ''
                  }
                </option>
              `
            )
            .join('')
        }
      `;


      tutorIdInput.innerHTML = `
        <option value="">Select tutor</option>
        ${
          tutors
            .filter(
              tutor =>
                tutor.status ===
                  'active' ||
                tutor.id ===
                  currentTutor
            )
            .map(
              tutor => `
                <option value="${escapeHtml(tutor.id)}">
                  ${escapeHtml(tutor.name)}
                  ${
                    tutor.tutor_code
                      ? `(${escapeHtml(tutor.tutor_code)})`
                      : ''
                  }
                </option>
              `
            )
            .join('')
        }
      `;


      studentIdInput.value =
        currentStudent;


      tutorIdInput.value =
        currentTutor;

    }


    function applyFilters() {

      const search =
        searchInput.value
          .toLowerCase()
          .trim();


      const status =
        statusFilter.value;


      const visibility =
        visibilityFilter.value;


      const filtered =
        reports.filter(
          report => {

            const student =
              getStudent(
                report.student_id
              );


            const tutor =
              getTutor(
                report.tutor_id
              );


            const combined = `
              ${student?.name || ''}
              ${student?.student_code || ''}
              ${tutor?.name || ''}
              ${tutor?.tutor_code || ''}
              ${report.subject || ''}
              ${report.topic || ''}
              ${report.summary || ''}
              ${report.strengths || ''}
              ${report.areas_for_improvement || ''}
            `
              .toLowerCase();


            const matchesSearch =
              combined.includes(
                search
              );


            const matchesStatus =
              status === 'all' ||
              report.status ===
                status;


            const matchesVisibility =
              visibility === 'all' ||
              (
                visibility ===
                  'visible' &&
                report.parent_visible
              ) ||
              (
                visibility ===
                  'hidden' &&
                !report.parent_visible
              );


            return (
              matchesSearch &&
              matchesStatus &&
              matchesVisibility
            );

          }
        );


      renderReports(
        filtered
      );

    }


    function renderReports(
      list: LearningReport[]
    ) {

      if (
        list.length === 0
      ) {

        reportTableBody.innerHTML = `
          <tr>
            <td colspan="8" class="empty-row">

              <div class="empty-state">
                <div class="empty-icon">📚</div>
                <strong>No reports found</strong>
                <p>Add a report or change your filters.</p>
              </div>

            </td>
          </tr>
        `;

        return;

      }


      reportTableBody.innerHTML =
        list
          .map(
            report =>
              renderReportRow(
                report
              )
          )
          .join('');

    }


    function renderReportRow(
      report: LearningReport
    ): string {

      const student =
        getStudent(
          report.student_id
        );


      const tutor =
        getTutor(
          report.tutor_id
        );


      return `
        <tr>

          <td>
            <div class="date-cell">
              <strong>
                ${escapeHtml(
                  formatDate(
                    report.report_date
                  )
                )}
              </strong>
            </div>
          </td>

          <td>
            <div class="student-cell">

              <div class="avatar">
                ${escapeHtml(
                  getInitials(
                    student?.name ||
                    '?'
                  )
                )}
              </div>

              <div>
                <div class="student-name">
                  ${escapeHtml(
                    student?.name ||
                    'Unknown student'
                  )}
                </div>

                <div class="student-code">
                  ${escapeHtml(
                    student?.student_code ||
                    'No student code'
                  )}
                </div>
              </div>

            </div>
          </td>

          <td>
            <div class="tutor-name">
              ${escapeHtml(
                tutor?.name ||
                'Unknown tutor'
              )}
            </div>
          </td>

          <td>
            <div class="topic-cell">
              <strong>
                ${escapeHtml(
                  report.subject ||
                  'General'
                )}
              </strong>

              <span>
                ${escapeHtml(
                  report.topic ||
                  'No topic'
                )}
              </span>
            </div>
          </td>

          <td>
            <div class="ratings-cell">

              <span>
                Engagement:
                <strong>
                  ${report.engagement_rating ?? '—'}
                </strong>
              </span>

              <span>
                Understanding:
                <strong>
                  ${report.understanding_rating ?? '—'}
                </strong>
              </span>

            </div>
          </td>

          <td>
            <span
              class="
                visibility-badge
                ${report.parent_visible ? 'visible' : 'hidden'}
              "
            >
              ${
                report.parent_visible
                  ? 'Parent Visible'
                  : 'Hidden'
              }
            </span>
          </td>

          <td>
            <span
              class="
                status-badge
                ${report.status}
              "
            >
              <span class="status-dot"></span>
              ${capitalize(report.status)}
            </span>
          </td>

          <td class="action-cell">
            <button
              class="edit-button edit-report-button"
              data-id="${escapeHtml(report.id)}"
              type="button"
            >
              Edit
            </button>
          </td>

        </tr>
      `;

    }


    function updateStats() {

      const published =
        reports.filter(
          report =>
            report.status ===
            'published'
        ).length;


      const draft =
        reports.filter(
          report =>
            report.status ===
            'draft'
        ).length;


      const visible =
        reports.filter(
          report =>
            report.parent_visible &&
            report.status ===
              'published'
        ).length;


      setText(
        '#totalReports',
        reports.length
      );


      setText(
        '#publishedReports',
        published
      );


      setText(
        '#draftReports',
        draft
      );


      setText(
        '#parentVisibleReports',
        visible
      );

    }


    function showModal() {

      editingReportId =
        null;


      reportForm.reset();


      clearFormMessage();


      populateDropdowns();


      reportDateInput.value =
        getLocalDateString(
          new Date()
        );


      reportStatusInput.value =
        'draft';


      parentVisibleInput.checked =
        false;


      setText(
        '#modalEyebrow',
        'NEW REPORT'
      );


      setText(
        '#modalTitle',
        'Add Learning Report'
      );


      setText(
        '#modalDescription',
        'Record the student\'s learning progress.'
      );


      saveButton.textContent =
        'Add Report';


      deleteReportButton.hidden =
        true;


      reportModal.hidden =
        false;


      document.body.classList.add(
        'modal-open'
      );


      setTimeout(
        () =>
          studentIdInput.focus(),
        0
      );

    }


    function openEditModal(
      reportId: string
    ) {

      const report =
        reports.find(
          item =>
            item.id ===
            reportId
        );


      if (!report) return;


      editingReportId =
        report.id;


      clearFormMessage();


      studentIdInput.value =
        report.student_id;


      tutorIdInput.value =
        report.tutor_id;


      populateDropdowns();


      studentIdInput.value =
        report.student_id;


      tutorIdInput.value =
        report.tutor_id;


      reportDateInput.value =
        report.report_date;


      reportStatusInput.value =
        report.status;


      subjectInput.value =
        report.subject ||
        '';


      topicInput.value =
        report.topic ||
        '';


      engagementRatingInput.value =
        report.engagement_rating !==
          null
          ? String(
              report.engagement_rating
            )
          : '';


      understandingRatingInput.value =
        report.understanding_rating !==
          null
          ? String(
              report.understanding_rating
            )
          : '';


      summaryInput.value =
        report.summary ||
        '';


      strengthsInput.value =
        report.strengths ||
        '';


      areasForImprovementInput.value =
        report.areas_for_improvement ||
        '';


      homeworkInput.value =
        report.homework ||
        '';


      nextFocusInput.value =
        report.next_focus ||
        '';


      parentVisibleInput.checked =
        report.parent_visible;


      setText(
        '#modalEyebrow',
        'REPORT DETAILS'
      );


      setText(
        '#modalTitle',
        'Edit Learning Report'
      );


      setText(
        '#modalDescription',
        'Update this student progress report.'
      );


      saveButton.textContent =
        'Save Changes';


      deleteReportButton.hidden =
        false;


      reportModal.hidden =
        false;


      document.body.classList.add(
        'modal-open'
      );

    }


    function hideModal() {

      reportModal.hidden =
        true;


      document.body.classList.remove(
        'modal-open'
      );


      clearFormMessage();

    }


    function clearFormMessage() {

      formMessage.textContent =
        '';


      formMessage.className =
        'form-message';

    }


    function showFormError(
      message: string
    ) {

      formMessage.textContent =
        message;


      formMessage.className =
        'form-message error';

    }


    reportForm
      .addEventListener(
        'submit',
        async event => {

          event.preventDefault();


          const studentId =
            studentIdInput.value;


          const tutorId =
            tutorIdInput.value;


          const reportDate =
            reportDateInput.value;


          if (
            !studentId ||
            !tutorId ||
            !reportDate
          ) {

            showFormError(
              'Student, tutor, and report date are required.'
            );

            return;

          }


          const reportStatus =
            reportStatusInput.value as ReportStatus;


          const engagementRating =
            engagementRatingInput.value
              ? Number(
                  engagementRatingInput.value
                )
              : null;


          const understandingRating =
            understandingRatingInput.value
              ? Number(
                  understandingRatingInput.value
                )
              : null;


          const reportData = {

            student_id:
              studentId,

            tutor_id:
              tutorId,

            report_date:
              reportDate,

            subject:
              subjectInput.value
                .trim() ||
              null,

            topic:
              topicInput.value
                .trim() ||
              null,

            summary:
              summaryInput.value
                .trim() ||
              null,

            strengths:
              strengthsInput.value
                .trim() ||
              null,

            areas_for_improvement:
              areasForImprovementInput.value
                .trim() ||
              null,

            homework:
              homeworkInput.value
                .trim() ||
              null,

            next_focus:
              nextFocusInput.value
                .trim() ||
              null,

            engagement_rating:
              engagementRating,

            understanding_rating:
              understandingRating,

            status:
              reportStatus,

            parent_visible:
              parentVisibleInput.checked

          };


          saveButton.disabled =
            true;


          saveButton.textContent =
            editingReportId
              ? 'Saving Changes...'
              : 'Saving...';


          let errorMessage:
            string | null = null;


          if (
            editingReportId
          ) {

            const {
              error
            } =
              await supabase
                .from(
                  'learning_reports'
                )
                .update(
                  reportData
                )
                .eq(
                  'id',
                  editingReportId
                );


            errorMessage =
              error?.message ||
              null;

          } else {

            const {
              error
            } =
              await supabase
                .from(
                  'learning_reports'
                )
                .insert(
                  reportData
                );


            errorMessage =
              error?.message ||
              null;

          }


          if (
            errorMessage
          ) {

            showFormError(
              errorMessage
            );


            saveButton.disabled =
              false;


            saveButton.textContent =
              editingReportId
                ? 'Save Changes'
                : 'Add Report';


            return;

          }


          await loadAllData();


          hideModal();


          saveButton.disabled =
            false;


          saveButton.textContent =
            'Add Report';


          editingReportId =
            null;

        }
      );


    deleteReportButton
      .addEventListener(
        'click',
        async () => {

          if (
            !editingReportId
          ) {

            return;

          }


          const confirmed =
            window.confirm(
              'Delete this learning report permanently?'
            );


          if (!confirmed) return;


          deleteReportButton.disabled =
            true;


          deleteReportButton.textContent =
            'Deleting...';


          const {
            error
          } =
            await supabase
              .from(
                'learning_reports'
              )
              .delete()
              .eq(
                'id',
                editingReportId
              );


          if (error) {

            window.alert(
              error.message
            );


            deleteReportButton.disabled =
              false;


            deleteReportButton.textContent =
              'Delete Report';


            return;

          }


          await loadAllData();


          deleteReportButton.disabled =
            false;


          deleteReportButton.textContent =
            'Delete Report';


          hideModal();


          editingReportId =
            null;

        }
      );


    searchInput
      .addEventListener(
        'input',
        applyFilters
      );


    statusFilter
      .addEventListener(
        'change',
        applyFilters
      );


    visibilityFilter
      .addEventListener(
        'change',
        applyFilters
      );


    getEl<HTMLButtonElement>(
      '#showFormButton'
    )
      .addEventListener(
        'click',
        showModal
      );


    getEl<HTMLButtonElement>(
      '#closeFormButton'
    )
      .addEventListener(
        'click',
        hideModal
      );


    getEl<HTMLButtonElement>(
      '#cancelButton'
    )
      .addEventListener(
        'click',
        hideModal
      );


    reportTableBody
      .addEventListener(
        'click',
        event => {

          const target =
            event.target;


          if (
            !(target instanceof Element)
          ) {

            return;

          }


          const button =
            target.closest<HTMLButtonElement>(
              '.edit-report-button'
            );


          if (!button) return;


          const reportId =
            button.dataset.id;


          if (reportId) {

            openEditModal(
              reportId
            );

          }

        }
      );


    reportModal
      .addEventListener(
        'click',
        event => {

          if (
            event.target ===
            reportModal
          ) {

            hideModal();

          }

        }
      );


    document
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key ===
              'Escape' &&
            !reportModal.hidden
          ) {

            hideModal();

          }

        }
      );


    getEl<HTMLButtonElement>(
      '#logoutButton'
    )
      .addEventListener(
        'click',
        async () => {

          await supabase.auth
            .signOut();


          window.location.href =
            '/portal/';

        }
      );


    function getStudent(
      studentId: string
    ): Student | undefined {

      return students.find(
        student =>
          student.id ===
          studentId
      );

    }


    function getTutor(
      tutorId: string
    ): Tutor | undefined {

      return tutors.find(
        tutor =>
          tutor.id ===
          tutorId
      );

    }


    function setText(
      selector: string,
      value: string | number
    ) {

      getEl<HTMLElement>(
        selector
      ).textContent =
        String(value);

    }


    function capitalize(
      value: string
    ): string {

      if (!value) return '';


      return (
        value.charAt(0)
          .toUpperCase() +
        value.slice(1)
      );

    }


    function getInitials(
      name: string
    ): string {

      return (
        name || '?'
      )
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(
          part =>
            part
              .charAt(0)
              .toUpperCase()
        )
        .join('');

    }


    function formatDate(
      value: string
    ): string {

      const [
        year,
        month,
        day
      ] =
        value
          .split('-')
          .map(Number);


      const date =
        new Date(
          year,
          month - 1,
          day
        );


      return new Intl
        .DateTimeFormat(
          'en-GB',
          {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
          }
        )
        .format(date);

    }


    function getLocalDateString(
      date: Date
    ): string {

      const year =
        date.getFullYear();


      const month =
        String(
          date.getMonth() + 1
        )
          .padStart(
            2,
            '0'
          );


      const day =
        String(
          date.getDate()
        )
          .padStart(
            2,
            '0'
          );


      return `${year}-${month}-${day}`;

    }


    function escapeHtml(
      value: string
    ): string {

      const div =
        document.createElement(
          'div'
        );


      div.textContent =
        value ?? '';


      return div.innerHTML;

    }


    initPage()
      .catch(
        error => {

          console.error(
            'Learning Reports page error:',
            error
          );


          loadingScreen.innerHTML = `
            <p class="error-text">
              Unable to load Learning Reports.
            </p>
          `;

        }
      );

