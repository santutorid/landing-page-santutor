			background: var(--white);
			-webkit-font-smoothing: antialiased;
			overflow-x: hidden;
		}
		img, svg { max-width: 100%; display: block; }
		a { color: inherit; text-decoration: none; }
		ul, ol { list-style: none; margin: 0; padding: 0; }
		h1, h2, h3 { font-family: var(--font-display); font-weight: 600; margin: 0; color: var(--navy); }
		p { margin: 0; line-height: 1.65; color: var(--ink-soft); }
		:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; border-radius: 4px; }

		.wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

		/* ---------- Decorative background system ---------- */
		.section-decor { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
		.blob { position: absolute; border-radius: 50%; filter: blur(46px); opacity: 0.55; }
		.blob-orange { background: var(--orange-light); }
		.blob-blue { background: var(--blue-light); }
		.blob-sage { background: var(--sage-light); }
		.dot-grid {
			position: absolute; inset: 0;
			background-image: radial-gradient(circle, var(--border) 1.6px, transparent 1.6px);
			background-size: 26px 26px;
			-webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 40%, transparent 90%);
			mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 40%, transparent 90%);
			opacity: 0.7;
		}
		.dot-grid-hero { -webkit-mask-image: radial-gradient(ellipse 60% 80% at 20% 30%, #000 30%, transparent 80%); mask-image: radial-gradient(ellipse 60% 80% at 20% 30%, #000 30%, transparent 80%); }
		.doodle { position: absolute; opacity: 0.55; }
		@media (prefers-reduced-motion: no-preference) {
			.doodle-star { animation: doodle-float 5s ease-in-out infinite; }
			.doodle-plus { animation: doodle-float 6.5s ease-in-out infinite 0.5s; }
		}
		@keyframes doodle-float {
			0%, 100% { transform: translateY(0) rotate(0deg); }
			50% { transform: translateY(-10px) rotate(12deg); }
		}
		@media (max-width: 680px) {
			.section-decor .blob { transform: scale(0.7); }
		}

		.eyebrow {
			font-family: var(--font-label);
			font-weight: 700;
			font-size: 0.82rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--orange);
			margin: 0 0 10px;
		}
		.eyebrow-light { color: var(--blue-light); }

		/* ---------- Buttons ---------- */
		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			font-family: var(--font-body);
			font-weight: 800;
			font-size: 0.95rem;
			padding: 13px 26px;
			border: none;
			border-radius: 100px;
			cursor: pointer;
			transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
			white-space: nowrap;
		}
		.btn-sm { padding: 9px 20px; font-size: 0.88rem; }
		.btn-lg { padding: 15px 30px; font-size: 1rem; }
		.btn-block { width: 100%; }
		.btn-primary { background: var(--orange); color: var(--white); box-shadow: 0 12px 24px -12px rgba(242, 118, 30, 0.6); }
		.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 28px -12px rgba(242, 118, 30, 0.7); }
		.btn-ghost { color: var(--navy); border: 2px solid var(--border); background: transparent; }
		.btn-ghost:hover { border-color: var(--navy); transform: translateY(-2px); }

		/* ---------- Language toggle ---------- */
		.language-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: space-between;
			position: relative;
			width: 74px;
			height: 36px;
			padding: 4px 9px;
			border: 1.5px solid var(--border);
			border-radius: 999px;
			background: var(--white);
			color: var(--ink-soft);
			font-family: var(--font-label);
			font-size: 0.72rem;
			font-weight: 800;
			cursor: pointer;
			box-shadow: 0 10px 22px -18px rgba(29,43,69,0.45);
			transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
		}
		.language-toggle:hover { border-color: var(--orange); box-shadow: 0 14px 26px -18px rgba(242,118,30,0.55); }
		.language-code { position: relative; z-index: 2; line-height: 1; transition: color 0.2s ease; }
		body[data-lang="id"] .language-code-id,
		body[data-lang="en"] .language-code-en { color: var(--white); }
		body[data-lang="id"] .language-code-en,
		body[data-lang="en"] .language-code-id { color: var(--ink-soft); }
		.language-knob {
			position: absolute;
			top: 4px;
			left: 4px;
			width: 33px;
			height: 26px;
			border-radius: 999px;
			background: var(--orange);
			box-shadow: 0 8px 16px -10px rgba(242,118,30,0.8);
			transition: transform 0.22s ease;
		}
		body[data-lang="en"] .language-knob { transform: translateX(31px); }
		.mobile-language-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			padding: 10px 4px 14px;
			border-bottom: 1px solid var(--border);
			font-weight: 800;
			color: var(--navy);
		}

		/* ---------- Header ---------- */
		.site-header {
			position: sticky;
			top: 0;
			z-index: 100;
			background: rgba(255, 255, 255, 0.85);
			backdrop-filter: blur(10px);
			border-bottom: 1px solid var(--border);
			transition: border-color 0.25s ease, box-shadow 0.25s ease;
		}
		.site-header.scrolled { border-bottom-color: var(--border); box-shadow: 0 8px 24px -20px rgba(29,43,69,0.4); }
		.nav-inner { display: flex; align-items: center; justify-content: space-between; padding-block: 8px; gap: 20px; }

		.logo { display: flex; align-items: center; }
		.logo-img { height: 64px; width: auto; }

		.main-nav { display: flex; gap: 30px; align-items: center; }
		.main-nav a { font-weight: 700; font-size: 0.92rem; color: var(--navy); position: relative; padding: 4px 0; }
		.main-nav a::after {
			content: ""; position: absolute; left: 0; bottom: -2px; width: 0; height: 2px;
			background: var(--orange); transition: width 0.2s ease;
		}
		.main-nav a:hover::after { width: 100%; }

		.nav-actions { display: flex; align-items: center; gap: 16px; }
		.nav-phone { display: none; align-items: center; gap: 6px; font-weight: 700; font-size: 0.86rem; color: var(--ink-soft); }
		.nav-phone:hover { color: var(--orange); }
		.nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; padding: 6px; cursor: pointer; }
		.nav-toggle span { width: 22px; height: 2.5px; background: var(--navy); border-radius: 2px; transition: transform 0.25s ease, opacity 0.25s ease; }
		.mobile-nav {
			display: none; flex-direction: column; gap: 4px; padding: 8px 24px 20px;
			background: var(--cream); border-bottom: 1px solid var(--border);
		}
		.mobile-nav a { padding: 12px 4px; font-weight: 700; border-bottom: 1px solid var(--border); }
		.mobile-nav .btn { margin-top: 12px; width: 100%; }
		.mobile-nav.open { display: flex; }

		@media (min-width: 1140px) {
			.nav-phone { display: flex; }
		}

		/* ---------- Hero ---------- */
		.hero { padding: 64px 0 96px; overflow: hidden; position: relative; }
		.hero-inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
		.hero-content h1 { font-size: clamp(2.1rem, 4vw, 3.15rem); line-height: 1.14; letter-spacing: -0.005em; margin-bottom: 20px; }
		.hero-lede { font-size: 1.08rem; max-width: 52ch; margin-bottom: 32px; }
		.hero-cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 44px; }
		.hero-stats { display: flex; gap: 34px; margin: 0; }
		.hero-stats dt { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--navy); }
		.hero-stats dd { margin: 2px 0 0; font-size: 0.82rem; color: var(--ink-soft); }

		.hero-visual { position: relative; }
		.hero-blob {
						position: absolute;
						top: 50%;
						left: 50%;
						transform: translate(-50%, -50%);
						width: 120%; 
						aspect-ratio: 1 / 1; 
						background: linear-gradient(135deg, var(--blue-light), var(--orange-light));
						border-radius: 62% 38% 55% 45% / 45% 55% 45% 55%;
						z-index: 0;
					}
		.hero-illustration {
						width: 100%;
						height: 100%;
						
						/* INI KUNCINYA: Memaksa gambar memenuhi area tanpa gepeng */
						object-fit: cover; 
						
						/* Mengembalikan sudut melengkung seperti desain awal */
						border-radius: 28px; 
						
						/* Memastikan gambar berada di depan blob latar belakang */
						position: relative;
						z-index: 1; 
					}
		.hero-badge {
			position: absolute; z-index: 2; bottom: -18px; left: 24px;
			background: var(--white); border-radius: 100px; padding: 10px 18px;
			display: flex; align-items: center; gap: 9px;
			font-weight: 700; font-size: 0.84rem; box-shadow: var(--shadow-soft);
		}
		.hero-badge-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--sage); flex-shrink: 0; }
		.hero-photo-chip {
			position: absolute; z-index: 2; top: -22px; right: -18px;
			width: 92px; height: 92px; border-radius: 22px; overflow: hidden;
			border: 5px solid var(--white); box-shadow: var(--shadow-soft);
			transform: rotate(6deg); margin: 0;
		}
		.hero-photo-chip img { width: 100%; height: 100%; object-fit: cover; }
		@media (max-width: 860px) {
			.hero-photo-chip { width: 76px; height: 76px; top: -14px; right: 6px; }
		}

		/* ---------- Section head ---------- */
		.section-head { max-width: 640px; margin: 0 auto 52px; text-align: center; }
		.section-head h2 { font-size: clamp(1.7rem, 3vw, 2.35rem); margin-bottom: 14px; }
		.section-lede { font-size: 1.02rem; }

		/* ---------- Why: list + collage ---------- */
		.why-section { padding: 90px 0; background: var(--cream); position: relative; overflow: hidden; }
		.why-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
		.why-list { display: flex; flex-direction: column; }
		.why-list-item { display: flex; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--border); }
		.why-list-item:first-child { padding-top: 0; }
		.why-list-item:last-child { border-bottom: none; padding-bottom: 0; }
		.why-list-icon {
			display: flex; align-items: center; justify-content: center; flex-shrink: 0;
			width: 44px; height: 44px; border-radius: 13px;
			background: var(--icon-bg); color: var(--icon-fg);
		}
		.why-list-item h3 { font-size: 1.02rem; margin-bottom: 4px; }
		.why-list-item p { font-size: 0.88rem; }

		.why-collage { display: grid; grid-template-columns: 1.2fr 1fr; grid-template-rows: repeat(2, 1fr); gap: 14px; height: 420px; }
		.collage-item { margin: 0; }
		.collage-item img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-md); box-shadow: var(--shadow-soft); }
		.collage-lg { grid-row: 1 / 3; }

		/* ---------- Tutor carousel ---------- */
		.tutor-section { padding: 90px 0; background: var(--white); position: relative; }
		.tutor-carousel { position: relative; }
		.tutor-track {
			display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
			padding: 6px 6px 10px; margin: 0 -6px;
			-ms-overflow-style: none; scrollbar-width: none;
		}
		.tutor-track::-webkit-scrollbar { display: none; }
		.tutor-card {
			flex: 0 0 250px; scroll-snap-align: start;
			background: var(--white); border: 1px solid var(--border); border-top: 4px solid var(--accent);
			border-radius: var(--radius-md); padding: 28px 22px; text-align: center;
			transition: transform 0.22s ease, box-shadow 0.22s ease;
		}
		.tutor-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-soft); }
		.tutor-avatar {
			display: flex; align-items: center; justify-content: center;
			width: 84px; height: 84px; border-radius: 50%; background: var(--avatar-bg);
			margin: 0 auto 16px;
		}
		.tutor-card h3 { font-size: 1.02rem; margin-bottom: 4px; }
		.tutor-role { font-weight: 700; color: var(--accent); font-size: 0.82rem; margin-bottom: 6px; }
		.tutor-edu { font-size: 0.78rem; margin-bottom: 12px; }
		.tutor-quote { font-size: 0.84rem; font-style: italic; color: var(--navy); line-height: 1.55; }
		.tutor-nav { display: flex; justify-content: center; gap: 12px; margin-top: 18px; }
		.tutor-nav button {
			width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid var(--border); background: var(--white);
			display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--navy);
			transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		}
		.tutor-nav button:hover { background: var(--orange-light); border-color: var(--orange); color: var(--orange); }
		.tutor-note { text-align: center; font-size: 0.78rem; color: var(--ink-soft); margin-top: 24px; opacity: 0.8; }

		/* ---------- Journey ---------- */
		.journey-section { padding: 90px 0 110px; background: var(--white); position: relative; }
		.journey-track {
			display: flex; justify-content: space-between; gap: 20px;
			position: relative; padding-top: 28px;
		}
		.journey-track::before {
			content: ""; position: absolute; top: 32px; left: 4%; right: 4%; height: 0;
			border-top: 2.5px dashed var(--border); z-index: 0;
		}
		.journey-stop { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; transform: translateY(var(--offset)); }
		.journey-dot {
			width: 16px; height: 16px; border-radius: 50%; background: var(--blue);
			border: 4px solid var(--white); box-shadow: 0 0 0 3px var(--blue-light);
			position: relative; z-index: 1; margin-bottom: 22px;
		}
		.journey-dot-end { background: var(--orange); box-shadow: 0 0 0 3px var(--orange-light); }
		.journey-card {
			background: var(--cream); border: 1px solid var(--border); border-radius: var(--radius-md);
			width: 100%; overflow: hidden;
		}
		.journey-photo { width: 100%; height: 118px; object-fit: cover; display: block; }
		.journey-card-body { padding: 18px 18px 22px; }
		.journey-age { font-family: var(--font-label); font-size: 0.78rem; font-weight: 700; color: var(--blue); letter-spacing: 0.04em; }
		.journey-card h3 { font-size: 1.3rem; margin: 4px 0 8px; }
		.journey-card p { font-size: 0.86rem; }

		/* ---------- Program ---------- */
		.program-section { background: var(--navy); padding: 84px 0; position: relative; overflow: hidden; }
		.dot-grid-light {
			background-image: radial-gradient(circle, rgba(255,255,255,0.14) 1.6px, transparent 1.6px);
			background-size: 26px 26px;
			-webkit-mask-image: radial-gradient(ellipse 60% 70% at 85% 20%, #000 30%, transparent 80%);
			mask-image: radial-gradient(ellipse 60% 70% at 85% 20%, #000 30%, transparent 80%);
		}
		.program-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; }
		.light-title { color: var(--white); font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 10px 0 16px; }
		.program-lede { color: rgba(255,255,255,0.72); max-width: 48ch; }
		.program-list { display: flex; flex-direction: column; gap: 0; }
		.program-list li {
			display: flex; align-items: flex-start; gap: 18px;
			padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.14);
		}
		.program-list li:last-child { border-bottom: none; }
		.program-num {
			font-family: var(--font-display); font-weight: 600; color: var(--blue); font-size: 0.9rem; padding-top: 2px;
		}
		.program-text { display: flex; flex-direction: column; gap: 4px; }
		.program-text strong { color: var(--white); font-size: 1.02rem; font-weight: 700; }
		.program-text small { color: rgba(255,255,255,0.6); font-size: 0.82rem; }

		/* ---------- FAQ ---------- */
		.faq-section { padding: 90px 0; background: var(--cream); position: relative; overflow: hidden; }
		.faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
		.faq-item {
			background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md);
			padding: 6px 24px;
		}
		.faq-item summary {
			cursor: pointer; list-style: none; padding: 18px 0;
			font-weight: 700; font-size: 1rem; color: var(--navy);
			display: flex; justify-content: space-between; align-items: center; gap: 16px;
		}
		.faq-item summary::-webkit-details-marker { display: none; }
		.faq-item summary::after {
			content: "+"; font-family: var(--font-display); font-size: 1.4rem; color: var(--orange);
			flex-shrink: 0; transition: transform 0.2s ease;
		}
		.faq-item[open] summary::after { transform: rotate(45deg); }
		.faq-item p { padding-bottom: 20px; font-size: 0.94rem; }

		/* ---------- Testimonials ---------- */
		.testimonials-section { padding: 90px 0; background: var(--white); position: relative; overflow: hidden; }
		.testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
		.testi-card {
			background: var(--cream); border: 1px solid var(--border); border-radius: var(--radius-md);
			padding: 30px 26px; margin: 0; display: flex; flex-direction: column; gap: 16px;
		}
		.testi-stars { color: var(--orange); letter-spacing: 2px; font-size: 0.95rem; }
		.testi-card blockquote { margin: 0; font-size: 0.98rem; color: var(--navy); line-height: 1.6; }
		.testi-card figcaption { display: flex; align-items: center; gap: 12px; font-size: 0.86rem; color: var(--ink-soft); }
		.testi-avatar {
			width: 38px; height: 38px; border-radius: 50%; background: var(--blue-light); color: var(--blue);
			display: flex; align-items: center; justify-content: center; font-weight: 800; flex-shrink: 0;
			font-family: var(--font-display);
		}
		.testi-badge {
			display: inline-flex; align-items: center; gap: 4px; margin-top: 7px;
			padding: 3px 10px; border-radius: 100px; background: var(--badge-bg); color: var(--badge-fg);
			font-size: 0.72rem; font-weight: 700; white-space: nowrap;
		}
		.testi-note { text-align: center; font-size: 0.78rem; color: var(--ink-soft); margin-top: 28px; opacity: 0.8; }

		/* ---------- Pendaftaran ---------- */
		.daftar-section { padding: 90px 0 100px; background: var(--cream); position: relative; overflow: hidden; }
		.daftar-inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; }
		.daftar-lede { margin: 4px 0 28px; max-width: 44ch; }
		.daftar-steps { display: flex; flex-direction: column; gap: 16px; }
		.daftar-steps li { display: flex; align-items: center; gap: 14px; font-weight: 700; color: var(--navy); font-size: 0.98rem; }
		.daftar-steps span {
			width: 30px; height: 30px; border-radius: 50%; background: var(--orange-light); color: var(--orange);
			display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 600;
			flex-shrink: 0; font-size: 0.92rem;
		}

		.daftar-form {
			background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg);
			padding: 34px; box-shadow: var(--shadow-soft); display: flex; flex-direction: column; gap: 18px;
		}
		.form-row { display: flex; flex-direction: column; gap: 7px; }
		.form-row-split { flex-direction: row; gap: 16px; }
		.form-row-split > div { flex: 1; display: flex; flex-direction: column; gap: 7px; }
		label { font-weight: 700; font-size: 0.86rem; color: var(--navy); }
		input, select, textarea {
			font-family: var(--font-body); font-size: 0.96rem; color: var(--navy);
			border: 1.5px solid var(--border); border-radius: 12px; padding: 12px 14px;
			background: var(--cream); transition: border-color 0.18s ease;
		}
		input:focus, select:focus, textarea:focus { border-color: var(--blue); outline: none; }
		textarea { resize: vertical; font-family: var(--font-body); }
		.form-hint { font-size: 0.8rem; text-align: center; color: var(--ink-soft); }

		/* ---------- Floating WhatsApp ---------- */
		.wa-float {
			position: fixed; bottom: 24px; right: 24px; z-index: 200;
			width: 58px; height: 58px; border-radius: 50%; background: var(--whatsapp); color: var(--white);
			display: flex; align-items: center; justify-content: center;
			box-shadow: 0 14px 28px -10px rgba(37, 211, 102, 0.6);
			transition: transform 0.2s ease;
		}
		.wa-float:hover { transform: scale(1.08); }
		.wa-float::before {
			content: ""; position: absolute; inset: 0; border-radius: 50%;
			border: 2px solid var(--whatsapp); animation: wa-pulse 2.2s ease-out infinite;
		}
		@keyframes wa-pulse {
			0% { transform: scale(1); opacity: 0.7; }
			100% { transform: scale(1.6); opacity: 0; }
		}
		@media (prefers-reduced-motion: reduce) {
			.wa-float::before { animation: none; display: none; }
		}

		/* ---------- Footer ---------- */
		.site-footer { background: var(--navy); padding: 70px 0 0; }
		.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 50px; border-bottom: 1px solid rgba(255,255,255,0.12); }
		.logo-chip {
			display: inline-flex; background: var(--white); border-radius: 14px; padding: 8px 14px; margin-bottom: 4px;
		}
		.footer-brand .logo-img { height: 52px; }
		.footer-brand p { color: rgba(255,255,255,0.65); margin-top: 14px; font-size: 0.92rem; max-width: 30ch; }
		.footer-col h4 { color: var(--white); font-family: var(--font-label); font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 16px; }
		.footer-col p { color: rgba(255,255,255,0.68); font-size: 0.92rem; margin-bottom: 8px; }
		.footer-col a:hover { color: var(--blue); }
		.footer-map-link { color: var(--blue); font-weight: 700; font-size: 0.86rem; display: inline-block; margin-top: 6px; }
		.footer-bottom { display: flex; justify-content: space-between; align-items: center; padding: 22px 24px; }
		.footer-bottom p, .footer-bottom a { color: rgba(255,255,255,0.55); font-size: 0.82rem; }
		.footer-bottom a:hover { color: var(--white); }

		/* ---------- Reveal on scroll ---------- */
		.reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
		.reveal.in-view { opacity: 1; transform: translateY(0); }
		@media (prefers-reduced-motion: reduce) {
			.reveal { opacity: 1; transform: none; transition: none; }
			html { scroll-behavior: auto; }
		}

		/* ---------- Responsive ---------- */
		@media (max-width: 980px) {
			.why-columns { grid-template-columns: 1fr; gap: 32px; }
			.why-collage { height: 320px; }
			.testi-grid { grid-template-columns: 1fr; }
			.program-inner { grid-template-columns: 1fr; }
			.daftar-inner { grid-template-columns: 1fr; }
		}
		@media (max-width: 860px) {
			.main-nav { display: none; }
			.nav-toggle { display: flex; }
			.hero-inner { grid-template-columns: 1fr; }
			.hero-visual { order: -1; max-width: 420px; margin: 0 auto; }
			.hero-cta { justify-content: center; }
			.hero-content { text-align: center; }
			.hero-stats { justify-content: center; }
			.hero-lede { margin-inline: auto; }
			.journey-track { flex-direction: column; gap: 34px; }
			.journey-track::before { top: 4%; bottom: 4%; left: 24px; right: auto; width: 0; border-top: none; border-left: 2.5px dashed var(--border); height: auto; }
			.journey-stop { flex-direction: row; text-align: left; transform: none !important; align-items: flex-start; }
			.journey-dot { margin: 4px 20px 0 8px; flex-shrink: 0; }
			.footer-grid { grid-template-columns: 1fr 1fr; }
			.form-row-split { flex-direction: column; }
			.tutor-card { flex-basis: 220px; }
		}
		@media (max-width: 560px) {
			.why-collage { grid-template-columns: 1fr; grid-template-rows: repeat(3, 130px); height: auto; }
			.collage-lg { grid-row: auto; }
			.hero-stats { flex-direction: column; gap: 14px; }
			.hero-cta { flex-direction: column; }
			.hero-cta .btn { width: 100%; }
