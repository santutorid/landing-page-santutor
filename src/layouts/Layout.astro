		const reversePageTranslations = Object.fromEntries(
			Object.entries(pageTranslations).map(([id, en]) => [en, id])
		);

		const readSavedLanguage = () => {
			try {
				const saved = window.localStorage?.getItem(languageStorageKey);
				return saved === 'en' ? 'en' : 'id';
			} catch {
				return 'id';
			}
		};

		const saveLanguage = (lang) => {
			try {
				window.localStorage?.setItem(languageStorageKey, lang);
			} catch {
				// Ignore storage errors; the toggle still works for the current page.
			}
		};

		const normalizeText = (value) => String(value || '').replace(/\s+/g, ' ').trim();
		const preserveOuterWhitespace = (original, replacement) => {
			const prefix = String(original || '').match(/^\s*/)?.[0] || '';
			const suffix = String(original || '').match(/\s*$/)?.[0] || '';
			return `${prefix}${replacement}${suffix}`;
		};
		const translateValue = (value, activeLang) => {
			const normalized = normalizeText(value);
			if (!normalized) return value;
			const translated = activeLang === 'en' ? pageTranslations[normalized] : reversePageTranslations[normalized];
			return translated ? preserveOuterWhitespace(value, translated) : value;
		};
		const updateMetaContent = (selector, content) => {
			const target = document.querySelector(selector);
			if (target && content) target.setAttribute('content', content);
		};
		const translateTextNodes = (activeLang) => {
			const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
				acceptNode(node) {
					const parent = node.parentElement;
					if (!parent) return NodeFilter.FILTER_REJECT;
					if (parent.closest('script, style, svg')) return NodeFilter.FILTER_REJECT;
					if (!normalizeText(node.nodeValue)) return NodeFilter.FILTER_REJECT;
					return NodeFilter.FILTER_ACCEPT;
				},
			});
			const nodes = [];
			while (walker.nextNode()) nodes.push(walker.currentNode);
			nodes.forEach((node) => {
				node.nodeValue = translateValue(node.nodeValue, activeLang);
			});
		};

		const setLanguage = (lang) => {
			const activeLang = lang === 'en' ? 'en' : 'id';
			document.documentElement.lang = activeLang;
			document.body.dataset.lang = activeLang;

			const pageTitle = activeLang === 'en' ? document.body.dataset.pageTitleEn : document.body.dataset.pageTitleId;
			const pageDescription = activeLang === 'en' ? document.body.dataset.pageDescriptionEn : document.body.dataset.pageDescriptionId;
			const ogTitle = activeLang === 'en' ? document.body.dataset.ogTitleEn : document.body.dataset.ogTitleId;
			const ogDescription = activeLang === 'en' ? document.body.dataset.ogDescriptionEn : document.body.dataset.ogDescriptionId;
			if (pageTitle) document.title = pageTitle;
			updateMetaContent('meta[name="description"]', pageDescription);
			updateMetaContent('meta[property="og:title"]', ogTitle);
			updateMetaContent('meta[property="og:description"]', ogDescription);

			document.querySelectorAll('[data-i18n-id][data-i18n-en]').forEach((element) => {
				const translated = activeLang === 'en' ? element.dataset.i18nEn : element.dataset.i18nId;
				if (typeof translated === 'string') element.textContent = translated;
			});

			document.querySelectorAll('[data-i18n-html-id][data-i18n-html-en]').forEach((element) => {
				const translated = activeLang === 'en' ? element.dataset.i18nHtmlEn : element.dataset.i18nHtmlId;
				if (typeof translated === 'string') element.innerHTML = translated;
			});

			['placeholder', 'aria-label', 'title', 'alt', 'value'].forEach((attribute) => {
				const idKey = `i18n${attribute.replace(/(^|-)([a-z])/g, (_, _sep, char) => char.toUpperCase())}Id`;
				const enKey = `i18n${attribute.replace(/(^|-)([a-z])/g, (_, _sep, char) => char.toUpperCase())}En`;
				document.querySelectorAll(`[data-${idKey.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}][data-${enKey.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}]`).forEach((element) => {
					const translated = activeLang === 'en' ? element.dataset[enKey] : element.dataset[idKey];
					if (typeof translated === 'string') element.setAttribute(attribute, translated);
				});
			});

			document.querySelectorAll('input[placeholder], textarea[placeholder], img[alt], [aria-label], [title]').forEach((element) => {
				['placeholder', 'alt', 'aria-label', 'title'].forEach((attribute) => {
					if (!element.hasAttribute(attribute)) return;
					element.setAttribute(attribute, translateValue(element.getAttribute(attribute), activeLang));
				});
			});

			translateTextNodes(activeLang);

			languageToggles.forEach((button) => {
				button.setAttribute('aria-pressed', String(activeLang === 'en'));
				button.setAttribute(
					'aria-label',
					activeLang === 'en' ? 'Ganti bahasa ke Bahasa Indonesia' : 'Switch language to English'
				);
			});

			window.dispatchEvent(new CustomEvent('santutor:language-change', { detail: { language: activeLang } }));
		};

		let currentLanguage = readSavedLanguage();
		setLanguage(currentLanguage);
		languageToggles.forEach((button) => {
			button.addEventListener('click', () => {
				currentLanguage = currentLanguage === 'en' ? 'id' : 'en';
				setLanguage(currentLanguage);
				saveLanguage(currentLanguage);
			});
		});

		const header = document.getElementById('siteHeader');
		const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		const toggle = document.getElementById('navToggle');
		const mobileNav = document.getElementById('mobileNav');
		toggle?.addEventListener('click', () => {
			const open = mobileNav?.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(!!open));
		});
		mobileNav?.querySelectorAll('a').forEach((a) =>
			a.addEventListener('click', () => {
				mobileNav.classList.remove('open');
				toggle?.setAttribute('aria-expanded', 'false');
			})
		);

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!prefersReduced && 'IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('in-view');
							io.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15 }
			);
			document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		} else {
			document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
		}
	</script>
</body>
