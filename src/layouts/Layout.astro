---
import logoSrc from '../assets/logo.svg';

type CurrentPage =
	| 'home'
	| 'e-learning'
	| 'math'
	| 'english'
	| 'science'
	| 'bahasa-indonesia'
	| 'stem'
	| 'coding'
	| 'robotic'
	| 'coming-soon';

interface Props {
	title?: string;
	description?: string;
	currentPage?: CurrentPage;
	ogTitle?: string;
	ogDescription?: string;
	titleEn?: string;
	descriptionEn?: string;
	ogTitleEn?: string;
	ogDescriptionEn?: string;
}

const {
	title = 'SAN TUTOR Learning Studio — Mitra Belajar Seumur Hidup Anak Anda',
	description = 'SAN TUTOR menemani anak Anda dari TK hingga SMA dengan tutor tetap, kurikulum berjenjang, dan kelas kecil yang interaktif.',
	currentPage = 'home',
	ogTitle = title,
	ogDescription = description,
	titleEn = title,
	descriptionEn = description,
	ogTitleEn = titleEn,
	ogDescriptionEn = descriptionEn,
} = Astro.props;

const subjectItems = [
	{ key: 'math', labelId: 'Matematika', labelEn: 'Mathematics', href: '/e-learning/matematika', ready: true },
	{ key: 'english', labelId: 'English', labelEn: 'English', href: '/e-learning/coming-soon?subject=english', ready: false },
	{ key: 'science', labelId: 'Science', labelEn: 'Science', href: '/e-learning/coming-soon?subject=science', ready: false },
	{ key: 'bahasa-indonesia', labelId: 'Bahasa Indonesia', labelEn: 'Indonesian Language', href: '/e-learning/coming-soon?subject=bahasa-indonesia', ready: false },
	{ key: 'stem', labelId: 'STEM', labelEn: 'STEM', href: '/e-learning/coming-soon?subject=stem', ready: false },
	{ key: 'coding', labelId: 'Coding', labelEn: 'Coding', href: '/e-learning/coming-soon?subject=coding', ready: false },
	{ key: 'robotic', labelId: 'Robotic', labelEn: 'Robotics', href: '/e-learning/coming-soon?subject=robotic', ready: false },
] as const;

const isSubjectPage = subjectItems.some((item) => item.key === currentPage);
const currentSubject = subjectItems.find((item) => item.key === currentPage);
const isELearning = currentPage === 'e-learning' || currentPage === 'coming-soon' || isSubjectPage;
const ctaHref = isELearning ? '/#pendaftaran' : '#pendaftaran';
const logoHref = isELearning ? '/' : '#top';
const faqHref = isELearning ? '/e-learning#faq-elearning' : '#faq';
const backTopHref = '#top';
const waText = currentSubject
	? `Halo SAN TUTOR, saya ingin bertanya tentang materi ${currentSubject.labelId} E-Learning.`
	: isELearning
		? 'Halo SAN TUTOR, saya ingin bertanya tentang E-Learning.'
		: 'Halo SAN TUTOR, saya ingin bertanya tentang program belajar.';
const waHref = `https://wa.me/6285872000689?text=${encodeURIComponent(waText)}`;
---

<!DOCTYPE html>
<html lang="id">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
	<meta name="description" content={description} data-page-description />
	<link rel="icon" href={logoSrc.src} type="image/svg+xml" />

	<meta property="og:type" content="website" />
	<meta property="og:title" content={ogTitle} data-og-title />
	<meta property="og:description" content={ogDescription} data-og-description />
	<meta property="og:image" content={logoSrc.src} />
	<meta name="twitter:card" content="summary" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="preconnect" href="https://images.pexels.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />
	<slot name="head" />
</head>
<body data-page-title-id={title} data-page-title-en={titleEn} data-page-description-id={description} data-page-description-en={descriptionEn} data-og-title-id={ogTitle} data-og-title-en={ogTitleEn} data-og-description-id={ogDescription} data-og-description-en={ogDescriptionEn}>
	<header class="site-header" id="siteHeader">
		<div class="wrap nav-inner">
			<a href={logoHref} class="logo" aria-label="SAN TUTOR Learning Studio — Beranda" data-i18n-aria-label-id="SAN TUTOR Learning Studio — Beranda" data-i18n-aria-label-en="SAN TUTOR Learning Studio — Home">
				<img
					src={logoSrc.src}
					style="height: 90px; width: auto;"
					alt="Logo Santutor Learning Studio"
					class="logo-img"
				/>
			</a>

			<nav class="main-nav" id="mainNav" aria-label="Navigasi utama" data-i18n-aria-label-id="Navigasi utama" data-i18n-aria-label-en="Main navigation">
				<a href="/#tentang" data-i18n-id="Tentang" data-i18n-en="About">Tentang</a>
				<a href="/#program" data-i18n-id="Program" data-i18n-en="Programs">Program</a>
				<div class={isELearning ? 'nav-dropdown is-active' : 'nav-dropdown'}>
					<a href="/e-learning" class="nav-dropdown-trigger" aria-current={isELearning ? 'page' : undefined}>
						<span data-i18n-id="E-Learning" data-i18n-en="E-Learning">E-Learning</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
					</a>
					<div class="nav-dropdown-menu" aria-label="Menu E-Learning" data-i18n-aria-label-id="Menu E-Learning" data-i18n-aria-label-en="E-Learning menu">
						{subjectItems.map((item) => (
							<a href={item.href} aria-current={currentPage === item.key ? 'page' : undefined}>
								<span data-i18n-id={item.labelId} data-i18n-en={item.labelEn}>{item.labelId}</span>
								{!item.ready && <small data-i18n-id="soon" data-i18n-en="soon">soon</small>}
							</a>
						))}
					</div>
				</div>

			</nav>

			<div class="nav-actions">
				<button
					type="button"
					class="language-toggle"
					data-language-toggle
					aria-label="Switch language to English"
					aria-pressed="false"
				>
					<span class="language-code language-code-id">ID</span>
					<span class="language-knob" aria-hidden="true"></span>
					<span class="language-code language-code-en">EN</span>
				</button>
				<a href="https://wa.me/6285872000689" class="nav-phone" target="_blank" rel="noopener">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
					<span>+62 858-7200-0689</span>
				</a>
				<a href={ctaHref} class="btn btn-primary btn-sm" data-i18n-id="Daftar Sekarang" data-i18n-en="Register Now">Daftar Sekarang</a>
				<button class="nav-toggle" id="navToggle" aria-label="Buka menu" data-i18n-aria-label-id="Buka menu" data-i18n-aria-label-en="Open menu" aria-expanded="false" aria-controls="mobileNav">
					<span></span><span></span><span></span>
				</button>
			</div>
		</div>

		<div class="mobile-nav" id="mobileNav">
			<div class="mobile-language-row">
				<span data-i18n-id="Bahasa" data-i18n-en="Language">Bahasa</span>
				<button
					type="button"
					class="language-toggle"
					data-language-toggle
					aria-label="Switch language to English"
					aria-pressed="false"
				>
					<span class="language-code language-code-id">ID</span>
					<span class="language-knob" aria-hidden="true"></span>
					<span class="language-code language-code-en">EN</span>
				</button>
			</div>
			<a href="/#tentang" data-i18n-id="Tentang" data-i18n-en="About">Tentang</a>
			<a href="/#program" data-i18n-id="Program" data-i18n-en="Programs">Program</a>
			<details class="mobile-nav-group" open={isELearning}>
				<summary data-i18n-id="E-Learning" data-i18n-en="E-Learning">E-Learning</summary>
				<div class="mobile-subnav">
					<a href="/e-learning" aria-current={currentPage === 'e-learning' ? 'page' : undefined} data-i18n-id="Overview E-Learning" data-i18n-en="E-Learning Overview">Overview E-Learning</a>
					{subjectItems.map((item) => (
						<a href={item.href} aria-current={currentPage === item.key ? 'page' : undefined}>
							<span data-i18n-id={item.labelId} data-i18n-en={item.labelEn}>{item.labelId}</span>
							{!item.ready && <small data-i18n-id="soon" data-i18n-en="soon">soon</small>}
						</a>
					))}
				</div>
			</details>

			<a href={ctaHref} class="btn btn-primary" data-i18n-id="Daftar Sekarang" data-i18n-en="Register Now">Daftar Sekarang</a>
		</div>
	</header>

	<slot />

	<a href={waHref} class="wa-float" target="_blank" rel="noopener" aria-label="Chat dengan SAN TUTOR via WhatsApp" data-i18n-aria-label-id="Chat dengan SAN TUTOR via WhatsApp" data-i18n-aria-label-en="Chat with SAN TUTOR via WhatsApp">
		<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2.003c-5.53 0-10.02 4.49-10.02 10.02 0 1.77.46 3.44 1.27 4.9L2 22l5.2-1.27a9.96 9.96 0 0 0 4.84 1.24h.01c5.53 0 10.02-4.49 10.02-10.02 0-2.67-1.04-5.19-2.93-7.08a9.96 9.96 0 0 0-7.1-2.85Z" opacity=".18"/><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/></svg>
	</a>

	<footer class="site-footer">
		<div class="wrap footer-grid">
			<div class="footer-brand">
				<a href="/" aria-label="Santutor Learning Studio">
					<img
						src={logoSrc.src}
						alt="Logo Santutor Learning Studio"
						class="logo-img"
						style="filter: invert(1) brightness(100); mix-blend-mode: color-dodge; height: 90px; width: auto;"
					/>
				</a>
				<p data-i18n-id="Mitra belajar anak Anda, dari TK hingga SMA." data-i18n-en="Your child’s learning partner, from kindergarten to senior high school.">Mitra belajar anak Anda, dari TK hingga SMA.</p>
			</div>

			<div class="footer-col">
				<h4 data-i18n-id="Lokasi" data-i18n-en="Location">Lokasi</h4>
				<p>Janur Kuning Residence<br />Jl. Kelapa puan raya Blok WS-1 No. 7<br />Kelapa Gading, Jakarta Utara<br />DKI Jakarta, 14240</p>
				<a class="footer-map-link" href="https://maps.app.goo.gl/NGiAVGoFEdXkbChr5" target="_blank" rel="noopener" data-i18n-id="Buka di Google Maps →" data-i18n-en="Open in Google Maps →">Buka di Google Maps →</a>
			</div>

			<div class="footer-col">
				<h4 data-i18n-id="Kontak" data-i18n-en="Contact">Kontak</h4>
				<p><a href="mailto:halo@santutor.id">halo@santutor.id</a></p>
				<p><a href="tel:+6285872000689">+62 858-7200-0689</a></p>
			</div>

			<div class="footer-col">
				<h4 data-i18n-id="E-Learning" data-i18n-en="E-Learning">E-Learning</h4>
				<p><a href="/e-learning" data-i18n-id="Overview" data-i18n-en="Overview">Overview</a></p>
				{subjectItems.map((item) => (
					<p><a href={item.href}><span data-i18n-id={item.labelId} data-i18n-en={item.labelEn}>{item.labelId}</span>{!item.ready && <span data-i18n-id=" — segera hadir" data-i18n-en=" — coming soon"> — segera hadir</span>}</a></p>
				))}
			</div>
		</div>
		<div class="wrap footer-bottom">
			<p data-i18n-id="© 2026 SAN TUTOR Learning Studio. Seluruh hak cipta dilindungi." data-i18n-en="© 2026 SAN TUTOR Learning Studio. All rights reserved.">© 2026 SAN TUTOR Learning Studio. Seluruh hak cipta dilindungi.</p>
			<a href={backTopHref} data-i18n-id="Kembali ke atas ↑" data-i18n-en="Back to top ↑">Kembali ke atas ↑</a>
		</div>
	</footer>

	<script>
		const languageStorageKey = 'santutor-language';
		const languageToggles = document.querySelectorAll('[data-language-toggle]');
		const pageTranslations = {
			"Sejak TK hingga SMA, satu atap yang sama": "From kindergarten to senior high school, all in one place",
			"Satu Mitra Belajar, untuk Setiap Babak Tumbuh Kembang Anak Anda": "One Learning Partner for Every Stage of Your Child’s Growth",
			"SAN TUTOR mendampingi anak Anda sejak langkah pertama di TK hingga garis akhir SMA — dengan tutor yang mengenal mereka luar-dalam, kurikulum yang ikut berkembang, dan kelas kecil yang membuat setiap anak benar-benar didengar.": "SAN TUTOR supports your child from their first steps in kindergarten through senior high school — with tutors who understand them deeply, a curriculum that grows with them, and small classes where every child is truly heard.",
			"Daftar Kelas Percobaan Gratis": "Book a Free Trial Class",
			"Lihat Jenjang Belajar": "View Learning Levels",
			"Siswa terbimbing": "Students supported",
			"4 Jenjang": "4 Levels",
			"TK · SD · SMP · SMA": "KG · Primary · Lower Secondary · High School",
			"Maks. 5": "Max. 5",
			"Anak per kelas": "Children per class",
			"Kelas kecil, maksimal 5 anak": "Small classes, maximum 5 children",
			"Kenapa Orang Tua Memilih Kami": "Why Parents Choose Us",
			"Belajar yang Ikut Tumbuh Bersama Anak Anda": "Learning That Grows with Your Child",
			"Bukan sekadar bimbingan belajar musiman. SAN TUTOR dibangun agar satu tutor bisa benar-benar mengenal anak Anda, dari kebiasaan belajarnya sampai apa yang membuatnya semangat.": "More than seasonal tutoring. SAN TUTOR is built so tutors can truly understand your child — from their learning habits to what motivates them.",
			"Tutor untuk Semua Jenjang": "Tutors Across All Levels",
			"Satu tutor dapat mendampingi anak Anda dari TK hingga SMA — kepercayaan dan pemahaman karakter anak terus terjaga, tidak mulai dari nol tiap tahun.": "A tutor can support your child from kindergarten through senior high school, so trust and understanding are built over time rather than starting over every year.",
			"Kurikulum Berjenjang & Personal": "Structured and Personalised Curriculum",
			"Materi disusun berbasis proyek dan disesuaikan gaya belajar tiap anak — bukan modul seragam untuk semua orang.": "Materials are designed around projects and each child’s learning style — not a one-size-fits-all module.",
			"Kelas Kecil & Interaktif": "Small and Interactive Classes",
			"Maksimal 5 anak per kelas, agar setiap pertanyaan terjawab dan setiap anak punya ruang untuk aktif.": "A maximum of 5 children per class, so questions are answered and every child has space to participate.",
			"Lingkungan Aman & Menyenangkan": "Safe and Enjoyable Environment",
			"Ruang belajar yang nyaman dan pengajar terlatih membuat anak betah — dan orang tua tenang.": "A comfortable learning space and trained tutors help children feel at ease — and give parents peace of mind.",
			"Kenali Tim Pengajar": "Meet the Teaching Team",
			"Tutor yang Akan Mendampingi Anak Anda": "Tutors Who Will Support Your Child",
			"Bukan wajah asing yang berganti tiap semester. Ini tutor tetap kami — dipilih lewat seleksi ketat dan dilatih memahami cara belajar tiap anak.": "Not unfamiliar faces that change every semester. These are our regular tutors — carefully selected and trained to understand how each child learns.",
			"Tutor TK SD &SMP": "KG, Primary & Lower Secondary Tutor",
			"Guru Sekolah Internasional Berpengalaman lebih dari 5 tahun Mengajar": "International school teacher with over 5 years of teaching experience",
			"Semua anak pasti bisa!": "Every child can learn!",
			"Spesialis STEM": "STEM Specialist",
			"Master pendidikan dan Pendidik Tersertifikasi, Pengalaman lebih dari 15 tahun mengajar": "Master’s in Education and certified educator with over 15 years of teaching experience",
			"Kalau konsep dasarnya kuat, soal sesulit apa pun jadi terasa masuk akal.": "When the core concept is strong, even difficult questions start to make sense.",
			"Spesialis Bahasa & Persiapan Ujian SMA": "Language & Senior High Exam Preparation Specialist",
			"S.Pd Pendidikan Bahasa Inggris, Universitas Padjadjaran": "B.Ed. in English Education, Universitas Padjadjaran",
			"Persiapan ujian paling efektif kalau anak juga percaya diri, bukan cuma hafal rumus.": "Exam preparation works best when children are confident, not just memorising formulas.",
			"Spesialis Sains SMP & SMA": "Lower Secondary & High School Science Specialist",
			"S.Pd Pendidikan Fisika, Universitas Gadjah Mada": "B.Ed. in Physics Education, Universitas Gadjah Mada",
			"Sains itu paling seru kalau dikaitkan ke hal-hal yang anak lihat sehari-hari.": "Science becomes more engaging when it connects to things children see every day.",
			"Perjalanan Belajar Bersama Kami": "The Learning Journey with Us",
			"Satu Jalur, Empat Babak Pertumbuhan": "One Path, Four Stages of Growth",
			"Di mana pun posisi belajar anak Anda saat ini, SAN TUTOR siap menjadi mitra terbaiknya. Kami menyediakan program belajar adaptif untuk semua jenjang—mulai dari pondasi dasar di TK/SD, persiapan kelulusan SMP, hingga strategi sukses ujian di SMA.": "Wherever your child is in their learning journey, SAN TUTOR is ready to support them. We provide adaptive programmes for every level — from foundational learning in KG/Primary, to lower secondary preparation, to senior high exam strategies.",
			"4–6 tahun": "Ages 4–6",
			"7–12 tahun": "Ages 7–12",
			"13–15 tahun": "Ages 13–15",
			"16–18 tahun": "Ages 16–18",
			"Mengenal huruf, angka, dan kebiasaan belajar lewat permainan dan cerita.": "Introducing letters, numbers, and learning habits through play and stories.",
			"Menguatkan dasar Matematika, Bahasa, dan Sains sambil menumbuhkan rasa percaya diri.": "Strengthening foundations in Math, Language, and Science while building confidence.",
			"Memperdalam pemahaman konsep dan melatih kebiasaan belajar yang lebih mandiri.": "Deepening conceptual understanding and building more independent study habits.",
			"Fokus pada pendalaman materi, strategi ujian, dan persiapan menuju jenjang berikutnya.": "Focused on deeper understanding, exam strategies, and preparation for the next stage.",
			"Program Kami": "Our Programmes",
			"Dirancang Sesuai Kebutuhan, Bukan Sekadar Jadwal": "Designed Around Needs, Not Just Schedules",
			"Dari pendampingan reguler mingguan hingga kelas intensif menjelang ujian, setiap program disusun bersama orang tua agar benar-benar menjawab kebutuhan anak. Biaya bervariasi tergantung jenjang dan frekuensi — tim kami akan bantu hitungkan paket yang paling pas saat konsultasi.": "From regular weekly support to intensive exam preparation, every programme is planned with parents so it addresses the child’s real needs. Fees vary by level and frequency — our team will help recommend the most suitable package during consultation.",
			"Bimbingan Reguler Mingguan": "Regular Weekly Tutoring",
			"• 1× seminggu (60 menit/sesi) • 2× seminggu (60 menit/sesi) • 3× seminggu (60 menit/sesi)": "• 1× per week (60 minutes/session) • 2× per week (60 minutes/session) • 3× per week (60 minutes/session)",
			"Kelas Intensif Persiapan Ujian": "Intensive Exam Preparation",
			"Jadwal padat menjelang UTS/UAS/ujian masuk": "Focused sessions before midterms, finals, or entrance exams",
			"Pendampingan Tugas & PR": "Homework & Assignment Support",
			"Fleksibel, disesuaikan jadwal sekolah anak": "Flexible and adjusted to the child’s school schedule",
			"Konsultasi Perkembangan Bulanan": "Monthly Progress Consultation",
			"Laporan progres langsung ke orang tua": "Progress updates shared directly with parents",
			"Pertanyaan yang Sering Ditanyakan": "Frequently Asked Questions",
			"Sebelum Anda Mendaftar": "Before You Register",
			"Apakah ada kelas percobaan sebelum mendaftar?": "Is there a trial class before registration?",
			"Ada. Kami menyediakan satu sesi kelas percobaan gratis agar Anda dan anak bisa merasakan langsung cara mengajar tutor kami sebelum memutuskan.": "Yes. We provide one free trial class so you and your child can experience how our tutors teach before deciding.",
			"Bagaimana proses seleksi tutor di SAN TUTOR?": "How does SAN TUTOR select its tutors?",
			"Setiap tutor melalui seleksi kompetensi akademik, wawancara, dan pelatihan cara mengajar anak sebelum diizinkan memegang kelas — bukan sekadar menguasai materi pelajaran.": "Every tutor goes through academic screening, interviews, and training in how to teach children before taking classes — not just subject mastery.",
			"Apakah jadwal bisa disesuaikan dengan kegiatan sekolah anak?": "Can the schedule be adjusted to my child’s school activities?",
			"Bisa. Jadwal kelas reguler kami atur bersama orang tua di awal, dan bisa disesuaikan lagi jika ada perubahan kegiatan sekolah atau ekstrakurikuler anak.": "Yes. Regular class schedules are arranged with parents at the start and can be adjusted if school or extracurricular activities change.",
			"Bagaimana sistem pembayarannya?": "How does payment work?",
			"Pembayaran dilakukan per paket bulanan. Rincian biaya akan kami sampaikan setelah mengetahui jenjang dan program yang dipilih saat konsultasi.": "Payment is made through monthly packages. We will share the fee details after confirming the level and programme during consultation.",
			"Apa yang terjadi kalau anak naik jenjang, misalnya dari SD ke SMP?": "What happens when my child moves up a level, such as from Primary to Lower Secondary?",
			"Karena tutor kami mendampingi lintas jenjang, sebisa mungkin kami pertahankan tutor yang sama agar anak tidak perlu beradaptasi dari awal lagi.": "Because our tutors support students across levels, we try to keep the same tutor where possible so your child does not need to adjust from the beginning again.",
